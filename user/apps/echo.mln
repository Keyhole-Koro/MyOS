namespace app;

import ulib from "../lib/ulib.mln";
import { Line } from "../lib/ulib.mln";
import process from "@std/hosted/process.mln";
import { Text } from "@std/text/text.mln";

/**
 * `echo <text>` prints the text. With nothing after its name it echoes the
 * lines typed to it until "quit".
 * @return Exit code 0.
 */
export i32 main() {
    Text<128> arguments = process.args();
    if (!arguments.is_empty()) {
        ulib.println(arguments.as_str());
        return 0;
    }
    Line line;
    ulib.println("echo: type lines, 'quit' to exit");
    while (1) {
        ulib.read_line(&line);
        if (ulib.line_is(line, "quit")) {
            ulib.println("bye");
            return 0;
        }
        ulib.print("> ");
        ulib.print_line(line);
    }
}
