package app;

import { sys_yield } from "../lib/sys.masm";
import ulib from "../lib/ulib.mln";

/**
 * User application entry point: counts to ten while yielding between prints.
 * @return Exit code 0.
 */
export i32 main() {
    i32 i = 1;
    while (i <= 10) {
        ulib.print("count ");
        ulib.print_i32(i);
        ulib.println("");
        i32 spin = 0;
        while (spin < 20) {
            sys_yield();
            spin = spin + 1;
        }
        i = i + 1;
    }
    ulib.println("done");
    return 0;
}
