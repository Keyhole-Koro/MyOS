package ulib;

import { sys_read, sys_write, sys_yield, sys_exit } from "sys.masm";

// Minimal user-space runtime: stdio over the read/write syscalls and a few
// string helpers. No heap (sbrk exists but nothing here needs it) and small
// stack frames -- a process gets one 4 KiB stack page.

export i32 strlen(char* s) {
    i32 n = 0;
    while (s[n] != 0) { n = n + 1; }
    return n;
}

export i32 str_eq(char* a, char* b) {
    i32 i = 0;
    while (a[i] != 0) {
        if (a[i] != b[i]) { return 0; }
        i = i + 1;
    }
    if (b[i] != 0) { return 0; }
    return 1;
}

export void print(char* s) {
    sys_write(1, s, strlen(s));
}

export void println(char* s) {
    print(s);
    sys_write(1, "\n", 1);
}

export void print_i32(i32 v) {
    char digits[12];
    i32 n = 0;
    i32 neg = 0;
    if (v < 0) { neg = 1; v = 0 - v; }
    if (v == 0) { digits[n] = '0'; n = n + 1; }
    while (v > 0) {
        digits[n] = (char)('0' + v % 10);
        v = v / 10;
        n = n + 1;
    }
    if (neg != 0) { digits[n] = '-'; n = n + 1; }
    // Digits were produced least significant first; emit them reversed.
    char out[12];
    i32 i = 0;
    while (i < n) {
        out[i] = digits[n - 1 - i];
        i = i + 1;
    }
    sys_write(1, &out[0], n);
}

// Read one line from stdin into buf (at most cap-1 bytes, NUL-terminated,
// newline stripped). stdin is non-blocking, so yield between empty reads
// instead of spinning. Returns the length.
export i32 readline(char* buf, i32 cap) {
    i32 len = 0;
    while (1) {
        char c[1];
        i32 got = sys_read(0, &c[0], 1);
        if (got <= 0) {
            sys_yield();
        } else {
            i32 ch = (i32)c[0] & 0xFF;
            if (ch == 10) {
                buf[len] = (char)0;
                return len;
            }
            if (len + 1 < cap) {
                buf[len] = (char)ch;
                len = len + 1;
            }
        }
    }
    return len;
}

export void exit(i32 code) {
    sys_exit(code);
}
