package ulib;

import { sys_read, sys_write, sys_yield, sys_exit } from "sys.masm";
import { SyscallStatus } from "@contracts/myos/syscall.contract.mln";

// Minimal user-space runtime: stdio over the read/write syscalls and a few
// string helpers. No heap (sbrk exists but nothing here needs it) and small
// stack frames -- a process gets one 4 KiB stack page.

/**
 * One line of input.
 * @property data The bytes.
 * @property length Number of bytes.
 */
export struct Line {
    char data[96];
    i32 length;
};

/**
 * Tests a line against a string.
 * @param line Line to compare.
 * @param s Expected text.
 * @return True if they hold the same bytes.
 */
@safe
export bool line_is(Line line, str s) {
    if (line.length != s.length) { return false; }
    i32 i = 0;
    while (i < s.length) {
        if (line.data[i] != s.data[i]) { return false; }
        i++;
    }
    return true;
}

/**
 * Writes a line to standard output, followed by a newline.
 * @param line Line to write.
 */
@safe
export void print_line(Line line) {
    i32 written = 0;
    sys_write(1, &line.data[0], line.length, &written);
    sys_write(1, "\n", 1, &written);
}

/**
 * Writes a string to standard output (file descriptor 1).
 * @param s String to write.
 */
@safe
export void print(str s) {
    i32 written = 0;
    sys_write(1, s.data, s.length, &written);
}

/**
 * Writes a string followed by a newline to standard output.
 * @param s String to write.
 */
@safe
export void println(str s) {
    print(s);
    i32 written = 0;
    sys_write(1, "\n", 1, &written);
}

/**
 * Prints a 32-bit signed integer in decimal form to standard output.
 * @param v Integer value to print.
 */
@safe
export void print_i32(i32 v) {
    char digits[12];
    i32 n = 0;
    bool neg = false;
    if (v < 0) { neg = true; v = -v; }
    if (v == 0) { digits[n] = '0'; n++; }
    while (v > 0) {
        digits[n] = (char)('0' + v % 10);
        v = v / 10;
        n++;
    }
    if (neg) { digits[n] = '-'; n++; }
    // Digits were produced least significant first; emit them reversed.
    char out[12];
    i32 i = 0;
    while (i < n) {
        out[i] = digits[n - 1 - i];
        i++;
    }
    i32 written = 0;
    sys_write(1, &out[0], n, &written);
}

/**
 * Reads a line of text from standard input (descriptor 0).
 * The trailing newline is dropped; bytes past the line's capacity are lost.
 * @param out Destination line.
 */
@safe
export void read_line(borrow Line out) {
    out.length = 0;
    while (1) {
        char c[1];
        i32 got = 0;
        SyscallStatus status = sys_read(0, &c[0], 1, &got);
        if (status != SyscallStatus::Ok || got <= 0) {
            sys_yield();
        } else {
            i32 ch = (i32)c[0] & 0xFF;
            if (ch == 10) { return; }
            if (out.length < 96) {
                out.data[out.length] = (char)ch;
                out.length++;
            }
        }
    }
}

/** Gives up the CPU until the scheduler returns to this process. */
@safe
export void yield_cpu() { sys_yield(); }

/**
 * Terminates the current process with the given exit code.
 * @param code Process exit status code.
 */
@safe
export void exit(i32 code) {
    sys_exit(code);
}
