import assert from "@std/testing/assert.mln";
import mock from "../../../../toolchain/MyLangTestKit/runtime/facade.mln";
import dom from "@os/ui/dom/dom.mln";
import dom_hit_test from "@os/ui/dom/dom_hit_test.mln";
import desktop from "@os/ui/desktop.mln";
import dom_elements from "@os/ui/dom/dom_elements.mln";
import dom_widgets from "@os/ui/dom/dom_widgets.mln";
import dom_focus from "@os/ui/dom/dom_focus.mln";
import dom_text_edit from "@os/ui/dom/dom_text_edit.mln";
import dom_list from "@os/ui/dom/dom_list.mln";
import dom_window_chrome from "@os/ui/dom/dom_window_chrome.mln";
import dom_render from "@os/ui/dom/dom_render.mln";
import graphics from "@os/ui/graphics.mln";
import theme from "@os/ui/theme.mln";
import heap from "@kernel/mm/heap.mln";
import allocator from "@std/memory/allocator.mln";
import { Option } from "@std/core/option.mln";
import { Result } from "@std/core/result.mln";
import { NodeId, UiError } from "@contracts/ui/widget.contract.mln";
import { NodeRow } from "@os/ui/dom/dom_model.mln";
import { Pid } from "@contracts/process/control.contract.mln";

// Pins the interaction contract the compositor relies on: it holds no node ids
// and starts every interaction from a hit test, so what must hold is that
// find_at returns the node under a point and dispatch_click queues that node's
// own handler, which drain_events then runs. Two buttons are mounted so a hit
// can be wrong rather than merely absent. Handlers set directly with
// set_on_click take the raw handler ABI, (owner, id, arg).
//
// Coordinates handed to create_* are logical (1024x768) and relative to the
// parent; a window's children start below its title bar (MYOS-014). Input
// points below are computed in the same logical space, then scaled.

i32 g_hits_a = 0;
i32 g_hits_b = 0;
i32 g_hits_c = 0;
i32 g_hits_d = 0;

i32 required_node_value(Option<i32> value) {
    return case value of {
        Some(v) -> v;
        None -> ({ assert.assert_true(false, "expected a live node bound"); 0; });
    };
}
i32 g_changes = 0;

void on_a(Option<Pid> owner, NodeId id, i32 arg) {
    g_hits_a = g_hits_a + 1;
}

void on_b(Option<Pid> owner, NodeId id, i32 arg) {
    g_hits_b = g_hits_b + 1;
}

void on_c(Option<Pid> owner, NodeId id, i32 arg) {
    g_hits_c = g_hits_c + 1;
}

void on_d(Option<Pid> owner, NodeId id, i32 arg) {
    g_hits_d = g_hits_d + 1;
}

void on_change(Option<Pid> owner, NodeId id, i32 arg) {
    g_changes = g_changes + 1;
}

NodeId require_node(Result<NodeId, UiError> result) {
    return case result of {
        Ok(id) -> id;
        Err(_) -> ({ assert.assert_true(false, "node creation failed"); (NodeId)0; });
    };
}

void require_append(Result<_, UiError> result) {
    case result of {
        Ok(_) -> _;
        Err(_) -> ({ assert.assert_true(false, "append failed"); });
    };
}

// Click wherever the pointer is, the way the compositor does: hit-test first,
// then dispatch to whatever came back.
Option<NodeId> click_at(i32 x, i32 y) {
    Option<NodeId> hit = dom_hit_test.find_at(x, y);
    case hit of {
        Some(id) -> ({
            dom.dispatch_click(id);
            dom.drain_events();
        });
        None -> _;
    };
    return hit;
}

/*@Test "dom hit dispatch" {
    step: 20000000;
}*/
void dom_hit_dispatch() {
    heap.init();
    allocator.configure(heap.alloc, heap.free);
    desktop.init();

    // The public scalar boundary keeps DOM's Node representation private.
    i32 none_sentinel = dom.node_exists(NodeId(0)) == 0;
    i32 none_negative = dom.node_exists(NodeId(-1)) == 0;
    i32 some_desktop = dom.node_exists(dom.desktop_id());

    i32 tb = theme.TITLEBAR_H; // logical px; children sit below it

    NodeId win = require_node(dom_elements.create_window("W", 0, 0, 400, 300));
    require_append(dom.append_child(dom.desktop_id(), win));

    NodeId a = require_node(dom_elements.create_button("A", 10, 10, 100, 50));
    dom.set_on_click(a, on_a);
    require_append(dom.append_child(win, a));          // -> (10, tb + 10)

    NodeId b = require_node(dom_elements.create_button("B", 200, 10, 100, 50));
    dom.set_on_click(b, on_b);
    require_append(dom.append_child(win, b));          // -> (200, tb + 10)

    // A decorative Box is visible but is not a hit target. It must therefore
    // not obscure its interactive descendants or turn empty decoration into a
    // click.
    NodeId box = require_node(dom_elements.create_box(20, 170, 200, 120, 14737632, 8947848));
    require_append(dom.append_child(win, box));        // -> (20, tb + 170)

    // Column owns direct-child x/y positions. Text reserves its measured
    // line height even though it has no explicit bounds, so D lands below it.
    NodeId column = require_node(dom_elements.create_column(0, 10, 200, 100, 10, 5));
    require_append(dom.append_child(box, column));     // -> (20, tb + 180)

    NodeId c = require_node(dom_elements.create_button("C", 0, 0, 80, 20));
    dom.set_on_click(c, on_c);
    require_append(dom.append_child(column, c));       // -> (30, tb + 190)

    NodeId label = require_node(dom_elements.create_text("note", 0, 0));
    require_append(dom.append_child(column, label));   // -> (30, tb + 215)

    NodeId d = require_node(dom_elements.create_button("D", 0, 0, 80, 20));
    dom.set_on_click(d, on_d);
    require_append(dom.append_child(column, d));       // -> below the label + gap

    assert.assert_true(none_sentinel == 1, "sentinel node id is None");
    assert.assert_true(none_negative == 1, "negative node id is None");
    assert.assert_true(some_desktop == 1, "desktop id resolves to a node");

    // DOM coordinates are logical; controls are scaled to the configured
    // display size. Keep input points in the same logical coordinate space.
    i32 scale = dom.ui_scale();

    // Children were translated by the window's content origin.
    assert.assert_true(required_node_value(dom.node_x(a)) == 10 * scale, "A keeps its authored x");
    assert.assert_true(required_node_value(dom.node_y(a)) == (tb + 10) * scale, "A sits below the title bar");
    assert.assert_true(required_node_value(dom.node_x(c)) == 30 * scale, "column padding places C");
    assert.assert_true(required_node_value(dom.node_y(c)) == (tb + 190) * scale, "column origin places C");

    Option<NodeId> hit_a = click_at(50 * scale, (tb + 30) * scale);   // inside A
    Option<NodeId> hit_b = click_at(240 * scale, (tb + 30) * scale);  // inside B
    assert.assert_true(dom.holds(hit_a, a), "A hit test returns A");
    assert.assert_true(dom.holds(hit_b, b), "B hit test returns B");

    // Outside both buttons the hit is the window itself: it is a hit target
    // (so clicks focus it) but carries no handler, so no counter moves.
    Option<NodeId> outside = click_at(350 * scale, (tb + 250) * scale);
    assert.assert_true(dom.holds(outside, win), "empty window area hits the window");

    Option<NodeId> box_hit = click_at(50 * scale, (tb + 175) * scale);
    assert.assert_true(dom.holds(box_hit, win), "decorative box does not become a hit target");

    // C at (30, tb+190); D follows the label's measured height plus the gap.
    Option<NodeId> hit_c = click_at(35 * scale, (tb + 195) * scale);
    i32 d_y = required_node_value(dom.node_y(d));
    Option<NodeId> hit_d = click_at(35 * scale, d_y + 5 * scale);
    assert.assert_true(dom.holds(hit_c, c), "column padding places C at its hit point");
    assert.assert_true(dom.holds(hit_d, d), "text line height and gap place D at its hit point");
    assert.assert_true(d_y > required_node_value(dom.node_y(label)), "D is laid out below the label");

    Option<NodeId> hit_a_again = click_at(50 * scale, (tb + 30) * scale);   // A again
    assert.assert_true(dom.holds(hit_a_again, a), "second A hit test returns A");
    assert.assert_true(g_hits_a == 2, "A receives both clicks");
    assert.assert_true(g_hits_b == 1, "B receives one click");
    assert.assert_true(g_hits_c == 1, "C receives one click");
    assert.assert_true(g_hits_d == 1, "D receives one click");

    // Window chrome: the title bar is the drag handle and the disc at its
    // left is the close button; neither is a child node.
    assert.assert_true(dom_window_chrome.titlebar_hit(win, 200 * scale, 10 * scale), "title bar hit");
    assert.assert_true(dom_window_chrome.close_button_hit(win, 16 * scale, (tb / 2) * scale), "close button hit");
    assert.assert_false(dom_window_chrome.titlebar_hit(win, 16 * scale, (tb / 2) * scale), "close button is not drag handle");
    assert.assert_false(dom_window_chrome.titlebar_hit(win, 200 * scale, (tb + 5) * scale), "content is not the title bar");

    // Focus and z-order: a second window appended later paints on top and
    // wins the hit test where they overlap; focusing the first raises it.
    NodeId win2 = require_node(dom_elements.create_window("W2", 300, 200, 300, 200));
    require_append(dom.append_child(dom.desktop_id(), win2));
    Option<NodeId> overlap = dom_hit_test.find_at(350 * scale, (tb + 250) * scale);
    assert.assert_true(dom.holds(overlap, win2), "later window is on top");
    dom_widgets.focus_window(win);
    assert.assert_true(dom.holds(dom.active_window_id(), win), "focus_window activates");
    assert.assert_true(dom.get_state_flag(win, 16), "active window has STATE_FOCUSED");
    overlap = dom_hit_test.find_at(350 * scale, (tb + 250) * scale);
    assert.assert_true(dom.holds(overlap, win), "focused window was raised");

    // Moving a window carries its subtree along.
    dom.move_node(win, 7 * scale, 3 * scale);
    assert.assert_true(required_node_value(dom.node_x(a)) == 17 * scale, "children move with the window (x)");
    assert.assert_true(required_node_value(dom.node_y(c)) == (tb + 193) * scale, "children move with the window (y)");
    dom.move_node(win, 0 - 7 * scale, 0 - 3 * scale);

    // Checkbox: dispatch_click toggles before the handler observes it.
    NodeId cb = require_node(dom_elements.create_checkbox("opt", 10, 100, 0));
    dom.set_on_change(cb, on_change);
    require_append(dom.append_child(win2, cb));
    assert.assert_false(dom.is_checked(cb), "checkbox starts unchecked");
    dom.dispatch_click(cb);
    dom.drain_events();
    assert.assert_true(dom.is_checked(cb), "click checks it");
    assert.assert_true(g_changes == 1, "on_change fired once");

    // TextInput: keyboard events edit the focused field.
    NodeId field = require_node(dom_elements.create_text_input("type", 10, 130, 200, 30, 16));
    dom.set_on_change(field, on_change);
    require_append(dom.append_child(win2, field));
    dom_focus.set_focus(field);
    dom_widgets.dispatch_key_event(3, 'h', 0);
    dom_widgets.dispatch_key_event(3, 'i', 0);
    dom_widgets.dispatch_key_event(1, 8, 0);   // backspace
    dom_widgets.dispatch_key_event(3, 'o', 0);
    dom.drain_events();
    str typed = dom.text_of(field);
    assert.assert_true(typed.data[0] == 'h', "first typed char");
    assert.assert_true(typed.data[1] == 'o', "backspace then insert");
    assert.assert_true(typed.length == 2, "terminated");
    assert.assert_true(g_changes == 5, "each edit fires on_change");

    // A TextArea takes the same write as a TextInput: its text is replaced.
    NodeId area = require_node(dom_elements.create_text_area("area", 10, 170, 200, 60, 32, 0));
    require_append(dom.append_child(win2, area));
    dom_text_edit.append_text(area, "old text");
    dom_text_edit.set_input_text(area, "new");
    str written = dom.text_of(area);
    assert.assert_true(written.length == 3, "a write replaces a text area's text");
    assert.assert_true(written.data[0] == 'n', "a write leaves the new text");
    dom_text_edit.set_input_text(area, "");
    str emptied = dom.text_of(area);
    assert.assert_true(emptied.length == 0, "an empty write clears a text area");

    // A list's selection is an Option, and neither no selection nor a row past
    // the end is encoded as a negative integer.
    NodeId list = require_node(dom_elements.create_list("rows", 10, 170, 200, 80, 64));
    require_append(dom.append_child(win2, list));
    dom_list.list_set_items(list, "first\nsecond");
    borrow NodeRow list_row = dom.row_of(list);
    assert.assert_true(list_row.sel.is_none(), "a new list has no selection");

    dom_list.list_select(list, 1);
    i32 selected_row = case list_row.sel of { Some(row) -> row; None -> 99; };
    assert.assert_true(selected_row == 1, "a selected row is Some(1)");

    dom_list.list_select(list, 9);
    assert.assert_true(list_row.sel.is_none(), "a row past the end selects nothing");

    Result<i32, UiError> counted = dom_list.list_count(list);
    i32 rows = case counted of { Ok(value) -> value; Err(_) -> 0; };
    assert.assert_true(rows == 2, "a list counts its rows");

    Result<i32, UiError> missing_list = dom_list.list_count(NodeId(99999));
    i32 missing_node = case missing_list of {
        Ok(_) -> 0;
        Err(cause) -> case cause of { UiError::NodeNotFound(value) -> value == NodeId(99999); _ -> 0; };
    };
    assert.assert_true(missing_node == 1, "a missing list node is a typed UiError");

    // Closing a window drops its subtree and hands activation to the top-most
    // remaining window.
    dom_widgets.focus_window(win2);
    dom_widgets.close_window(win2);
    assert.assert_true(dom.node_exists(win2) == 0, "closed window is gone");
    assert.assert_true(dom.node_exists(field) == 0, "its children are gone too");
    assert.assert_true(dom.holds(dom.active_window_id(), win), "remaining window becomes active");

    // Exercise the renderer (window chrome, panel, buttons, text) in the
    // headless emulator as well as the tree-only assertions.
    dom_render.render_all();
}

i32 pixel_at(i32 x, i32 y) {
    return case graphics.get_pixel(x, y) of {
        Some(value) -> value;
        None -> ({ assert.assert_true(false, "pixel is on the display"); 0; });
    };
}

// Repainting an area whose top edge lies just below a window's title bar,
// within the reach of the bar's rounded corners, must leave the bar as it
// was. The bar's clip and that area share no row, and the bar used to be
// filled flat over its buttons, title and gradient.
/*@Test "a repaint just below a title bar leaves the bar alone" {
    step: 20000000;
}*/
void title_bar_survives_a_repaint_below_it() {
    heap.init();
    allocator.configure(heap.alloc, heap.free);
    desktop.init();

    NodeId win = require_node(dom_elements.create_window("W", 100, 100, 400, 300));
    require_append(dom.append_child(dom.desktop_id(), win));
    // Two logical pixels below the bar, closer than WINDOW_RADIUS.
    NodeId below = require_node(dom_elements.create_button("B", 10, 2, 100, 30));
    require_append(dom.append_child(win, below));
    dom_widgets.focus_window(win);
    dom_render.render_all();

    borrow NodeRow w = dom.row_of(win);
    i32 s = dom.ui_scale();
    i32 close_x = dom_window_chrome.button_cx(&w, 1);
    i32 close_y = dom_window_chrome.button_cy(&w);
    i32 bar_x = w.x + w.w - 40 * s;   // right of the title
    i32 bar_y = w.y + theme.TITLEBAR_H * s - 4 * s;
    i32 close_before = pixel_at(close_x, close_y);
    i32 bar_before = pixel_at(bar_x, bar_y);

    dom.damage_node(below);
    dom_render.render_scene();
    assert.assert_true(pixel_at(close_x, close_y) == close_before, "the close button is still drawn");
    assert.assert_true(pixel_at(bar_x, bar_y) == bar_before, "the bar keeps its gradient");
}

NodeId g_mid_paint_node;
i32 g_clips = 0;

// Stands in for graphics.set_clip, which render_scene calls for each damaged
// rectangle as it paints it. The first call also damages g_mid_paint_node,
// the way a process's console output lands from its own task mid-paint.
void set_clip_and_damage(i32 x, i32 y, i32 w, i32 h) {
    if (g_clips == 0) { dom.damage_node(g_mid_paint_node); }
    g_clips = g_clips + 1;
}

/*@Test "damage added during a paint waits for the next frame" {
    step: 20000000;
}*/
void damage_added_during_a_paint_waits() {
    heap.init();
    allocator.configure(heap.alloc, heap.free);
    desktop.init();

    NodeId win = require_node(dom_elements.create_window("W", 0, 0, 400, 300));
    require_append(dom.append_child(dom.desktop_id(), win));
    NodeId a = require_node(dom_elements.create_button("A", 10, 10, 100, 50));
    require_append(dom.append_child(win, a));
    NodeId b = require_node(dom_elements.create_button("B", 200, 10, 100, 50));
    require_append(dom.append_child(win, b));
    dom_render.render_all();
    assert.assert_false(dom.has_damage(), "a full paint leaves nothing queued");

    g_mid_paint_node = b;
    mock.of(graphics.set_clip)
        .when(mock.any(), mock.any(), mock.any(), mock.any())
        .call(set_clip_and_damage);
    dom.damage_node(a);
    dom_render.render_scene();
    assert.assert_true(g_clips == 1, "the frame paints A's rectangle");
    assert.assert_true(dom.has_damage(), "B's damage is kept for the next frame");

    dom_render.render_scene();
    assert.assert_true(g_clips == 2, "the next frame paints B's rectangle");
    assert.assert_false(dom.has_damage(), "nothing is left after it");
}
