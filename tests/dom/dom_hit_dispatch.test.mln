import assert from "../../../../toolchain/MyStdLib/assert.mln";
import dom from "../../src/ui/dom/dom.mln";
import dom_elements from "../../src/ui/dom/dom_elements.mln";
import dom_widgets from "../../src/ui/dom/dom_widgets.mln";
import dom_render from "../../src/ui/dom/dom_render.mln";
import graphics from "../../src/ui/graphics.mln";
import theme from "../../src/ui/theme.mln";
import heap from "../../../MyKernel/src/mm/heap.mln";
import { Option } from "../../../../toolchain/MyStdLib/option.mln";
import { Result } from "../../../../toolchain/MyStdLib/result.mln";
import { UiError } from "../../../../contracts/ui/widget.contract.mln";

// Pins the interaction contract the compositor relies on: it holds no node ids
// and starts every interaction from a hit test, so what must hold is that
// find_at returns the node under a point and dispatch_click queues that node's
// own handler, which drain_events then runs. Two buttons are mounted so a hit
// can be wrong rather than merely absent. Handlers set directly with
// set_on_click take the raw handler ABI, (owner, id, arg).
//
// Coordinates handed to create_* are logical (1024x768) and relative to the
// parent; a window's children start below its title bar (MYOS-014). Input
// points below are computed in the same logical space, then scaled.

i32 g_hits_a = 0;
i32 g_hits_b = 0;
i32 g_hits_c = 0;
i32 g_hits_d = 0;
i32 g_changes = 0;

void on_a(i32 owner, i32 id, i32 arg) {
    g_hits_a = g_hits_a + 1;
}

void on_b(i32 owner, i32 id, i32 arg) {
    g_hits_b = g_hits_b + 1;
}

void on_c(i32 owner, i32 id, i32 arg) {
    g_hits_c = g_hits_c + 1;
}

void on_d(i32 owner, i32 id, i32 arg) {
    g_hits_d = g_hits_d + 1;
}

void on_change(i32 owner, i32 id, i32 arg) {
    g_changes = g_changes + 1;
}

i32 require_node(Result<i32, UiError> result) {
    return case result of {
        Ok(id) -> id;
        Err(_) -> ({ assert.assert_true(false, "node creation failed"); 0; });
    };
}

void require_append(Result<_, UiError> result) {
    case result of {
        Ok(_) -> _;
        Err(_) -> ({ assert.assert_true(false, "append failed"); });
    };
}

i32 hit_or_zero(Option<i32> hit) {
    return case hit of { Some(id) -> id; None -> 0; };
}

i32 active_or_zero() {
    return case dom_widgets.active_window() of { Some(id) -> id; None -> 0; };
}

// Click wherever the pointer is, the way the compositor does: hit-test first,
// then dispatch to whatever came back.
i32 click_at(i32 x, i32 y) {
    i32 hit = hit_or_zero(dom.find_at(x, y));
    if (hit != 0) {
        dom.dispatch_click(hit);
        dom.drain_events();
    }
    return hit;
}

/*@Test "dom hit dispatch" {
    step: 20000000;
}*/
void dom_hit_dispatch() {
    heap.init();
    dom.init();

    // The public scalar boundary keeps DOM's Node representation private.
    i32 none_sentinel = dom.node_exists(0) == 0;
    i32 none_negative = dom.node_exists(-1) == 0;
    i32 some_desktop = dom.node_exists(dom.desktop_id());

    i32 tb = theme.titlebar_h(); // logical px; children sit below it

    i32 win = require_node(dom_elements.create_window("W", 0, 0, 400, 300));
    require_append(dom.append_child(dom.desktop_id(), win));

    i32 a = require_node(dom_elements.create_button("A", 10, 10, 100, 50));
    dom.set_on_click(a, on_a);
    require_append(dom.append_child(win, a));          // -> (10, tb + 10)

    i32 b = require_node(dom_elements.create_button("B", 200, 10, 100, 50));
    dom.set_on_click(b, on_b);
    require_append(dom.append_child(win, b));          // -> (200, tb + 10)

    // A decorative Box is visible but is not a hit target. It must therefore
    // not obscure its interactive descendants or turn empty decoration into a
    // click.
    i32 box = require_node(dom_elements.create_box(20, 170, 200, 120, 14737632, 8947848));
    require_append(dom.append_child(win, box));        // -> (20, tb + 170)

    // Column owns direct-child x/y positions. Text reserves its measured
    // line height even though it has no explicit bounds, so D lands below it.
    i32 column = require_node(dom_elements.create_column(0, 10, 200, 100, 10, 5));
    require_append(dom.append_child(box, column));     // -> (20, tb + 180)

    i32 c = require_node(dom_elements.create_button("C", 0, 0, 80, 20));
    dom.set_on_click(c, on_c);
    require_append(dom.append_child(column, c));       // -> (30, tb + 190)

    i32 label = require_node(dom_elements.create_text("note", 0, 0));
    require_append(dom.append_child(column, label));   // -> (30, tb + 215)

    i32 d = require_node(dom_elements.create_button("D", 0, 0, 80, 20));
    dom.set_on_click(d, on_d);
    require_append(dom.append_child(column, d));       // -> below the label + gap

    assert.assert_true(none_sentinel == 1, "sentinel node id is None");
    assert.assert_true(none_negative == 1, "negative node id is None");
    assert.assert_true(some_desktop == 1, "desktop id resolves to a node");

    // DOM coordinates are logical; controls are scaled to the configured
    // display size. Keep input points in the same logical coordinate space.
    i32 scale = dom.ui_scale();

    // Children were translated by the window's content origin.
    assert.assert_true(dom.node_x(a) == 10 * scale, "A keeps its authored x");
    assert.assert_true(dom.node_y(a) == (tb + 10) * scale, "A sits below the title bar");
    assert.assert_true(dom.node_x(c) == 30 * scale, "column padding places C");
    assert.assert_true(dom.node_y(c) == (tb + 190) * scale, "column origin places C");

    i32 hit_a = click_at(50 * scale, (tb + 30) * scale);   // inside A
    i32 hit_b = click_at(240 * scale, (tb + 30) * scale);  // inside B
    assert.assert_true(hit_a == a, "A hit test returns A");
    assert.assert_true(hit_b == b, "B hit test returns B");

    // Outside both buttons the hit is the window itself: it is a hit target
    // (so clicks focus it) but carries no handler, so no counter moves.
    i32 outside = click_at(350 * scale, (tb + 250) * scale);
    assert.assert_true(outside == win, "empty window area hits the window");

    i32 box_hit = click_at(50 * scale, (tb + 175) * scale);
    assert.assert_true(box_hit == win, "decorative box does not become a hit target");

    // C at (30, tb+190); D follows the label's measured height plus the gap.
    i32 hit_c = click_at(35 * scale, (tb + 195) * scale);
    i32 d_y = dom.node_y(d);
    i32 hit_d = click_at(35 * scale, d_y + 5 * scale);
    assert.assert_true(hit_c == c, "column padding places C at its hit point");
    assert.assert_true(hit_d == d, "text line height and gap place D at its hit point");
    assert.assert_true(d_y > dom.node_y(label), "D is laid out below the label");

    i32 hit_a_again = click_at(50 * scale, (tb + 30) * scale);   // A again
    assert.assert_true(hit_a_again == a, "second A hit test returns A");
    assert.assert_true(g_hits_a == 2, "A receives both clicks");
    assert.assert_true(g_hits_b == 1, "B receives one click");
    assert.assert_true(g_hits_c == 1, "C receives one click");
    assert.assert_true(g_hits_d == 1, "D receives one click");

    // Window chrome: the title bar is the drag handle and the disc at its
    // left is the close button; neither is a child node.
    assert.assert_true(dom_widgets.titlebar_hit(win, 200 * scale, 10 * scale), "title bar hit");
    assert.assert_true(dom_widgets.close_button_hit(win, 16 * scale, (tb / 2) * scale), "close button hit");
    assert.assert_false(dom_widgets.titlebar_hit(win, 16 * scale, (tb / 2) * scale), "close button is not drag handle");
    assert.assert_false(dom_widgets.titlebar_hit(win, 200 * scale, (tb + 5) * scale), "content is not the title bar");

    // Focus and z-order: a second window appended later paints on top and
    // wins the hit test where they overlap; focusing the first raises it.
    i32 win2 = require_node(dom_elements.create_window("W2", 300, 200, 300, 200));
    require_append(dom.append_child(dom.desktop_id(), win2));
    i32 overlap = hit_or_zero(dom.find_at(350 * scale, (tb + 250) * scale));
    assert.assert_true(overlap == win2, "later window is on top");
    dom_widgets.focus_window(win);
    assert.assert_true(active_or_zero() == win, "focus_window activates");
    assert.assert_true(dom.get_state_flag(win, 16), "active window has STATE_FOCUSED");
    overlap = hit_or_zero(dom.find_at(350 * scale, (tb + 250) * scale));
    assert.assert_true(overlap == win, "focused window was raised");

    // Moving a window carries its subtree along.
    dom.move_node(win, 7 * scale, 3 * scale);
    assert.assert_true(dom.node_x(a) == 17 * scale, "children move with the window (x)");
    assert.assert_true(dom.node_y(c) == (tb + 193) * scale, "children move with the window (y)");
    dom.move_node(win, 0 - 7 * scale, 0 - 3 * scale);

    // Checkbox: dispatch_click toggles before the handler observes it.
    i32 cb = require_node(dom_elements.create_checkbox("opt", 10, 100, 0));
    dom.set_on_change(cb, on_change);
    require_append(dom.append_child(win2, cb));
    assert.assert_false(dom.is_checked(cb), "checkbox starts unchecked");
    dom.dispatch_click(cb);
    dom.drain_events();
    assert.assert_true(dom.is_checked(cb), "click checks it");
    assert.assert_true(g_changes == 1, "on_change fired once");

    // TextInput: keyboard events edit the focused field.
    i32 field = require_node(dom_elements.create_text_input("type", 10, 130, 200, 30, 16));
    dom.set_on_change(field, on_change);
    require_append(dom.append_child(win2, field));
    dom_widgets.set_focus(field);
    dom_widgets.dispatch_key_event(3, 'h', 0);
    dom_widgets.dispatch_key_event(3, 'i', 0);
    dom_widgets.dispatch_key_event(1, 8, 0);   // backspace
    dom_widgets.dispatch_key_event(3, 'o', 0);
    dom.drain_events();
    char *typed = dom.text_of(field);
    assert.assert_true(typed[0] == 'h', "first typed char");
    assert.assert_true(typed[1] == 'o', "backspace then insert");
    assert.assert_true(typed[2] == 0, "terminated");
    assert.assert_true(g_changes == 5, "each edit fires on_change");

    // List queries preserve the semantic difference between no selection and
    // an invalid request; neither path is encoded as a negative integer.
    i32 list = require_node(dom_elements.create_list("rows", 10, 170, 200, 80, 64));
    require_append(dom.append_child(win2, list));
    dom_widgets.list_set_items(list, "first\nsecond");
    Result<Option<i32>, UiError> no_selection = dom_widgets.list_selected(list);
    i32 is_none = case no_selection of {
        Ok(value) -> case value of { None -> 1; Some(_) -> 0; };
        Err(_) -> 0;
    };
    assert.assert_true(is_none == 1, "no list selection is Ok(None)");

    dom_widgets.list_select(list, 1);
    Result<Option<i32>, UiError> selected = dom_widgets.list_selected(list);
    i32 selected_row = case selected of {
        Ok(value) -> case value of { Some(row) -> row; None -> 99; };
        Err(_) -> 99;
    };
    assert.assert_true(selected_row == 1, "selected list row is Ok(Some(1))");

    char item[16];
    Result<i32, UiError> copied = dom_widgets.list_item(list, 1, &item[0], 16);
    i32 copied_len = case copied of { Ok(n) -> n; Err(_) -> 0; };
    assert.assert_true(copied_len == 6, "valid list item returns copied length");
    assert.assert_true(item[0] == 's', "valid list item copies text");

    Result<i32, UiError> bad_item = dom_widgets.list_item(list, 9, &item[0], 16);
    i32 invalid_index = case bad_item of {
        Ok(_) -> 0;
        Err(cause) -> case cause of { UiError::InvalidIndex(value) -> value == 9; _ -> 0; };
    };
    assert.assert_true(invalid_index == 1, "invalid list row is typed UiError");

    Result<Option<i32>, UiError> missing_list = dom_widgets.list_selected(99999);
    i32 missing_node = case missing_list of {
        Ok(_) -> 0;
        Err(cause) -> case cause of { UiError::NodeNotFound(value) -> value == 99999; _ -> 0; };
    };
    assert.assert_true(missing_node == 1, "missing list node is typed UiError");

    // Closing a window drops its subtree and hands activation to the top-most
    // remaining window.
    dom_widgets.focus_window(win2);
    dom_widgets.close_window(win2);
    assert.assert_true(dom.node_exists(win2) == 0, "closed window is gone");
    assert.assert_true(dom.node_exists(field) == 0, "its children are gone too");
    assert.assert_true(active_or_zero() == win, "remaining window becomes active");

    // Exercise the renderer (window chrome, panel, buttons, text) in the
    // headless emulator as well as the tree-only assertions.
    dom_render.render_all();
}
