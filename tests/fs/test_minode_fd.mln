import debug from "../../../MyKernel/src/debug/debug.mln";
import heap from "../../../MyKernel/src/mm/heap.mln";
import fs from "../../src/fs/fs.mln";
import serial from "../../../MyKernel/src/io/serial.mln";
import { halt_cpu } from "../../../MyKernel/src/arch/halt.masm";
import { FsError } from "../../src/fs/fs.mln";
import { Result } from "../../../../toolchain/MyStdLib/result.mln";

i32 SEEK_SET = 0;
i32 SEEK_CUR = 1;
i32 SEEK_END = 2;

void set_byte(i32 addr, i32 value) {
    char *p = (char *)addr;
    *p = (char)value;
}

i32 get_byte(i32 addr) {
    char *p = (char *)addr;
    return (i32)(*p) & 0xFF;
}

void print_buf(i32 buf, i32 len) {
    i32 i = 0;
    while (i < len) {
        serial.putc(get_byte(buf + i));
        i = i + 1;
    }
}

void test_minode_and_fd() {
    debug.println("--- Starting minode & mfd tests ---");

    // 1. Test standard descriptor (fd = 1 stdout)
    i32 sbuf = heap.alloc(16);
    set_byte(sbuf + 0, 72);  // H
    set_byte(sbuf + 1, 101); // e
    set_byte(sbuf + 2, 108); // l
    set_byte(sbuf + 3, 108); // l
    set_byte(sbuf + 4, 111); // o
    set_byte(sbuf + 5, 32);  // space
    set_byte(sbuf + 6, 70);  // F
    set_byte(sbuf + 7, 68);  // D
    set_byte(sbuf + 8, 49);  // 1
    set_byte(sbuf + 9, 10);  // \n
    Result<i32, FsError> stdout_res = fs.write(1, sbuf, 10);   // Writes to stdout/serial via unified mfd 1

    // 2. Test file creation with leading slash path resolution
    i32 wbuf = heap.alloc(32);
    // "ABCDEFGHIJ"
    i32 i = 0;
    while (i < 10) {
        set_byte(wbuf + i, 65 + i);
        i = i + 1;
    }

    Result<i32, FsError> create_res = fs.create("/alphabet.txt");
    i32 fd1 = case create_res of { Ok(v) -> v; Err(e) -> -1; };
    if (fd1 < 0) {
        debug.println("[FAIL] failed to create /alphabet.txt");
        halt_cpu();
    }
    debug.printf("Created /alphabet.txt on mfd %i\n", fd1);
    Result<i32, FsError> write_res = fs.write(fd1, wbuf, 10);
    fs.close(fd1);

    // 3. Test multi-handle concurrent open on the same file
    Result<i32, FsError> h1_res = fs.open("/alphabet.txt");
    i32 h1 = case h1_res of { Ok(v) -> v; Err(e) -> -1; };
    Result<i32, FsError> h2_res = fs.open("alphabet.txt"); // without leading slash
    i32 h2 = case h2_res of { Ok(v) -> v; Err(e) -> -1; };
    debug.printf("Opened h1=%i, h2=%i (concurrent FDs for same minode)\n", h1, h2);

    if (h1 < 0 || h2 < 0 || h1 == h2) {
        debug.println("[FAIL] expected distinct positive FDs");
        halt_cpu();
    }

    // Read first 4 bytes from h1 -> "ABCD"
    i32 rbuf1 = heap.alloc(16);
    Result<i32, FsError> n1_res = fs.read(h1, rbuf1, 4);
    i32 n1 = case n1_res of { Ok(v) -> v; Err(e) -> 0; };
    debug.print("h1 read 4 bytes: ");
    print_buf(rbuf1, n1);
    debug.println("");

    // Seek h2 to offset 4 (SEEK_SET) and read 4 bytes -> "EFGH"
    Result<i32, FsError> seek_res = fs.seek(h2, 4, SEEK_SET);
    i32 rbuf2 = heap.alloc(16);
    Result<i32, FsError> n2_res = fs.read(h2, rbuf2, 4);
    i32 n2 = case n2_res of { Ok(v) -> v; Err(e) -> 0; };
    debug.print("h2 read 4 bytes after seek: ");
    print_buf(rbuf2, n2);
    debug.println("");

    // Verify h1 offset is still 4, read next 2 bytes from h1 -> "EF"
    i32 rbuf3 = heap.alloc(16);
    Result<i32, FsError> n3_res = fs.read(h1, rbuf3, 2);
    i32 n3 = case n3_res of { Ok(v) -> v; Err(e) -> 0; };
    debug.print("h1 read next 2 bytes: ");
    print_buf(rbuf3, n3);
    debug.println("");

    fs.close(h1);
    fs.close(h2);

    // 4. Test remove
    Result<i32, FsError> remove_res = fs.remove("/alphabet.txt");
    i32 rem_ok = case remove_res of { Ok(v) -> 1; Err(e) -> 0; };
    debug.printf("Removed /alphabet.txt result: %i\n", rem_ok);

    Result<i32, FsError> h3_res = fs.open("/alphabet.txt");
    i32 h3_ok = case h3_res of {
        Ok(v) -> 1;
        Err(e) -> case e of {
            NotFound -> 0;
            InvalidName -> 2; Disabled -> 2; AlreadyExists -> 2; NoFreeSlot -> 2;
            AllocFailed -> 2; BadFd(fd) -> 2; WrongType(fd) -> 2;
            BadWhence(w) -> 2; Closed(fd) -> 2; InvalidSize(s) -> 2;
        };
    };
    if (h3_ok != 0) {
        debug.println("[FAIL] /alphabet.txt should not exist after remove (or wrong FsError variant)");
        halt_cpu();
    }

    // 5. Test that an error instance actually carries the data it says it
    // does: close() marks the descriptor slot unused (not just its backing
    // entry), so reading through it afterward falls all the way through
    // read()'s type checks to Err(WrongType(h1)) -- naming the very fd that
    // was closed.
    Result<i32, FsError> after_close_res = fs.read(h1, rbuf1, 1);
    i32 closed_fd = case after_close_res of {
        Ok(v) -> -1;
        Err(e) -> case e of {
            WrongType(fd) -> fd;
            Disabled -> -2; NotFound -> -2; InvalidName -> -2; AlreadyExists -> -2; NoFreeSlot -> -2;
            AllocFailed -> -2; BadFd(fd) -> -2; Closed(fd) -> -2; BadWhence(w) -> -2;
            InvalidSize(s) -> -2;
        };
    };
    if (closed_fd != h1) {
        debug.printf("[FAIL] expected Err(WrongType(%i)), got closed_fd=%i\n", h1, closed_fd);
        halt_cpu();
    }
    debug.printf("Confirmed Err(WrongType(%i)) after closing h1\n", closed_fd);

    debug.println("Minode and FD tests PASSED!");
    halt_cpu();
}

void kernel_init() {
    heap.init();
    fs.init();
    test_minode_and_fd();
}

i32 kernel_main() {
    kernel_init();
    return 0;
}
