import heap from "../../../MyKernel/src/mm/heap.mln";
import fs from "../../src/fs/fs.mln";
import { FsError } from "../../src/fs/fs.mln";
import { Result } from "../../../../toolchain/MyStdLib/result.mln";
import { assert_eq } from "../../../../toolchain/MyStdLib/assert.mln";

i32 SEEK_SET = 0;
i32 SEEK_CUR = 1;
i32 SEEK_END = 2;

void set_byte(i32 addr, i32 value) {
    char *p = (char *)addr;
    *p = (char)value;
}

i32 get_byte(i32 addr) {
    char *p = (char *)addr;
    return (i32)(*p) & 0xFF;
}

/*@Test "minode and file descriptors" {
    disk: true;
    step: 50000000;
}*/
void minode_and_file_descriptors() {
    heap.init();
    fs.init();

    // 1. Test standard descriptor (fd = 1 stdout)
    i32 sbuf = heap.alloc(16);
    set_byte(sbuf + 0, 72);  // H
    set_byte(sbuf + 1, 101); // e
    set_byte(sbuf + 2, 108); // l
    set_byte(sbuf + 3, 108); // l
    set_byte(sbuf + 4, 111); // o
    set_byte(sbuf + 5, 32);  // space
    set_byte(sbuf + 6, 70);  // F
    set_byte(sbuf + 7, 68);  // D
    set_byte(sbuf + 8, 49);  // 1
    set_byte(sbuf + 9, 10);  // \n
    Result<i32, FsError> stdout_res = fs.write(1, sbuf, 10);   // Writes to stdout/serial via unified mfd 1
    i32 stdout_written = case stdout_res of {
        Ok(n) -> n;
        Err(e) -> ({ assert_eq<i32>(1, 0, "write stdout"); 0; });
    };
    assert_eq<i32>(stdout_written, 10, "stdout write byte count");

    // 2. Test file creation with leading slash path resolution
    i32 wbuf = heap.alloc(32);
    // "ABCDEFGHIJ"
    i32 i = 0;
    while (i < 10) {
        set_byte(wbuf + i, 65 + i);
        i = i + 1;
    }

    Result<i32, FsError> create_res = fs.create("/alphabet.txt");
    i32 fd1 = case create_res of {
        Ok(v) -> v;
        Err(e) -> ({ assert_eq<i32>(1, 0, "create alphabet file"); 0; });
    };
    Result<i32, FsError> write_res = fs.write(fd1, wbuf, 10);
    i32 written = case write_res of {
        Ok(n) -> n;
        Err(e) -> ({ assert_eq<i32>(1, 0, "write alphabet file"); 0; });
    };
    assert_eq<i32>(written, 10, "alphabet write byte count");
    fs.close(fd1);

    // 3. Test multi-handle concurrent open on the same file
    Result<i32, FsError> h1_res = fs.open("/alphabet.txt");
    i32 h1 = case h1_res of {
        Ok(v) -> v;
        Err(e) -> ({ assert_eq<i32>(1, 0, "open alphabet with slash"); 0; });
    };
    Result<i32, FsError> h2_res = fs.open("alphabet.txt"); // without leading slash
    i32 h2 = case h2_res of {
        Ok(v) -> v;
        Err(e) -> ({ assert_eq<i32>(1, 0, "open alphabet without slash"); 0; });
    };
    assert_eq<i32>(h1 >= 0, 1, "first file descriptor is non-negative");
    assert_eq<i32>(h2 >= 0, 1, "second file descriptor is non-negative");
    assert_eq<i32>(h1 != h2, 1, "concurrent opens receive distinct descriptors");

    // Read first 4 bytes from h1 -> "ABCD"
    i32 rbuf1 = heap.alloc(16);
    Result<i32, FsError> n1_res = fs.read(h1, rbuf1, 4);
    i32 n1 = case n1_res of { Ok(v) -> v; Err(e) -> ({ assert_eq<i32>(1, 0, "read h1 first bytes"); 0; }); };
    assert_eq<i32>(n1, 4, "h1 first read byte count");
    assert_eq<i32>(get_byte(rbuf1 + 0), 'A', "h1 byte 0");
    assert_eq<i32>(get_byte(rbuf1 + 3), 'D', "h1 byte 3");

    // Seek h2 to offset 4 (SEEK_SET) and read 4 bytes -> "EFGH"
    Result<i32, FsError> seek_res = fs.seek(h2, 4, SEEK_SET);
    i32 seeked = case seek_res of { Ok(v) -> 1; Err(e) -> 0; };
    assert_eq<i32>(seeked, 1, "seek h2");
    i32 rbuf2 = heap.alloc(16);
    Result<i32, FsError> n2_res = fs.read(h2, rbuf2, 4);
    i32 n2 = case n2_res of { Ok(v) -> v; Err(e) -> ({ assert_eq<i32>(1, 0, "read h2 after seek"); 0; }); };
    assert_eq<i32>(n2, 4, "h2 read byte count");
    assert_eq<i32>(get_byte(rbuf2 + 0), 'E', "h2 byte 0 after seek");
    assert_eq<i32>(get_byte(rbuf2 + 3), 'H', "h2 byte 3 after seek");

    // Verify h1 offset is still 4, read next 2 bytes from h1 -> "EF"
    i32 rbuf3 = heap.alloc(16);
    Result<i32, FsError> n3_res = fs.read(h1, rbuf3, 2);
    i32 n3 = case n3_res of { Ok(v) -> v; Err(e) -> ({ assert_eq<i32>(1, 0, "read h1 after h2 seek"); 0; }); };
    assert_eq<i32>(n3, 2, "h1 second read byte count");
    assert_eq<i32>(get_byte(rbuf3 + 0), 'E', "h1 offset remains independent");
    assert_eq<i32>(get_byte(rbuf3 + 1), 'F', "h1 offset remains independent second byte");

    fs.close(h1);
    fs.close(h2);

    // 4. Test remove
    Result<_, FsError> remove_res = fs.remove("/alphabet.txt");
    i32 rem_ok = case remove_res of { Ok(_) -> 1; Err(e) -> 0; };
    assert_eq<i32>(rem_ok, 1, "remove alphabet file");

    Result<i32, FsError> h3_res = fs.open("/alphabet.txt");
    i32 h3_ok = case h3_res of {
        Ok(v) -> 1;
        Err(NotFound) -> 0;
        Err(InvalidName) -> 2;
        Err(Disabled) -> 2;
        Err(AlreadyExists) -> 2;
        Err(NoFreeSlot) -> 2;
        Err(AllocFailed) -> 2;
        Err(BadFd(fd)) -> 2;
        Err(WrongType(fd)) -> 2;
        Err(BadWhence(w)) -> 2;
        Err(Closed(fd)) -> 2;
        Err(InvalidSize(s)) -> 2;
    };
    assert_eq<i32>(h3_ok, 0, "removed file returns NotFound");

    // 5. Test that an error instance actually carries the data it says it
    // does: close() marks the descriptor slot unused (not just its backing
    // entry), so reading through it afterward falls all the way through
    // read()'s type checks to Err(WrongType(h1)) -- naming the very fd that
    // was closed.
    Result<i32, FsError> after_close_res = fs.read(h1, rbuf1, 1);
    i32 closed_fd = case after_close_res of {
        Ok(v) -> -1;
        Err(WrongType(fd)) -> fd;
        Err(Disabled) -> -2;
        Err(NotFound) -> -2;
        Err(InvalidName) -> -2;
        Err(AlreadyExists) -> -2;
        Err(NoFreeSlot) -> -2;
        Err(AllocFailed) -> -2;
        Err(BadFd(fd)) -> -2;
        Err(Closed(fd)) -> -2;
        Err(BadWhence(w)) -> -2;
        Err(InvalidSize(s)) -> -2;
    };
    assert_eq<i32>(closed_fd, h1, "closed descriptor reports its original fd");
}
