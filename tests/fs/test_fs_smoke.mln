import debug from "../../../MyKernel/src/debug/debug.mln";
import heap from "../../../MyKernel/src/mm/heap.mln";
import fs from "../../src/fs/fs.mln";
import serial from "../../../MyKernel/src/io/serial.mln";
import { halt_cpu } from "../../../MyKernel/src/arch/halt.masm";
import { FsError } from "../../src/fs/fs.mln";
import { Result } from "../../../../toolchain/MyStdLib/result.mln";

// Write one byte to a plain byte buffer (caller buffers are byte arrays).
void set_byte(i32 addr, i32 value) {
    char *p = (char *)addr;
    *p = (char)value;
}

i32 get_byte(i32 addr) {
    char *p = (char *)addr;
    return (i32)(*p) & 0xFF;
}

void test_fs_smoke() {
    i32 buf = heap.alloc(64);

    // "hi fs" -> buf, one byte per address.
    set_byte(buf + 0, 104); // h
    set_byte(buf + 1, 105); // i
    set_byte(buf + 2, 32);  // space
    set_byte(buf + 3, 102); // f
    set_byte(buf + 4, 115); // s

    Result<i32, FsError> create_res = fs.create("hello");
    i32 fd = case create_res of { Ok(v) -> v; Err(e) -> -1; };
    if (fd < 0) {
        // Already exists from a previous run (persistent disk): just open it.
        Result<i32, FsError> open_res = fs.open("hello");
        fd = case open_res of { Ok(v) -> v; Err(e) -> -1; };
    } else {
        Result<i32, FsError> write_res = fs.write(fd, buf, 5);
    }
    fs.close(fd);

    Result<i32, FsError> reopen_res = fs.open("hello");
    i32 rfd = case reopen_res of { Ok(v) -> v; Err(e) -> -1; };
    if (rfd >= 0) {
        i32 rbuf = heap.alloc(64);
        Result<i32, FsError> read_res = fs.read(rfd, rbuf, 64);
        i32 n = case read_res of { Ok(v) -> v; Err(e) -> 0; };
        debug.print("fs: read back '");
        i32 i = 0;
        while (i < n) {
            serial.putc(get_byte(rbuf + i));
            i = i + 1;
        }
        debug.println("'");
        fs.close(rfd);
    }

    fs.list();

    debug.println("Test PASSED!");
    halt_cpu();
}

void kernel_init() {
    heap.init();
    fs.init();
    test_fs_smoke();
}

i32 kernel_main() {
    kernel_init();
    return 0;
}
