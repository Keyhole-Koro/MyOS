import heap from "../../../MyKernel/src/mm/heap.mln";
import fs from "../../src/fs/fs.mln";
import { FsError } from "../../src/fs/fs.mln";
import { Result } from "../../../../toolchain/MyStdLib/result.mln";
import { assert_eq } from "../../../../toolchain/MyStdLib/assert.mln";

// Write one byte to a plain byte buffer (caller buffers are byte arrays).
void set_byte(i32 addr, i32 value) {
    char *p = (char *)addr;
    *p = (char)value;
}

i32 get_byte(i32 addr) {
    char *p = (char *)addr;
    return (i32)(*p) & 0xFF;
}

/*@Test "filesystem smoke" {
    disk: true;
    step: 50000000;
}*/
void filesystem_smoke() {
    heap.init();
    fs.init();

    i32 buf = heap.alloc(64);
    assert_eq<i32>(buf != 0, 1, "heap allocation for file data");

    // "hi fs" -> buf, one byte per address.
    set_byte(buf + 0, 104); // h
    set_byte(buf + 1, 105); // i
    set_byte(buf + 2, 32);  // space
    set_byte(buf + 3, 102); // f
    set_byte(buf + 4, 115); // s

    Result<i32, FsError> create_res = fs.create("hello");
    i32 fd = case create_res of {
        Ok(v) -> v;
        Err(e) -> ({ assert_eq<i32>(1, 0, "create hello"); 0; });
    };
    Result<i32, FsError> write_res = fs.write(fd, buf, 5);
    i32 wrote = case write_res of {
        Ok(n) -> n;
        Err(e) -> ({ assert_eq<i32>(1, 0, "write hello"); 0; });
    };
    assert_eq<i32>(wrote, 5, "write reports byte count");
    fs.close(fd);

    Result<i32, FsError> reopen_res = fs.open("hello");
    i32 rfd = case reopen_res of {
        Ok(v) -> v;
        Err(e) -> ({ assert_eq<i32>(1, 0, "reopen hello"); 0; });
    };
    i32 rbuf = heap.alloc(64);
    assert_eq<i32>(rbuf != 0, 1, "heap allocation for read buffer");
    Result<i32, FsError> read_res = fs.read(rfd, rbuf, 64);
    i32 n = case read_res of {
        Ok(v) -> v;
        Err(e) -> ({ assert_eq<i32>(1, 0, "read hello"); 0; });
    };
    assert_eq<i32>(n, 5, "read reports byte count");
    assert_eq<i32>(get_byte(rbuf + 0), 'h', "read byte 0");
    assert_eq<i32>(get_byte(rbuf + 1), 'i', "read byte 1");
    assert_eq<i32>(get_byte(rbuf + 2), ' ', "read byte 2");
    assert_eq<i32>(get_byte(rbuf + 3), 'f', "read byte 3");
    assert_eq<i32>(get_byte(rbuf + 4), 's', "read byte 4");
    fs.close(rfd);
}
