/**
 * Memory copy helpers between a user process's address space and the kernel's.
 *
 * Every address an OS_CALL or a console hook gets from a process means
 * something only in that process's address space, and the kernel's own RAM,
 * MMIO and VRAM are mapped there too, for the kernel. So nothing here takes
 * an address as it is: each helper has the kernel's user_access check the
 * whole range against the caller's page tables first, and copy it through
 * the frames they map it to. A range the caller may not use moves nothing:
 * the helper returns false, and the kernel answers the syscall with
 * BadAddress, whatever the endpoint returns. An endpoint checks every range
 * a call names before it acts, so a refused call changes nothing.
 *
 * Syscall endpoints must copy data into kernel buffers before passing it across tasks.
 */
namespace user_memory;

import user_access from "@kernel/kernel/user_access.mln";
import { UserAccess } from "@kernel/kernel/user_access.mln";
import { UserAddress } from "@std/core/address.mln";
import { Pid } from "@contracts/process/control.contract.mln";
import { Text } from "@std/text/text.mln";

/**
 * Checks that the OS may read a range of the caller's memory.
 * @param caller Process that named the range.
 * @param user First byte.
 * @param n Length in bytes. Zero or less names no memory, so it passes unchecked.
 * @return false when the range is not all the caller's; the call then answers BadAddress.
 */
export bool readable(Pid caller, UserAddress user, i32 n) {
    if (n <= 0) { return true; }
    return user_access.check(caller, user, n, UserAccess::READ);
}

/**
 * Checks that the OS may write a range of the caller's memory: an answer's
 * destination, before the operation that produces the answer runs.
 * @param caller Process that named the range.
 * @param user First byte.
 * @param n Length in bytes. Zero or less names no memory, so it passes unchecked.
 * @return false when the range is not all the caller's, writable; the call then answers BadAddress.
 */
export bool writable(Pid caller, UserAddress user, i32 n) {
    if (n <= 0) { return true; }
    return user_access.check(caller, user, n, UserAccess::WRITE);
}

/**
 * Copies a fixed-size argument record from the caller's memory.
 * Pointer values inside the record remain user addresses and require their
 * own copy before anything they name is read.
 *
 * @param caller Process whose memory it is.
 * @param user Source address in user virtual memory.
 * @param dst Destination buffer in kernel memory.
 * @param n Number of bytes to copy; zero or less copies nothing.
 * @return false, with nothing copied, when the caller may not have the range read.
 */
export bool copy_in(Pid caller, UserAddress user, char *dst, i32 n) {
    return user_access.copy_from(caller, user, dst, n);
}

/**
 * Copies a length-delimited string from user space into a kernel Text.
 *
 * Stops at the Text's capacity, and at a NUL, which a Text cannot hold. The
 * bytes up to the capacity must be the caller's to read, NUL or not: the
 * length says they are there.
 *
 * @param caller Process whose memory it is.
 * @param user Virtual memory address of the first byte.
 * @param length Byte length; zero or negative means empty.
 * @param dst Destination, replaced by the copy; left empty when refused.
 * @return false when the caller may not have the bytes read.
 */
export bool copy_in_text<const N>(Pid caller, UserAddress user, i32 length, borrow Text<N> dst) {
    dst.clear();
    i32 n = length;
    if (n > dst.capacity()) { n = dst.capacity(); }
    if (n <= 0) { return true; }
    char *bytes = dst.as_ptr();
    if (!copy_in(caller, user, bytes, n)) { return false; }
    bytes[n] = (char)0;
    dst.sync_from_ptr();
    return true;
}

/**
 * Copies a NUL-terminated string from user space into a kernel Text, whole:
 * a string longer than the Text holds is refused, not cut. It reads a byte at
 * a time, and none past the NUL, so a string that ends right before memory
 * the caller does not have is taken whole.
 *
 * @param caller Process whose memory it is.
 * @param user Virtual memory address of the first byte.
 * @param dst Destination, replaced by the copy; left empty when refused.
 * @return false when a byte up to the NUL is not the caller's to read (the
 *         kernel then answers BadAddress), or the string does not fit.
 */
export bool copy_in_c_string<const N>(Pid caller, UserAddress user, borrow Text<N> dst) {
    dst.clear();
    char c[1];
    i32 k = 0;
    while (k <= dst.capacity()) {
        if (!copy_in(caller, user.plus(k), &c[0], 1)) {
            dst.clear();
            return false;
        }
        if (c[0] == 0) { return true; }
        if (k == dst.capacity()) { break; } // a byte more than it holds
        dst.push((u8)c[0]);
        k++;
    }
    dst.clear();
    return false;
}

/**
 * Copies a length-delimited string view from user space into a kernel buffer.
 *
 * Copies at most `cap - 1` bytes and always NUL-terminates `dst`, so the
 * server keeps reading plain kernel strings whatever the sender passed.
 *
 * @param caller Process whose memory it is.
 * @param user Virtual memory address of the view's first byte; zero is no view.
 * @param length Byte length of the view; zero or negative means empty.
 * @param dst Destination buffer in kernel address space.
 * @param cap Capacity of the destination in bytes, including the terminator.
 * @return false when the caller may not have the bytes read; dst is then empty.
 */
export bool copy_in_view(Pid caller, UserAddress user, i32 length, char *dst, i32 cap) {
    i32 n = 0;
    if ((i32)user != 0) {
        n = length;
        if (n > cap - 1) { n = cap - 1; }
        if (n < 0) { n = 0; }
    }
    bool copied = copy_in(caller, user, dst, n);
    if (!copied) { n = 0; }
    dst[n] = (char)0;
    return copied;
}

/**
 * Copies a byte buffer from kernel address space to user process address space.
 *
 * Writes `n` bytes from `src` into the user virtual address `user`.
 *
 * @param caller Process whose memory it is.
 * @param user Destination virtual memory address in user process space.
 * @param src Source buffer in kernel address space.
 * @param n Number of bytes to copy; zero or less copies nothing.
 * @return false, with nothing copied, when the caller may not have the range written.
 */
export bool copy_out(Pid caller, UserAddress user, char *src, i32 n) {
    return user_access.copy_to(caller, user, src, n);
}
