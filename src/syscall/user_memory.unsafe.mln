/**
 * Memory copy helpers between user process address space and kernel address space.
 *
 * Provides safe buffer copy routines across active user-process page tables.
 * Syscall endpoints must copy data into kernel buffers before passing it across tasks.
 */
package user_memory;

import mem from "@kernel/mm/mem.mln";
import bytes from "@std/text/bytes.mln";
import { UserAddress } from "@std/core/address.mln";
import { Text } from "@std/text/text.mln";

/** Reads one byte of the active process's memory. */
export i32 read_byte(UserAddress user) { return mem.read_byte((i32)user); }

/** Writes one byte of the active process's memory. */
export void write_byte(UserAddress user, i32 value) { mem.write_byte((i32)user, value); }

/** Reads one word of the active process's memory. */
export i32 read_word(UserAddress user) { return mem.read_word((i32)user); }

/** Writes one word of the active process's memory. */
export void write_word(UserAddress user, i32 value) { mem.write_word((i32)user, value); }

/**
 * Views bytes of the active process's memory, valid while its page tables are.
 * @param user Virtual memory address of the first byte.
 * @param length Number of bytes.
 * @return The view; it must not outlive the syscall.
 */
export str view(UserAddress user, i32 length) {
    return str { data: (char*)(i32)user, length: length };
}

/**
 * Copies a fixed-size argument record from the active user address space.
 * Pointer values inside the record remain user addresses and require their
 * own copy_in_string()/copy_out() operation before dereferencing.
 *
 * @param user Source address in user virtual memory.
 * @param dst Destination buffer in kernel memory.
 * @param n Number of bytes to copy.
 */
export void copy_in(UserAddress user, char *dst, i32 n) {
    i32 k = 0;
    while (k < n) {
        dst[k] = (char)read_byte(user.plus(k));
        k++;
    }
}

/**
 * Copies a length-delimited string from user space into a kernel Text.
 *
 * Stops at the Text's capacity, and at a NUL, which a Text cannot hold.
 *
 * @param user Virtual memory address of the first byte.
 * @param length Byte length; zero or negative means empty.
 * @param dst Destination, replaced by the copy.
 */
export void copy_in_text<const N>(UserAddress user, i32 length, borrow Text<N> dst) {
    dst.clear();
    i32 k = 0;
    while (k < length) {
        if (!dst.push((u8)read_byte(user.plus(k)))) { return; }
        k++;
    }
}

/**
 * Copies a length-delimited string view from user space into a kernel buffer.
 *
 * Copies at most `cap - 1` bytes and always NUL-terminates `dst`, so the
 * server keeps reading plain kernel strings whatever the sender passed.
 *
 * @param user Virtual memory address of the view's first byte.
 * @param length Byte length of the view; zero or negative means empty.
 * @param dst Destination buffer in kernel address space.
 * @param cap Capacity of the destination in bytes, including the terminator.
 */
export void copy_in_view(UserAddress user, i32 length, char *dst, i32 cap) {
    i32 k = 0;
    if ((i32)user != 0) {
        while (k < length && k + 1 < cap) {
            dst[k] = (char)read_byte(user.plus(k));
            k++;
        }
    }
    dst[k] = (char)0;
}

/**
 * Copies a byte buffer from kernel address space to user process address space.
 *
 * Writes `n` bytes from `src` into the user virtual address `user`.
 *
 * @param user Destination virtual memory address in user process space.
 * @param src Source buffer in kernel address space.
 * @param n Number of bytes to copy.
 */
export void copy_out(UserAddress user, char *src, i32 n) {
    i32 k = 0;
    while (k < n) {
        write_byte(user.plus(k), bytes.as_unsigned(src[k]));
        k++;
    }
}
