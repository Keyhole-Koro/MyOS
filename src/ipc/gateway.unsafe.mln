/**
 * User/kernel boundary gateway for application request/event transport.
 *
 * Copies pointers, strings, and output buffers across page tables into kernel-owned
 * memory. Ensures the service task sees only validated, kernel-resident data.
 * Every range of the caller's that a request names is checked before the
 * request is queued, and a reply's or event's destination before one is taken
 * off its channel: a refused range queues or takes nothing, and the kernel
 * answers BadAddress.
 */
namespace request_gateway;

import mem from "@kernel/mm/mem.mln";
import ipc from "@kernel/kernel/ipc.mln";
import { ChannelId } from "@kernel/kernel/ipc.mln";
import debug from "@kernel/debug/debug.mln";
import str from "@std/text/str.mln";
import heap from "@kernel/mm/heap.mln";
import { Option } from "@std/core/option.mln";
import { Result } from "@std/core/result.mln";
import user_memory from "@os/syscall/user_memory.mln";
import { UserAddress } from "@std/core/address.mln";
import { Pid } from "@contracts/process/control.contract.mln";
import request_channel from "channel.mln";
import app_events from "events.mln";
import { Event, Request, RequestDomain, TransportSignal } from "@contracts/myapp/message.contract.mln";
import { UiOp } from "@contracts/myapp/ui.contract.mln";
import { UiError } from "@contracts/ui/widget.contract.mln";
import scheduler from "@kernel/kernel/scheduler.mln";
import process from "@kernel/kernel/process.mln";

i32 S0_CAP = 1024;
i32 S1_CAP = 128;
i32 OUT_CAP = 4096;
// A server writes a typed Result through the staged pointer at its full
// size, whatever result_size the caller asked to have copied back, so the
// buffer must hold the largest one: Result<Option<i32>, UiError> (48 bytes;
// see check_result_capacity). At 32 bytes every UI result overflowed into the
// next heap block.
i32 RESULT_CAP = 64;

// Keep the transport state for one process together. The old parallel
// arrays made it easy to update one table and forget its companion table.
/**
 * Per-process channels and kernel staging buffers for the request gateway.
 * @property reply_ch IPC channel for replies sent to this process.
 * @property event_ch IPC channel for events sent to this process.
 * @property events_bound True while app_events routes this slot's owner to event_ch.
 * @property s0 Kernel copy of the first request string argument.
 * @property s1 Kernel copy of the second request string argument.
 * @property out Kernel staging buffer for request output bytes.
 * @property out_user User-space address that receives staged output.
 * @property out_cap Capacity of the output staging buffer in bytes.
 * @property result Kernel address of the typed Result value returned to the user.
 * @property result_user User-space address that receives the typed Result value.
 * @property result_size Size in bytes of the staged typed Result value.
 * @property pending A request of this process's is queued or being answered,
 *   and its reply is not taken yet. Until then its strings and destinations
 *   are staged here, so the process has one request out at a time.
 */
struct GatewaySlot {
    ChannelId reply_ch;
    ChannelId event_ch;
    bool events_bound;
    i32 s0;
    i32 s1;
    i32 out;
    UserAddress out_user;
    i32 out_cap;
    i32 result;
    UserAddress result_user;
    i32 result_size;
    bool pending;
};

GatewaySlot gateway_slots[16];

/** Stops the kernel if a typed request result outgrows its staging buffer. */
void check_result_capacity() {
    if (sizeof(Result<Option<i32>, UiError>) > RESULT_CAP) {
        debug.panic("request_gateway: RESULT_CAP is smaller than a UI request result");
    }
}

/**
 * Allocates kernel heap memory or panics if allocation fails.
 *
 * @param n Number of bytes to allocate.
 * @return Memory address of allocated block.
 */
i32 alloc_or_panic(i32 n) {
    return case heap.alloc(n) of {
        Ok(pointer) -> pointer;
        Err(_) -> ({ debug.panic("request_gateway: out of memory"); 0; });
    };
}

/**
 * Zeroes a kernel staging buffer.
 * @param at Its first byte, word-aligned.
 * @param n Its size in bytes, a multiple of 4.
 */
void clear(i32 at, i32 n) {
    i32 k = 0;
    while (k < n) {
        mem.write_word(at + k, 0);
        k = k + 4;
    }
}

/**
 * Reads the fixed-width Request wire record and decodes it into named fields.
 * @param caller Process that sent it.
 * @param user_request User-space address of a 15-word Request.
 * @param request Destination Request structure.
 * @return false when the record is not the caller's to read; request is then not filled.
 */
bool read_user_request(Pid caller, UserAddress user_request, Request *request) {
    i32 words[15];
    if (!user_memory.copy_in(caller, user_request, (char*)(&words[0]), request_channel.REQUEST_WORD_COUNT * 4)) {
        return false;
    }
    request_channel.decode_request_words(&words[0], request);
    return true;
}

/**
 * Copies user-owned string arguments into this process's kernel staging buffers.
 * @param caller Process that sent the request.
 * @param slot_index Gateway slot belonging to the caller.
 * @param request Request whose s0/s1 currently contain user addresses.
 * @return false when a string is not the caller's to read.
 */
bool copy_request_strings(Pid caller, i32 slot_index, Request *request) {
    char *s0 = (char*)gateway_slots[slot_index].s0;
    char *s1 = (char*)gateway_slots[slot_index].s1;
    if (!user_memory.copy_in_view(caller, UserAddress((i32)request->s0), request->s0_len, s0, S0_CAP)
        || !user_memory.copy_in_view(caller, UserAddress((i32)request->s1), request->s1_len, s1, S1_CAP)) {
        return false;
    }
    request->s0 = s0;
    request->s1 = s1;
    return true;
}

/**
 * Redirects operation output pointers to kernel staging buffers and remembers
 * the original user destinations for the reply path. Each destination is
 * checked now, for all the bytes the reply may copy there, before the request
 * runs.
 * @param caller Process that sent the request.
 * @param slot_index Gateway slot belonging to the caller.
 * @param request Request to update before it crosses into the server task.
 * @return false when a destination is not the caller's to write.
 */
bool stage_request_outputs(Pid caller, i32 slot_index, Request *request) {
    gateway_slots[slot_index].out_user = UserAddress(0);
    gateway_slots[slot_index].result_user = UserAddress(0);

    if (request->domain == RequestDomain::UI && request->op == UiOp::TEXT_COPY) {
        i32 cap = request->a2;
        if (cap > OUT_CAP) { cap = OUT_CAP; }
        UserAddress out = UserAddress(request->a1);
        if ((i32)out != 0 && !user_memory.writable(caller, out, cap)) { return false; }
        gateway_slots[slot_index].out_user = out;
        gateway_slots[slot_index].out_cap = cap;
        request->a1 = gateway_slots[slot_index].out;
        request->a2 = gateway_slots[slot_index].out_cap;
    }

    // The server writes its whole typed answer through result_out, whatever
    // result_size says, and it runs on its own task, in the kernel's address
    // space, so a caller's result_out never reaches it. With a size, the
    // caller's address is checked and the gateway's staging buffer goes in its
    // place; the reply copies up to that size back.
    if (request->result_out != 0 && request->result_size > 0) {
        i32 size = request->result_size;
        if (size > RESULT_CAP) { size = RESULT_CAP; }
        UserAddress result = UserAddress(request->result_out);
        if (!user_memory.writable(caller, result, size)) { return false; }
        gateway_slots[slot_index].result_user = result;
        gateway_slots[slot_index].result_size = size;
        request->result_out = gateway_slots[slot_index].result;
        request->result_size = size;
    } else {
        // With no size there is nothing to copy back, and the app's own
        // address must not reach the server, which would write through it.
        // An operation that answers with a result then says MISSING_RESULT.
        request->result_out = 0;
        request->result_size = 0;
    }
    return true;
}

/**
 * Lazily initializes per-process IPC reply/event channels and staging buffers.
 *
 * A slot keeps its channels and buffers from one holder of the pid to the next.
 * Its event channel is bound to the process in `app_events` for each holder.
 *
 * @param pid Process ID.
 * @return `true` when the PID has a gateway slot; `false` when it is invalid.
 */
bool ready(Pid pid) {
    i32 i = case process.slot_of(pid) of {
        Some(v) -> v;
        None -> ({ return false; });
    };
    if (gateway_slots[i].reply_ch == ChannelId(0)) {
        Option<ChannelId> reply_channel = ipc.create();
        Option<ChannelId> event_channel = ipc.create();
        case reply_channel of {
            Some(value) -> ({ gateway_slots[i].reply_ch = value; });
            None -> ({ debug.panic("request_gateway: IPC reply channel table exhausted"); });
        };
        case event_channel of {
            Some(value) -> ({ gateway_slots[i].event_ch = value; });
            None -> ({ debug.panic("request_gateway: IPC event channel table exhausted"); });
        };
        gateway_slots[i].s0 = alloc_or_panic(S0_CAP);
        gateway_slots[i].s1 = alloc_or_panic(S1_CAP);
        gateway_slots[i].out = alloc_or_panic(OUT_CAP);
        check_result_capacity();
        gateway_slots[i].result = alloc_or_panic(RESULT_CAP);
        // A reply copies out of these even when the server wrote nothing
        // there, and the heap hands back whatever a free left: they start
        // empty, so what a process gets back is never someone else's.
        clear(gateway_slots[i].out, OUT_CAP);
        clear(gateway_slots[i].result, RESULT_CAP);
    }
    if (!gateway_slots[i].events_bound) {
        app_events.bind(pid, gateway_slots[i].event_ch);
        gateway_slots[i].events_bound = true;
    }
    return true;
}

/**
 * Handles OS_CALL REQUEST: validates and submits a UI/App request from a user process.
 *
 * Decodes the user Request into its named fields, copies string arguments to
 * kernel staging buffers, redirects output buffers, and queues it to
 * `request_channel`.
 *
 * @param pid Process ID of the caller.
 * @param user_request Virtual address of user Request structure (15 words).
 * @return true when queued; false when the shared request channel is full,
 *         or when this process already has a request out whose reply it has
 *         not taken. Both are transient: the caller waits for REQUEST_SPACE
 *         and sends it again. The PID comes from the current-process syscall
 *         context and must be valid. False also when a range the request
 *         names was refused; the kernel then answers BadAddress, not 0.
 */
export bool request(Pid pid, UserAddress user_request) {
    if (!ready(pid)) { debug.panic("request_gateway: invalid caller PID"); }
    i32 i = case process.slot_of(pid) of {
        Some(v) -> v;
        None -> ({ debug.panic("request_gateway: PID slot disappeared"); return false; });
    };
    // One request out at a time. The first one's strings and destinations
    // stay staged in this slot until its reply is taken, and a process that
    // sent requests without taking replies would fill its reply channel,
    // which the server cannot answer into. A second one waits as for a full
    // channel; taking the reply wakes it (reply).
    if (gateway_slots[i].pending) {
        scheduler.arm_notification(TransportSignal::REQUEST_SPACE);
        return false;
    }
    Request request;
    if (!read_user_request(pid, user_request, &request)) { return false; }
    request.owner = (i32)pid;
    // A string or destination the caller does not have: nothing is queued,
    // and the kernel answers BadAddress rather than "full, retry".
    if (!copy_request_strings(pid, i, &request) || !stage_request_outputs(pid, i, &request)) {
        return false;
    }
    if (!request_channel.submit(&request, gateway_slots[i].reply_ch)) {
        scheduler.arm_notification(TransportSignal::REQUEST_SPACE);
        return false;
    }
    scheduler.disarm_notification(TransportSignal::REQUEST_SPACE);
    gateway_slots[i].pending = true;
    return true;
}

/**
 * Handles OS_CALL REPLY: retrieves a response to a previously submitted request.
 *
 * Checks the process's reply channel, copies any buffered string results back
 * to user memory space, and writes the return scalar into `user_out`.
 *
 * @param pid Process ID.
 * @param user_out Destination virtual address in user space for the return scalar.
 * @return True if a reply was received.
 */
export bool reply(Pid pid, UserAddress user_out) {
    i32 i = case process.slot_of(pid) of {
        Some(v) -> v;
        None -> ({ debug.panic("request_gateway: invalid reply PID"); return false; });
    };
    // Where the answer word goes is checked before a reply is taken, so a
    // bad one loses no reply.
    if (!user_memory.writable(pid, user_out, 4)) { return false; }
    if (gateway_slots[i].reply_ch == ChannelId(0)) { return false; }
    i32 r[24];
    if (!ipc.recv(gateway_slots[i].reply_ch, &r[0])) {
        scheduler.arm_notification(TransportSignal::REPLY);
        return false;
    }
    scheduler.disarm_notification(TransportSignal::REPLY);
    // The process may send its next request; another of its threads may be
    // waiting to.
    gateway_slots[i].pending = false;
    scheduler.notify_pid(pid, TransportSignal::REQUEST_SPACE);
    // The request checked these destinations. One that is gone since (a
    // thread's stack, say) is refused here: the reply is still taken, and
    // the call answers BadAddress.
    if ((i32)gateway_slots[i].out_user != 0) {
        i32 n = str.len((char*)gateway_slots[i].out) + 1;
        if (n > gateway_slots[i].out_cap) { n = gateway_slots[i].out_cap; }
        user_memory.copy_out(pid, gateway_slots[i].out_user, (char*)gateway_slots[i].out, n);
        gateway_slots[i].out_user = UserAddress(0);
    }
    if ((i32)gateway_slots[i].result_user != 0 && gateway_slots[i].result_size > 0) {
        user_memory.copy_out(pid, gateway_slots[i].result_user, (char*)gateway_slots[i].result, gateway_slots[i].result_size);
    }
    gateway_slots[i].result_user = UserAddress(0);
    gateway_slots[i].result_size = 0;
    user_memory.copy_out(pid, user_out, (char*)(&r[0]), 4);
    return true;
}

/**
 * Handles OS_CALL POLL: polls for queued events addressed to this process.
 *
 * If an event is pending, populates the user Event struct and copies any
 * associated text payload into user memory.
 *
 * @param pid Process ID.
 * @param user_event Pointer to an Event with its own inline text storage.
 * @return True if an event was dequeued.
 */
export bool poll(Pid pid, UserAddress user_event) {
    if (!ready(pid)) { debug.panic("request_gateway: invalid poll PID"); }
    i32 i = case process.slot_of(pid) of {
        Some(v) -> v;
        None -> ({ debug.panic("request_gateway: PID slot disappeared"); return false; });
    };
    // The whole Event is checked before one is taken, so a bad one loses no event.
    if (!user_memory.writable(pid, user_event, sizeof(Event))) { return false; }
    i32 w[24];
    if (!ipc.recv(gateway_slots[i].event_ch, &w[0])) {
        scheduler.arm_notification(TransportSignal::EVENT);
        return false;
    }
    scheduler.disarm_notification(TransportSignal::EVENT);
    // Words 0..4 are the Event's fields and words 5..20 its event-owned
    // 64-byte payload, so the message's first 84 bytes are the Event as it
    // lies in memory. The payload, its last field, ends in a NUL whatever
    // was queued.
    char *event = (char*)(&w[0]);
    event[sizeof(Event) - 1] = (char)0;
    user_memory.copy_out(pid, user_event, event, sizeof(Event));
    return true;
}

/**
 * Leaves a process's gateway slot as a new holder of the pid must find it.
 *
 * Stops routing events to it, drains pending replies and events, and clears
 * the staging buffers a reply copies out of.
 *
 * @param pid Process ID of terminated process.
 */
export void process_gone(Pid pid) {
    i32 i = case process.slot_of(pid) of { Some(v) -> v; None -> ({ return; }); };
    app_events.unbind(pid);
    gateway_slots[i].events_bound = false;
    if (gateway_slots[i].reply_ch == ChannelId(0)) { return; }
    i32 w[24];
    while (ipc.recv(gateway_slots[i].reply_ch, &w[0])) { }
    while (ipc.recv(gateway_slots[i].event_ch, &w[0])) { }
    gateway_slots[i].pending = false;
    gateway_slots[i].out_user = UserAddress(0);
    gateway_slots[i].result_user = UserAddress(0);
    gateway_slots[i].result_size = 0;
    mem.write_byte(gateway_slots[i].out, 0);
    i32 at = 0;
    while (at < RESULT_CAP) {
        mem.write_byte(gateway_slots[i].result + at, 0);
        at++;
    }
}
