namespace shell;

import debug from "@kernel/debug/debug.mln";
import fs from "@os/fs/fs.mln";
import scheduler from "@kernel/kernel/scheduler.mln";
import { KernelSignal } from "@kernel/kernel/thread.mln";
import serial from "@kernel/io/serial.mln";
import str from "@std/text/str.mln";
import { Text } from "@std/text/text.mln";
import { Option } from "@std/core/option.mln";
import { KeyCode } from "@contracts/input/keyboard.contract.mln";

/**
 * Blocks until a character is available from the serial input queue, sleeping
 * until the serial interrupt says one arrived.
 * @return Received ASCII character byte.
 */
i32 read_char() {
    while (1) {
        // Armed before the look, so a character that lands in between is kept.
        scheduler.arm_notification(KernelSignal::SERIAL);
        case serial.read_input() of {
            Some(c) -> ({ return c; });
            None -> ({ scheduler.await_notification(KernelSignal::SERIAL, 0); });
        };
    }
}

/**
 * Main interactive command line loop for the serial terminal shell.
 *
 * Reads user commands over serial RX, handles line editing, and executes built-ins.
 */
export void run() {
    debug.println("Starting OS shell...");
    Text<128> buf = Text<128> {};

    while (1) {
        debug.print("MyOS> ");
        buf.clear();

        while (1) {
            i32 c = read_char();
            if (c == '\r' || c == '\n') {
                debug.println("");
                break;
            }
            if (c == '\b' || c == KeyCode::DELETE) {
                if (!buf.is_empty()) {
                    buf.truncate(buf.len() - 1);
                    // Backspace, space, backspace to erase char on terminal
                    debug.print("\b \b");
                }
            } else {
                if (buf.push((u8)c)) {
                    serial.putc(c);
                }
            }
        }

        if (!buf.is_empty()) {
            str command = buf.as_str();
            if (command == "help") {
                debug.println("Commands:");
                debug.println("  help  - Show this help");
                debug.println("  ls    - List files");
                debug.println("  hello - Print a greeting");
            } else if (command == "ls") {
                fs.list();
            } else if (command == "hello") {
                debug.println("Hello from MyOS Shell!");
            } else {
                debug.print("Unknown command: ");
                debug.println(command);
            }
        }
    }
}
