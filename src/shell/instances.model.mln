package instances;

import { Text } from "@std/text/text.mln";
import { NodeId } from "@contracts/ui/widget.contract.mln";
import { Pid } from "@contracts/process/control.contract.mln";

// The instances running on the desktop: one row per running or starting app
// process, keyed by its pid. Applications never see these ids.
entity Instance max 32 {
    Pid pid;
    i32 app;            // registry slot
    Option<NodeId> win; // main window; None until MAIN_WINDOW
    bool open;          // open_path waits for the window
    bool done;          // it sent EXIT; reap once it has exited
    // A path per instance: a single scratch buffer loses the first path when
    // two applications are still starting at the same time.
    Text<64> open_path;
}

unique Instance.pid;
