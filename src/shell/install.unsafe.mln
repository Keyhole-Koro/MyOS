package shell_install;

import fs from "@os/fs/fs.mln";
import heap from "@kernel/mm/heap.mln";
import compositor from "@os/ui/compositor.mln";
import annotations from "@std/meta/annotations.mln";
import { Annotations } from "@std/meta/annotations.mln";
import mbin from "@std/format/mbin.mln";
import { Option } from "@std/core/option.mln";
import { Result } from "@std/core/result.mln";
import { Text } from "@std/text/text.mln";

// What the shell's install() needs that a checked source cannot do, so that
// app.mln stays one. Reading an app's @app row takes a heap buffer that
// fs.read fills by its integer address, and an annotations iterator that
// points into that buffer; the compositor keeps the desktop menu as a C string.
// Both wait on MLC-026, which gives them values.

// --- installed apps --------------------------------------------------------------------------

Text<32> scan_path;

// The @app row an image declares, if it does: read its header (MBIN, section
// directory) for its annotation rows, without loading it.
void read_app_row(str path, str image, fn(str path, str type, bool single, str name, bool opens) -> void found) {
    if (!mbin.is_image(image)) { return; }
    Annotations rows = annotations.in_image(image);
    rows.on("app", "");
    if (!rows.next()) { return; }
    str type = case rows.type() of {
        Ok(value) -> value;
        Err(_) -> ({ return; });
    };
    bool single = case rows.flag(0) of {
        Ok(value) -> value;
        Err(_) -> ({ return; });
    };
    str label = case rows.text(1) of {
        Ok(value) -> value;
        Err(_) -> ({ return; });
    };
    bool opens = case rows.flag(2) of {
        Ok(value) -> value;
        Err(_) -> ({ return; });
    };
    found(path, type, single, label, opens);
}

// Read the file at `path`, `size` bytes, into a heap buffer for as long as its
// row is being read.
void read_image(str path, i32 size, fn(str path, str type, bool single, str name, bool opens) -> void found) {
    i32 fd = case fs.open(path) of {
        Ok(value) -> value;
        Err(_) -> ({ return; });
    };
    i32 image = case heap.alloc(size) of {
        Ok(pointer) -> pointer;
        Err(_) -> 0;
    };
    if (image != 0) {
        bool whole = case fs.read(fd, image, size) of {
            Ok(got) -> got == size;
            Err(_) -> false;
        };
        if (whole) {
            str bytes = str { data: (char*)image, length: size };
            read_app_row(path, bytes, found);
        }
        heap.free(image);
    }
    fs.close(fd);
}

/**
 * Hands the @app row of every executable in /apps that declares one to `found`.
 * Call after fs.init().
 * @param found Called with the executable's path, the row's receiver type,
 *        whether the app is single-instance, its launcher name ("" when the row
 *        has none) and whether it takes opened paths. The strings are valid until
 *        it returns.
 */
@safe
export void each_app(fn(str path, str type, bool single, str name, bool opens) -> void found) {
    Text<16> name = Text<16> {};
    i32 start = 0;
    while (1) {
        Option<i32> entry = case fs.dir_next_at("apps", start, &name) of {
            Ok(value) -> value;
            Err(_) -> ({ return; });
        };
        i32 idx = case entry of {
            Some(n) -> n;
            None -> ({ break; });
        };
        start = idx + 1;
        i32 size = case fs.entry_size(idx) of {
            Ok(value) -> value;
            Err(_) -> ({ continue; });
        };
        if (size < 36) { continue; }
        scan_path.clear();
        scan_path.append("apps/");
        scan_path.append(name.as_str());
        read_image(scan_path.as_str(), size, found);
    }
}

// --- desktop menu ----------------------------------------------------------------------------

// The compositor reads the desktop menu through a C string on every
// right-click, so the text it points at is kept here, for good.
Text<256> desktop_menu;

/**
 * Sets the desktop's right-click menu. The items are copied.
 * @param items "\n"-joined labels.
 * @param handler Called with the index of the item picked.
 */
@safe
export void set_desktop_menu(str items, fn(i32 index) -> void handler) {
    desktop_menu.clear();
    desktop_menu.append(items);
    compositor.set_desktop_menu(desktop_menu.as_ptr(), handler);
}
