package app;

import debug from "@kernel/debug/debug.mln";
import heap from "@kernel/mm/heap.mln";
import str from "@std/text/str.mln";
import ascii from "@std/text/ascii.mln";
import { ParseIntError } from "@std/text/str.mln";
import { Text } from "@std/text/text.mln";
import dom from "@os/ui/dom/dom.mln";
import dom_widgets from "@os/ui/dom/dom_widgets.mln";
import dom_render from "@os/ui/dom/dom_render.mln";
import compositor from "@os/ui/compositor.mln";
import graphics from "@os/ui/graphics.mln";
import annotations from "@std/meta/annotations.mln";
import { Annotations, AnnotationError } from "@std/meta/annotations.mln";
import fs from "@os/fs/fs.mln";
import { FsError } from "@contracts/io/fs.contract.mln";
import { SpawnError } from "@contracts/process/spawn.contract.mln";
import { Pid } from "@contracts/process/control.contract.mln";
import { AppError, KeyClaimError } from "@contracts/myapp/lifecycle.contract.mln";
import console from "@os/proc/console.mln";
import mbin from "@std/format/mbin.mln";
import { Result } from "@std/core/result.mln";
import { NodeId } from "@contracts/ui/widget.contract.mln";
import { result_take_ok } from "@std/core/result_take.mln";
import { Option } from "@std/core/option.mln";
import { Iterator } from "@std/core/iter.mln";
import instances from "instances.mln";
import { Instance, InstanceRow, instance_all_Iter } from "instances.mln";
import { ShellEventKind } from "events.mln";
import { KeyModifier, KeyCode } from "@contracts/input/keyboard.contract.mln";

// The shell: the registry of installed apps and the instances running on
// the desktop. This is the OS side of the application framework -- apps
// never call it; they link against the SDK (system/MyAppFramework), which
// gives `@app` its meaning.
//
// An installed app is an executable on the disk whose header carries an
// @app row (the compiler recorded it; install() reads it with MyStdLib's
// annotations iterator, without loading the file): its type name, launcher
// name, whether it is single-instance and whether it takes @open. What its
// other annotations mean -- @timer, @key, @on_close -- is the app's own
// runtime's business (MyAppFramework/src/runtime/runtime.mln), which reads them
// when the process starts and asks the shell only for what crosses the
// boundary: a timer node, a key claim.
//
// An instance is a process. The shell publishes events through its event
// sink: KEY when a claimed shortcut is pressed, OPEN with a
// path, CLOSE when the user closes its window; the instance answers CLOSE
// with an EXIT request and ends. The instance's window comes back as a
// MAIN_WINDOW request.
//
// The shell owns the apps it launches: they have no parent process, and the OS
// reaps them as soon as they end (console.sweep). What the shell holds for any
// process goes in process_gone().
//
// A process owns every DOM node it creates (requests carry its pid as the
// owner), so closing its window sweeps dialogs and timers with it.
// Registry and instances are fixed-size tables, like the rest of the
// kernel's bookkeeping.

// --- registry --------------------------------------------------------------------------------

i32 APPS_MAX = 16;

/**
 * Metadata read from an installed executable's @app annotation.
 * @property path Executable path.
 * @property type Application receiver type recorded in the @app annotation.
 * @property single True when launch requests should reuse an existing instance.
 * @property name Launcher label; falls back to type when the annotation omits a name.
 * @property opens True when this application declares an @open handler.
 */
struct AppRecord {
    Text<32> path;
    Text<32> type;              // "Counter", the @app row's receiver type
    bool single;
    Text<32> name;
    bool opens;
};
AppRecord registry[16];
i32 registry_count = 0;

// Outbound port installed by boundary endpoints. The shell owns lifecycle
// policy but does not depend on the transport that delivers it.
void no_event_sink(Pid owner, i32 id, i32 kind, i32 arg, i32 token, str text) { }

fn(Pid owner, i32 id, i32 kind, i32 arg, i32 token, str text) -> void event_sink = no_event_sink;

/**
 * Installs the callback used to deliver application lifecycle and shortcut events.
 * @param sink Callback with signature (owner, node_id, kind, arg, token, text), or 0 to disable.
 */
export void set_event_sink(
    fn(Pid owner, i32 id, i32 kind, i32 arg, i32 token, str text) -> void sink
) { event_sink = sink; }

/**
 * Forwards an application event through the configured event endpoint.
 * @param owner Recipient process ID.
 * @param id Target DOM node or window ID.
 * @param kind ShellEventKind event code.
 * @param arg Event-specific integer argument.
 * @param token Correlation token or event-specific secondary value.
 * @param text Text payload, such as an opened path, or "".
 */
void push_app_event(Pid owner, NodeId id, i32 kind, i32 arg, i32 token, str text) {
    event_sink(owner, (i32)id, kind, arg, token, text);
}

// Names, types and paths read out of images on disk are copied into the
// record: the image buffer is freed once its header has been read.
void register_app(str path, str type, bool single, str name, bool opens) {
    if (registry_count >= APPS_MAX) {
        debug.println("app: registry full");
        return;
    }
    AppRecord record = AppRecord { single: single, opens: opens };
    record.path.append(path);
    record.type.append(type);
    if (name.is_empty()) { record.name.append(type); }
    else { record.name.append(name); }
    registry[registry_count] = record;
    registry_count++;
}

str label_of(i32 index) {
    AppRecord *record = &registry[index];
    return record->name.as_str();
}

// Register the app an image declares, if it does: read its header (MBIN,
// section directory) for its annotation rows, without loading it.
void register_image(str path, str image) {
    if (!mbin.is_image(image)) { return; }
    Annotations rows = annotations.in_image(image);
    rows.on("app", "");
    if (!rows.next()) { return; }
    str type = case rows.type() of {
        Ok(value) -> value;
        Err(_) -> ({ return; });
    };
    bool single = case rows.flag(0) of {
        Ok(value) -> value;
        Err(_) -> ({ return; });
    };
    str label = case rows.text(1) of {
        Ok(value) -> value;
        Err(_) -> ({ return; });
    };
    Annotations opens = annotations.in_image(image);
    opens.on("open", type);
    register_app(path, type, single, label, opens.next());
    debug.print("app: installed ");
    debug.print(type);
    debug.print(" (");
    debug.print(path);
    debug.println(")");
}

// Every executable in /apps that declares @app is an installed app.
Text<32> scan_path;

void scan_disk() {
    Text<16> name = Text<16> {};
    i32 start = 0;
    while (1) {
        Result<Option<i32>, FsError> res = fs.dir_next_at("apps", start, &name);
        Option<i32> entry = None;
        if (!result_take_ok<Option<i32>, FsError>(&res, &entry)) { return; }
        i32 idx = case entry of {
            Some(n) -> n;
            None -> ({ break; });
        };
        start = idx + 1;
        Result<i32, FsError> size_result = fs.entry_size(idx);
        i32 size = 0;
        if (!result_take_ok<i32, FsError>(&size_result, &size)) { continue; }
        if (size < 36) { continue; }
        scan_path.clear();
        scan_path.append("apps/");
        scan_path.append(name.as_str());
        Result<i32, FsError> opened = fs.open(scan_path.as_str());
        i32 fd = 0;
        if (result_take_ok<i32, FsError>(&opened, &fd)) {
            i32 image = case heap.alloc(size) of {
                Ok(pointer) -> pointer;
                Err(_) -> 0;
            };
            if (image != 0) {
                Result<i32, FsError> read_result = fs.read(fd, image, size);
                i32 got = 0;
                bool read_ok = result_take_ok<i32, FsError>(&read_result, &got);
                if (read_ok && got == size) {
                    str bytes = str { data: (char*)image, length: size };
                    register_image(scan_path.as_str(), bytes);
                }
                heap.free(image);
            }
            fs.close(fd);
        }
    }
}

// --- instances -------------------------------------------------------------------------------

Text<256> menu_buf; // "\n"-joined app names

// The instance of app `app` that has not sent EXIT.
Option<Instance> instance_of_app(i32 app) {
    for (Instance each in instances.instance_all()) {
        borrow InstanceRow row = each.row();
        if (!row.done && row.app == app) {
            return Some(each);
        }
    }
    return None;
}

bool has_window(borrow InstanceRow row) {
    return case row.win of { Some(_) -> true; None -> false; };
}

// Start an instance of app `a`: spawn its executable. Its window arrives
// later, as a MAIN_WINDOW request (window_ready below).
Result<Instance, AppError> mount(i32 a) {
    Instance instance = case instances.new_instance() of {
        Some(value) -> value;
        None -> ({
            debug.println("app: too many instances");
            return Err(AppError::NoFreeSlot);
        });
    };
    AppRecord *record = &registry[a];
    Result<Pid, SpawnError> spawned = console.spawn_file(None, record->path.as_str());
    Pid pid = case spawned of {
        Ok(value) -> value;
        Err(_) -> ({
            debug.print("app: cannot start ");
            debug.println(record->path.as_str());
            instance.delete();
            return Err(AppError::SpawnFailed);
        });
    };
    instance.set_pid(pid);
    borrow InstanceRow row = instance.row();
    row.app = a;
    row.win = None;
    dom.note_app_starting(1);
    return Ok(instance);
}

// MAIN_WINDOW from an instance: its view() built `win`. Put it on the
// desktop as the instance's window, and deliver an OPEN that was waiting
// for it.
/**
 * Registers an application's newly created main window with the desktop.
 * Assigns ownership and close handling, focuses it, and delivers any OPEN path
 * that arrived while the application was starting.
 * @param owner Process ID of the application instance.
 * @param win DOM node ID of the window created by that process.
 */
export void window_ready(Pid owner, NodeId win) {
    Instance instance = case instances.instance_by_pid(owner) of {
        Some(value) -> value;
        None -> ({ return; });
    };
    borrow InstanceRow row = instance.row();
    if (!has_window(&row)) { dom.note_app_starting(-1); }
    dom.set_owner(win, owner);
    dom.set_on_close(win, window_closed);
    case dom.append_child(dom.desktop_id(), win) of {
        Ok(_) -> _;
        Err(_) -> ({ return; });
    };
    row.win = Some(win);
    dom_widgets.focus_window(win);
    if (row.open) {
        row.open = false;
        str opened = row.open_path.as_str();
        push_app_event(owner, win, ShellEventKind::OPEN, 0, 0, opened);
    }
}

// The on_close handler every app window carries: tell the instance its
// window is closing (a CLOSE event; its runtime runs the app's @on_close)
// and wait for its EXIT request to actually take it down.
/**
 * Handles a window-close event by asking its owning app to close gracefully.
 * @param owner Process ID owning the closed window.
 * @param win DOM node ID of the closed window.
 * @param arg Event argument supplied by the DOM callback (unused).
 */
void window_closed(Option<Pid> owner, NodeId win, i32 arg) {
    case owner of {
        Some(pid) -> ({
            case instances.instance_by_pid(pid) of {
                Some(instance) -> ({
                    // A close queued for the last holder of this pid names a
                    // window that is gone, and must not close the new instance.
                    borrow InstanceRow row = instance.row();
                    bool current = case row.win of { Some(held) -> held == win; None -> false; };
                    if (current) {
                        push_app_event(pid, win, ShellEventKind::CLOSE, 0, 0, "");
                        return;
                    }
                });
                None -> _;
            };
        });
        None -> _;
    };
    dom.remove_node(win);
    dom_widgets.activate_topmost();
}

// The instance is done (EXIT): a relaunch no longer finds it. The process ends
// itself right after, and its window goes with everything else it owned.
/**
 * Records that an application has sent EXIT.
 * @param owner Process ID of the exiting application.
 */
export void instance_exited(Pid owner) {
    case instances.instance_by_pid(owner) of {
        Some(instance) -> ({ instance.row().done = true; });
        None -> _;
    };
}

/**
 * Releases what the shell holds for a process that has ended, however it ended
 * and whether or not the shell started it: its nodes -- window, dialogs, timers
 * -- its key claims, and its instance if it had one.
 * @param pid Process that has ended; its slot is still held.
 */
export void process_gone(Pid pid) {
    dom.remove_owned(pid);
    release_claims(pid);
    case instances.instance_by_pid(pid) of {
        Some(instance) -> ({
            borrow InstanceRow row = instance.row();
            if (!has_window(&row)) { dom.note_app_starting(-1); }
            instance.delete();
            dom_widgets.activate_topmost();
        });
        None -> _;
    };
}

// A timer on the desktop: this is the server task's turn to end the processes
// that have ended -- ones that sent EXIT, and ones that died without (a crash).
/**
 * Runs the OS's sweep of ended processes on the server task.
 * Registered as the shell's periodic timer callback.
 * @param owner Timer event owner (unused).
 * @param id Timer node ID (unused).
 * @param arg Timer callback argument (unused).
 */
void reap_exited(Option<Pid> owner, NodeId id, i32 arg) {
    console.sweep();
}

// Start the app at `index`; a single-instance app that is already running is
// brought to the front instead. Returns the running instance's window, or
// None while a newly started instance waits for MAIN_WINDOW.
/**
 * Launches an installed app, or focuses its existing instance when single-instance.
 * @param index Zero-based application registry index.
 * @return Ok(Some(window)) when a main window exists, Ok(None) while it starts,
 *         or Err when the index is invalid or launching fails.
 */
export Result<Option<NodeId>, AppError> launch(i32 index) {
    if (index < 0 || index >= registry_count) { return Err(AppError::InvalidIndex(index)); }
    if (registry[index].single) {
        case instance_of_app(index) of {
            Some(instance) -> ({
                borrow InstanceRow row = instance.row();
                case row.win of {
                    Some(window) -> ({ dom_widgets.focus_window(window); return Ok(Some(window)); });
                    None -> ({ return Ok(None); });
                };
            });
            None -> _;
        };
    }
    return case mount(index) of {
        Ok(_) -> Ok(None);
        Err(error) -> Err(error);
    };
}

/**
 * Launches an installed application by its launcher label.
 * @param name Application label shown in the launcher.
 * @return Ok(Some(window)) when available, Ok(None) while starting, or Err when
 *         the name is not installed or launching fails.
 */
export Result<Option<NodeId>, AppError> launch_named(str name) {
    i32 i = 0;
    while (i < registry_count) {
        if (label_of(i) == name) { return launch(i); }
        i++;
    }
    return Err(AppError::NotFound);
}

// The instance that takes an OPEN for app `a`: the running one of a
// single-instance app, otherwise a fresh one.
Result<Instance, AppError> instance_for_open(i32 a) {
    if (registry[a].single) {
        case instance_of_app(a) of {
            Some(instance) -> ({ return Ok(instance); });
            None -> _;
        };
    }
    return mount(a);
}

// Hand `path` to an app with an @open method: the running instance of a
// single-instance app, otherwise a fresh one, as an OPEN event -- sent at
// once to a running instance, or as soon as a new one reports its window.
// Returns Some(window) when it went to a live window and None while that
// window is still starting; invalid paths and launch failures are errors.
/**
 * Routes a file path to the first installed app that declares an @open handler.
 * Queues the path until the app's main window exists when the app is starting.
 * @param path Path to open.
 * @return Ok(Some(window)) when delivered immediately, Ok(None) while the app
 *         starts, or Err when the path, handler, or launch request is invalid.
 */
export Result<Option<NodeId>, AppError> open(str path) {
    if (path.length > 63) { return Err(AppError::PathTooLong(path.length)); }
    i32 a = 0;
    while (a < registry_count) {
        if (registry[a].opens) {
            Instance instance = instance_for_open(a)?;
            borrow InstanceRow row = instance.row();
            row.open_path.clear();
            row.open_path.append(path);
            case row.win of {
                Some(win) -> ({
                    dom_widgets.focus_window(win);
                    str opened = row.open_path.as_str();
                    push_app_event(instance.pid(), win, ShellEventKind::OPEN, 0, 0, opened);
                    return Ok(Some(win));
                });
                None -> ({
                    row.open = true;
                    return Ok(None);
                });
            };
        }
        a++;
    }
    return Err(AppError::NoOpenHandler);
}

// --- launcher menu ---------------------------------------------------------------------------

/**
 * Builds the launcher's newline-separated list of application labels.
 * @return View of shell-owned static storage.
 */
export str menu_items() {
    menu_buf.clear();
    i32 i = 0;
    while (i < registry_count) {
        if (i > 0) { menu_buf.append("\n"); }
        menu_buf.append(label_of(i));
        i++;
    }
    return menu_buf.as_str();
}

/**
 * Launches the application selected from the launcher menu.
 * @param index Zero-based app index matching the order in menu_items().
 */
export void on_menu(i32 index) {
    launch(index);
}

/** Opens the application launcher menu above the taskbar button. */
export void launch_menu() {
    i32 s = dom.ui_scale();
    i32 rows = registry_count;
    if (rows < 1) { rows = 1; }
    i32 y = graphics.display_height() - dom_widgets.taskbar_height() - (rows * 34 + 20) * s;
    str items = menu_items();
    case dom_widgets.open_menu(8 * s, y, items, on_menu, None) of {
        Ok(_) -> _;
        Err(_) -> _;
    };
}

// --- keyboard shortcuts ----------------------------------------------------------------------

// True if `word` is `name`, whatever the case of `word`.
bool word_is(str word, str name) {
    if (word.length != name.length) { return false; }
    i32 i = 0;
    while (i < word.length) {
        if (ascii.to_lower(word.byte(i)) != name.byte(i)) { return false; }
        i++;
    }
    return true;
}

// The key code a spec's final word names: a single character (as lower
// case), or a named key in the kernel's keyboard.mln encoding. None if unknown.
Option<i32> named_key(str word) {
    if (word.length == 1) {
        i32 c = ascii.to_lower(word.byte(0));
        return Some(c);
    }
    if (word_is(word, "enter")) { return Some(KeyCode::ENTER); }
    if (word_is(word, "return")) { return Some(KeyCode::ENTER); }
    if (word_is(word, "tab")) { return Some(KeyCode::TAB); }
    if (word_is(word, "escape")) { return Some(KeyCode::ESCAPE); }
    if (word_is(word, "esc")) { return Some(KeyCode::ESCAPE); }
    if (word_is(word, "space")) { return Some(KeyCode::SPACE); }
    if (word_is(word, "backspace")) { return Some(KeyCode::BACKSPACE); }
    if (word_is(word, "delete")) { return Some(KeyCode::DELETE); }
    if (word_is(word, "left")) { return Some(KeyCode::LEFT); }
    if (word_is(word, "right")) { return Some(KeyCode::RIGHT); }
    if (word_is(word, "up")) { return Some(KeyCode::UP); }
    if (word_is(word, "down")) { return Some(KeyCode::DOWN); }
    if (word_is(word, "home")) { return Some(KeyCode::HOME); }
    if (word_is(word, "end")) { return Some(KeyCode::END); }
    if (word_is(word, "pageup")) { return Some(KeyCode::PAGE_UP); }
    if (word_is(word, "pagedown")) { return Some(KeyCode::PAGE_DOWN); }
    if (word.length >= 2) {
        if (ascii.to_lower(word.byte(0)) == 'f') {
            str digits = case word.slice(1, word.length) of {
                Some(value) -> value;
                None -> ({ return None; });
            };
            Result<i32, ParseIntError> parsed = str.atoi(digits);
            i32 f = case parsed of {
                Ok(value) -> value;
                Err(_) -> ({ return None; });
            };
            if (f >= 1) { if (f <= 12) { return Some(KeyCode::F1 + f - 1); } }
        }
    }
    return None;
}

// Does "Ctrl+Shift+S" describe this key DOWN? Words before the last are
// modifiers (Ctrl, Shift, Alt); the last is the key.
bool key_spec_matches(str spec, i32 code, i32 mods) {
    i32 want_mods = 0;
    i32 i = 0;
    while (1) {
        i32 start = i;
        while (i < spec.length && spec.byte(i) != '+') { i++; }
        i32 n = i - start;
        if (i < spec.length) {
            if (n == 0) {
                // "Ctrl++": the '+' key itself.
                if (i + 1 < spec.length) { return false; }
                n = 1;
            } else {
                str modifier = case spec.slice(start, i) of {
                    Some(value) -> value;
                    None -> ({ return false; });
                };
                if (word_is(modifier, "ctrl")) { want_mods = want_mods | KeyModifier::CTRL; }
                else if (word_is(modifier, "shift")) { want_mods = want_mods | KeyModifier::SHIFT; }
                else if (word_is(modifier, "alt")) { want_mods = want_mods | KeyModifier::ALT; }
                else { return false; }
                i++;
                continue;
            }
        }
        if (want_mods != mods) { return false; }
        str key = case spec.slice(start, start + n) of {
            Some(value) -> value;
            None -> ({ return false; });
        };
        case named_key(key) of {
            Some(want) -> ({ if (want != code) { return false; } });
            None -> ({ return false; });
        };
        return true;
    }
}

// --- key claims -------------------------------------------------------------------------------
// An instance claims the shortcuts its @key methods name (CLAIM_KEY, sent
// by its runtime at start-up) and gets a token back; a matching key press
// while its window is active becomes a KEY event carrying that token, and
// the widget under focus never sees the key. Matching is done here so no
// app code has to run to decide whether a key is taken.

i32 CLAIMS_MAX = 64;
/**
 * One process-owned keyboard shortcut registered with the shell.
 * @property owner Process ID that registered this shortcut; None marks an unused slot.
 * @property spec Bounded copy of the textual key combination, such as "Ctrl+Shift+F12".
 */
struct KeyClaim {
    Option<Pid> owner;
    Text<16> spec; // copied because the request's string is transient
};
KeyClaim claims[64];
i32 claim_count = 0;

bool claimed_by(KeyClaim claim, Pid owner) {
    return case claim.owner of { Some(held) -> held == owner; None -> false; };
}

/**
 * Registers a process keyboard shortcut and returns its event correlation token.
 * @param owner Process ID that owns the shortcut.
 * @param spec Combination such as "Ctrl+S" or "Alt+F4".
 * @return Ok(one-based shortcut token), or Err when the specification is too long
 *         or the fixed claim table is full.
 */
export Result<i32, KeyClaimError> claim_key(Pid owner, str spec) {
    if (spec.length > 15) { return Err(KeyClaimError::KeySpecTooLong(spec.length)); }
    i32 i = 0;
    while (i < claim_count) {
        bool free = case claims[i].owner of { Some(_) -> false; None -> true; };
        if (free) { break; }
        i++;
    }
    if (i == claim_count) {
        if (claim_count >= CLAIMS_MAX) { return Err(KeyClaimError::TableFull); }
        claim_count++;
    }
    KeyClaim *claim = &claims[i];
    claim->owner = Some(owner);
    claim->spec.clear();
    claim->spec.append(spec);
    return Ok(i + 1);
}

void release_claims(Pid owner) {
    i32 i = 0;
    while (i < claim_count) {
        if (claimed_by(claims[i], owner)) { claims[i].owner = None; }
        i++;
    }
}

// Key filter installed on the DOM: a DOWN event matching a claim of the
// active window's instance becomes a KEY event to it and is taken.
/**
 * Tests a key-down event against one process's registered shortcuts.
 * @param active_owner Process owning the active window; None for a system window.
 * @param code Encoded key code from the keyboard driver.
 * @param mods KeyModifier bitmask from the shared keyboard contract.
 * @return True when a matching shortcut event was sent.
 */
export bool dispatch_key(Option<Pid> active_owner, i32 code, i32 mods) {
    Pid owner = case active_owner of { Some(value) -> value; None -> ({ return false; }); };
    Instance instance = case instances.instance_by_pid(owner) of {
        Some(value) -> value;
        None -> ({ return false; });
    };
    i32 i = 0;
    while (i < claim_count) {
        KeyClaim *claim = &claims[i];
        if (claimed_by(*claim, owner)) {
            if (key_spec_matches(claim->spec.as_str(), code, mods)) {
                borrow InstanceRow row = instance.row();
                NodeId window = case row.win of {
                    Some(value) -> value;
                    None -> ({ return false; });
                };
                push_app_event(owner, window, ShellEventKind::KEY, code | (mods << 16), i + 1, "");
                return true;
            }
        }
        i++;
    }
    return false;
}

// Read the disk and wire the shell to the desktop: taskbar launcher,
// desktop menu, the keyboard filter and the reaper. Call once after
// desktop.init() and fs.init().
/**
 * Scans installed applications and connects the shell to desktop events and launch UI.
 * Call once after DOM and filesystem initialization.
 */
export void install() {
    scan_disk();
    dom_render.set_launcher(launch_menu);
    menu_items();
    compositor.set_desktop_menu(menu_buf.as_ptr(), on_menu);
    dom.set_key_filter(dispatch_key);
    case dom_widgets.create_timer(50, reap_exited) of {
        Ok(_) -> _;
        Err(_) -> ({ debug.panic("app: reaper timer creation failed"); });
    };
}
