package app;

import debug from "../../../MyKernel/src/debug/debug.mln";
import heap from "../../../MyKernel/src/mm/heap.mln";
import str from "../../../../toolchain/MyStdLib/str.mln";
import strbuf from "../../../../toolchain/MyStdLib/text/strbuf.mln";
import dom from "../ui/dom/dom.mln";
import dom_widgets from "../ui/dom/dom_widgets.mln";
import dom_render from "../ui/dom/dom_render.mln";
import compositor from "../ui/compositor.mln";
import graphics from "../ui/graphics.mln";
import annotations from "../../../../toolchain/MyStdLib/meta/annotations.mln";
import { Annotations } from "../../../../toolchain/MyStdLib/meta/annotations.mln";
import ui_events from "../ui/ui_events.mln";
import fs from "../fs/fs.mln";
import { FsError } from "../fs/fs.mln";
import console from "../proc/console.mln";
import os_calls from "../proc/os_calls.mln";
import mbin from "../../../../toolchain/MyStdLib/format/mbin.mln";
import { Result } from "../../../../toolchain/MyStdLib/result.mln";
import { Option } from "../../../../toolchain/MyStdLib/option.mln";
import { UiEventKind } from "../../../MyAppFramework/src/protocol/ui.mln";

// The shell: the registry of installed apps and the instances running on
// the desktop. This is the OS side of the application framework -- apps
// never call it; they link against the SDK (system/MyAppFramework) and
// this is what gives `@app` its meaning (docs/design/os-app-boundaries.md).
//
// An installed app is an executable on the disk whose header carries an
// @app row (the compiler recorded it; install() reads it with MyStdLib's
// annotations iterator, without loading the file): its type name, launcher
// name, whether it is single-instance and whether it takes @open. What its
// other annotations mean -- @timer, @key, @on_close -- is the app's own
// runtime's business (MyAppFramework/src/runtime/runtime.mln), which reads them
// when the process starts and asks the shell only for what crosses the
// boundary: a timer node, a key claim.
//
// An instance is a process. The shell talks to it only through UI protocol
// events (ui_events): KEY when a claimed shortcut is pressed, OPEN with a
// path, CLOSE when the user closes its window; the instance answers CLOSE
// with an EXIT request and ends, and the shell then frees what it owned
// and reaps it. The instance's window comes back as a MAIN_WINDOW request.
//
// A process owns every DOM node it creates (requests carry its pid as the
// owner), so closing its window sweeps dialogs and timers with it.
// Registry and instances are fixed-size tables, like the rest of the
// kernel's bookkeeping; strings are kept in i32 arrays (see the note on
// pointer arrays in docs/APP_FRAMEWORK.md).

// --- registry --------------------------------------------------------------------------------

i32 APPS_MAX = 16;

i32 g_path[16];                // char*: the executable on disk
i32 g_type[16];                // char*: "Counter", the @app row's receiver type
i32 g_single[16];
i32 g_name[16];                // char*: launcher label
i32 g_opens[16];               // 1 if the type has an @open method
i32 g_app_count = 0;

// Names, types and paths read out of images on disk are copied here: the
// image buffer is freed once its header has been read.
char g_names[512];
i32 g_names_used = 0;

char *keep(char *s) {
    i32 n = str.len(s) + 1;
    if (g_names_used + n > 512) { return ""; }
    char *out = &g_names[g_names_used];
    str.copy(out, s);
    g_names_used = g_names_used + n;
    return out;
}

void register_app(char *path, char *type, i32 single, char *name, i32 opens) {
    if (g_app_count >= APPS_MAX) {
        debug.println("app: registry full");
        return;
    }
    i32 i = g_app_count;
    g_app_count++;
    g_path[i] = (i32)path;
    g_type[i] = (i32)type;
    g_single[i] = single;
    g_name[i] = (i32)name;
    if (name[0] == 0) { g_name[i] = (i32)type; }
    g_opens[i] = opens;
}

// Every executable in /apps that declares @app is an installed app: read
// each file's header (MBIN, section directory) for its annotation rows,
// without loading it.
char g_scan_path[32];

void scan_disk() {
    char name[16];
    i32 start = 0;
    while (1) {
        Result<Option<i32>, FsError> res = fs.dir_next_at("apps", start, &name[0], 16);
        i32 idx = -1;
        case res of {
            Ok(v) -> ({ idx = case v of { Some(n) -> n; None -> -1; }; });
            Err(_) -> ({ return; });
        };
        if (idx < 0) { break; }
        start = idx + 1;
        i32 size = fs.entry_size(idx);
        if (size < 36) { continue; }
        i32 k = strbuf.reset(&g_scan_path[0]);
        k = strbuf.append(&g_scan_path[0], 32, k, "apps/");
        k = strbuf.append(&g_scan_path[0], 32, k, &name[0]);
        i32 fd = case fs.open(&g_scan_path[0]) of { Ok(v) -> v; Err(_) -> -1; };
        if (fd < 0) { continue; }
        char *image = (char*)heap.alloc(size);
        if (image == 0) { fs.close(fd); continue; }
        i32 got = case fs.read(fd, (i32)image, size) of { Ok(v) -> v; Err(_) -> 0; };
        fs.close(fd);
        if (got == size) {
            if (mbin.is_image(image, size)) {
                Annotations rows = annotations.in_image(image);
                rows.on("app", (char*)0);
                if (rows.next()) {
                    char *type = keep(rows.type());
                    Annotations opens = annotations.in_image(image);
                    opens.on("open", type);
                    i32 has_open = 0;
                    if (opens.next()) { has_open = 1; }
                    register_app(keep(&g_scan_path[0]), type, rows.arg(0), keep(rows.text(1)), has_open);
                    debug.printf("app: installed %s (%s)\n", (i32)type, (i32)(&g_scan_path[0]));
                }
            }
        }
        heap.free((i32)image);
    }
}

export i32 count() { return g_app_count; }

export char* app_name(i32 index) {
    if (index < 0) { return ""; }
    if (index >= g_app_count) { return ""; }
    return (char*)g_name[index];
}

// --- instances -------------------------------------------------------------------------------

i32 INSTANCES_MAX = 32;
i32 g_inst_pid[32];    // the process (0 = free slot)
i32 g_inst_app[32];    // registry slot
i32 g_inst_win[32];    // its main window; 0 until the instance reports it (MAIN_WINDOW)
i32 g_inst_open[32];   // 1: an OPEN with g_open_path waits for the window
i32 g_inst_done[32];   // 1: it sent EXIT; the process is reaped once it has exited
i32 g_inst_count = 0;  // slots in use, including freed ones below the high-water mark

char g_menu_buf[256];  // "\n"-joined app names for the launcher menu
char g_open_path[64];  // path handed to an @open handler (copied: the caller's buffer may go away)

i32 slot_of_owner(i32 owner) {
    i32 i = 0;
    while (i < g_inst_count) {
        if (g_inst_pid[i] == owner) { return i; }
        i++;
    }
    return -1;
}

i32 slot_of_app(i32 app) {
    i32 i = 0;
    while (i < g_inst_count) {
        if (g_inst_pid[i] != 0 && g_inst_done[i] == 0) {
            if (g_inst_app[i] == app) { return i; }
        }
        i++;
    }
    return -1;
}

i32 free_slot() {
    i32 i = 0;
    while (i < g_inst_count) {
        if (g_inst_pid[i] == 0) { return i; }
        i++;
    }
    if (g_inst_count >= INSTANCES_MAX) { return -1; }
    g_inst_count++;
    return g_inst_count - 1;
}

// The instance whose window this is, or 0.
export i32 owner_of_window(i32 win) {
    i32 i = 0;
    while (i < g_inst_count) {
        if (g_inst_win[i] == win) { return g_inst_pid[i]; }
        i++;
    }
    return 0;
}

// Start an instance of app `a`: spawn its executable. Its window arrives
// later, as a MAIN_WINDOW request (window_ready below). Returns the
// instance slot, or -1 when out of slots or the spawn failed.
i32 mount(i32 a) {
    i32 slot = free_slot();
    if (slot < 0) {
        debug.println("app: too many instances");
        return -1;
    }
    i32 pid = console.spawn_file((char*)g_path[a]);
    if (pid <= 0) {
        debug.printf("app: cannot start %s\n", g_path[a]);
        return -1;
    }
    g_inst_pid[slot] = pid;
    g_inst_app[slot] = a;
    g_inst_win[slot] = 0;
    g_inst_open[slot] = 0;
    g_inst_done[slot] = 0;
    dom.note_app_starting(1);
    return slot;
}

// MAIN_WINDOW from an instance: its view() built `win`. Put it on the
// desktop as the instance's window, and deliver an OPEN that was waiting
// for it.
export void window_ready(i32 owner, i32 win) {
    i32 slot = slot_of_owner(owner);
    if (slot < 0) { return; }
    if (g_inst_win[slot] == 0) { dom.note_app_starting(-1); }
    if (win == 0) { return; }
    dom.set_owner(win, owner);
    dom.set_on_close(win, window_closed);
    dom.append_child(dom.desktop_id(), win);
    g_inst_win[slot] = win;
    dom_widgets.focus_window(win);
    if (g_inst_open[slot] != 0) {
        g_inst_open[slot] = 0;
        ui_events.push(owner, win, UiEventKind::OPEN, 0, 0, &g_open_path[0]);
    }
}

// The on_close handler every app window carries: tell the instance its
// window is closing (a CLOSE event; its runtime runs the app's @on_close)
// and wait for its EXIT request to actually take it down.
void window_closed(i32 owner, i32 win, i32 arg) {
    i32 slot = slot_of_owner(owner);
    if (slot < 0) {
        dom.remove_node(win);
        dom_widgets.activate_topmost();
        return;
    }
    ui_events.push(owner, win, UiEventKind::CLOSE, 0, 0, (char*)0);
}

// The instance is done (EXIT): remove everything it owns -- its window,
// dialogs, timers -- and drop its key claims. The process ends itself
// right after; reap_exited() collects it.
export void instance_exited(i32 owner) {
    i32 slot = slot_of_owner(owner);
    if (slot < 0) { return; }
    dom.remove_owned(owner);
    release_claims(owner);
    g_inst_done[slot] = 1;
    dom_widgets.activate_topmost();
}

// A timer on the desktop: collect processes that have ended -- ones that
// sent EXIT, and ones that died without (a crash): their nodes go too.
void reap_exited(i32 owner, i32 id, i32 arg) {
    i32 i = 0;
    while (i < g_inst_count) {
        i32 pid = g_inst_pid[i];
        if (pid != 0) {
            if (console.has_exited(pid)) {
                if (g_inst_win[i] == 0) { dom.note_app_starting(-1); }
                if (g_inst_done[i] == 0) {
                    dom.remove_owned(pid);
                    release_claims(pid);
                    dom_widgets.activate_topmost();
                }
                console.reap(pid);
                os_calls.process_gone(pid);
                g_inst_pid[i] = 0;
                g_inst_app[i] = 0;
                g_inst_win[i] = 0;
                g_inst_open[i] = 0;
                g_inst_done[i] = 0;
            }
        }
        i++;
    }
}

// Start the app at `index`; a single-instance app that is already running is
// brought to the front instead. Returns the running instance's window, or
// 0 when the instance is only starting (its window comes with MAIN_WINDOW).
export i32 launch(i32 index) {
    if (index < 0) { return 0; }
    if (index >= g_app_count) { return 0; }
    if (g_single[index] != 0) {
        i32 slot = slot_of_app(index);
        if (slot >= 0) {
            if (g_inst_win[slot] != 0) { dom_widgets.focus_window(g_inst_win[slot]); }
            return g_inst_win[slot];
        }
    }
    mount(index);
    return 0;
}

// Start the app called `name` (as the launcher shows it); 0 if there is none.
export i32 launch_named(char *name) {
    i32 i = 0;
    while (i < g_app_count) {
        if (str.eq((char*)g_name[i], name) != 0) { return launch(i); }
        i++;
    }
    return 0;
}

// Hand `path` to an app with an @open method: the running instance of a
// single-instance app, otherwise a fresh one, as an OPEN event -- sent at
// once to a running instance, or as soon as a new one reports its window.
// Returns the window it went to (0 while the instance is still starting),
// or 0 when no app opens files.
export i32 open(char *path) {
    i32 a = 0;
    while (a < g_app_count) {
        if (g_opens[a] != 0) {
            i32 slot = -1;
            if (g_single[a] != 0) { slot = slot_of_app(a); }
            if (slot < 0) { slot = mount(a); }
            if (slot < 0) { return 0; }
            str.ncopy(&g_open_path[0], path, 64);
            i32 win = g_inst_win[slot];
            if (win != 0) {
                dom_widgets.focus_window(win);
                ui_events.push(g_inst_pid[slot], win, UiEventKind::OPEN, 0, 0, &g_open_path[0]);
            } else {
                g_inst_open[slot] = 1;
            }
            return win;
        }
        a++;
    }
    return 0;
}

// --- launcher menu ---------------------------------------------------------------------------

export char* menu_items() {
    i32 n = strbuf.reset(&g_menu_buf[0]);
    i32 i = 0;
    while (i < g_app_count) {
        if (i > 0) { n = strbuf.append(&g_menu_buf[0], 256, n, "\n"); }
        n = strbuf.append(&g_menu_buf[0], 256, n, (char*)g_name[i]);
        i++;
    }
    return &g_menu_buf[0];
}

// Menu handler(index): the same table order as menu_items().
export void on_menu(i32 index) {
    launch(index);
}

// Taskbar launcher: pop the app menu up above the button.
export void launch_menu() {
    i32 s = dom.ui_scale();
    i32 rows = g_app_count;
    if (rows < 1) { rows = 1; }
    i32 y = graphics.display_height() - dom_widgets.taskbar_height() - (rows * 34 + 20) * s;
    dom_widgets.open_menu(8 * s, y, menu_items(), on_menu, 0);
}

// --- keyboard shortcuts ----------------------------------------------------------------------

i32 MOD_SHIFT = 1;
i32 MOD_CTRL = 2;
i32 MOD_ALT = 4;

// True if `word` (n chars, case-insensitive) is `name`.
i32 word_is(char *word, i32 n, char *name) {
    i32 i = 0;
    while (i < n) {
        i32 c = word[i] & 0xFF;
        if (c >= 'A') { if (c <= 'Z') { c = c + 32; } }
        i32 d = name[i] & 0xFF;
        if (d == 0) { return 0; }
        if (c != d) { return 0; }
        i++;
    }
    if (name[n] != 0) { return 0; }
    return 1;
}

// The key code a spec's final word names: a single character (as lower
// case), or a named key in the kernel's keyboard.mln encoding. -1 if unknown.
i32 named_key(char *word, i32 n) {
    if (n == 1) {
        i32 c = word[0] & 0xFF;
        if (c >= 'A') { if (c <= 'Z') { c = c + 32; } }
        return c;
    }
    if (word_is(word, n, "enter") != 0) { return 13; }
    if (word_is(word, n, "return") != 0) { return 13; }
    if (word_is(word, n, "tab") != 0) { return 9; }
    if (word_is(word, n, "escape") != 0) { return 27; }
    if (word_is(word, n, "esc") != 0) { return 27; }
    if (word_is(word, n, "space") != 0) { return 32; }
    if (word_is(word, n, "backspace") != 0) { return 8; }
    if (word_is(word, n, "delete") != 0) { return 127; }
    if (word_is(word, n, "left") != 0) { return 0x101; }
    if (word_is(word, n, "right") != 0) { return 0x102; }
    if (word_is(word, n, "up") != 0) { return 0x103; }
    if (word_is(word, n, "down") != 0) { return 0x104; }
    if (word_is(word, n, "home") != 0) { return 0x105; }
    if (word_is(word, n, "end") != 0) { return 0x106; }
    if (word_is(word, n, "pageup") != 0) { return 0x107; }
    if (word_is(word, n, "pagedown") != 0) { return 0x108; }
    if (n >= 2) {
        if (word[0] == 'F') {
            i32 f = str.atoi(&word[1]);
            if (f >= 1) { if (f <= 12) { return 0x120 + f; } }
        }
    }
    return -1;
}

// Does "Ctrl+Shift+S" describe this key DOWN? Words before the last are
// modifiers (Ctrl, Shift, Alt); the last is the key.
i32 key_spec_matches(char *spec, i32 code, i32 mods) {
    i32 want_mods = 0;
    i32 i = 0;
    while (1) {
        i32 start = i;
        while (spec[i] != 0) {
            if (spec[i] == '+') { break; }
            i++;
        }
        i32 n = i - start;
        if (spec[i] == '+') {
            if (n == 0) {
                // "Ctrl++": the '+' key itself.
                if (spec[i + 1] != 0) { return 0; }
                n = 1;
            } else {
                if (word_is(&spec[start], n, "ctrl") != 0) { want_mods = want_mods | MOD_CTRL; }
                else if (word_is(&spec[start], n, "shift") != 0) { want_mods = want_mods | MOD_SHIFT; }
                else if (word_is(&spec[start], n, "alt") != 0) { want_mods = want_mods | MOD_ALT; }
                else { return 0; }
                i++;
                continue;
            }
        }
        if (want_mods != mods) { return 0; }
        if (named_key(&spec[start], n) != code) { return 0; }
        return 1;
    }
    return 0;
}

// --- key claims -------------------------------------------------------------------------------
// An instance claims the shortcuts its @key methods name (CLAIM_KEY, sent
// by its runtime at start-up) and gets a token back; a matching key press
// while its window is active becomes a KEY event carrying that token, and
// the widget under focus never sees the key. Matching is done here so no
// app code has to run to decide whether a key is taken.

i32 CLAIMS_MAX = 64;
i32 SPEC_MAX = 16;         // "Ctrl+Shift+F12" fits
i32 g_claim_owner[64];     // 0 = free
char g_claim_spec[1024];   // CLAIMS_MAX * SPEC_MAX; the spec is copied: the request's string is gone by the next
i32 g_claim_count = 0;

export i32 claim_key(i32 owner, char *spec) {
    i32 i = 0;
    while (i < g_claim_count) {
        if (g_claim_owner[i] == 0) { break; }
        i++;
    }
    if (i == g_claim_count) {
        if (g_claim_count >= CLAIMS_MAX) { return 0; }
        g_claim_count++;
    }
    g_claim_owner[i] = owner;
    str.ncopy(&g_claim_spec[i * SPEC_MAX], spec, SPEC_MAX);
    return i + 1;
}

void release_claims(i32 owner) {
    i32 i = 0;
    while (i < g_claim_count) {
        if (g_claim_owner[i] == owner) { g_claim_owner[i] = 0; }
        i++;
    }
}

// Key filter installed on the DOM: a DOWN event matching a claim of the
// active window's instance becomes a KEY event to it and is taken.
export i32 dispatch_key(i32 owner, i32 code, i32 mods) {
    if (owner == 0) { return 0; }
    i32 slot = slot_of_owner(owner);
    if (slot < 0) { return 0; }
    i32 i = 0;
    while (i < g_claim_count) {
        if (g_claim_owner[i] == owner) {
            if (key_spec_matches(&g_claim_spec[i * SPEC_MAX], code, mods) != 0) {
                ui_events.push(owner, g_inst_win[slot], UiEventKind::KEY, code | (mods << 16), i + 1, (char*)0);
                return 1;
            }
        }
        i++;
    }
    return 0;
}

// Read the disk and wire the shell to the desktop: taskbar launcher,
// desktop menu, the keyboard filter and the reaper. Call once after
// dom.init() and fs.init().
export void install() {
    scan_disk();
    dom_render.set_launcher(launch_menu);
    compositor.set_desktop_menu(menu_items(), on_menu);
    dom.set_key_filter(dispatch_key);
    dom_widgets.create_timer(50, reap_exited);
}
