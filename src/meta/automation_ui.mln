package automation_ui;

import automation_transport from "automation_transport.mln";
import dom_automation from "../ui/dom/dom_automation.mln";
import dom from "../ui/dom/dom.mln";
import scheduler from "../../../MyKernel/src/kernel/scheduler.mln";

i32 CMD_DOM_SNAPSHOT = 1;
i32 CMD_DOM_HIT_TEST = 2;

/**
 * Main loop of the metadata automation service task.
 *
 * Polls for host automation requests, dispatches DOM snapshot or hit-test queries,
 * and replies with JSON responses via the MMIO transport.
 */
export void run() {
    while (1) {
        if (automation_transport.has_request() != 0) {
            i32 command = automation_transport.read_request();
            // Reading the tree while the UI server is mid-pass would give a
            // torn picture: take the DOM lock for the dump.
            dom.lock();
            if (command == CMD_DOM_SNAPSHOT) { dom_automation.write_automation_snapshot(); }
            else if ((command >> 28) == CMD_DOM_HIT_TEST) {
                i32 x = (command >> 14) & 0x3FFF;
                i32 y = command & 0x3FFF;
                dom_automation.write_automation_hit_test(x, y);
            }
            else { automation_transport.putc('{'); automation_transport.putc('}'); }
            dom.unlock();
            automation_transport.done();
        }
        scheduler.sleep(1);
    }
}
