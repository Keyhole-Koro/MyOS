import debug from "../../../MyKernel/src/debug/debug.mln";
import heap from "../../../MyKernel/src/mm/heap.mln";
import dom_widgets from "../ui/dom/dom_widgets.mln";
import dom_render from "../ui/dom/dom_render.mln";
import dom from "../ui/dom/dom.mln";
import dom_automation from "../ui/dom/dom_automation.mln";
import graphics from "../ui/graphics.mln";
import fs from "../fs/fs.mln";
import scheduler from "../../../MyKernel/src/kernel/scheduler.mln";
import { SchedulerError } from "../../../MyKernel/src/kernel/scheduler.mln";
import irq_dispatch from "../../../MyKernel/src/kernel/irq_dispatch.mln";
import irq from "../../../MyKernel/src/arch/irq.mln";
import shell from "../apps/shell.mln";
import automation_ui from "../meta/automation_ui.mln";
import compositor from "../ui/compositor.mln";
import console from "../proc/console.mln";
import mmu from "../../../MyKernel/src/mm/mmu.mln";
import { MmuError } from "../../../MyKernel/src/mm/mmu.mln";
import { Result } from "../../../../toolchain/MyStdLib/result.mln";
import { Option } from "../../../../toolchain/MyStdLib/option.mln";
import app from "../../../MyAppFramework/src/app.mln";

// The applications. Importing a module is what puts it in the program (the
// build follows imports from here), and the annotations in it -- @app on a
// view, @timer, @key, ... -- are recorded by the compiler as metadata that
// app.install() reads. Nothing else registers an app.
//
// TODO(apps-on-disk): this list is the interim form. The intended one is
// apps as .mbin files on the MFS disk, loaded by the process loader, with
// the same metadata table carried in the MBIN header and read by the
// framework at load time -- then "which apps exist" is `ls`, not an import.
// See docs/learn/annotations-and-metaprogramming.md.
import counter from "../apps/counter.dom.mln";
import editor from "../apps/editor.dom.mln";
import files from "../apps/files.dom.mln";
import notes from "../apps/notes.dom.mln";
import terminal from "../apps/terminal.dom.mln";

// System bring-up.
//
// This is the OS's entry point, not the kernel's. It lives in MyOS because
// most of what it does is OS work -- starting the DOM, the filesystem, the
// compositor and the apps -- and only the first few lines are kernel
// services being handed their turn. Keeping it in MyKernel was what made the
// two submodules import each other, so that neither could build alone.
//
// The direction here is one-way: MyOS reaches into MyKernel for heap,
// scheduler, irq and debug, and nothing in MyKernel points back.

/**
 * Prints the initial kernel boot banner message to the debug console.
 */
void kernel_boot_banner() {
    debug.println("kernel: boot");
}

/**
 * Initializes architecture-specific kernel subsystems including heap memory.
 */
void kernel_arch_init() {
    debug.println("kernel: arch init");
    heap.init();
    debug.println("kernel: heap ready");
}

/**
 * Sets up kernel identity paging and activates the MMU page directory.
 *
 * Panics if page directory allocation or identity mapping fails.
 */
void enable_kernel_paging() {
    i32 kpd = case mmu.create_page_directory() of {
        Some(p) -> p;
        None -> ({ debug.panic("kernel: no memory for the page directory"); 0; });
    };
    Result<_, MmuError> mapped = mmu.setup_identity_kernel_mapping(kpd);
    case mapped of {
        Ok(_) -> _;
        Err(e) -> ({ debug.panic("kernel: identity mapping failed"); });
    };
    mmu.enable_paging(kpd);
}

// Once a second: redraw the taskbar so its uptime clock advances. A system
// timer, so it takes the raw handler ABI.
void on_clock(i32 owner, i32 id, i32 arg) {
    dom_render.refresh_taskbar();
}

/**
 * Performs full system initialization and enters the compositor event loop.
 *
 * Sets up MMU, DOM, filesystem, default applications, timers, scheduler, and IRQs.
 */
void kernel_init() {
    kernel_boot_banner();
    kernel_arch_init();
    enable_kernel_paging();

    dom.init();
    dom.create_taskbar();
    dom_widgets.create_timer(1000, on_clock);
    debug.println("kernel: dom ready");

    fs.init();
    console.init();

    // The framework (system/MyAppFramework) reads the apps' annotations and
    // owns launching, the app menu, shortcuts and window close.
    app.install();

    // Open a few at boot; the last one launched is the active window.
    app.launch_named("Counter");
    app.launch_named("Notes");
    app.launch_named("Terminal");
    dom_automation.dump();

    // Paint the desktop once before interrupts are enabled. render_all()
    // walks the whole tree (DMA2D fills + glyph draws); once scheduler.init()
    // below flips task 0 to preemptible, the first timer tick can land mid-walk
    // and leave box/button/text undrawn until enough later scheduler slices
    // finish it -- which looks like a UI element appearing out of nowhere on
    // the next click. See compositor.mln's paint_first_frame() for detail.
    compositor.paint_first_frame();

    debug.println("kernel: enabling interrupts for event queue");
    scheduler.init();
    irq.set_handler();
    irq.enable();

    debug.println("kernel: spawning shell task");
    // spawn_task returns a Result; bind it so the callee has somewhere to
    // write it (a bare aggregate-returning call passes no out-pointer).
    Result<i32, SchedulerError> shell_task = scheduler.spawn_task(shell.run);
    case shell_task of { Ok(_) -> _; Err(_) -> ({ debug.println("kernel: no task slot for the shell"); }); };
    Result<i32, SchedulerError> automation_task = scheduler.spawn_task(automation_ui.run);
    case automation_task of { Ok(_) -> _; Err(_) -> ({ debug.println("kernel: no task slot for automation"); }); };

    debug.println("ui: click the button (window must have focus)");
    compositor.run();
}

/**
 * System entry point invoked after low-level bootloader initialization.
 * @return Exit code (always 0).
 */
i32 kernel_main() {
    kernel_init();
    return 0;
}
