package console;

import serial from "../../../MyKernel/src/io/serial.mln";
import heap from "../../../MyKernel/src/mm/heap.mln";
import mem from "../../../MyKernel/src/mm/mem.mln";
import syscall from "../../../MyKernel/src/kernel/syscall.mln";
import debug from "../../../MyKernel/src/debug/debug.mln";
import loader from "../../../MyKernel/src/kernel/loader.mln";
import process from "../../../MyKernel/src/kernel/process.mln";
import { ProcessState, ProcessError } from "../../../MyKernel/src/kernel/process.mln";
import { LoaderError } from "../../../../contracts/process/loader.contract.mln";
import { Result, result_take_ok } from "../../../../toolchain/MyStdLib/result.mln";
import { Option } from "../../../../toolchain/MyStdLib/option.mln";
import { SpawnError, SpawnFsOperation, SpawnFilesystemError, SpawnReadMismatch } from "../../../../contracts/process/spawn.contract.mln";
import { ProcessControlError, ProcessExitStatus } from "../../../../contracts/process/control.contract.mln";
import { FsError, SeekWhence } from "../../../../contracts/io/fs.contract.mln";
import fs from "../fs/fs.mln";
import strbuf from "../../../../toolchain/MyStdLib/text/strbuf.mln";
import dom_widgets from "../ui/dom/dom_widgets.mln";
import dom from "../ui/dom/dom.mln";

// Process consoles (MYOS-015): the glue between user-space processes and
// terminal windows.
//
// The kernel's syscall layer does not know about the desktop; it calls the
// write/read handlers registered here (syscall.set_console) and the spawn
// handler (syscall.set_spawn_handler). Each running process is bound to a
// console slot that names the TextArea its stdout goes to and holds a small
// stdin queue the terminal fills one line at a time. Output written from a
// syscall lands in the DOM directly (append_bytes reads the user buffer
// through the process's own page tables, which are active during the
// syscall); the compositor repaints it on its next pass.

i32 SLOTS = 8;
i32 STDIN_CAP = 256;

/**
 * Standard-I/O routing state associated with one user process.
 * @property pid Bound process ID; zero means this console slot is unused.
 * @property output DOM TextArea node receiving bytes written to stdout/stderr.
 * @property stdin Heap buffer holding queued input characters.
 * @property in_head Index of the next queued input byte to read.
 * @property in_tail Index where the next input byte will be appended.
 */
struct ConsoleSlot {
    i32 pid;          // 0 = free slot
    i32 output;       // TextArea node id receiving stdout
    i32 stdin;        // heap ring buffer of STDIN_CAP bytes
    i32 in_head;
    i32 in_tail;
};
ConsoleSlot consoles[8];

i32 ready = 0;

/**
 * Looks up the console slot index for a given process ID.
 * @param pid Process ID to search for.
 * @return Option containing the slot index if found, or None.
 */
Option<i32> slot_of(i32 pid) {
    if (pid <= 0) { return None; }
    i32 i = 0;
    while (i < SLOTS) {
        if (consoles[i].pid == pid) { return Some(i); }
        i++;
    }
    return None;
}

/**
 * Attaches a process's stdio to a DOM TextArea node.
 * @param pid Target process ID.
 * @param output_id DOM node ID of the TextArea for stdout.
 * @return `true` when bound, or `false` if all console slots are in use.
 */
export bool bind(i32 pid, i32 output_id) {
    i32 i = 0;
    while (i < SLOTS) {
        if (consoles[i].pid == 0) {
            consoles[i].pid = pid;
            consoles[i].output = output_id;
            if (consoles[i].stdin == 0) { consoles[i].stdin = heap.alloc(STDIN_CAP); }
            consoles[i].in_head = 0;
            consoles[i].in_tail = 0;
            return true;
        }
        i++;
    }
    return false;
}

/**
 * Releases a process's console slot binding.
 * @param pid Process ID to detach.
 */
export void unbind(i32 pid) {
    case slot_of(pid) of {
        Some(i) -> ({
            consoles[i].pid = 0;
            consoles[i].output = 0;
        });
        None -> _;
    };
}

/**
 * Looks up the TextArea DOM node ID associated with a process's stdout.
 * @param pid Process ID.
 * @return `Some(node_id)` when attached, or `None` when unattached.
 */
export Option<i32> output_of(i32 pid) {
    Option<i32> output = None;
    case slot_of(pid) of {
        Some(i) -> ({ output = Some(consoles[i].output); });
        None -> _;
    };
    return output;
}

/**
 * Queues one line of text into the process's stdin buffer.
 * @param pid Target process ID.
 * @param line Pointer to null-terminated string to feed as input.
 */
export void feed_line(i32 pid, char *line) {
    i32 i = case slot_of(pid) of {
        Some(v) -> v;
        None -> ({ return; });
    };
    i32 base = consoles[i].stdin;
    i32 k = 0;
    while (1) {
        i32 c = 10;
        if (line[k] != 0) { c = (i32)line[k] & 0xFF; }
        i32 next = (consoles[i].in_tail + 1) % STDIN_CAP;
        if (next == consoles[i].in_head) { return; } // full
        mem.write_byte(base + consoles[i].in_tail, c);
        consoles[i].in_tail = next;
        if (line[k] == 0) { return; }
        k++;
    }
}

// --- syscall handlers (run in the calling process's context) ---

/**
 * Syscall handler for SYS_WRITE: writes output bytes to the process's bound console TextArea or serial log.
 * @param pid Calling process ID.
 * @param buf Virtual memory address of output buffer.
 * @param count Number of bytes to write.
 * @return Number of bytes written.
 */
i32 on_write(i32 pid, i32 buf, i32 count) {
    Option<i32> output = output_of(pid);
    i32 out = 0;
    bool has_output = false;
    case output of {
        Some(node) -> ({ out = node; has_output = true; });
        None -> _;
    };
    if (!has_output) {
        // No console: fall back to the serial log so nothing is lost.
        i32 k = 0;
        while (k < count) {
            i32 c = mem.read_byte(buf + k);
            serial.putc(c);
            k++;
        }
        return count;
    }
    dom_widgets.append_bytes(out, buf, count);
    return count;
}

/**
 * Syscall handler for SYS_READ: reads input bytes from the process's stdin ring buffer.
 * @param pid Calling process ID.
 * @param buf Destination buffer memory address.
 * @param count Maximum number of bytes to read.
 * @return Number of bytes read.
 */
i32 on_read(i32 pid, i32 buf, i32 count) {
    i32 i = case slot_of(pid) of {
        Some(v) -> v;
        None -> ({ return 0; });
    };
    i32 base = consoles[i].stdin;
    i32 got = 0;
    while (got < count) {
        if (consoles[i].in_head == consoles[i].in_tail) { break; }
        i32 c = mem.read_byte(base + consoles[i].in_head);
        consoles[i].in_head = (consoles[i].in_head + 1) % STDIN_CAP;
        mem.write_byte(buf + got, c);
        got++;
    }
    return got;
}

/**
 * Loads an executable file from the filesystem and starts it as a new process.
 * @param path Pointer to null-terminated file path.
 * @return Ok(PID) on success, or Err(SpawnError) when the executable cannot
 *         be opened, loaded, or scheduled.
 */
char spawn_path[80];

// The file for an executable name: a path as given, or a bare name looked
// up in /bin then /apps (the search path).
Result<Option<i32>, SpawnError> try_open(char *path) {
    Result<i32, FsError> opened = fs.open(path);
    return case opened of {
        Ok(fd) -> Ok(Some(fd));
        Err(NotFound) -> Ok(None);
        Err(e) -> Err(SpawnError::Filesystem(SpawnFilesystemError {
            operation: SpawnFsOperation::Open,
            cause: e,
        }));
    };
}

Result<i32, SpawnError> open_executable(char *path) {
    i32 has_slash = 0;
    i32 i = 0;
    while (path[i] != 0) { if (path[i] == '/') { has_slash = 1; } i++; }
    if (has_slash == 0) {
        i32 k = strbuf.reset(&spawn_path[0]);
        k = strbuf.append(&spawn_path[0], 80, k, "bin/");
        k = strbuf.append(&spawn_path[0], 80, k, path);
        Option<i32> bin = try_open(&spawn_path[0])?;
        case bin of { Some(fd) -> ({ return Ok(fd); }); None -> _; };
        k = strbuf.reset(&spawn_path[0]);
        k = strbuf.append(&spawn_path[0], 80, k, "apps/");
        k = strbuf.append(&spawn_path[0], 80, k, path);
        Option<i32> apps = try_open(&spawn_path[0])?;
        case apps of { Some(fd) -> ({ return Ok(fd); }); None -> _; };
    }
    Option<i32> direct = try_open(path)?;
    case direct of { Some(fd) -> ({ return Ok(fd); }); None -> _; };
    return Err(SpawnError::NotFound);
}

/**
 * Opens an executable image, loads it as a user process, and releases the image buffer.
 * @param path NUL-terminated path searched as supplied, under bin/, and under apps/.
 * @return Ok(pid) when the process starts, or Err(SpawnError) with the launch failure.
 */
export Result<i32, SpawnError> spawn_file(char *path) {
    i32 fd = open_executable(path)?;
    i32 size = case fs.seek(fd, 0, SeekWhence::End) of {
        Ok(v) -> v;
        Err(e) -> ({
            fs.close(fd);
            return Err(SpawnError::Filesystem(SpawnFilesystemError {
                operation: SpawnFsOperation::Measure,
                cause: e,
            }));
        });
    };
    if (size <= 0) { fs.close(fd); return Err(SpawnError::EmptyExecutable); }
    case fs.seek(fd, 0, SeekWhence::Set) of {
        Ok(_) -> _;
        Err(e) -> ({
            fs.close(fd);
            return Err(SpawnError::Filesystem(SpawnFilesystemError {
                operation: SpawnFsOperation::Rewind,
                cause: e,
            }));
        });
    };
    i32 buf = heap.alloc(size);
    if (buf == 0) {
        fs.close(fd);
        return Err(SpawnError::BufferAllocationFailed(size));
    }
    i32 got = case fs.read(fd, buf, size) of {
        Ok(v) -> v;
        Err(e) -> ({
            fs.close(fd);
            heap.free(buf);
            return Err(SpawnError::Filesystem(SpawnFilesystemError {
                operation: SpawnFsOperation::Read,
                cause: e,
            }));
        });
    };
    fs.close(fd);
    if (got != size) {
        heap.free(buf);
        return Err(SpawnError::ShortRead(SpawnReadMismatch {
            expected: size,
            actual: got,
        }));
    }
    Result<i32, LoaderError> spawned = loader.spawn_from_buffer(buf, size);
    i32 pid = case spawned of {
        Ok(p) -> p;
        Err(e) -> ({ heap.free(buf); return Err(SpawnError::Loader(e)); });
    };
    heap.free(buf); // the loader copied the segments into fresh frames
    return Ok(pid);
}

/**
 * SYS_SPAWN hook: writes a typed launch result and binds successful children to the parent console.
 * @param user_path Virtual memory address of null-terminated path string in user space.
 * @param result_out Kernel address of Result<i32, SpawnError> output.
 */
void on_spawn(i32 user_path, Result<i32, SpawnError> *result_out) {
    char path[32];
    i32 k = 0;
    while (k < 31) {
        i32 c = mem.read_byte(user_path + k);
        path[k] = (char)c;
        if (c == 0) { break; }
        k++;
    }
    path[31] = (char)0;
    Result<i32, SpawnError> result = spawn_file(&path[0]);
    i32 pid = 0;
    if (result_take_ok<i32, SpawnError>(&result, &pid)) {
        i32 parent = case process.get_current_pid() of {
            Some(value) -> value;
            None -> ({ debug.panic("SYS_SPAWN hook called without a current process"); });
        };
        Option<i32> output = output_of(parent);
        case output of {
            Some(node) -> ({ bind(pid, node); });
            None -> _;
        };
    }
    *result_out = result;
}

/**
 * Checks whether a process has terminated.
 * @param pid Process ID.
 * @return Ok(true) if exited, Ok(false) if live, or Err(InvalidPid).
 */
export Result<bool, ProcessControlError> has_exited(i32 pid) {
    Option<ProcessState> state = process.get_state(pid);
    Result<bool, ProcessControlError> result;
    case state of {
        Some(s) -> ({
            bool exited = case s of { Zombie(_) -> true; _ -> false; };
            result = Ok(exited);
        });
        None -> ({ result = Err(ProcessControlError::InvalidPid(pid)); });
    };
    return result;
}

/**
 * Reaps an exited Zombie process, retrieves its typed exit status, and frees its slot.
 * @param pid Process ID.
 * @return Ok(exit_status), Err(NotExited), or Err(InvalidPid).
 */
export Result<ProcessExitStatus, ProcessControlError> reap(i32 pid) {
    Option<ProcessState> state = process.get_state(pid);
    Result<ProcessExitStatus, ProcessControlError> result;
    case state of {
        Some(s) -> ({
            case s of {
                Zombie(status) -> ({
                    Result<_, ProcessError> freed = process.free_proc(pid);
                    case freed of {
                        Ok(_) -> ({ unbind(pid); result = Ok(status); });
                        Err(_) -> ({ result = Err(ProcessControlError::InvalidPid(pid)); });
                    };
                });
                _ -> ({ result = Err(ProcessControlError::NotExited(pid)); });
            };
        });
        None -> ({ result = Err(ProcessControlError::InvalidPid(pid)); });
    };
    return result;
}

/**
 * Initializes console subsystem and registers console and spawn hooks with the kernel.
 */
export void init() {
    if (ready) { return; }
    i32 i = 0;
    while (i < SLOTS) {
        consoles[i].pid = 0;
        consoles[i].output = 0;
        consoles[i].stdin = 0;
        i++;
    }
    syscall.set_console(on_write, on_read);
    syscall.set_spawn_handler(on_spawn);
    ready = 1;
}
