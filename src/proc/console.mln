package console;

import debug from "../../../MyKernel/src/debug/debug.mln";
import serial from "../../../MyKernel/src/io/serial.mln";
import heap from "../../../MyKernel/src/mm/heap.mln";
import mem from "../../../MyKernel/src/mm/mem.mln";
import syscall from "../../../MyKernel/src/kernel/syscall.mln";
import loader from "../../../MyKernel/src/kernel/loader.mln";
import process from "../../../MyKernel/src/kernel/process.mln";
import { ProcessState, ProcessError } from "../../../MyKernel/src/kernel/process.mln";
import { LoaderError } from "../../../MyKernel/src/kernel/loader.mln";
import { MmuError } from "../../../MyKernel/src/mm/mmu.mln";
import { Result } from "../../../../toolchain/MyStdLib/result.mln";
import { Option } from "../../../../toolchain/MyStdLib/option.mln";
import { FsError } from "../fs/fs.mln";
import fs from "../fs/fs.mln";
import dom_widgets from "../ui/dom/dom_widgets.mln";
import dom from "../ui/dom/dom.mln";

// Process consoles (MYOS-015): the glue between user-space processes and
// terminal windows.
//
// The kernel's syscall layer does not know about the desktop; it calls the
// write/read handlers registered here (syscall.set_console) and the spawn
// handler (syscall.set_spawn_handler). Each running process is bound to a
// console slot that names the TextArea its stdout goes to and holds a small
// stdin queue the terminal fills one line at a time. Output written from a
// syscall lands in the DOM directly (append_bytes reads the user buffer
// through the process's own page tables, which are active during the
// syscall); the compositor repaints it on its next pass.

i32 SLOTS = 8;
i32 STDIN_CAP = 256;

i32 g_pid[8];        // 0 = free slot
i32 g_output[8];     // TextArea node id receiving stdout
i32 g_stdin[8];      // heap ring buffer of STDIN_CAP bytes
i32 g_in_head[8];
i32 g_in_tail[8];

i32 g_ready = 0;

/**
 * Looks up the console slot index for a given process ID.
 * @param pid Process ID to search for.
 * @return Option containing the slot index if found, or None.
 */
Option<i32> slot_of(i32 pid) {
    if (pid <= 0) { return None; }
    i32 i = 0;
    while (i < SLOTS) {
        if (g_pid[i] == pid) { return Some(i); }
        i++;
    }
    return None;
}

/**
 * Attaches a process's stdio to a DOM TextArea node.
 * @param pid Target process ID.
 * @param output_id DOM node ID of the TextArea for stdout.
 * @return 1 on success, 0 if all console slots are in use.
 */
export i32 bind(i32 pid, i32 output_id) {
    i32 i = 0;
    while (i < SLOTS) {
        if (g_pid[i] == 0) {
            g_pid[i] = pid;
            g_output[i] = output_id;
            if (g_stdin[i] == 0) { g_stdin[i] = heap.alloc(STDIN_CAP); }
            g_in_head[i] = 0;
            g_in_tail[i] = 0;
            return 1;
        }
        i++;
    }
    return 0;
}

/**
 * Releases a process's console slot binding.
 * @param pid Process ID to detach.
 */
export void unbind(i32 pid) {
    case slot_of(pid) of {
        Some(i) -> ({
            g_pid[i] = 0;
            g_output[i] = 0;
        });
        None -> _;
    };
}

/**
 * Looks up the TextArea DOM node ID associated with a process's stdout.
 * @param pid Process ID.
 * @return DOM node ID, or 0 if unattached.
 */
export i32 output_of(i32 pid) {
    return case slot_of(pid) of {
        Some(i) -> g_output[i];
        None -> 0;
    };
}

/**
 * Queues one line of text into the process's stdin buffer.
 * @param pid Target process ID.
 * @param line Pointer to null-terminated string to feed as input.
 */
export void feed_line(i32 pid, char *line) {
    i32 i = case slot_of(pid) of {
        Some(v) -> v;
        None -> ({ return; });
    };
    i32 base = g_stdin[i];
    i32 k = 0;
    while (1) {
        i32 c = 10;
        if (line[k] != 0) { c = (i32)line[k] & 0xFF; }
        i32 next = (g_in_tail[i] + 1) % STDIN_CAP;
        if (next == g_in_head[i]) { return; } // full
        mem.write_byte(base + g_in_tail[i], c);
        g_in_tail[i] = next;
        if (line[k] == 0) { return; }
        k++;
    }
}

// --- syscall handlers (run in the calling process's context) ---

/**
 * Syscall handler for SYS_WRITE: writes output bytes to the process's bound console TextArea or serial log.
 * @param pid Calling process ID.
 * @param buf Virtual memory address of output buffer.
 * @param count Number of bytes to write.
 * @return Number of bytes written.
 */
i32 on_write(i32 pid, i32 buf, i32 count) {
    i32 out = output_of(pid);
    if (out == 0) {
        // No console: fall back to the serial log so nothing is lost.
        i32 k = 0;
        while (k < count) {
            i32 c = mem.read_byte(buf + k);
            serial.putc(c);
            k++;
        }
        return count;
    }
    dom_widgets.append_bytes(out, buf, count);
    return count;
}

/**
 * Syscall handler for SYS_READ: reads input bytes from the process's stdin ring buffer.
 * @param pid Calling process ID.
 * @param buf Destination buffer memory address.
 * @param count Maximum number of bytes to read.
 * @return Number of bytes read.
 */
i32 on_read(i32 pid, i32 buf, i32 count) {
    i32 i = case slot_of(pid) of {
        Some(v) -> v;
        None -> ({ return 0; });
    };
    i32 base = g_stdin[i];
    i32 got = 0;
    while (got < count) {
        if (g_in_head[i] == g_in_tail[i]) { break; }
        i32 c = mem.read_byte(base + g_in_head[i]);
        g_in_head[i] = (g_in_head[i] + 1) % STDIN_CAP;
        mem.write_byte(buf + got, c);
        got++;
    }
    return got;
}

/**
 * Loads an executable file from the filesystem and starts it as a new process.
 * @param path Pointer to null-terminated file path.
 * @return PID of spawned process on success, or 0 on failure.
 */
export i32 spawn_file(char *path) {
    i32 fd = case fs.open(path) of {
        Ok(v) -> v;
        Err(e) -> ({ return 0; });
    };
    i32 size = case fs.seek(fd, 0, 2) of {
        Ok(v) -> v;
        Err(e) -> ({ fs.close(fd); return 0; });
    };
    if (size <= 0) { fs.close(fd); return 0; }
    case fs.seek(fd, 0, 0) of { Ok(_) -> _; Err(_) -> _; };
    i32 buf = heap.alloc(size);
    if (buf == 0) { fs.close(fd); return 0; }
    i32 got = case fs.read(fd, buf, size) of {
        Ok(v) -> v;
        Err(e) -> 0;
    };
    fs.close(fd);
    if (got != size) {
        heap.free(buf);
        return 0;
    }
    i32 pid = case loader.spawn_from_buffer(buf, size) of {
        Ok(p) -> p;
        Err(e) -> ({ debug.println("console: loader rejected the image"); 0; });
    };
    heap.free(buf); // the loader copied the segments into fresh frames
    return pid;
}

/**
 * Syscall handler for SYS_SPAWN: spawns a process from a user-space path and binds it to the parent console.
 * @param user_path Virtual memory address of null-terminated path string in user space.
 * @return Spawned process ID on success, or negative error code.
 */
i32 on_spawn(i32 user_path) {
    char path[32];
    i32 k = 0;
    while (k < 31) {
        i32 c = mem.read_byte(user_path + k);
        path[k] = (char)c;
        if (c == 0) { break; }
        k++;
    }
    path[31] = (char)0;
    i32 parent = case process.get_current_pid() of {
        Some(v) -> v;
        None -> 0;
    };
    i32 pid = spawn_file(&path[0]);
    if (pid > 0) {
        i32 out = output_of(parent);
        if (out != 0) { bind(pid, out); }
    }
    return pid;
}

/**
 * Checks whether a process has terminated.
 * @param pid Process ID.
 * @return True if process has exited (or does not exist), false if still running.
 */
export bool has_exited(i32 pid) {
    Option<ProcessState> state = process.get_state(pid);
    return case state of {
        Some(s) -> case s of { Zombie(_) -> true; _ -> false; };
        None -> true;
    };
}

/**
 * Reaps an exited Zombie process, retrieves its exit code, and frees its slot.
 * @param pid Process ID.
 * @return Process exit code.
 */
export i32 reap(i32 pid) {
    i32 code = case process.get_exit_code(pid) of {
        Some(v) -> v;
        None -> 0;
    };
    case process.free_proc(pid) of { Ok(_) -> _; Err(_) -> _; };
    unbind(pid);
    return code;
}

/**
 * Initializes console subsystem and registers console and spawn hooks with the kernel.
 */
export void init() {
    if (g_ready != 0) { return; }
    i32 i = 0;
    while (i < SLOTS) {
        g_pid[i] = 0;
        g_output[i] = 0;
        g_stdin[i] = 0;
        i++;
    }
    syscall.set_console(on_write, on_read);
    syscall.set_spawn_handler(on_spawn);
    g_ready = 1;
}
