package os_calls;

// The OS_CALL handler (MyKernel syscall.mln, set_os_handler): every service
// an application process reaches beyond the kernel's own syscalls --
// the UI protocol, the filesystem, process control -- arrives here as
// (pid, service, args) with `args` a user address, and is answered by
// calling the OS's own modules. The service numbers are the SDK's
// (system/MyAppFramework/src/os_services.mln); what each takes is
// documented at the SDK stub that sends it.
//
// This runs in the calling process's context (its page tables are active),
// so user memory is read and written through mem.read_*/write_* here and
// only here: everything that leaves this file is a kernel copy. The UI
// server's task, which answers UI requests later, never sees a user
// address.
//
// UI requests: the message is copied in, its strings into per-process
// buffers, and queued for the UI server with the process's own reply
// channel; UI_REPLY polls that channel and, for a request that writes text
// back (TEXT_COPY, LIST_ITEM), copies the kernel-side buffer into the
// user's. Events come from the process's event channel, their string
// payload copied into the buffer the app names.

import mem from "../../../MyKernel/src/mm/mem.mln";
import ipc from "../../../MyKernel/src/kernel/ipc.mln";
import syscall from "../../../MyKernel/src/kernel/syscall.mln";
import kernel_config from "../../../MyKernel/src/kernel/kernel_config.mln";
import debug from "../../../MyKernel/src/debug/debug.mln";
import str from "../../../../toolchain/MyStdLib/str.mln";
import heap from "../../../MyKernel/src/mm/heap.mln";
import { Result, result_take_ok, result_take_err } from "../../../../toolchain/MyStdLib/result.mln";
import { Option } from "../../../../toolchain/MyStdLib/option.mln";
import fs from "../fs/fs.mln";
import { FsError } from "../fs/fs.mln";
import console from "console.mln";
import ui_channel from "../ui/ui_channel.mln";
import ui_events from "../ui/ui_events.mln";
import { OsService } from "../../../MyAppFramework/src/os_services.mln";
import os_services from "../../../MyAppFramework/src/os_services.mln";
import { UiOp } from "../../../MyAppFramework/src/protocol.mln";

// --- per-process UI state ------------------------------------------------------------------

i32 PROCS = 16;              // kernel_config.MAX_PROCS
i32 S0_CAP = 1024;           // a request's first string (list items are the longest)
i32 S1_CAP = 128;
i32 OUT_CAP = 4096;          // a text the server copies back (an editor's whole buffer)

i32 g_reply_ch[16];          // 0 until the process's first UI call
i32 g_event_ch[16];
i32 g_s0[16];                // char*: heap buffers, allocated on first use
i32 g_s1[16];
i32 g_out[16];
i32 g_out_user[16];          // where the pending request's text result goes, or 0
i32 g_out_cap[16];

i32 slot(i32 pid) {
    if (pid <= 0 || pid > PROCS) { return -1; }
    return pid - 1;
}

// Set up the channels and buffers on a process's first UI call.
i32 ui_ready(i32 pid) {
    i32 i = slot(pid);
    if (i < 0) { return 0; }
    if (g_reply_ch[i] == 0) {
        g_reply_ch[i] = ipc.create();
        g_event_ch[i] = ipc.create();
        g_s0[i] = alloc_or_panic(S0_CAP);
        g_s1[i] = alloc_or_panic(S1_CAP);
        g_out[i] = alloc_or_panic(OUT_CAP);
        ui_events.bind(pid, g_event_ch[i]);
    }
    return 1;
}

i32 alloc_or_panic(i32 n) {
    i32 p = heap.alloc(n);
    if (p == 0) { debug.panic("os_calls: out of memory"); }
    return p;
}

// Copy a NUL-terminated user string into `dst` (cap bytes); "" for 0.
void copy_in_string(i32 user, char *dst, i32 cap) {
    i32 k = 0;
    if (user != 0) {
        while (k + 1 < cap) {
            i32 c = mem.read_byte(user + k);
            if (c == 0) { break; }
            dst[k] = (char)c;
            k++;
        }
    }
    dst[k] = (char)0;
}

// Copy `n` bytes from kernel `src` to user `user`.
void copy_out(i32 user, char *src, i32 n) {
    i32 k = 0;
    while (k < n) {
        mem.write_byte(user + k, src[k] & 0xFF);
        k++;
    }
}

// --- UI protocol -----------------------------------------------------------------------------

i32 svc_ui_request(i32 pid, i32 user_msg) {
    if (ui_ready(pid) == 0) { return -1; }
    i32 i = slot(pid);
    // UiMsg: op, owner, a0..a5, s0, s1 -- 10 words in the app's memory.
    i32 w[16];
    i32 k = 0;
    while (k < 10) { w[k] = mem.read_word(user_msg + k * 4); k++; }
    w[1] = pid;                          // the owner is the process, whatever it wrote
    char *s0 = (char*)g_s0[i];
    char *s1 = (char*)g_s1[i];
    copy_in_string(w[8], s0, S0_CAP);
    copy_in_string(w[9], s1, S1_CAP);
    w[8] = (i32)s0;
    w[9] = (i32)s1;
    // A request that writes text back: point the server at a kernel
    // buffer and remember where the app wants it.
    g_out_user[i] = 0;
    i32 op = w[0];
    if (op == UiOp::TEXT_COPY) {
        g_out_user[i] = w[3];  // a1 = out
        g_out_cap[i] = w[4];   // a2 = cap
        if (g_out_cap[i] > OUT_CAP) { g_out_cap[i] = OUT_CAP; }
        w[3] = g_out[i];
        w[4] = g_out_cap[i];
    } else if (op == UiOp::LIST_ITEM) {
        g_out_user[i] = w[4];  // a2 = out
        g_out_cap[i] = w[5];   // a3 = cap
        if (g_out_cap[i] > OUT_CAP) { g_out_cap[i] = OUT_CAP; }
        w[4] = g_out[i];
        w[5] = g_out_cap[i];
    }
    w[10] = g_reply_ch[i];               // where the server answers
    if (!ui_channel.submit(&w[0])) { return -1; }
    return 0;
}

i32 svc_ui_reply(i32 pid, i32 user_out) {
    i32 i = slot(pid);
    if (i < 0) { return 0; }
    if (g_reply_ch[i] == 0) { return 0; }
    i32 r[16];
    if (!ipc.recv(g_reply_ch[i], &r[0])) { return 0; }
    if (g_out_user[i] != 0) {
        // The text the server wrote into our buffer, NUL included.
        i32 n = str.len((char*)g_out[i]) + 1;
        if (n > g_out_cap[i]) { n = g_out_cap[i]; }
        copy_out(g_out_user[i], (char*)g_out[i], n);
        g_out_user[i] = 0;
    }
    mem.write_word(user_out, r[0]);
    return 1;
}

i32 svc_ui_poll(i32 pid, i32 user_args) {
    if (ui_ready(pid) == 0) { return 0; }
    i32 i = slot(pid);
    i32 w[16];
    if (!ipc.recv(g_event_ch[i], &w[0])) { return 0; }
    i32 user_ev = mem.read_word(user_args);
    i32 user_text = mem.read_word(user_args + 4);
    // UiEvent: owner, id, kind, arg, token, text.
    mem.write_word(user_ev, w[0]);
    mem.write_word(user_ev + 4, w[1]);
    mem.write_word(user_ev + 8, w[2]);
    mem.write_word(user_ev + 12, w[3]);
    mem.write_word(user_ev + 16, w[4]);
    char *text = (char*)w[5];
    if (text != 0) {
        i32 n = str.len(text) + 1;
        if (n > 64) { n = 64; }
        copy_out(user_text, text, n);
        mem.write_byte(user_text + 63, 0);
    } else {
        mem.write_byte(user_text, 0);
    }
    mem.write_word(user_ev + 20, user_text);
    return 1;
}

// The process is gone: its channels stay allocated (the pid may return),
// but nothing pending should reach the next process with that pid.
export void process_gone(i32 pid) {
    i32 i = slot(pid);
    if (i < 0) { return; }
    i32 w[16];
    if (g_reply_ch[i] != 0) { while (ipc.recv(g_reply_ch[i], &w[0])) { } }
    if (g_event_ch[i] != 0) { while (ipc.recv(g_event_ch[i], &w[0])) { } }
    g_out_user[i] = 0;
}

// --- filesystem --------------------------------------------------------------------------------

char g_path[64];

i32 fs_code(FsError e) {
    return case e of {
        NotFound -> 0 - os_services.ERR_NOT_FOUND;
        NoFreeSlot -> 0 - os_services.ERR_NO_SLOT;
        IoError -> 0 - os_services.ERR_IO;
        AlreadyExists -> 0 - os_services.ERR_EXISTS;
        InvalidName -> 0 - os_services.ERR_INVALID;
        _ -> 0 - os_services.ERR_BAD_FD;
    };
}

i32 fs_result(Result<i32, FsError> *r) {
    i32 v = 0;
    if (result_take_ok<i32, FsError>(r, &v) != 0) { return v; }
    FsError e;
    result_take_err<i32, FsError>(r, &e);
    return fs_code(e);
}

i32 svc_fs_open(i32 user_path) {
    copy_in_string(user_path, &g_path[0], 64);
    Result<i32, FsError> r = fs.open(&g_path[0]);
    return fs_result(&r);
}

i32 svc_fs_create(i32 user_path) {
    copy_in_string(user_path, &g_path[0], 64);
    Result<i32, FsError> r = fs.create(&g_path[0]);
    return fs_result(&r);
}

i32 svc_fs_remove(i32 user_path) {
    copy_in_string(user_path, &g_path[0], 64);
    Result<_, FsError> r = fs.remove(&g_path[0]);
    i32 code = 0;
    case r of {
        Ok(_) -> 0;
        Err(e) -> ({ code = fs_code(e); });
    };
    return code;
}

// Read into the user's buffer through a kernel one, a chunk at a time.
char g_io[512];

i32 svc_fs_read(i32 user_args) {
    i32 fd = mem.read_word(user_args);
    i32 user_buf = mem.read_word(user_args + 4);
    i32 size = mem.read_word(user_args + 8);
    i32 total = 0;
    while (total < size) {
        i32 want = size - total;
        if (want > 512) { want = 512; }
        Result<i32, FsError> r = fs.read(fd, (i32)(&g_io[0]), want);
        i32 got = fs_result(&r);
        if (got < 0) { if (total == 0) { return got; } break; }
        if (got == 0) { break; }
        copy_out(user_buf + total, &g_io[0], got);
        total = total + got;
        if (got < want) { break; }
    }
    return total;
}

i32 svc_fs_write(i32 user_args) {
    i32 fd = mem.read_word(user_args);
    i32 user_buf = mem.read_word(user_args + 4);
    i32 size = mem.read_word(user_args + 8);
    i32 total = 0;
    while (total < size) {
        i32 n = size - total;
        if (n > 512) { n = 512; }
        i32 k = 0;
        while (k < n) { g_io[k] = (char)mem.read_byte(user_buf + total + k); k++; }
        Result<i32, FsError> r = fs.write(fd, (i32)(&g_io[0]), n);
        i32 put = fs_result(&r);
        if (put < 0) { if (total == 0) { return put; } break; }
        total = total + put;
        if (put < n) { break; }
    }
    return total;
}

i32 svc_fs_seek(i32 user_args) {
    i32 fd = mem.read_word(user_args);
    i32 offset = mem.read_word(user_args + 4);
    i32 whence = mem.read_word(user_args + 8);
    Result<i32, FsError> r = fs.seek(fd, offset, whence);
    return fs_result(&r);
}

i32 svc_fs_close(i32 user_args) {
    fs.close(mem.read_word(user_args));
    return 0;
}

char g_name[16];


i32 svc_fs_entry_size(i32 user_args) {
    return fs.entry_size(mem.read_word(user_args));
}

i32 svc_fs_mkdir(i32 user_path) {
    copy_in_string(user_path, &g_path[0], 64);
    Result<i32, FsError> r = fs.mkdir(&g_path[0]);
    return fs_result(&r);
}

i32 svc_fs_dir_next_at(i32 user_args) {
    copy_in_string(mem.read_word(user_args), &g_path[0], 64);
    i32 start = mem.read_word(user_args + 4);
    i32 user_out = mem.read_word(user_args + 8);
    i32 cap = mem.read_word(user_args + 12);
    if (cap > 16) { cap = 16; }
    Result<Option<i32>, FsError> res = fs.dir_next_at(&g_path[0], start, &g_name[0], 16);
    i32 idx = -1;
    i32 code = 0;
    case res of {
        Ok(v) -> ({ idx = case v of { Some(n) -> n; None -> -1; }; });
        Err(e) -> ({ code = fs_code(e); });
    };
    if (code != 0) { return code; }
    if (idx < 0) { return -1; }
    i32 n = str.len(&g_name[0]) + 1;
    if (n > cap) { n = cap; }
    copy_out(user_out, &g_name[0], n);
    mem.write_byte(user_out + cap - 1, 0);
    return idx;
}

i32 svc_fs_is_dir(i32 user_args) {
    if (fs.is_dir(mem.read_word(user_args))) { return 1; }
    return 0;
}

// --- processes -----------------------------------------------------------------------------------

char g_line[128];

i32 svc_proc_spawn(i32 user_args) {
    copy_in_string(mem.read_word(user_args), &g_path[0], 64);
    i32 node = mem.read_word(user_args + 4);
    i32 pid = console.spawn_file(&g_path[0]);
    if (pid > 0 && node != 0) { console.bind(pid, node); }
    return pid;
}

i32 svc_proc_bind(i32 user_args) {
    console.bind(mem.read_word(user_args), mem.read_word(user_args + 4));
    return 0;
}

i32 svc_proc_unbind(i32 user_args) {
    console.unbind(mem.read_word(user_args));
    return 0;
}

i32 svc_proc_exited(i32 user_args) {
    if (console.has_exited(mem.read_word(user_args))) { return 1; }
    return 0;
}

i32 svc_proc_reap(i32 user_args) {
    return console.reap(mem.read_word(user_args));
}

i32 svc_proc_feed(i32 user_args) {
    i32 pid = mem.read_word(user_args);
    copy_in_string(mem.read_word(user_args + 4), &g_line[0], 128);
    console.feed_line(pid, &g_line[0]);
    return 0;
}

// --- dispatch ------------------------------------------------------------------------------------

i32 handle(i32 pid, i32 service, i32 args) {
    if (service == OsService::UI_REQUEST)    { return svc_ui_request(pid, args); }
    if (service == OsService::UI_REPLY)      { return svc_ui_reply(pid, args); }
    if (service == OsService::UI_POLL)       { return svc_ui_poll(pid, args); }
    if (service == OsService::FS_OPEN)       { return svc_fs_open(args); }
    if (service == OsService::FS_CREATE)     { return svc_fs_create(args); }
    if (service == OsService::FS_READ)       { return svc_fs_read(args); }
    if (service == OsService::FS_WRITE)      { return svc_fs_write(args); }
    if (service == OsService::FS_SEEK)       { return svc_fs_seek(args); }
    if (service == OsService::FS_CLOSE)      { return svc_fs_close(args); }
    if (service == OsService::FS_REMOVE)     { return svc_fs_remove(args); }
    if (service == OsService::FS_ENTRY_SIZE) { return svc_fs_entry_size(args); }
    if (service == OsService::FS_MKDIR)      { return svc_fs_mkdir(args); }
    if (service == OsService::FS_DIR_NEXT_AT) { return svc_fs_dir_next_at(args); }
    if (service == OsService::FS_IS_DIR)     { return svc_fs_is_dir(args); }
    if (service == OsService::PROC_SPAWN)    { return svc_proc_spawn(args); }
    if (service == OsService::PROC_BIND)     { return svc_proc_bind(args); }
    if (service == OsService::PROC_UNBIND)   { return svc_proc_unbind(args); }
    if (service == OsService::PROC_EXITED)   { return svc_proc_exited(args); }
    if (service == OsService::PROC_REAP)     { return svc_proc_reap(args); }
    if (service == OsService::PROC_FEED)     { return svc_proc_feed(args); }
    if (service == OsService::LOG) {
        copy_in_string(args, &g_line[0], 128);
        debug.printf("[pid %d] %s\n", pid, (i32)(&g_line[0]));
        return 0;
    }
    return -1;
}

export void init() {
    syscall.set_os_handler(handle);
}
