package console;

import serial from "@kernel/io/serial.mln";
import heap from "@kernel/mm/heap.mln";
import { HeapBlock } from "@kernel/mm/heap.mln";
import syscall from "@kernel/kernel/syscall.mln";
import user_memory from "@os/syscall/user_memory.mln";
import { UserAddress } from "@std/core/address.mln";
import debug from "@kernel/debug/debug.mln";
import loader from "@kernel/kernel/loader.mln";
import irq from "@kernel/arch/irq.mln";
import kernel_config from "@kernel/kernel/kernel_config.mln";
import process from "@kernel/kernel/process.mln";
import scheduler from "@kernel/kernel/scheduler.mln";
import thread from "@kernel/kernel/thread.mln";
import { ProcessState } from "@kernel/kernel/process.mln";
import { LoaderError } from "@contracts/process/loader.contract.mln";
import { Result } from "@std/core/result.mln";
import { Option } from "@std/core/option.mln";
import { SpawnError, SpawnFsOperation, SpawnFilesystemError, SpawnReadMismatch } from "@contracts/process/spawn.contract.mln";
import { Pid, ProcessControlError, ProcessExitStatus } from "@contracts/process/control.contract.mln";
import { ProcessSignal } from "@contracts/myos/syscall.contract.mln";
import { FsError, SeekWhence } from "@contracts/io/fs.contract.mln";
import fs from "@os/fs/fs.mln";
import { FileHandle } from "@os/fs/fs.mln";
import str from "@std/text/str.mln";
import { Text } from "@std/text/text.mln";
import consoles from "consoles.mln";
import proc_stats from "stats.mln";
import { Console, ConsoleRow } from "consoles.mln";
import dom_text_edit from "@os/ui/dom/dom_text_edit.mln";
import dom_terminal from "@os/ui/dom/dom_terminal.mln";
import dom from "@os/ui/dom/dom.mln";
import { NodeKind } from "@os/ui/dom/dom.mln";
import { NodeId } from "@contracts/ui/widget.contract.mln";

// Process consoles (MYOS-015): the glue between user-space processes and
// terminal windows.
//
// The kernel's syscall layer does not know about the desktop; it calls the
// write/read handlers registered here (syscall.set_console) and the spawn
// handler (syscall.set_spawn_handler). Each running process is bound to a
// row of consoles.model.mln, which names the Terminal (or TextArea) its stdout
// goes to and holds a small stdin queue. Output written from a syscall lands
// in the DOM directly (it is read from the user buffer through the process's
// own page tables, which are active during the syscall); the compositor
// repaints it on its next pass.
//
// A child starts on its parent's terminal. A line typed there goes to the
// process attached to it last: the program a shell started, until it ends,
// and then the shell again. Every process still reads only its own queue.
//
// This is also where a process ends. A process controls only its children, and
// a child can be reaped only once the OS holds nothing under its pid, so the
// next process in its slot starts clean. sweep(), on the server task, does that release;
// see below for why it cannot happen inside a parent's reap syscall.

i32 STDIN_CAP = 256;

// Counts attachments, so the latest process on a terminal is the greatest.
i32 g_attached = 0;

/**
 * The exit status of a child ended because its parent did. Nobody reads it, as
 * the OS reaps such a child; it is 128 plus SIGHUP's number, to read as a hangup.
 */
i32 HANGUP_CODE = 129;

// What the layers above hold for a process. The router installs this: those
// layers import this one, so it cannot name them.
void no_process_gone_sink(Pid pid) { }

fn(Pid pid) -> void process_gone_sink = no_process_gone_sink;

/**
 * Installs the callback that releases what the layers above hold for a process.
 * @param sink Called once per process, on the server task, with its slot still held.
 */
export void set_process_gone_sink(fn(Pid pid) -> void sink) { process_gone_sink = sink; }

/**
 * Checks that `pid` is a child of `caller`, the rule for every control operation.
 * @param caller Process asking.
 * @param pid Process it wants to act on.
 * @return Ok(_), or Err(InvalidPid) when no such child exists.
 */
Result<_, ProcessControlError> check_child(Pid caller, Pid pid) {
    if (!process.is_child_of(pid, Some(caller))) {
        return Err(ProcessControlError::InvalidPid(pid));
    }
    return Ok(_);
}

/**
 * Attaches a process's stdio to a DOM TextArea node, replacing any earlier one.
 * With the console table full the process keeps writing to the serial log.
 * @param pid Target process ID.
 * @param output_id DOM node ID of the Terminal or TextArea for stdout.
 */
void attach(Pid pid, i32 output_id) {
    g_attached++;
    case consoles.console_by_pid(pid) of {
        Some(bound) -> ({
            bound.row().output = output_id;
            bound.row().since = g_attached;
            return;
        });
        None -> _;
    };
    Console made = case consoles.new_console() of {
        Some(value) -> value;
        None -> ({ return; });
    };
    made.set_pid(pid);
    made.row().output = output_id;
    made.row().since = g_attached;
}

/**
 * Removes a process's console row, if it has one.
 * @param pid Process ID to detach.
 */
void detach(Pid pid) {
    case consoles.console_by_pid(pid) of {
        Some(bound) -> ({ bound.delete(); });
        None -> _;
    };
}

/**
 * Attaches a child's stdio to a TextArea. A child that has ended has no stdio
 * left to route, and a row made for it now would outlive its release.
 * @param caller Calling process, which must be the parent.
 * @param pid Child process ID.
 * @param output_id DOM node ID of the TextArea for stdout.
 * @return Ok(_), or Err(InvalidPid) when no such child exists.
 */
export Result<_, ProcessControlError> bind(Pid caller, Pid pid, i32 output_id) {
    check_child(caller, pid)?;
    if (process.accepts_threads(pid)) { attach(pid, output_id); }
    return Ok(_);
}

/**
 * Releases a child's console binding.
 * @param caller Calling process, which must be the parent.
 * @param pid Child process ID.
 * @return Ok(_), or Err(InvalidPid) when no such child exists.
 */
export Result<_, ProcessControlError> unbind(Pid caller, Pid pid) {
    check_child(caller, pid)?;
    detach(pid);
    return Ok(_);
}

/**
 * Looks up the TextArea DOM node ID associated with a process's stdout.
 * @param pid Process ID.
 * @return `Some(node_id)` when attached, or `None` when unattached.
 */
export Option<i32> output_of(Pid pid) {
    Option<i32> output = None;
    case consoles.console_by_pid(pid) of {
        Some(bound) -> ({ output = Some(bound.row().output); });
        None -> _;
    };
    return output;
}

/**
 * Queues one line of text into a child's stdin buffer. A child with no console,
 * or a full queue, drops the line.
 * @param caller Calling process, which must be the parent.
 * @param pid Child process ID.
 * @param line Text to feed as input; a newline follows it.
 * @return Ok(_), or Err(InvalidPid) when no such child exists.
 */
export Result<_, ProcessControlError> feed_line(Pid caller, Pid pid, str line) {
    check_child(caller, pid)?;
    case consoles.console_by_pid(pid) of {
        Some(bound) -> ({
            queue(bound, line);
            queue(bound, "\n");
        });
        None -> _;
    };
    return Ok(_);
}

// Adds bytes to a process's stdin queue, and wakes it if it waits to read.
// What does not fit is dropped.
void queue(Console bound, str bytes) {
    borrow ConsoleRow row = bound.row();
    i32 k = 0;
    while (k < bytes.length) {
        i32 next = (row.in_tail + 1) % STDIN_CAP;
        if (next == row.in_head) { break; }
        row.stdin[row.in_tail] = (u8)bytes.byte(k);
        row.in_tail = next;
        k++;
    }
    scheduler.notify_pid(bound.pid(), ProcessSignal::STDIN);
}

/**
 * A line typed in a Terminal: the input of the living process attached to it
 * last. One that has ended but is not yet released is passed over, so a line
 * typed just after a program ends goes to the shell. Nobody attached, it goes
 * nowhere. Runs on the server task.
 * @param terminal The Terminal it was typed in.
 * @param line The line, its newline included.
 */
void take_line(NodeId terminal, str line) {
    // Syscalls read these queues, and this task can be preempted.
    bool was_enabled = irq.save_disable();
    defer irq.restore(was_enabled);
    Option<Console> latest = None;
    i32 since = 0;
    for (Console each in consoles.console_all()) {
        borrow ConsoleRow row = each.row();
        if (row.output == (i32)terminal && row.since > since && process.accepts_threads(each.pid())) {
            latest = Some(each);
            since = row.since;
        }
    }
    case latest of {
        Some(found) -> queue(found, line);
        None -> _;
    };
}

// --- syscall handlers (run in the calling process's context) ---

/**
 * Syscall handler for SYS_WRITE: writes output bytes to the process's bound console TextArea or serial log.
 * @param pid Calling process ID.
 * @param buf Virtual memory address of output buffer.
 * @param count Number of bytes to write.
 * @return Number of bytes written.
 */
i32 on_write(Pid pid, UserAddress buf, i32 count) {
    Option<i32> output = output_of(pid);
    i32 out = 0;
    bool has_output = false;
    case output of {
        Some(node) -> ({ out = node; has_output = true; });
        None -> _;
    };
    if (!has_output) {
        // No console: fall back to the serial log so nothing is lost.
        i32 k = 0;
        while (k < count) {
            i32 c = user_memory.read_byte(buf.plus(k));
            serial.putc(c);
            k++;
        }
        return count;
    }
    bool terminal = case dom.kind_of(NodeId(out)) of { Some(kind) -> kind == NodeKind::TERMINAL; None -> false; };
    if (terminal) { dom_terminal.write(NodeId(out), user_memory.view(buf, count)); }
    else { dom_text_edit.append_bytes(NodeId(out), user_memory.view(buf, count)); }
    return count;
}

/**
 * Syscall handler for SYS_READ: reads input bytes from the process's stdin ring buffer.
 * @param pid Calling process ID.
 * @param buf Destination buffer memory address.
 * @param count Maximum number of bytes to read.
 * @return Number of bytes read.
 */
i32 on_read(Pid pid, UserAddress buf, i32 count) {
    Console bound = case consoles.console_by_pid(pid) of {
        Some(v) -> v;
        None -> ({
            scheduler.arm_notification(ProcessSignal::STDIN);
            return 0;
        });
    };
    borrow ConsoleRow row = bound.row();
    i32 got = 0;
    while (got < count) {
        if (row.in_head == row.in_tail) { break; }
        i32 c = row.stdin[row.in_head];
        row.in_head = (row.in_head + 1) % STDIN_CAP;
        user_memory.write_byte(buf.plus(got), c);
        got++;
    }
    // Nothing yet: the next line wakes a reader that waits for STDIN, even one
    // that queued after this answer and before the wait.
    if (got == 0) { scheduler.arm_notification(ProcessSignal::STDIN); }
    else { scheduler.disarm_notification(ProcessSignal::STDIN); }
    return got;
}

Text<80> spawn_path;

// The file for an executable name: a path as given, or a bare name looked
// up in /bin then /apps (the search path).
Result<Option<i32>, SpawnError> try_open(str path) {
    Result<i32, FsError> opened = fs.open(path);
    return case opened of {
        Ok(fd) -> Ok(Some(fd));
        Err(FsError::NotFound) -> Ok(None);
        Err(e) -> Err(SpawnError::Filesystem(SpawnFilesystemError {
            operation: SpawnFsOperation::Open,
            cause: e,
        }));
    };
}

Result<i32, SpawnError> open_executable(str path) {
    bool has_slash = case path.find("/") of { Some(_) -> true; None -> false; };
    if (!has_slash) {
        spawn_path.clear();
        spawn_path.append("bin/");
        spawn_path.append(path);
        Option<i32> bin = try_open(spawn_path.as_str())?;
        case bin of { Some(fd) -> ({ return Ok(fd); }); None -> _; };
        spawn_path.clear();
        spawn_path.append("apps/");
        spawn_path.append(path);
        Option<i32> apps = try_open(spawn_path.as_str())?;
        case apps of { Some(fd) -> ({ return Ok(fd); }); None -> _; };
    }
    Option<i32> direct = try_open(path)?;
    case direct of { Some(fd) -> ({ return Ok(fd); }); None -> _; };
    return Err(SpawnError::NotFound);
}

SpawnError filesystem_failure(SpawnFsOperation operation, FsError cause) {
    return SpawnError::Filesystem(SpawnFilesystemError {
        operation: operation,
        cause: cause,
    });
}

/**
 * Opens an executable image, loads it as a user process, and releases the image buffer.
 * @param parent Process that will own the new one; None for the OS itself.
 * @param path Path searched as supplied, under bin/, and under apps/.
 * @return Ok(pid) when the process starts, or Err(SpawnError) with the launch failure.
 */
@safe
export Result<Pid, SpawnError> spawn_file(Option<Pid> parent, str path) {
    // The file is closed and the image buffer freed on every path out.
    FileHandle file = FileHandle { fd: open_executable(path)? };
    i32 size = case fs.seek(file.fd, 0, SeekWhence::End) of {
        Ok(v) -> v;
        Err(e) -> ({ return Err(filesystem_failure(SpawnFsOperation::Measure, e)); });
    };
    if (size <= 0) { return Err(SpawnError::EmptyExecutable); }
    case fs.seek(file.fd, 0, SeekWhence::Set) of {
        Ok(_) -> _;
        Err(e) -> ({ return Err(filesystem_failure(SpawnFsOperation::Rewind, e)); });
    };
    i32 buf = case heap.alloc(size) of {
        Ok(v) -> v;
        Err(_) -> ({ return Err(SpawnError::BufferAllocationFailed(size)); });
    };
    HeapBlock image = HeapBlock { addr: buf }; // the loader copies the segments out
    i32 got = case fs.read(file.fd, image.addr, size) of {
        Ok(v) -> v;
        Err(e) -> ({ return Err(filesystem_failure(SpawnFsOperation::Read, e)); });
    };
    if (got != size) {
        return Err(SpawnError::ShortRead(SpawnReadMismatch {
            expected: size,
            actual: got,
        }));
    }
    // A loader failure becomes SpawnError::Loader through the contract's From.
    Pid pid = loader.spawn_from_buffer(parent, image.addr, size)?;
    proc_stats.name_process(pid, path);
    return Ok(pid);
}

/**
 * SYS_SPAWN hook: launches the program and binds a successful child to the parent's console.
 * @param user_path Address of a null-terminated path string in user space.
 * @return The new process ID.
 */
Result<Pid, SpawnError> on_spawn(UserAddress user_path) {
    Pid parent = case thread.current_pid() of {
        Some(value) -> value;
        None -> ({ debug.panic("SYS_SPAWN hook called without a current process"); });
    };
    Text<32> path = Text<32> {};
    path.clear();
    i32 k = 0;
    while (k < path.capacity()) {
        i32 c = user_memory.read_byte(user_path.plus(k));
        if (c == 0) { break; }
        path.push((u8)c);
        k++;
    }
    Result<Pid, SpawnError> result = spawn_file(Some(parent), path.as_str());
    case result of {
        Ok(pid) -> ({
            Option<i32> output = output_of(parent);
            case output of {
                Some(node) -> ({ attach(pid, node); });
                None -> _;
            };
        });
        Err(_) -> _;
    };
    return result;
}

/**
 * Checks whether a child can be reaped: true once it has ended and the OS holds
 * nothing under its pid, which is a sweep() after it became a Zombie.
 * @param caller Calling process, which must be the parent.
 * @param pid Child process ID.
 * @return Ok(true) if reapable, Ok(false) if not yet, or Err(InvalidPid).
 */
export Result<bool, ProcessControlError> has_exited(Pid caller, Pid pid) {
    check_child(caller, pid)?;
    bool released = case process.get_state(pid) of {
        Some(state) -> case state of { ProcessState::Released(_) -> true; _ -> false; };
        None -> ({ return Err(ProcessControlError::InvalidPid(pid)); });
    };
    // Not yet: the release of a child wakes a parent that waits for CHILD,
    // even one released after this answer and before the wait.
    if (released) { scheduler.disarm_notification(ProcessSignal::CHILD); }
    else { scheduler.arm_notification(ProcessSignal::CHILD); }
    return Ok(released);
}

/**
 * Reaps a released child: retrieves its typed exit status and frees its slot,
 * which is all that is left of it.
 * @param caller Calling process, which must be the parent.
 * @param pid Child process ID.
 * @return Ok(exit_status), Err(NotExited), or Err(InvalidPid).
 */
export Result<ProcessExitStatus, ProcessControlError> reap(Pid caller, Pid pid) {
    check_child(caller, pid)?;
    ProcessState state = case process.get_state(pid) of {
        Some(value) -> value;
        None -> ({ return Err(ProcessControlError::InvalidPid(pid)); });
    };
    return case state of {
        ProcessState::Released(status) -> case process.free_proc(pid) of {
            Ok(_) -> Ok(status);
            Err(_) -> Err(ProcessControlError::InvalidPid(pid));
        };
        _ -> Err(ProcessControlError::NotExited(pid));
    };
}

// --- the end of a process ---
// One path, however a process ended. The kernel has already taken its threads
// and address space (Zombie); this takes what the OS holds under its pid
// (Released). The slot goes last of all, in a reap: the number stays taken until
// nothing can reach the old process through it, so a reused pid sees no old state.
//
// It runs on the server task, under the DOM lock, because nodes are part of what
// goes. A reap arrives as a syscall, with interrupts off, on top of a server task
// that may be preempted anywhere in a pass, holding that lock: a syscall can
// neither wait for the lock nor walk the tree without it.

/**
 * Hangs up every child of a process that has ended: ends it, releases it and
 * frees its slot, since no parent is left to reap it.
 * @param parent A process that has ended.
 * @return True when no child remains; false if one must be retried on a later
 *         sweep because it is still on its way out.
 */
bool end_children(Pid parent) {
    bool all_gone = true;
    i32 slot = 0;
    while (slot < kernel_config.MAX_PROCS) {
        case process.pid_at(slot) of {
            Some(child) -> ({
                if (process.is_child_of(child, Some(parent))) {
                    ProcessExitStatus hangup = ProcessExitStatus::Code(HANGUP_CODE);
                    scheduler.terminate(child, hangup);
                    if (release(child)) { process.free_proc(child); }
                    else { all_gone = false; }
                }
            });
            None -> _;
        };
        slot++;
    }
    return all_gone;
}

/**
 * Takes an ended process from Zombie to Released, children first: a parent stays
 * until they are gone, so no process ever names a parent that is not there.
 * @param pid Any process.
 * @return True when `pid` is Released, whether by this call or an earlier one.
 */
bool release(Pid pid) {
    ProcessState state = case process.get_state(pid) of {
        Some(value) -> value;
        None -> ({ return false; });
    };
    bool zombie = case state of {
        ProcessState::Zombie(_) -> true;
        ProcessState::Released(_) -> ({ return true; });
        _ -> false;
    };
    if (!zombie) { return false; }
    if (!end_children(pid)) { return false; }
    process_gone_sink(pid);
    {
        // Syscalls use this table, and this task can be preempted.
        bool was_enabled = irq.save_disable();
        defer irq.restore(was_enabled);
        detach(pid);
    }
    process.mark_released(pid);
    // A parent that waits for it can reap it now.
    case process.parent_of(pid) of {
        Some(Some(parent)) -> scheduler.notify_pid(parent, ProcessSignal::CHILD);
        _ -> _;
    };
    return true;
}

/**
 * Releases every process that has ended, and reaps those the OS itself owns:
 * the shell's apps, whose exit status nobody wants. A child with a living parent
 * stays Released until that parent reaps it. Call on the server task.
 */
@safe
export void sweep() {
    i32 slot = 0;
    while (slot < kernel_config.MAX_PROCS) {
        case process.pid_at(slot) of {
            Some(pid) -> ({
                if (release(pid) && process.is_child_of(pid, None)) { process.free_proc(pid); }
            });
            None -> _;
        };
        slot++;
    }
}

/**
 * Initializes console subsystem and registers console and spawn hooks with the kernel.
 */
export void init() {
    syscall.set_console(on_write, on_read);
    syscall.set_spawn_handler(on_spawn);
    dom_terminal.set_input_sink(take_line);
}
