/**
 * Process-control syscall boundary.
 *
 * Exposes process lifecycle, console/TextArea binding, status query, and stdin
 * feed operations to user-space processes via OS_CALL.
 */
package process_syscall;

import { OsService, OsServiceError } from "@contracts/myos/services.contract.mln";
import {
    ProcSpawnArgs, ProcExitedArgs, ProcReapArgs, ProcFeedArgs,
    ProcBindArgs, ProcUnbindArgs, ProcStatsArgs, ProcStats, ProcInfo, CpuTimes, ProcActivity
} from "@contracts/myos/process-args.contract.mln";
import console from "console.mln";
import proc_stats from "stats.mln";
import user_memory from "@os/syscall/user_memory.mln";
import { copy_in_text } from "@os/syscall/user_memory.mln";
import { UserAddress } from "@std/core/address.mln";
import { Result } from "@std/core/result.mln";
import { SpawnError } from "@contracts/process/spawn.contract.mln";
import { Pid, ProcessControlError, ProcessControlStatus, ProcessExitStatus } from "@contracts/process/control.contract.mln";
import { Text } from "@std/text/text.mln";

Text<64> g_path;
Text<128> g_line;

/**
 * Puts a control result on the wire for a service with no result_out.
 * @param result What the operation returned.
 * @return The ProcessControlStatus word for r2.
 */
i32 answer(Result<_, ProcessControlError> result) {
    ProcessControlStatus status = case result of {
        Ok(_) -> ProcessControlStatus::Accepted;
        Err(_) -> ProcessControlStatus::Refused;
    };
    return (i32)status;
}

/**
 * Dispatches a process OS_CALL request and performs user-memory copies where needed.
 *
 * @param caller Calling process: the parent of what it spawns, and the only
 *               process that may control those children.
 * @param service Service code (PROC_SPAWN, PROC_BIND, PROC_UNBIND, PROC_EXITED, PROC_REAP, PROC_FEED,
 *                PROC_STATS).
 * @param args Virtual address of argument structure in caller's memory.
 * @return Ok(r2 word) when the request was handled, or Err(UnknownService).
 */
export Result<i32, OsServiceError> handle(Pid caller, i32 service, UserAddress args) {
    if (service == OsService::PROC_SPAWN) {
        ProcSpawnArgs<Result<Pid, SpawnError>> request;
        user_memory.copy_in(args, (char*)(&request), sizeof(request));
        copy_in_text<64>(UserAddress((i32)request.path), request.path_length, &g_path);
        Result<Pid, SpawnError> result = console.spawn_file(Some(caller), g_path.as_str());
        // With no node named, the child writes where its parent does.
        i32 output = request.stdout_node;
        if (output == 0) {
            output = case console.output_of(caller) of { Some(node) -> node; None -> 0; };
        }
        if (output != 0) {
            case result of {
                Ok(pid) -> ({ console.bind(caller, pid, output); });
                Err(_) -> _;
            };
        }
        user_memory.copy_out(
            UserAddress((i32)request.result_out),
            (char*)(&result),
            sizeof(Result<Pid, SpawnError>)
        );
        return Ok(0);
    }
    if (service == OsService::PROC_BIND) {
        ProcBindArgs request;
        user_memory.copy_in(args, (char*)(&request), sizeof(request));
        return Ok(answer(console.bind(caller, Pid(request.pid), request.output_node)));
    }
    if (service == OsService::PROC_UNBIND) {
        ProcUnbindArgs request;
        user_memory.copy_in(args, (char*)(&request), sizeof(request));
        return Ok(answer(console.unbind(caller, Pid(request.pid))));
    }
    if (service == OsService::PROC_EXITED) {
        ProcExitedArgs<Result<bool, ProcessControlError>> request;
        user_memory.copy_in(args, (char*)(&request), sizeof(request));
        Result<bool, ProcessControlError> result = console.has_exited(caller, Pid(request.pid));
        user_memory.copy_out(
            UserAddress((i32)request.result_out),
            (char*)(&result),
            sizeof(Result<bool, ProcessControlError>)
        );
        return Ok(0);
    }
    if (service == OsService::PROC_REAP) {
        ProcReapArgs<Result<ProcessExitStatus, ProcessControlError>> request;
        user_memory.copy_in(args, (char*)(&request), sizeof(request));
        Result<ProcessExitStatus, ProcessControlError> result = console.reap(caller, Pid(request.pid));
        user_memory.copy_out(
            UserAddress((i32)request.result_out),
            (char*)(&result),
            sizeof(Result<ProcessExitStatus, ProcessControlError>)
        );
        return Ok(0);
    }
    if (service == OsService::PROC_FEED) {
        ProcFeedArgs request;
        user_memory.copy_in(args, (char*)(&request), sizeof(request));
        copy_in_text<128>(UserAddress((i32)request.line), request.line_length, &g_line);
        return Ok(answer(console.feed_line(caller, Pid(request.pid), g_line.as_str())));
    }
    if (service == OsService::PROC_STATS) {
        // It controls nothing, so it answers anyone, about every process.
        ProcStatsArgs request;
        user_memory.copy_in(args, (char*)(&request), sizeof(request));
        ProcStats result = ProcStats {};
        proc_stats.fill(&result);
        user_memory.copy_out(UserAddress((i32)request.result_out), (char*)(&result), sizeof(ProcStats));
        return Ok(0);
    }
    return Err(OsServiceError::UnknownService(service));
}
