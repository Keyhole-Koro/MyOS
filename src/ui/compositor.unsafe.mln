import str from "@std/text/str.mln";
import { Option } from "@std/core/option.mln";
import { Result } from "@std/core/result.mln";
package compositor;

import blob from "@std/memory/blob.mln";
import dom from "dom/dom.mln";
import dom_hit_test from "dom/dom_hit_test.mln";
import { NodeKind } from "dom/dom.mln";
import dom_widgets from "dom/dom_widgets.mln";
import dom_list from "dom/dom_list.mln";
import dom_menu from "dom/dom_menu.mln";
import dom_text_edit from "dom/dom_text_edit.mln";
import dom_window_chrome from "dom/dom_window_chrome.mln";
import dom_render from "dom/dom_render.mln";
import { TaskbarTarget } from "dom/dom_render.mln";
import graphics from "graphics.mln";
import mouse from "@kernel/io/mouse.mln";
import { PointerButton } from "@contracts/input/pointer.contract.mln";
import keyboard from "@kernel/io/keyboard.mln";
import scheduler from "@kernel/kernel/scheduler.mln";
import irq from "@kernel/arch/irq.mln";
import { NodeId, UiError } from "@contracts/ui/widget.contract.mln";

// Work owned by outer boundary endpoints that must run on this task. Boot wires
// the callback; the compositor does not depend on request transport.
bool no_requests() { return false; }

fn() -> bool g_request_pump = no_requests;
/**
 * Registers the callback that drains work owned by an outer request endpoint.
 * @param pump Callback that reports whether it served anything.
 */
export void set_request_pump(fn() -> bool pump) { g_request_pump = pump; }

// Presents the DOM scene and turns mouse and keyboard events into DOM
// interactions: hover, press/click, window focus and z-order, title-bar
// dragging, the close button, the taskbar, keyboard focus and timers.
//
// The compositor knows no node ids of its own. Every interaction starts from
// dom_hit_test.find_at(x, y), so whatever tree the running apps built is what gets
// hovered, pressed and clicked; a node participates simply by being hit-
// testable, and it reacts to a click by having an on_click handler.

/**
 * Renders damaged DOM scene regions and flips the display front/back buffers.
 */
void present_frame() {
    dom_render.render_scene();
    graphics.present();
}

/**
 * Unconditionally paints the initial frame of the desktop before interrupts are enabled.
 *
 * Ensures atomic rendering of the full desktop tree so timer preemption cannot interrupt the first paint.
 */
export void paint_first_frame() {
    graphics.show_cursor(1);
    dom_render.render_all();
    graphics.present();
}

// Drag state: the window being moved by its title bar (or resized by its
// grip), and where the pointer was at the last event so each motion event
// applies only its own delta.
Option<NodeId> g_drag_win;
Option<NodeId> g_resize_win;
i32 g_drag_last_x = 0;
i32 g_drag_last_y = 0;

// Press state: the node under the pointer when the left button went down.
// A click fires on release only if the pointer is still over that node, so
// dragging off a button cancels it.
Option<NodeId> g_pressed_id;
Option<NodeId> g_hot_id;

// Desktop context menu (right-click on the wallpaper), registered by main.
char *g_desktop_menu_items = (char*)0;
void no_desktop_menu(i32 index) { }

fn(i32 index) -> void g_desktop_menu_handler = no_desktop_menu;

/**
 * Registers the desktop wallpaper context menu items and click handler.
 * @param items Menu items separated by newlines, as open_menu takes them; a C string.
 * @param handler Callback function pointer invoked with selected menu index.
 */
export void set_desktop_menu(char *items, fn(i32 index) -> void handler) {
    g_desktop_menu_items = items;
    g_desktop_menu_handler = handler;
}

/** Actions available in a window's context menu. */
enum WindowMenuAction {
    MINIMIZE,
    MAXIMIZE,
    CLOSE
}

/**
 * Callback handler for window context menu actions (minimize, maximize, close).
 * @param action Chosen WindowMenuAction item.
 */
void on_window_menu(WindowMenuAction action) {
    NodeId win = case dom_menu.menu_target() of { Some(id) -> id; None -> ({ return; }); };
    case action of {
        WindowMenuAction::MINIMIZE -> dom_widgets.minimize_window(win);
        WindowMenuAction::MAXIMIZE -> dom_widgets.maximize_window(win);
        WindowMenuAction::CLOSE -> ({ g_hot_id = None; dom_widgets.close_window(win); });
    };
}

/**
 * Handles left mouse button press events: manages menu dismissal, window focus, chrome dragging, and button pressing.
 * @param ex Horizontal mouse pointer coordinate in logical pixels.
 * @param ey Vertical mouse pointer coordinate in logical pixels.
 */
void on_press(i32 ex, i32 ey) {
    // A click while a menu is open either picks an item or dismisses the
    // menu; either way it goes no further.
    Option<NodeId> menu = dom_menu.menu_id();
    if (menu.is_some()) {
        if (dom.same_node(dom_hit_test.find_at(ex, ey), menu)) { dom_menu.menu_click(ex, ey); }
        else { dom_menu.close_menu(); }
        return;
    }

    NodeId hit = case dom_hit_test.find_at(ex, ey) of {
        Some(id) -> id;
        None -> ({ dom_widgets.clear_focus(); return; });
    };

    // Anything inside a window activates that window first.
    Option<NodeId> enclosing = dom.enclosing_window(hit);
    case enclosing of {
        Some(win) -> dom_widgets.focus_window(win);
        None -> _;
    };

    if (dom.holds(dom.taskbar_id(), hit)) {
        case dom_render.taskbar_target_at(ex, ey) of {
            TaskbarTarget::Window(target) -> dom_widgets.focus_window(target);
            TaskbarTarget::Launcher -> ({
                fn() -> void handler = dom.launcher_handler();
                handler();
            });
            TaskbarTarget::Miss -> 0;
        };
        return;
    }

    if (dom.holds(enclosing, hit)) {
        // The window itself: title-bar buttons, drag handle, resize grip,
        // or just focus.
        NodeId win = hit;
        case dom_window_chrome.button_hit(win, ex, ey) of {
            Some(value) -> ({
                if (value == 1) {
                    g_hot_id = None;
                    dom_widgets.close_window(win);
                    return;
                }
                if (value == 2) { dom_widgets.minimize_window(win); return; }
                if (value == 3) { dom_widgets.maximize_window(win); return; }
            });
            None -> _;
        };
        if (dom_window_chrome.resize_grip_hit(win, ex, ey)) {
            g_resize_win = Some(win);
            g_drag_last_x = ex;
            g_drag_last_y = ey;
            return;
        }
        if (dom_window_chrome.titlebar_hit(win, ex, ey)) {
            g_drag_win = Some(win);
            g_drag_last_x = ex;
            g_drag_last_y = ey;
        }
        return;
    }

    NodeKind kind = case dom.kind_of(hit) of {
        Some(v) -> v;
        None -> ({ return; });
    };
    case kind of {
        NodeKind::TEXT_INPUT -> ({ dom_widgets.set_focus(hit); return; });
        NodeKind::TEXT_AREA  -> ({ dom_widgets.set_focus(hit); return; });
        NodeKind::LIST       -> ({
            dom_widgets.set_focus(hit);
            dom_list.list_click(hit, ex, ey);
            return;
        });
        _ -> 0;
    };
    dom.set_pressed(hit, 1);
    g_pressed_id = Some(hit);
}

/**
 * Handles right mouse button press events: opens window context menu or desktop wallpaper menu.
 * @param ex Horizontal mouse pointer coordinate in logical pixels.
 * @param ey Vertical mouse pointer coordinate in logical pixels.
 */
void on_right_press(i32 ex, i32 ey) {
    if (dom_menu.menu_id().is_some()) {
        dom_menu.close_menu();
        return;
    }
    NodeId hit = case dom_hit_test.find_at(ex, ey) of {
        Some(id) -> id;
        None -> ({
            if (g_desktop_menu_items != 0) {
                str desktop_items = str.from_c(g_desktop_menu_items);
                case dom_menu.open_menu(ex, ey, desktop_items, g_desktop_menu_handler, None) of { Ok(_) -> _; Err(_) -> _; };
            }
            return;
        });
    };
    if (dom.holds(dom.taskbar_id(), hit)) { return; }
    Option<NodeId> enclosing = dom.enclosing_window(hit);
    case enclosing of {
        Some(win) -> ({
            dom_widgets.focus_window(win);
            if (dom_widgets.is_maximized(win)) {
                case dom_menu.open_menu(ex, ey, "Minimize\nRestore\nClose", on_window_menu, enclosing) of { Ok(_) -> _; Err(_) -> _; };
            } else {
                case dom_menu.open_menu(ex, ey, "Minimize\nMaximize\nClose", on_window_menu, enclosing) of { Ok(_) -> _; Err(_) -> _; };
            }
        });
        None -> _;
    };
}

/**
 * Handles mouse button release events: clears drag states and dispatches click events to the pressed node.
 * @param ex Horizontal mouse pointer coordinate in logical pixels.
 * @param ey Vertical mouse pointer coordinate in logical pixels.
 */
void on_release(i32 ex, i32 ey) {
    if (g_drag_win.is_some()) {
        g_drag_win = None;
        return;
    }
    if (g_resize_win.is_some()) {
        g_resize_win = None;
        return;
    }
    case g_pressed_id of {
        Some(pressed) -> ({
            // Un-press whatever this loop pressed, not whatever happens to be
            // under the pointer now; click only if it is the same node.
            dom.set_pressed(pressed, 0);
            if (dom.holds(dom_hit_test.find_at(ex, ey), pressed)) { dom.dispatch_click(pressed); }
            g_pressed_id = None;
        });
        None -> _;
    };
}

/**
 * Handles mouse motion events: updates window position or size if dragging/resizing.
 * @param ex Current horizontal pointer coordinate in logical pixels.
 * @param ey Current vertical pointer coordinate in logical pixels.
 */
void on_motion(i32 ex, i32 ey) {
    i32 dx = ex - g_drag_last_x;
    i32 dy = ey - g_drag_last_y;
    case g_drag_win of {
        Some(win) -> ({ if (dx != 0 || dy != 0) { dom.move_node(win, dx, dy); } });
        None -> _;
    };
    case g_resize_win of {
        Some(win) -> ({
            borrow NodeRow n = case dom.find_row(win) of {
                Some(row) -> row;
                None -> ({ g_resize_win = None; return; });
            };
            dom_widgets.resize_window(win, n.w + dx, n.h + dy);
        });
        None -> _;
    };
    g_drag_last_x = ex;
    g_drag_last_y = ey;
}

// Interactive loop, event-driven. The mouse and keyboard IRQ handlers drain
// the hardware FIFOs into software queues; each pass consumes every queued
// event and edge-detects the button per event, so a click whose press and
// release both happened since the last pass still dispatches. The live
// registers stay authoritative for the cursor position and hover state, so a
// dropped event can delay a repaint but never wedge a node in a pressed or
// hovered state.
i32 g_paint_deferred = 0;

/**
 * Runs the compositor event loop until the system stops.
 * Polls queued input, dispatches UI events, advances timers, and paints damaged regions.
 */
export void run() {
    i32 prev_left = 0;
    i32 prev_right = 0;

    // paint_first_frame() already painted the desktop (called from main.mln
    // before interrupts were enabled, so that paint could not be preempted).

    while (1) {
        {
            // One pass holds the DOM; the lock is given back before sleeping.
            dom.lock();
            defer dom.unlock();

            // Consume all queued mouse events. Clicks are dispatched at the
            // event's own coordinates: where the press happened, not where the
            // pointer is now.
            while (mouse.has_event()) {
                i32 ex = mouse.event_x();
                i32 ey = mouse.event_y();
                i32 btn = mouse.event_btn();
                i32 wheel = mouse.event_wheel();
                mouse.pop_event();
                i32 eb = btn & PointerButton::LEFT;
                i32 er = btn & PointerButton::RIGHT;

                if (eb) {
                    if (!prev_left) {
                        on_press(ex, ey);
                    } else {
                        on_motion(ex, ey);
                    }
                } else {
                    if (prev_left) {
                        on_release(ex, ey);
                    }
                }
                prev_left = eb;

                if (er) {
                    if (!prev_right) { on_right_press(ex, ey); }
                }
                prev_right = er;

                if (wheel != 0) {
                    case dom_hit_test.find_at(ex, ey) of {
                        Some(id) -> ({ dom_text_edit.dispatch_wheel(id, wheel); });
                        None -> _;
                    };
                }
            }

            // Keyboard events go to whichever node holds focus.
            while (keyboard.has_event()) {
                i32 t = keyboard.event_type();
                i32 c = keyboard.event_code();
                i32 m = keyboard.event_mods();
                keyboard.pop_event();
                dom_widgets.dispatch_key_event(t, c, m);
            }

            // Live state drives the cursor and hover. Moving the pointer is two
            // register writes and does not dirty the scene; only a change in what
            // is hovered does.
            i32 mx = mouse.x();
            i32 my = mouse.y();
            graphics.set_cursor(mx, my);

            Option<NodeId> hit = dom_hit_test.find_at(mx, my);
            if (!dom.same_node(hit, g_hot_id)) {
                case g_hot_id of { Some(id) -> dom.set_hovered(id, 0); None -> _; };
                case hit of { Some(id) -> dom.set_hovered(id, 1); None -> _; };
                g_hot_id = hit;
            }
            dom_menu.menu_hover(mx, my);

            // Timers (clock, animations) run on this task between events.
            dom_widgets.tick();

            // Application service work is answered here, on this task. The app
            // task sleeps on each request until its reply; its handlers run over
            // there, on events the DOM emitted above.
            bool served = g_request_pump();

            // The server's own queued handlers (taskbar, menus, the shell's
            // window-close hook) run here, between input and paint.
            dom.drain_events();

            // The setters above record what changed, so the damage region is the
            // authority on whether a repaint is needed. A pass that answered
            // requests is likely in the middle of an app's burst (view() is a
            // dozen creates, each one pass apart): hold the paint until a quiet
            // pass, but never for more than a few, so a chatty app still shows.
            if (served) { g_paint_deferred++; } else { g_paint_deferred = 0; }
            if (dom.has_damage()) {
                if (!served || g_paint_deferred > 8) {
                    g_paint_deferred = 0;
                    present_frame();
                }
            }

            // Every view of a DOM string lives inside a pass, under this lock,
            // so this is where freed text may really go.
            blob.collect();
        }
        scheduler.sleep(1); // yield the CPU to other tasks between passes
    }
}
