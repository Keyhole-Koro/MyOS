package dom_elements;
import debug from "../../../../MyKernel/src/debug/debug.mln";
import heap from "../../../../MyKernel/src/mm/heap.mln";
import scheduler from "../../../../MyKernel/src/kernel/scheduler.mln";
import graphics from "../graphics.mln";
import theme from "../theme.mln";
import { halt_cpu } from "../../../../MyKernel/src/arch/halt.masm";
import dom_widgets from "dom_widgets.mln";
import dom from "dom.mln";
import { Node, NodeKind, NodeRole, NodeState, NodeStyle } from "dom.mln";
import { Option } from "../../../../../toolchain/MyStdLib/option.mln";
// --- UI node create helpers ------------------------------------------------------------------
// Each sets kind + role + bounds + text + default state (visible/enabled) in one
// call. Coordinates are logical (1024x768) and relative to the parent the node
// is later appended to.

// Note: NODE_*/ROLE_*/STATE_* are `export u16` globals; pass them bare as
// function args. Casting them like (i32)NodeState::VISIBLE makes semantic report
// `undefined identifier` (see docs/DOM_SPEC.md), so no casts here.
export i32 create_window(char *title, i32 x, i32 y, i32 w, i32 h) {
    i32 id = dom.create_node(NodeKind::WINDOW, title);
    dom.set_role(id, NodeRole::WINDOW);
    dom.set_bounds(id, dom.scale_ui(x), dom.scale_ui(y), dom.scale_ui(w), dom.scale_ui(h));
    dom.set_text(id, title);
    dom.set_state_flag(id, NodeState::VISIBLE, 1);
    dom.set_state_flag(id, NodeState::ENABLED, 1);
    dom.set_state_flag(id, NodeState::HIT_TESTABLE, 1); // body clicks focus the window
    return id;
}

export i32 create_button(char *label, i32 x, i32 y, i32 w, i32 h) {
    i32 id = dom.create_node(NodeKind::BUTTON, label);
    dom.set_role(id, NodeRole::BUTTON);
    dom.set_bounds(id, dom.scale_ui(x), dom.scale_ui(y), dom.scale_ui(w), dom.scale_ui(h));
    dom.set_text(id, label);
    dom.set_state_flag(id, NodeState::VISIBLE, 1);
    dom.set_state_flag(id, NodeState::ENABLED, 1);
    dom.set_state_flag(id, NodeState::HIT_TESTABLE, 1);
    return id;
}

export i32 create_text(char *text, i32 x, i32 y) {
    i32 id = dom.create_node(NodeKind::TEXT, text);
    dom.set_role(id, NodeRole::TEXT);
    dom.set_bounds(id, dom.scale_ui(x), dom.scale_ui(y), 0, 0);
    dom.set_text(id, text);
    dom.set_state_flag(id, NodeState::VISIBLE, 1);
    return id;
}

// A Box is a visual grouping primitive. It has no accessibility role and is
// not hit-testable by default, so decoration never obscures a Button within it.
export i32 create_box(i32 x, i32 y, i32 w, i32 h,
                      i32 background, i32 border) {
    i32 id = dom.create_node(NodeKind::BOX, "box");
    dom.set_bounds(id, dom.scale_ui(x), dom.scale_ui(y), dom.scale_ui(w), dom.scale_ui(h));
    dom.set_colors(id, background, border);
    dom.set_state_flag(id, NodeState::VISIBLE, 1);
    return id;
}

// A Panel is a themed rounded card; its children are clipped to it.
export i32 create_panel(i32 x, i32 y, i32 w, i32 h, i32 radius) {
    i32 id = dom.create_node(NodeKind::PANEL, "panel");
    dom.set_bounds(id, dom.scale_ui(x), dom.scale_ui(y), dom.scale_ui(w), dom.scale_ui(h));
    Node *n = dom.node_ptr(id);
    n->radius = (u16)dom.scale_ui(radius);
    dom.set_state_flag(id, NodeState::VISIBLE, 1);
    return id;
}

// A Column is a visible-to-the-renderer layout container: it draws nothing of
// its own, but visibility gates all descendants. When a child is appended its
// x/y are recomputed from this origin, padding, and the preceding child sizes.
export i32 create_column(i32 x, i32 y, i32 w, i32 h,
                         i32 padding, i32 gap) {
    i32 id = dom.create_node(NodeKind::COLUMN, "column");
    dom.set_bounds(id, dom.scale_ui(x), dom.scale_ui(y), dom.scale_ui(w), dom.scale_ui(h));
    dom.set_column_layout(id, dom.scale_ui(padding), dom.scale_ui(gap));
    dom.set_state_flag(id, NodeState::VISIBLE, 1);
    return id;
}

export i32 create_row(i32 x, i32 y, i32 w, i32 h,
                      i32 padding, i32 gap) {
    i32 id = dom.create_node(NodeKind::ROW, "row");
    dom.set_bounds(id, dom.scale_ui(x), dom.scale_ui(y), dom.scale_ui(w), dom.scale_ui(h));
    dom.set_column_layout(id, dom.scale_ui(padding), dom.scale_ui(gap));
    dom.set_state_flag(id, NodeState::VISIBLE, 1);
    return id;
}

// A single-line text field. `placeholder` shows while empty; the node owns a
// heap buffer of `capacity` bytes (including the terminator).
export i32 create_text_input(char *placeholder, i32 x, i32 y, i32 w, i32 h, i32 capacity) {
    if (capacity < 2) { capacity = 2; }
    i32 id = dom.create_node(NodeKind::TEXT_INPUT, placeholder);
    dom.set_role(id, NodeRole::TEXTBOX);
    dom.set_bounds(id, dom.scale_ui(x), dom.scale_ui(y), dom.scale_ui(w), dom.scale_ui(h));
    Node *n = dom.node_ptr(id);
    char *buf = (char*)heap.alloc(capacity);
    buf[0] = (char)0;
    n->text = buf;
    n->cap = (u16)capacity;
    n->len = 0;
    n->cursor = 0;
    dom.set_state_flag(id, NodeState::VISIBLE, 1);
    dom.set_state_flag(id, NodeState::ENABLED, 1);
    dom.set_state_flag(id, NodeState::HIT_TESTABLE, 1);
    return id;
}

export i32 create_checkbox(char *label, i32 x, i32 y, i32 checked) {
    i32 id = dom.create_node(NodeKind::CHECKBOX, label);
    dom.set_role(id, NodeRole::CHECKBOX);
    i32 s = dom.ui_scale();
    i32 box = theme.checkbox_size() * s;
    i32 tw = graphics.text_width(label, 0, s);
    i32 th = graphics.text_height(0, s);
    i32 h = box;
    if (th > h) { h = th; }
    dom.set_bounds(id, dom.scale_ui(x), dom.scale_ui(y), box + 8 * s + tw, h);
    dom.set_text(id, label);
    dom.set_state_flag(id, NodeState::VISIBLE, 1);
    dom.set_state_flag(id, NodeState::ENABLED, 1);
    dom.set_state_flag(id, NodeState::HIT_TESTABLE, 1);
    dom.set_state_flag(id, NodeState::CHECKED, checked);
    return id;
}

export i32 create_separator(i32 x, i32 y, i32 w) {
    i32 id = dom.create_node(NodeKind::SEPARATOR, "separator");
    dom.set_role(id, NodeRole::SEPARATOR);
    dom.set_bounds(id, dom.scale_ui(x), dom.scale_ui(y), dom.scale_ui(w), dom.ui_scale());
    dom.set_state_flag(id, NodeState::VISIBLE, 1);
    return id;
}

// Multi-line text. `capacity` bytes of heap (including the terminator);
// readonly != 0 makes it a display-only console that append_text feeds.
export i32 create_text_area(char *name, i32 x, i32 y, i32 w, i32 h, i32 capacity, i32 readonly) {
    if (capacity < 2) { capacity = 2; }
    i32 id = dom.create_node(NodeKind::TEXT_AREA, name);
    dom.set_role(id, NodeRole::TEXTAREA);
    dom.set_bounds(id, dom.scale_ui(x), dom.scale_ui(y), dom.scale_ui(w), dom.scale_ui(h));
    Node *n = dom.node_ptr(id);
    char *buf = (char*)heap.alloc(capacity);
    buf[0] = (char)0;
    n->text = buf;
    n->cap = (u16)capacity;
    n->len = 0;
    n->cursor = 0;
    n->scroll = 0;
    if (readonly != 0) { dom.set_style(id, NodeStyle::READONLY); }
    dom.set_state_flag(id, NodeState::VISIBLE, 1);
    dom.set_state_flag(id, NodeState::ENABLED, 1);
    dom.set_state_flag(id, NodeState::HIT_TESTABLE, 1);
    return id;
}

// A selectable list of rows (see list_set_items).
export i32 create_list(char *name, i32 x, i32 y, i32 w, i32 h, i32 capacity) {
    if (capacity < 2) { capacity = 2; }
    i32 id = dom.create_node(NodeKind::LIST, name);
    dom.set_role(id, NodeRole::LIST);
    dom.set_bounds(id, dom.scale_ui(x), dom.scale_ui(y), dom.scale_ui(w), dom.scale_ui(h));
    Node *n = dom.node_ptr(id);
    char *buf = (char*)heap.alloc(capacity);
    buf[0] = (char)0;
    n->text = buf;
    n->cap = (u16)capacity;
    n->len = 0;
    n->sel = 0;
    n->scroll = 0;
    dom.set_state_flag(id, NodeState::VISIBLE, 1);
    dom.set_state_flag(id, NodeState::ENABLED, 1);
    dom.set_state_flag(id, NodeState::HIT_TESTABLE, 1);
    return id;
}

// ---------------------------------------------------------------------------
// DOM syntax elements.
//
// `<Window title="A" x={0} y={0} w={1} h={1}/>` in a .dom.mln source lowers to
// a call to the function of the same name, with each property handed to the
// parameter of the same name, and children passed to append_child. The element
// vocabulary therefore lives here rather than in the compiler: adding an
// element means adding a function, and its parameters are its properties.
//
// A parameter with a default is an optional property: position defaults to
// the parent's origin (which is what a child of a Column or Row wants, since
// the container places it), sizes to something sensible, handlers to none.
// `testId` names the node for automation. Handler parameters (on*) receive
// functions with the dispatcher ABI, `void (i32 owner, i32 id, i32 arg)`;
// the compiler wraps methods and plain handlers into it, see
// toolchain/MyLangCompiler/docs/source-modifiers.md.
// ---------------------------------------------------------------------------

// Children of an element are attached with the `append_child` in scope;
// re-exported here so a markup file needs only this package.
export void append_child(i32 parent, i32 child) { dom.append_child(parent, child); }

void tag(i32 id, char *testId) {
    if (testId[0] != 0) { dom.set_test_id(id, testId); }
}

export i32 Window(char *title, i32 x = 0, i32 y = 0, i32 w = 400, i32 h = 300, char *testId = "") {
    i32 id = create_window(title, x, y, w, h);
    tag(id, testId);
    return id;
}

export i32 Button(char *text, i32 x = 0, i32 y = 0, i32 w = 90, i32 h = 34, i32 onClick = 0, char *testId = "") {
    i32 id = create_button(text, x, y, w, h);
    dom.set_on_click(id, onClick);
    tag(id, testId);
    return id;
}

// Accent-coloured call to action.
export i32 PrimaryButton(char *text, i32 x = 0, i32 y = 0, i32 w = 90, i32 h = 34, i32 onClick = 0, char *testId = "") {
    i32 id = create_button(text, x, y, w, h);
    dom.set_on_click(id, onClick);
    dom.set_style(id, NodeStyle::PRIMARY);
    tag(id, testId);
    return id;
}

export i32 Text(char *text, i32 x = 0, i32 y = 0, char *testId = "") {
    i32 id = create_text(text, x, y);
    tag(id, testId);
    return id;
}

// Text with an explicit colour (graphics.rgb(); 0 = theme default) and weight.
export i32 Label(char *text, i32 x = 0, i32 y = 0, i32 color = 0, i32 bold = 0, char *testId = "") {
    i32 id = create_text(text, x, y);
    if (bold != 0) { dom.set_style(id, NodeStyle::BOLD); }
    dom.set_color(id, color);
    tag(id, testId);
    return id;
}

export i32 Box(i32 x = 0, i32 y = 0, i32 w = 100, i32 h = 100,
               i32 background = 0, i32 border = 0) {
    return create_box(x, y, w, h, background, border);
}

export i32 Panel(i32 x = 0, i32 y = 0, i32 w = 100, i32 h = 100, i32 radius = 0) {
    return create_panel(x, y, w, h, radius);
}

export i32 Column(i32 x = 0, i32 y = 0, i32 w = 100, i32 h = 100,
                  i32 padding = 0, i32 gap = 0) {
    return create_column(x, y, w, h, padding, gap);
}

export i32 Row(i32 x = 0, i32 y = 0, i32 w = 100, i32 h = 34,
               i32 padding = 0, i32 gap = 0) {
    return create_row(x, y, w, h, padding, gap);
}

export i32 TextInput(char *placeholder, i32 x = 0, i32 y = 0, i32 w = 200, i32 h = 34, i32 capacity = 64, i32 onChange = 0, char *testId = "") {
    i32 id = create_text_input(placeholder, x, y, w, h, capacity);
    dom.set_on_change(id, onChange);
    tag(id, testId);
    return id;
}

export i32 Checkbox(char *text, i32 x = 0, i32 y = 0, i32 checked = 0, i32 onClick = 0, char *testId = "") {
    i32 id = create_checkbox(text, x, y, checked);
    dom.set_on_click(id, onClick);
    dom.set_hit_testable(id, 1); // toggles by itself even with no handler
    tag(id, testId);
    return id;
}

export i32 Separator(i32 x = 0, i32 y = 0, i32 w = 100) {
    return create_separator(x, y, w);
}

export i32 Timer(i32 interval, i32 onTick) {
    return dom_widgets.create_timer(interval, onTick);
}

export i32 TextArea(char *name, i32 x = 0, i32 y = 0, i32 w = 300, i32 h = 200, i32 capacity = 1024, i32 readonly = 0, i32 onChange = 0, char *testId = "") {
    i32 id = create_text_area(name, x, y, w, h, capacity, readonly);
    dom.set_on_change(id, onChange);
    tag(id, testId);
    return id;
}

// onChange fires when the selection moves, onActivate (stored as the click
// handler) when a row is clicked again or Enter is pressed.
export i32 List(char *name, i32 x = 0, i32 y = 0, i32 w = 300, i32 h = 200, i32 capacity = 1024, i32 onChange = 0, i32 onActivate = 0, char *testId = "") {
    i32 id = create_list(name, x, y, w, h, capacity);
    dom.set_on_change(id, onChange);
    dom.set_on_click(id, onActivate);
    dom.set_hit_testable(id, 1); // rows select on click even with no handler
    tag(id, testId);
    return id;
}

// The human-readable dump (dump()), the JSON snapshot, and the automation
// bridge (write_automation_snapshot/write_automation_hit_test) moved to
// dom_automation.mln -- they only walk the tree through accessors above,
// never touch tree state, and made this file harder to find things in.
// role_name() stays here because it compares against ROLE_*, and an
// `export u16` global doesn't resolve as a cross-package symbol (see
// dom.set_hovered() and friends above); dom_automation.mln calls dom_elements.role_name().
export char* role_name(i32 role) {
    if (role == NodeRole::TEXTAREA) { return "textarea"; }
    if (role == NodeRole::LIST) { return "list"; }
    if (role == NodeRole::MENU) { return "menu"; }
    if (role == NodeRole::ROOT) { return "root"; }
    if (role == NodeRole::DESKTOP) { return "desktop"; }
    if (role == NodeRole::WINDOW) { return "window"; }
    if (role == NodeRole::BUTTON) { return "button"; }
    if (role == NodeRole::TEXT) { return "text"; }
    if (role == NodeRole::TEXTBOX) { return "textbox"; }
    if (role == NodeRole::CHECKBOX) { return "checkbox"; }
    if (role == NodeRole::TOOLBAR) { return "toolbar"; }
    if (role == NodeRole::SEPARATOR) { return "separator"; }
    return "none";
}


