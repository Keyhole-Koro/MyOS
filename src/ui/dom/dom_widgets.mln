package dom_widgets;
import debug from "../../../../MyKernel/src/debug/debug.mln";
import heap from "../../../../MyKernel/src/mm/heap.mln";
import scheduler from "../../../../MyKernel/src/kernel/scheduler.mln";
import graphics from "../graphics.mln";
import theme from "../theme.mln";
import { halt_cpu } from "../../../../MyKernel/src/arch/halt.masm";
import dom from "dom.mln";
import { UiEventKind } from "../../../../MyAppFramework/src/protocol.mln";
import ui_config from "../ui_config.mln";
import { Node, NodeKind, NodeRole, NodeState, NodeStyle } from "dom.mln";
import { Option } from "../../../../../toolchain/MyStdLib/option.mln";

export enum EditResult {
    Unhandled,
    Changed,
    Moved,
}

// --- focus / window management -----------------------------------------------------------

/**
 * Returns height of the taskbar in display pixels (or 0 if none).
 * @return Taskbar height in pixels.
 */
export i32 taskbar_height() {
    Node *n = dom.node_ptr(dom.get_g_taskbar_id());
    if (n == 0) { return 0; }
    return n->h;
}

/**
 * Returns the DOM Node ID of the active window.
 * @return Active window Node ID.
 */
export i32 active_window() {
    return dom.get_g_active_window();
}

/**
 * Returns the DOM Node ID of the currently focused control.
 * @return Focused Node ID, or 0 if none.
 */
export i32 focused_node() {
    return dom.get_g_focus_id();
}

/**
 * Sets keyboard focus to a node, updating FOCUSED state flags.
 * @param id DOM Node ID to focus, or 0 to clear focus.
 */
export void set_focus(i32 id) {
    if (id == dom.get_g_focus_id()) { return; }
    if (dom.get_g_focus_id() != 0) { dom.set_state_flag(dom.get_g_focus_id(), NodeState::FOCUSED, 0); }
    dom.set_g_focus_id(0);
    Node *n = dom.node_ptr(id);
    if (n == 0) { return; }
    dom.set_g_focus_id(id);
    dom.set_state_flag(id, NodeState::FOCUSED, 1);
}

/**
 * Activates a window, bringing it to front and focusing it.
 * @param win Window DOM Node ID.
 */
export void focus_window(i32 win) {
    Node *n = dom.node_ptr(win);
    if (n == 0) { return; }
    if (n->kind != NodeKind::WINDOW) { return; }
    if ((n->state & NodeState::MINIMIZED) != 0) {
        dom.set_state_flag(win, NodeState::MINIMIZED, 0);
        dom.set_state_flag(win, NodeState::VISIBLE, 1);
    }
    if (dom.get_g_active_window() != win) {
        if (dom.get_g_active_window() != 0) { dom.set_state_flag(dom.get_g_active_window(), NodeState::FOCUSED, 0); }
        dom.set_g_active_window(win);
        dom.set_state_flag(win, NodeState::FOCUSED, 1);
        if (dom.window_of(dom.get_g_focus_id()) != win) { set_focus(0); }
        dom.damage_node(dom.get_g_taskbar_id()); // the active entry's highlight moved
    }
    dom.bring_to_front(win);
}

/**
 * Activates the topmost unminimized window on the desktop.
 */
export void activate_topmost() {
    i32 top = 0;
    i32 child_id = dom.first_child(dom.get_g_desktop_node_id());
    while (child_id != 0) {
        Node *c = dom.node_ptr(child_id);
        if (c == 0) { child_id = 0; }
        else {
            if (c->kind == NodeKind::WINDOW) {
                if ((c->state & NodeState::MINIMIZED) == 0) { top = child_id; }
            }
            child_id = c->next_sibling;
        }
    }
    if (top != 0) { focus_window(top); }
    else { dom.set_g_active_window(0); }
    dom.damage_node(dom.get_g_taskbar_id());
}

// The user closed a window. A window with an on_close handler is handed to
// its app (queued, so the app framework runs the handler and then removes
// everything the instance owns); any other window is removed here.
export void close_window(i32 win) {
    i32 handler = dom.on_close_of(win);
    if (handler != 0) {
        dom.push_event(handler, dom.owner_of(win), win, 0);
        return;
    }
    dom.remove_node(win);
    activate_topmost();
}

/**
 * Resizes a window in place, enforcing minimum dimensions and damaging invalidated areas.
 * @param win Window DOM Node ID.
 * @param w Target width in pixels.
 * @param h Target height in pixels.
 */
export void resize_window(i32 win, i32 w, i32 h) {
    Node *n = dom.node_ptr(win);
    if (n == 0) { return; }
    i32 s = dom.ui_scale();
    i32 min_w = 200 * s;
    i32 min_h = 120 * s;
    if (w < min_w) { w = min_w; }
    if (h < min_h) { h = min_h; }
    dom.damage_node(win);
    n->w = (u16)w;
    n->h = (u16)h;
    dom.damage_node(win);
    dom.touch();
}

/**
 * Minimizes a window to the taskbar, hiding its visible contents.
 * @param win Window DOM Node ID.
 */
export void minimize_window(i32 win) {
    Node *n = dom.node_ptr(win);
    if (n == 0) { return; }
    dom.set_state_flag(win, NodeState::MINIMIZED, 1);
    dom.set_state_flag(win, NodeState::VISIBLE, 0);
    if (dom.window_of(dom.get_g_focus_id()) == win) { set_focus(0); }
    if (dom.get_g_active_window() == win) {
        dom.set_state_flag(win, NodeState::FOCUSED, 0);
        dom.set_g_active_window(0);
        activate_topmost();
    }
    dom.damage_node(dom.get_g_taskbar_id());
    dom.touch();
}

/**
 * Checks whether a window is currently minimized.
 * @param win Window DOM Node ID.
 * @return True if minimized, false otherwise.
 */
export bool is_minimized(i32 win) {
    return dom.get_state_flag(win, NodeState::MINIMIZED);
}

/**
 * Checks whether a window is currently maximized.
 * @param win Window DOM Node ID.
 * @return True if maximized, false otherwise.
 */
export bool is_maximized(i32 win) {
    return dom.get_state_flag(win, NodeState::MAXIMIZED);
}

/**
 * Toggles a window between maximized full-desktop state and previous restored bounds.
 * @param win Window DOM Node ID.
 */
export void maximize_window(i32 win) {
    Node *n = dom.node_ptr(win);
    if (n == 0) { return; }
    if ((n->state & NodeState::MAXIMIZED) != 0) {
        i32 rx = n->sx;
        i32 ry = n->sy;
        dom.move_node(win, rx - n->x, ry - n->y);
        resize_window(win, n->sw, n->sh);
        dom.set_state_flag(win, NodeState::MAXIMIZED, 0);
        return;
    }
    n->sx = n->x;
    n->sy = n->y;
    n->sw = n->w;
    n->sh = n->h;
    i32 dw = graphics.display_width();
    i32 dh = graphics.display_height() - taskbar_height();
    dom.move_node(win, -n->x, -n->y);
    resize_window(win, dw, dh);
    dom.set_state_flag(win, NodeState::MAXIMIZED, 1);
}

// Chrome geometry, in display pixels. Three discs sit at the left of the
// title bar -- close, minimize, maximize -- and the rest of the bar is the
// drag handle. A resize grip occupies the bottom-right corner.
i32 TB_BUTTON_CLOSE = 1;
i32 TB_BUTTON_MINIMIZE = 2;
i32 TB_BUTTON_MAXIMIZE = 3;

/**
 * Computes the center X coordinate of the close button on a window's title bar.
 * @param w Pointer to Window Node.
 * @return Center X coordinate in display pixels.
 */
export i32 close_button_cx(Node *w) {
    i32 s = dom.ui_scale();
    return w->x + 16 * s;
}

/**
 * Computes the center X coordinate of title bar button index `which` (1=close, 2=minimize, 3=maximize).
 * @param w Pointer to Window Node.
 * @param which Titlebar button index (1-3).
 * @return Center X coordinate in display pixels.
 */
export i32 tb_button_cx(Node *w, i32 which) {
    i32 s = dom.ui_scale();
    return w->x + (16 + 20 * (which - 1)) * s;
}

/**
 * Computes the center Y coordinate of title bar buttons on a window.
 * @param w Pointer to Window Node.
 * @return Center Y coordinate in display pixels.
 */
export i32 close_button_cy(Node *w) {
    i32 s = dom.ui_scale();
    i32 tb = theme.titlebar_h() * s;
    return w->y + tb / 2;
}

/**
 * Returns radius of title bar buttons in display pixels.
 * @return Radius in pixels.
 */
export i32 close_button_r() {
    return 7 * dom.ui_scale();
}

/**
 * Hit tests a point against title bar control buttons (1=close, 2=minimize, 3=maximize, 0=none).
 * @param win Window DOM Node ID.
 * @param px Target X coordinate.
 * @param py Target Y coordinate.
 * @return Button index hit (1, 2, 3) or 0 if none.
 */
export i32 titlebar_button_hit(i32 win, i32 px, i32 py) {
    Node *w = dom.node_ptr(win);
    if (w == 0) { return 0; }
    i32 dy = py - close_button_cy(w);
    i32 r = close_button_r() + 3 * dom.ui_scale(); // a little slack
    i32 which = 1;
    while (which <= 3) {
        i32 dx = px - tb_button_cx(w, which);
        if (dx * dx + dy * dy <= r * r) { return which; }
        which++;
    }
    return 0;
}

/**
 * Checks if a point hits a window's close button.
 * @param win Window DOM Node ID.
 * @param px Target X coordinate.
 * @param py Target Y coordinate.
 * @return True if close button hit, false otherwise.
 */
export bool close_button_hit(i32 win, i32 px, i32 py) {
    if (titlebar_button_hit(win, px, py) == 1) { return true; }
    return false;
}

/**
 * Checks if a point hits the bottom-right corner resize grip of a window.
 * @param win Window DOM Node ID.
 * @param px Target X coordinate.
 * @param py Target Y coordinate.
 * @return True if resize grip hit, false otherwise.
 */
export bool resize_grip_hit(i32 win, i32 px, i32 py) {
    Node *w = dom.node_ptr(win);
    if (w == 0) { return false; }
    i32 g = ui_config.GRIP_SIZE * dom.ui_scale();
    if (px < w->x + w->w - g) { return false; }
    if (py < w->y + w->h - g) { return false; }
    if (px >= w->x + w->w) { return false; }
    if (py >= w->y + w->h) { return false; }
    return true;
}

/**
 * Checks if a point hits a window's draggable title bar (excluding control buttons).
 * @param win Window DOM Node ID.
 * @param px Target X coordinate.
 * @param py Target Y coordinate.
 * @return True if title bar hit, false otherwise.
 */
export bool titlebar_hit(i32 win, i32 px, i32 py) {
    Node *w = dom.node_ptr(win);
    if (w == 0) { return false; }
    if (titlebar_button_hit(win, px, py) != 0) { return false; }
    i32 tb = theme.titlebar_h() * dom.ui_scale();
    if (px < w->x) { return false; }
    if (px >= w->x + w->w) { return false; }
    if (py < w->y) { return false; }
    if (py >= w->y + tb) { return false; }
    return true;
}

// --- keyboard --------------------------------------------------------------------------------

i32 KEY_BACKSPACE = 8;
i32 KEY_TAB = 9;
i32 KEY_ENTER = 13;
i32 KEY_ESCAPE = 27;
i32 KEY_SPACE = 32;
i32 KEY_DELETE = 127;
i32 KEY_LEFT = 0x101;
i32 KEY_RIGHT = 0x102;
i32 KEY_UP = 0x103;
i32 KEY_DOWN = 0x104;
i32 KEY_HOME = 0x105;
i32 KEY_END = 0x106;
i32 KEY_PAGE_UP = 0x107;
i32 KEY_PAGE_DOWN = 0x108;
i32 MOD_SHIFT = 1;
i32 EVT_DOWN = 1;
i32 EVT_CHAR = 3;

/**
 * Inserts a character into a text buffer at current cursor position.
 * @param n Pointer to DOM Node.
 * @param c ASCII character code to insert.
 */
export void input_insert(Node *n, i32 c) {
    i32 len = n->len;
    i32 cap = n->cap;
    if (len + 1 >= cap) { return; }
    char *buf = (char*)n->text;
    i32 cur = n->cursor;
    i32 i = len;
    while (i > cur) {
        buf[i] = buf[i - 1];
        i--;
    }
    buf[cur] = (char)c;
    buf[len + 1] = (char)0;
    n->len = (u16)(len + 1);
    n->cursor = (u16)(cur + 1);
}

/**
 * Deletes character at specified index in a text node buffer.
 * @param n Pointer to DOM Node.
 * @param at Byte index of character to remove.
 */
export void input_delete_at(Node *n, i32 at) {
    i32 len = n->len;
    if (at < 0) { return; }
    if (at >= len) { return; }
    char *buf = (char*)n->text;
    i32 i = at;
    while (i < len - 1) {
        buf[i] = buf[i + 1];
        i++;
    }
    buf[len - 1] = (char)0;
    n->len = (u16)(len - 1);
}

/**
 * Handles default editing keyboard events for a single-line TextInput node.
 * @param n Pointer to TextInput Node.
 * @param type Keyboard event type (EVT_CHAR or EVT_DOWN).
 * @param code Key code or ASCII character.
 * @return EditResult enum indicating outcome (Changed, Moved, Unhandled).
 */
export EditResult input_handle(Node *n, i32 type, i32 code) {
    i32 cur = n->cursor;
    i32 len = n->len;
    if (type == EVT_CHAR) {
        if (code >= 0x20) {
            if (code <= 0x7E) {
                input_insert(n, code);
                return EditResult::Changed;
            }
        }
        return EditResult::Unhandled;
    }
    if (type != EVT_DOWN) { return EditResult::Unhandled; }
    if (code == KEY_BACKSPACE) {
        if (cur > 0) {
            input_delete_at(n, cur - 1);
            n->cursor = (u16)(cur - 1);
            return EditResult::Changed;
        }
        return EditResult::Unhandled;
    }
    if (code == KEY_DELETE) {
        if (cur < len) { input_delete_at(n, cur); return EditResult::Changed; }
        return EditResult::Unhandled;
    }
    if (code == KEY_LEFT) {
        if (cur > 0) { n->cursor = (u16)(cur - 1); }
        return EditResult::Moved;
    }
    if (code == KEY_RIGHT) {
        if (cur < len) { n->cursor = (u16)(cur + 1); }
        return EditResult::Moved;
    }
    if (code == KEY_HOME) { n->cursor = 0; return EditResult::Moved; }
    if (code == KEY_END) { n->cursor = (u16)len; return EditResult::Moved; }
    return EditResult::Unhandled;
}

// Route one keyboard event (type = keyboard.EVT_*, code = key code or
// character) to the focused node. A node's on_key handler, if set, sees DOWN
// events first and can claim them by returning non-zero; otherwise text
// inputs get their default editing behaviour.
// --- multi-line text (TextArea) ---
// The buffer holds the whole document with '\n' separators; `cursor` is a
// byte index, `scroll` the first visible line. Editing shares the insert/
// delete helpers with TextInput and adds newline, vertical movement and
// keeping the caret's line in view.

/**
 * Checks whether a node has the READONLY style bit set.
 * @param n Pointer to DOM Node.
 * @return True if read-only, false otherwise.
 */
export bool is_readonly(Node *n) {
    return (n->style & NodeStyle::READONLY) != 0;
}

/**
 * Finds the 0-based line index containing byte offset `at` in a text buffer.
 * @param n Pointer to TextArea Node.
 * @param at Byte offset in text buffer.
 * @return 0-based line number.
 */
export i32 line_of(Node *n, i32 at) {
    char *buf = (char*)n->text;
    i32 line = 0;
    i32 i = 0;
    while (i < at) {
        if (buf[i] == 10) { line++; }
        i++;
    }
    return line;
}

/**
 * Returns the byte offset corresponding to the start of a given line index.
 * @param n Pointer to TextArea Node.
 * @param line 0-based line index.
 * @return Byte offset of line start.
 */
export i32 line_start(Node *n, i32 line) {
    char *buf = (char*)n->text;
    i32 len = n->len;
    i32 i = 0;
    i32 cur = 0;
    while (cur < line) {
        if (i >= len) { return len; }
        if (buf[i] == 10) { cur++; }
        i++;
    }
    return i;
}

/**
 * Computes byte length of a line starting at `start` (excluding newline).
 * @param n Pointer to TextArea Node.
 * @param start Byte offset of line start.
 * @return Line length in bytes.
 */
export i32 line_len_at(Node *n, i32 start) {
    char *buf = (char*)n->text;
    i32 len = n->len;
    i32 i = start;
    while (i < len) {
        if (buf[i] == 10) { return i - start; }
        i++;
    }
    return len - start;
}

/**
 * Returns total line count of a TextArea node.
 * @param id DOM Node ID.
 * @return Total number of lines.
 */
export i32 text_area_line_count(i32 id) {
    Node *n = dom.node_ptr(id);
    if (n == 0) { return 0; }
    return line_of(n, n->len) + 1;
}

/**
 * Calculates number of visible lines fitting inside a TextArea or List.
 * @param n Pointer to DOM Node.
 * @return Number of visible text lines.
 */
export i32 visible_lines(Node *n) {
    i32 s = dom.ui_scale();
    i32 pad = 8 * s;
    i32 lh = graphics.text_height(0, s);
    i32 rows = (n->h - 2 * pad) / lh;
    if (rows < 1) { rows = 1; }
    return rows;
}

/**
 * Adjusts TextArea scroll offset to ensure the cursor line is visible.
 * @param n Pointer to TextArea Node.
 */
export void text_area_reveal_cursor(Node *n) {
    i32 line = line_of(n, n->cursor);
    i32 rows = visible_lines(n);
    i32 scroll = n->scroll;
    if (line < scroll) { scroll = line; }
    if (line >= scroll + rows) { scroll = line - rows + 1; }
    n->scroll = (u16)scroll;
}

/**
 * Moves TextArea cursor to the same column on target line.
 * @param n Pointer to TextArea Node.
 * @param line Target line index.
 */
export void text_area_goto_line(Node *n, i32 line) {
    i32 total = line_of(n, n->len) + 1;
    if (line < 0) { line = 0; }
    if (line >= total) { line = total - 1; }
    i32 cur_start = line_start(n, line_of(n, n->cursor));
    i32 col = n->cursor - cur_start;
    i32 start = line_start(n, line);
    i32 llen = line_len_at(n, start);
    if (col > llen) { col = llen; }
    n->cursor = (u16)(start + col);
}

/**
 * Handles multi-line editing and navigation keyboard events for a TextArea node.
 * @param n Pointer to TextArea Node.
 * @param type Keyboard event type (EVT_CHAR or EVT_DOWN).
 * @param code Key code or ASCII character.
 * @param mods Active modifier keys bitmask.
 * @return EditResult enum indicating outcome (Changed, Moved, Unhandled).
 */
export EditResult text_area_handle(Node *n, i32 type, i32 code, i32 mods) {
    bool ro = is_readonly(n);
    i32 cur = n->cursor;
    i32 len = n->len;
    if (type == EVT_CHAR) {
        if (ro) { return EditResult::Unhandled; }
        if (code >= 0x20) {
            if (code <= 0x7E) {
                input_insert(n, code);
                text_area_reveal_cursor(n);
                return EditResult::Changed;
            }
        }
        return EditResult::Unhandled;
    }
    if (type != EVT_DOWN) { return EditResult::Unhandled; }
    if (code == KEY_ENTER) {
        if (ro) { return EditResult::Unhandled; }
        input_insert(n, 10);
        text_area_reveal_cursor(n);
        return EditResult::Changed;
    }
    if (code == KEY_BACKSPACE) {
        if (ro) { return EditResult::Unhandled; }
        if (cur > 0) {
            input_delete_at(n, cur - 1);
            n->cursor = (u16)(cur - 1);
            text_area_reveal_cursor(n);
            return EditResult::Changed;
        }
        return EditResult::Unhandled;
    }
    if (code == KEY_DELETE) {
        if (ro) { return EditResult::Unhandled; }
        if (cur < len) {
            input_delete_at(n, cur);
            return EditResult::Changed;
        }
        return EditResult::Unhandled;
    }
    if (code == KEY_LEFT) {
        if (cur > 0) { n->cursor = (u16)(cur - 1); }
        text_area_reveal_cursor(n);
        return EditResult::Moved;
    }
    if (code == KEY_RIGHT) {
        if (cur < len) { n->cursor = (u16)(cur + 1); }
        text_area_reveal_cursor(n);
        return EditResult::Moved;
    }
    if (code == KEY_UP) {
        text_area_goto_line(n, line_of(n, cur) - 1);
        text_area_reveal_cursor(n);
        return EditResult::Moved;
    }
    if (code == KEY_DOWN) {
        text_area_goto_line(n, line_of(n, cur) + 1);
        text_area_reveal_cursor(n);
        return EditResult::Moved;
    }
    if (code == KEY_PAGE_UP) {
        text_area_goto_line(n, line_of(n, cur) - visible_lines(n));
        text_area_reveal_cursor(n);
        return EditResult::Moved;
    }
    if (code == KEY_PAGE_DOWN) {
        text_area_goto_line(n, line_of(n, cur) + visible_lines(n));
        text_area_reveal_cursor(n);
        return EditResult::Moved;
    }
    if (code == KEY_HOME) {
        n->cursor = (u16)line_start(n, line_of(n, cur));
        return EditResult::Moved;
    }
    if (code == KEY_END) {
        i32 start = line_start(n, line_of(n, cur));
        n->cursor = (u16)(start + line_len_at(n, start));
        return EditResult::Moved;
    }
    return EditResult::Unhandled;
}

/**
 * Appends a null-terminated string to a TextArea, dropping oldest lines if capacity is exceeded.
 * @param id DOM Node ID of TextArea.
 * @param s Null-terminated string to append.
 */
export void append_text(i32 id, char *s) {
    Node *n = dom.node_ptr(id);
    if (n == 0) { return; }
    if (n->kind != NodeKind::TEXT_AREA) { return; }
    char *buf = (char*)n->text;
    i32 cap = n->cap;
    i32 add = 0;
    while (s[add] != 0) { add++; }
    i32 len = n->len;
    if (len + add + 1 > cap) {
        // Drop whole lines from the front until it fits (or everything).
        i32 need = len + add + 1 - cap;
        i32 drop = 0;
        while (drop < len) {
            if (drop >= need) {
                if (buf[drop - 1] == 10) { break; }
            }
            drop++;
        }
        i32 i = 0;
        while (drop + i < len) {
            buf[i] = buf[drop + i];
            i++;
        }
        len = len - drop;
        if (len < 0) { len = 0; }
    }
    i32 i = 0;
    while (i < add) {
        if (len + 1 >= cap) { break; }
        buf[len] = s[i];
        len++;
        i++;
    }
    buf[len] = (char)0;
    n->len = (u16)len;
    n->cursor = (u16)len;
    text_area_reveal_cursor(n);
    dom.damage_node(id);
    dom.touch();
}

/**
 * Appends raw bytes from a memory address to a TextArea, filtering non-printable ASCII.
 * @param id DOM Node ID of TextArea.
 * @param addr Pointer/address of source buffer.
 * @param count Number of bytes to read and append.
 */
export void append_bytes(i32 id, i32 addr, i32 count) {
    char tmp[64];
    i32 n = 0;
    i32 i = 0;
    while (i < count) {
        char *p = (char*)(addr + i);
        i32 c = (i32)(*p) & 0xFF;
        i32 keep = 0;
        if (c == 10) { keep = 1; }
        if (c >= 0x20) { if (c <= 0x7E) { keep = 1; } }
        if (keep != 0) {
            tmp[n] = (char)c;
            n++;
            if (n == 63) {
                tmp[n] = (char)0;
                append_text(id, &tmp[0]);
                n = 0;
            }
        }
        i++;
    }
    tmp[n] = (char)0;
    if (n > 0) { append_text(id, &tmp[0]); }
}

/**
 * Empties all text content and resets cursor and scroll position in a TextArea.
 * @param id DOM Node ID of TextArea.
 */
export void clear_text_area(i32 id) {
    Node *n = dom.node_ptr(id);
    if (n == 0) { return; }
    if (dom.owns_buffer(n) == 0) { return; }
    char *buf = (char*)n->text;
    buf[0] = (char)0;
    n->len = 0;
    n->cursor = 0;
    n->scroll = 0;
    n->sel = 0;
    dom.damage_node(id);
    dom.touch();
}

/**
 * Scrolls a TextArea or List node by a relative number of lines.
 * @param id DOM Node ID.
 * @param lines Line delta (negative = scroll up, positive = scroll down).
 */
export void scroll_by(i32 id, i32 lines) {
    Node *n = dom.node_ptr(id);
    if (n == 0) { return; }
    if (n->kind != NodeKind::TEXT_AREA) { if (n->kind != NodeKind::LIST) { return; } }
    i32 total = line_of(n, n->len) + 1;
    i32 rows = visible_lines(n);
    i32 max_scroll = total - rows;
    if (max_scroll < 0) { max_scroll = 0; }
    i32 scroll = n->scroll + lines;
    if (scroll < 0) { scroll = 0; }
    if (scroll > max_scroll) { scroll = max_scroll; }
    if (scroll != n->scroll) {
        n->scroll = (u16)scroll;
        dom.damage_node(id);
    }
}

/**
 * Handles mouse wheel scroll events over a node.
 * @param id DOM Node ID.
 * @param steps Scroll step count (positive = wheel forward/up).
 */
export void dispatch_wheel(i32 id, i32 steps) {
    if (steps == 0) { return; }
    scroll_by(id, -steps * 3);
}

// --- List ---
// Items are newline-separated in the node's buffer; `sel` is the selected
// row + 1. A click selects a row (on_change); clicking the selected row again
// or pressing Enter activates it (on_click).

/**
 * Populates a List node with newline-separated item strings.
 * @param id DOM Node ID of List.
 * @param items Newline-separated list of items.
 */
export void list_set_items(i32 id, char *items) {
    Node *n = dom.node_ptr(id);
    if (n == 0) { return; }
    if (n->kind != NodeKind::LIST) { return; }
    char *buf = (char*)n->text;
    i32 cap = n->cap;
    i32 i = 0;
    for (; items[i] != 0 && i + 1 < cap; i++) {
        buf[i] = items[i];
    }
    buf[i] = (char)0;
    n->len = (u16)i;
    n->sel = 0;
    n->scroll = 0;
    dom.damage_node(id);
    dom.touch();
}

/**
 * Returns the currently selected row index in a List, or None if no selection.
 * @param id DOM Node ID of List.
 * @return Option containing 0-based row index, or None.
 */
export Option<i32> list_selected(i32 id) {
    Node *n = dom.node_ptr(id);
    if (n == 0) { return None; }
    if (n->sel == 0) { return None; }
    return Some(n->sel - 1);
}

/**
 * Returns total row count of a List node.
 * @param id DOM Node ID of List.
 * @return Total number of rows.
 */
export i32 list_count(i32 id) {
    Node *n = dom.node_ptr(id);
    if (n == 0) { return 0; }
    if (n->len == 0) { return 0; }
    return line_of(n, n->len) + 1;
}

/**
 * Retrieves the text of a specific item in a List node.
 * @param id DOM Node ID of List.
 * @param index 0-based item index.
 * @param out Destination buffer for item string.
 * @param cap Buffer capacity in bytes.
 * @return Option containing string length copied, or None on error.
 */
export Option<i32> list_item(i32 id, i32 index, char *out, i32 cap) {
    Node *n = dom.node_ptr(id);
    if (n == 0) { return None; }
    if (index < 0) { return None; }
    if (index >= list_count(id)) { return None; }
    i32 start = line_start(n, index);
    i32 llen = line_len_at(n, start);
    char *buf = (char*)n->text;
    i32 i = 0;
    while (i < llen) {
        if (i + 1 >= cap) { break; }
        out[i] = buf[start + i];
        i++;
    }
    out[i] = (char)0;
    return Some(i);
}

/**
 * Sets the active selected row in a List node, scrolling it into view.
 * @param id DOM Node ID of List.
 * @param index 0-based item index to select.
 */
export void list_select(i32 id, i32 index) {
    Node *n = dom.node_ptr(id);
    if (n == 0) { return; }
    i32 count = list_count(id);
    if (index < 0) { n->sel = 0; }
    else if (index >= count) { n->sel = 0; }
    else {
        n->sel = (u16)(index + 1);
        // keep it in view
        i32 rows = visible_lines(n);
        i32 scroll = n->scroll;
        if (index < scroll) { scroll = index; }
        if (index >= scroll + rows) { scroll = index - rows + 1; }
        n->scroll = (u16)scroll;
    }
    dom.damage_node(id);
    dom.touch();
}

/**
 * Determines which row of a List is located at display point (px, py).
 * @param id DOM Node ID of List.
 * @param px Target X coordinate.
 * @param py Target Y coordinate.
 * @return Option containing 0-based row index, or None.
 */
export Option<i32> list_row_at(i32 id, i32 px, i32 py) {
    Node *n = dom.node_ptr(id);
    if (n == 0) { return None; }
    i32 s = dom.ui_scale();
    i32 pad = 8 * s;
    i32 lh = graphics.text_height(0, s);
    i32 rel = py - n->y - pad;
    if (rel < 0) { return None; }
    i32 row = rel / lh + n->scroll;
    if (row >= list_count(id)) { return None; }
    return Some(row);
}

/**
 * Handles mouse click on a List control: selects the row or triggers activation if re-clicked.
 * @param id DOM Node ID of List.
 * @param px Click X coordinate.
 * @param py Click Y coordinate.
 */
export void list_click(i32 id, i32 px, i32 py) {
    Node *n = dom.node_ptr(id);
    if (n == 0) { return; }
    i32 row = case list_row_at(id, px, py) of { Some(v) -> v; None -> ({ return; }); };
    i32 was = n->sel - 1;
    list_select(id, row);
    if (row == was) {
        dom.emit(n, UiEventKind::ACTIVATE, n->on_click, 0);
    } else {
        dom.fire_change(n);
    }
}

/**
 * Handles keyboard navigation (arrows/Home/End/Enter) on a focused List control.
 * @param n Pointer to List Node.
 * @param type Keyboard event type.
 * @param code Key code.
 * @return EditResult enum indicating outcome (Moved or Unhandled).
 */
export EditResult list_handle(Node *n, i32 type, i32 code) {
    if (type != EVT_DOWN) { return EditResult::Unhandled; }
    i32 id = n->id;
    i32 sel = n->sel - 1;
    i32 count = list_count(id);
    if (count == 0) { return EditResult::Unhandled; }
    if (code == KEY_UP) {
        if (sel > 0) { list_select(id, sel - 1); } else { list_select(id, 0); }
        dom.fire_change(n);
        return EditResult::Moved;
    }
    if (code == KEY_DOWN) {
        if (sel + 1 < count) { list_select(id, sel + 1); }
        dom.fire_change(n);
        return EditResult::Moved;
    }
    if (code == KEY_HOME) { list_select(id, 0); dom.fire_change(n); return EditResult::Moved; }
    if (code == KEY_END) { list_select(id, count - 1); dom.fire_change(n); return EditResult::Moved; }
    if (code == KEY_ENTER) {
        if (sel >= 0) {
            dom.emit(n, UiEventKind::ACTIVATE, n->on_click, 0);
        }
        return EditResult::Moved;
    }
    return EditResult::Unhandled;
}

// --- popup menu ---
// One menu at a time, a top-level node on the desktop drawn above everything.
// Items are newline-separated; hovering highlights a row, clicking one calls
// handler(index) after closing. Escape or a click elsewhere closes it.

/**
 * Closes and removes the currently open popup menu from the desktop.
 */
export void close_menu() {
    if (dom.get_g_menu_id() == 0) { return; }
    i32 id = dom.get_g_menu_id();
    dom.set_g_menu_id(0);
    dom.set_g_menu_handler(0);
    dom.remove_node(id);
    dom.touch();
}

/**
 * Returns the DOM Node ID of the active popup menu, or 0 if none is open.
 * @return Menu DOM Node ID.
 */
export i32 menu_id() {
    return dom.get_g_menu_id();
}

/**
 * Returns the target Node ID associated with the open popup menu.
 * @return Target DOM Node ID.
 */
export i32 menu_target() {
    return dom.get_g_menu_target();
}

/**
 * Opens a popup menu at display coordinates (x, y) with newline-separated items.
 * @param x Display X position.
 * @param y Display Y position.
 * @param items Newline-separated list of menu options.
 * @param handler Callback function pointer invoked on selection: fn(index).
 * @param target Associated target Node ID.
 * @return Menu DOM Node ID.
 */
export i32 open_menu(i32 x, i32 y, char *items, i32 handler, i32 target) {
    close_menu();
    i32 s = dom.ui_scale();
    i32 count = 1;
    i32 i = 0;
    i32 widest = 0;
    i32 line_w = 0;
    while (items[i] != 0) {
        if (items[i] == 10) {
            count++;
            line_w = 0;
        } else {
            line_w++;
        }
        i++;
    }
    i32 lh = graphics.text_height(0, s);
    i32 pad = 8 * s;
    i32 h = count * lh + 2 * pad;
    i32 w = graphics.text_width(items, 0, s);
    // text_width measures the whole string; a rough width from the longest
    // item is enough for a menu, so measure per line instead.
    w = 0;
    i32 start = 0;
    i32 j = 0;
    while (1) {
        if (items[j] == 10) {
            items[j] = (char)0;
            i32 lw = graphics.text_width(&items[start], 0, s);
            items[j] = (char)10;
            if (lw > w) { w = lw; }
            start = j + 1;
        } else if (items[j] == 0) {
            i32 lw = graphics.text_width(&items[start], 0, s);
            if (lw > w) { w = lw; }
            break;
        }
        j++;
    }
    w = w + 4 * pad;
    if (w < 140 * s) { w = 140 * s; }
    i32 dw = graphics.display_width();
    i32 dh = graphics.display_height();
    if (x + w > dw) { x = dw - w; }
    if (y + h > dh) { y = dh - h; }
    if (x < 0) { x = 0; }
    if (y < 0) { y = 0; }

    i32 id = dom.create_node(NodeKind::MENU, "menu");
    dom.set_role(id, NodeRole::MENU);
    Node *n = dom.node_ptr(id);
    i32 cap = i + 2;
    char *buf = (char*)heap.alloc(cap);
    i32 k = 0;
    while (k < i) { buf[k] = items[k]; k++; }
    buf[i] = (char)0;
    n->text = buf;
    n->cap = (u16)cap;
    n->len = (u16)i;
    n->x = (u16)x;
    n->y = (u16)y;
    n->w = (u16)w;
    n->h = (u16)h;
    n->sel = 0;
    n->on_change = 0;
    dom.set_state_flag(id, NodeState::VISIBLE, 1);
    dom.set_state_flag(id, NodeState::HIT_TESTABLE, 1);
    // Appended to the desktop like a window, but painted last (see
    // paint_desktop) and hit-tested first (see find_at).
    dom.append_child(dom.get_g_desktop_node_id(), id);
    // append_child translated by the desktop origin (0,0): bounds stand.
    dom.set_g_menu_id(id);
    dom.set_g_menu_handler(handler);
    dom.set_g_menu_target(target);
    dom.touch();
    return id;
}

/**
 * Updates highlighted row in active popup menu based on mouse hover position.
 * @param px Cursor display X coordinate.
 * @param py Cursor display Y coordinate.
 */
export void menu_hover(i32 px, i32 py) {
    i32 id = dom.get_g_menu_id();
    Node *n = dom.node_ptr(id);
    if (n == 0) { return; }
    i32 next = case list_row_at(id, px, py) of {
        Some(r) -> r + 1;
        None -> 0;
    };
    if (next != n->sel) {
        n->sel = (u16)next;
        dom.damage_node(id);
    }
}

/**
 * Handles mouse click on active popup menu, invoking callback and closing menu.
 * @param px Cursor display X coordinate.
 * @param py Cursor display Y coordinate.
 */
export void menu_click(i32 px, i32 py) {
    i32 id = dom.get_g_menu_id();
    if (id == 0) { return; }
    Option<i32> row = list_row_at(id, px, py);
    i32 handler = dom.get_g_menu_handler();
    close_menu();
    case row of {
        Some(r) -> ({
            if (handler != 0) { handler(r); }
        });
        None -> _;
    };
}

// --- Tab focus ---
// Focusable controls are visited in tree order within the active window.

/**
 * Tests whether a DOM node can accept keyboard focus.
 * @param n Pointer to DOM Node.
 * @return True if focusable, false otherwise.
 */
export bool is_focusable(Node *n) {
    if ((n->state & NodeState::VISIBLE) == 0) { return false; }
    i32 k = n->kind;
    if (k == NodeKind::TEXT_INPUT) { return true; }
    if (k == NodeKind::TEXT_AREA) { return true; }
    if (k == NodeKind::BUTTON) { return true; }
    if (k == NodeKind::CHECKBOX) { return true; }
    if (k == NodeKind::LIST) { return true; }
    return false;
}

// Depth-first walk collecting focusable ids into g_focus_ring.
i32 g_focus_ring[64];
i32 g_focus_ring_count = 0;

/**
 * Recursively collects all focusable node IDs in a subtree into the focus ring.
 * @param id Root DOM Node ID of subtree.
 */
export void collect_focusable(i32 id) {
    Node *n = dom.node_ptr(id);
    if (n == 0) { return; }
    if (is_focusable(n)) {
        if (g_focus_ring_count < ui_config.FOCUS_MAX) {
            g_focus_ring[g_focus_ring_count] = id;
            g_focus_ring_count++;
        }
    }
    i32 child = n->first_child;
    while (child != 0) {
        collect_focusable(child);
        child = dom.next_sibling(child);
    }
}

/**
 * Moves keyboard focus to next or previous focusable control in the active window.
 * @param backwards Non-zero to move focus backward (Shift-Tab), 0 forward (Tab).
 */
export void focus_next(i32 backwards) {
    i32 win = dom.get_g_active_window();
    if (win == 0) { return; }
    g_focus_ring_count = 0;
    collect_focusable(win);
    if (g_focus_ring_count == 0) { return; }

    Option<i32> cur = None;
    i32 i = 0;
    while (i < g_focus_ring_count) {
        if (g_focus_ring[i] == dom.get_g_focus_id()) {
            cur = Some(i);
            break;
        }
        i++;
    }

    i32 next_idx = 0;
    case cur of {
        Some(idx) -> ({
            if (backwards != 0) {
                if (idx == 0) { next_idx = g_focus_ring_count - 1; }
                else { next_idx = idx - 1; }
            } else {
                if (idx + 1 >= g_focus_ring_count) { next_idx = 0; }
                else { next_idx = idx + 1; }
            }
        });
        None -> ({
            if (backwards != 0) {
                next_idx = g_focus_ring_count - 1;
            } else {
                next_idx = 0;
            }
        });
    };

    set_focus(g_focus_ring[next_idx]);
}

/**
 * Dispatches a keyboard event to the currently focused node or handles window/menu shortcuts.
 * @param type Event type (EVT_CHAR or EVT_DOWN).
 * @param code Key code or ASCII character.
 * @param mods Active modifier bitmask (e.g. MOD_SHIFT).
 */
export void dispatch_key_event(i32 type, i32 code, i32 mods) {
    if (type == EVT_DOWN) {
        if (code == KEY_ESCAPE) {
            if (dom.get_g_menu_id() != 0) { close_menu(); return; }
        }
        if (code == KEY_TAB) {
            focus_next(mods & MOD_SHIFT);
            return;
        }
        // App shortcuts (@key) for the active window's app go first.
        i32 filter = dom.key_filter();
        if (filter != 0) {
            i32 claimed = filter(dom.owner_of(dom.get_g_active_window()), code, mods);
            if (claimed != 0) { return; }
        }
    }
    Node *n = dom.node_ptr(dom.get_g_focus_id());
    if (n == 0) { return; }
    i32 id = dom.get_g_focus_id();
    if (type == EVT_DOWN) {
        i32 handler = n->on_key;
        if (handler != 0) {
            // Runs inline, unlike the queued handlers: it decides whether
            // the key goes on to the widget, which cannot wait.
            i32 claimed = handler(n->owner, id, code | (mods << 16));
            if (claimed != 0) { return; }
        }
    }
    i32 kind = n->kind;
    if (kind == NodeKind::TEXT_INPUT) {
        EditResult r = input_handle(n, type, code);
        case r of {
            EditResult::Changed -> ({
                dom.damage_node(id);
                dom.touch();
                dom.fire_change(n);
            });
            EditResult::Moved -> ({
                dom.damage_node(id);
                dom.touch();
            });
            EditResult::Unhandled -> _;
        };
        return;
    }
    if (kind == NodeKind::TEXT_AREA) {
        EditResult r = text_area_handle(n, type, code, mods);
        case r of {
            EditResult::Changed -> ({
                dom.damage_node(id);
                dom.touch();
                dom.fire_change(n);
            });
            EditResult::Moved -> ({
                dom.damage_node(id);
                dom.touch();
            });
            EditResult::Unhandled -> _;
        };
        return;
    }
    if (kind == NodeKind::LIST) {
        list_handle(n, type, code);
        return;
    }
    if (type == EVT_DOWN) {
        if (kind == NodeKind::BUTTON) {
            if (code == KEY_ENTER) { dom.dispatch_click(id); return; }
            if (code == KEY_SPACE) { dom.dispatch_click(id); return; }
        }
        if (kind == NodeKind::CHECKBOX) {
            if (code == KEY_SPACE) { dom.dispatch_click(id); return; }
        }
    }
}

/**
 * Sets text content of a TextInput node, updating length, cursor and redrawing.
 * @param id DOM Node ID of TextInput.
 * @param s Replacement string.
 */
export void set_input_text(i32 id, char *s) {
    Node *n = dom.node_ptr(id);
    if (n == 0) { return; }
    if (n->kind != NodeKind::TEXT_INPUT) { return; }
    char *buf = (char*)n->text;
    i32 cap = n->cap;
    i32 i = 0;
    for (; s[i] != 0 && i + 1 < cap; i++) {
        buf[i] = s[i];
    }
    buf[i] = (char)0;
    n->len = (u16)i;
    n->cursor = (u16)i;
    dom.damage_node(id);
    dom.touch();
}

// --- timers --------------------------------------------------------------------------------------

// Queue every registered timer whose period has elapsed. The compositor
// calls this once per pass and drains the queue afterwards.
export void tick() {
    i32 *g_timer_ids = dom.get_g_timer_ids();
    i32 now = scheduler.ticks();
    i32 i = 0;
    while (i < dom.get_g_timer_count()) {
        i32 id = g_timer_ids[i];
        Node *t = dom.node_ptr(id);
        if (t != 0) {
            if (now >= t->next_due) {
                t->next_due = now + t->interval;
                dom.emit(t, UiEventKind::TIMER, t->on_tick, 0);
            }
        }
        i++;
    }
}

/**
 * Creates and registers a recurring timer with a given interval and callback.
 * @param interval Periodic interval in system ticks.
 * @param handler Server-side tick callback, or 0 for an app timer (its
 * ticks are TIMER events to the owner).
 * @return Timer DOM Node ID.
 */
export i32 create_timer(i32 interval, i32 handler) {
    i32 *g_timer_ids = dom.get_g_timer_ids();
    i32 id = dom.create_node(NodeKind::TIMER, "timer");
    Node *t = dom.node_ptr(id);
    t->interval = interval;
    t->on_tick = handler;
    t->next_due = scheduler.ticks() + interval;
    if (dom.get_g_timer_count() < dom.get_TIMER_MAX()) {
        g_timer_ids[dom.get_g_timer_count()] = id;
        dom.set_g_timer_count(dom.get_g_timer_count() + 1);
    }
    return id;
}

