package dom_widgets;

import scheduler from "@kernel/kernel/scheduler.mln";
import ui_metrics from "@os/ui/ui_metrics.mln";
import dom from "dom.mln";
import { NodeRow } from "dom_model.mln";
import { Blob } from "@std/memory/blob.mln";
import { UiEventKind } from "@os/ui/events.mln";
import dom_focus from "dom_focus.mln";
import dom_list from "dom_list.mln";
import dom_menu from "dom_menu.mln";
import dom_text_edit from "dom_text_edit.mln";
import { EditResult } from "dom_text_edit.mln";
import { NodeKind, NodeState, NewNode } from "dom.mln";
import { Option } from "@std/core/option.mln";
import { Result } from "@std/core/result.mln";
import { NodeId, UiError } from "@contracts/ui/widget.contract.mln";
import { Pid } from "@contracts/process/control.contract.mln";
import { KeyEventType, KeyModifier, KeyCode } from "@contracts/input/keyboard.contract.mln";

// Window management, key dispatch and timers. The controls themselves live
// beside this module: text editing in dom_text_edit, lists in dom_list, the
// popup menu in dom_menu and keyboard focus in dom_focus.

fn(Option<Pid> owner, NodeId id, i32 arg) -> void close_handler_or_zero(NodeId id) {
    return case dom.on_close_of(id) of {
        Ok(Some(handler)) -> handler;
        Ok(None) -> 0;
        Err(_) -> 0;
    };
}

// --- window management ---------------------------------------------------------------------

/**
 * Returns the height of the taskbar node in display pixels, as laid out.
 * ui_metrics.taskbar_height() is the theme's logical height instead.
 * @return Taskbar node height in display pixels, or 0 without a taskbar.
 */
export i32 taskbar_node_height() {
    return case dom.row_in(dom.taskbar_id()) of { Some(n) -> n.h; None -> 0; };
}

/**
 * Activates a window, bringing it to front and focusing it.
 * @param win Window DOM Node ID.
 */
export void focus_window(NodeId win) {
    borrow NodeRow n = case dom.find_row(win) of { Some(row) -> row; None -> ({ return; }); };
    if (n.kind != NodeKind::WINDOW) { return; }
    if (n.state & NodeState::MINIMIZED) {
        dom.set_state_flag(win, NodeState::MINIMIZED, 0);
        dom.set_state_flag(win, NodeState::VISIBLE, 1);
    }
    if (!dom.holds(dom.active_window_id(), win)) {
        case dom.active_window_id() of {
            Some(active) -> dom.set_state_flag(active, NodeState::FOCUSED, 0);
            None -> _;
        };
        dom.set_active_window_id(Some(win));
        dom.set_state_flag(win, NodeState::FOCUSED, 1);
        if (!dom_focus.focus_is_in(win)) { dom_focus.clear_focus(); }
        dom.damage_taskbar(); // the active entry's highlight moved
    }
    dom.bring_to_front(win);
}

/**
 * Activates the topmost unminimized window on the desktop.
 */
export void activate_topmost() {
    Option<NodeId> top = None;
    for (NodeId child_id in dom.children(dom.desktop_id())) {
        borrow NodeRow c = dom.row_of(child_id);
        if (c.kind == NodeKind::WINDOW) {
            if (!(c.state & NodeState::MINIMIZED)) { top = Some(child_id); }
        }
    }
    case top of {
        Some(win) -> focus_window(win);
        None -> dom.set_active_window_id(None);
    };
    dom.damage_taskbar();
}

// The user closed a window. A window with an on_close handler is handed to
// its app (queued, so the app framework runs the handler and then removes
// everything the instance owns); any other window is removed here.
/**
 * Closes a window by queuing its close callback or removing it immediately.
 * @param win DOM node ID of the window to close.
 */
export void close_window(NodeId win) {
    fn(Option<Pid> owner, NodeId id, i32 arg) -> void handler = close_handler_or_zero(win);
    if (handler != 0) {
        Option<Pid> owner = dom.owner_of(win).unwrap_or(None);
        dom.push_event(handler, owner, win, 0);
        return;
    }
    dom.remove_node(win);
    activate_topmost();
}

/**
 * Resizes a window in place, enforcing minimum dimensions and damaging invalidated areas.
 * @param win Window DOM Node ID.
 * @param w Target width in pixels.
 * @param h Target height in pixels.
 */
export void resize_window(NodeId win, i32 w, i32 h) {
    borrow NodeRow n = case dom.find_row(win) of { Some(row) -> row; None -> ({ return; }); };
    i32 s = dom.ui_scale();
    i32 min_w = 200 * s;
    i32 min_h = 120 * s;
    if (w < min_w) { w = min_w; }
    if (h < min_h) { h = min_h; }
    dom.damage_row(&n);
    n.w = (u16)w;
    n.h = (u16)h;
    dom.damage_row(&n);
    dom.touch();
}

/**
 * Minimizes a window to the taskbar, hiding its visible contents.
 * @param win Window DOM Node ID.
 */
export void minimize_window(NodeId win) {
    if (!dom.node_exists(win)) { return; }
    dom.set_state_flag(win, NodeState::MINIMIZED, 1);
    dom.set_state_flag(win, NodeState::VISIBLE, 0);
    if (dom_focus.focus_is_in(win)) { dom_focus.clear_focus(); }
    if (dom.holds(dom.active_window_id(), win)) {
        dom.set_state_flag(win, NodeState::FOCUSED, 0);
        dom.set_active_window_id(None);
        activate_topmost();
    }
    dom.damage_taskbar();
    dom.touch();
}

/**
 * Checks whether a window is currently maximized.
 * @param win Window DOM Node ID.
 * @return True if maximized, false otherwise.
 */
export bool is_maximized(NodeId win) {
    return dom.get_state_flag(win, NodeState::MAXIMIZED);
}

/**
 * Toggles a window between maximized full-desktop state and previous restored bounds.
 * @param win Window DOM Node ID.
 */
export void maximize_window(NodeId win) {
    borrow NodeRow n = case dom.find_row(win) of { Some(row) -> row; None -> ({ return; }); };
    if (n.state & NodeState::MAXIMIZED) {
        i32 rx = n.sx;
        i32 ry = n.sy;
        dom.move_node(win, rx - n.x, ry - n.y);
        resize_window(win, n.sw, n.sh);
        dom.set_state_flag(win, NodeState::MAXIMIZED, 0);
        return;
    }
    n.sx = n.x;
    n.sy = n.y;
    n.sw = n.w;
    n.sh = n.h;
    i32 dw = ui_metrics.display_width();
    i32 dh = ui_metrics.display_height() - taskbar_node_height();
    dom.move_node(win, -n.x, -n.y);
    resize_window(win, dw, dh);
    dom.set_state_flag(win, NodeState::MAXIMIZED, 1);
}

// --- keys ----------------------------------------------------------------------------------------

// Installed by the shell: filter(owner, code, mods) sees every key DOWN
// before the focused widget and returns true to claim it (shortcuts).
bool no_key_filter(Option<Pid> owner, i32 code, i32 mods) { return false; }
fn(Option<Pid> owner, i32 code, i32 mods) -> bool g_key_filter = no_key_filter;

/**
 * Installs the key-down filter called before the focused widget receives a key.
 * @param handler Callback (owner, key_code, modifiers) returning true to consume the key.
 */
export void set_key_filter(fn(Option<Pid> owner, i32 code, i32 mods) -> bool handler) { g_key_filter = handler; }

/**
 * Dispatches a keyboard event to the currently focused node or handles window/menu shortcuts.
 * @param type KeyEventType value from the shared keyboard contract.
 * @param code Key code or ASCII character.
 * @param mods Active KeyModifier bitmask.
 */
export void dispatch_key_event(i32 type, i32 code, i32 mods) {
    if (type == KeyEventType::DOWN) {
        if (code == KeyCode::ESCAPE) {
            if (dom_menu.menu_id().is_some()) { dom_menu.close_menu(); return; }
        }
        if (code == KeyCode::TAB) {
            dom_focus.focus_next(mods & KeyModifier::SHIFT);
            return;
        }
        // App shortcuts (@key) for the active window's app go first.
        fn(Option<Pid> owner, i32 code, i32 mods) -> bool filter = g_key_filter;
        case dom.row_in(dom.active_window_id()) of {
            Some(win) -> ({ if (filter(win.owner, code, mods)) { return; } });
            None -> _;
        };
    }
    borrow NodeRow n = case dom.row_in(dom.focus_id()) of { Some(row) -> row; None -> ({ return; }); };
    NodeId id = n.id;
    i32 kind = n.kind;
    if (kind == NodeKind::TEXT_INPUT) {
        EditResult r = dom_text_edit.input_handle(&n, type, code);
        case r of {
            EditResult::Changed -> ({
                dom.damage_row(&n);
                dom.touch();
                dom.fire_change(&n);
            });
            EditResult::Moved -> ({
                dom.damage_row(&n);
                dom.touch();
            });
            EditResult::Unhandled -> _;
        };
        return;
    }
    if (kind == NodeKind::TEXT_AREA) {
        EditResult r = dom_text_edit.text_area_handle(&n, type, code, mods);
        case r of {
            EditResult::Changed -> ({
                dom.damage_row(&n);
                dom.touch();
                dom.fire_change(&n);
            });
            EditResult::Moved -> ({
                dom.damage_row(&n);
                dom.touch();
            });
            EditResult::Unhandled -> _;
        };
        return;
    }
    if (kind == NodeKind::LIST) {
        dom_list.list_handle(&n, type, code);
        return;
    }
    if (type == KeyEventType::DOWN) {
        if (kind == NodeKind::BUTTON) {
            if (code == KeyCode::ENTER) { dom.dispatch_click(id); return; }
            if (code == KeyCode::SPACE) { dom.dispatch_click(id); return; }
        }
        if (kind == NodeKind::CHECKBOX) {
            if (code == KeyCode::SPACE) { dom.dispatch_click(id); return; }
        }
    }
}

// --- timers --------------------------------------------------------------------------------------

// Queue every registered timer whose period has elapsed. The compositor
// calls this once per pass and drains the queue afterwards.
/**
 * Queues callbacks for all registered timers whose deadlines have elapsed.
 */
export void tick() {
    i32 now = scheduler.ticks();
    i32 i = 0;
    while (i < dom.timer_count()) {
        NodeId id = dom.timer_id_at(i);
        case dom.find_row(id) of {
            Some(t) -> ({
                if (now >= t.next_due) {
                    t.next_due = now + t.interval;
                    dom.emit(&t, UiEventKind::TIMER, t.on_tick, 0);
                }
            });
            None -> _;
        };
        i++;
    }
}

/**
 * Creates and registers a recurring timer with a given interval and callback.
 * @param interval Periodic interval in system ticks.
 * @param handler Server-side tick callback, or 0 to deliver TIMER events to the owning app.
 * @return Timer DOM Node ID.
 */
export Result<NodeId, UiError> create_timer(
    i32 interval, fn(Option<Pid> owner, NodeId id, i32 arg) -> void handler) {
    NewNode node = NewNode { id: dom.create_node(NodeKind::TIMER, "timer")? };
    borrow NodeRow t = dom.row_of(node.id);
    t.interval = interval;
    t.on_tick = handler;
    t.next_due = scheduler.ticks() + interval;
    dom.register_timer(node.id)?;
    return Ok(node.keep());
}
