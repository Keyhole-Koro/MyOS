package dom_widgets;
import debug from "@kernel/debug/debug.mln";
import blob from "@std/memory/blob.mln";
import scheduler from "@kernel/kernel/scheduler.mln";
import ui_metrics from "@os/ui/ui_metrics.mln";
import { halt_cpu } from "@kernel/arch/halt.masm";
import dom from "dom.mln";
import { NodeRow } from "dom_model.mln";
import { Blob } from "@std/memory/blob.mln";
import { UiEventKind } from "@os/ui/events.mln";
import ui_config from "@os/ui/config.mln";
import { NodeKind, NodeRole, NodeState, NodeStyle, Children, NewNode } from "dom.mln";
import { Option } from "@std/core/option.mln";
import { Result } from "@std/core/result.mln";
import { Text } from "@std/text/text.mln";
import ascii from "@std/text/ascii.mln";
import str from "@std/text/str.mln";
import { NodeId, UiError } from "@contracts/ui/widget.contract.mln";
import { KeyEventType, KeyModifier, KeyCode } from "@contracts/input/keyboard.contract.mln";

fn(i32 owner, NodeId id, i32 arg) -> void close_handler_or_zero(NodeId id) {
    Result<Option<fn(i32 owner, NodeId id, i32 arg) -> void>, UiError> result =
        dom.on_close_of(id);
    return case result of {
        Ok(Some(handler)) -> handler;
        Ok(None) -> 0;
        Err(_) -> 0;
    };
}

/** Result of applying a keyboard edit to a text-input widget. */
export enum EditResult {
    Unhandled,
    Changed,
    Moved,
}

// --- focus / window management -----------------------------------------------------------

/**
 * Returns height of the taskbar in display pixels (or 0 if none).
 * @return Taskbar height in pixels.
 */
export i32 taskbar_height() {
    return case dom.row_in(dom.taskbar_id()) of { Some(n) -> n.h; None -> 0; };
}

/**
 * Returns the DOM Node ID of the active window.
 * @return Active window Node ID.
 */
export Option<NodeId> active_window() {
    return dom.active_window_id();
}

/**
 * Takes keyboard focus away from the focused node, if there is one.
 */
export void clear_focus() {
    case dom.focus_id() of {
        Some(id) -> dom.set_state_flag(id, NodeState::FOCUSED, 0);
        None -> _;
    };
    dom.clear_focus_id();
}

// Whether the focused node, if any, is inside a window.
bool focus_is_in(NodeId win) {
    return case dom.focus_id() of {
        Some(id) -> dom.holds(dom.enclosing_window(id), win);
        None -> false;
    };
}

/**
 * Sets keyboard focus to a node, updating FOCUSED state flags. A dead ID
 * clears focus.
 * @param id DOM Node ID to focus.
 */
export void set_focus(NodeId id) {
    if (dom.holds(dom.focus_id(), id)) { return; }
    clear_focus();
    if (!dom.node_exists(id)) { return; }
    dom.set_focus_id(id);
    dom.set_state_flag(id, NodeState::FOCUSED, 1);
}

/**
 * Activates a window, bringing it to front and focusing it.
 * @param win Window DOM Node ID.
 */
export void focus_window(NodeId win) {
    borrow NodeRow n = case dom.find_row(win) of { Some(row) -> row; None -> ({ return; }); };
    if (n.kind != NodeKind::WINDOW) { return; }
    if (n.state & NodeState::MINIMIZED) {
        dom.set_state_flag(win, NodeState::MINIMIZED, 0);
        dom.set_state_flag(win, NodeState::VISIBLE, 1);
    }
    if (!dom.holds(dom.active_window_id(), win)) {
        case dom.active_window_id() of {
            Some(active) -> dom.set_state_flag(active, NodeState::FOCUSED, 0);
            None -> _;
        };
        dom.set_active_window_id(win);
        dom.set_state_flag(win, NodeState::FOCUSED, 1);
        if (!focus_is_in(win)) { clear_focus(); }
        dom.damage_taskbar(); // the active entry's highlight moved
    }
    dom.bring_to_front(win);
}

// The byte at `index`, or zero past the end.
i32 byte_of(str s, i32 index) {
    return s.byte(index);
}

/**
 * Activates the topmost unminimized window on the desktop.
 */
export void activate_topmost() {
    Option<NodeId> top = None;
    for (NodeId child_id in dom.children(dom.desktop_id())) {
        borrow NodeRow c = dom.row_of(child_id);
        if (c.kind == NodeKind::WINDOW) {
            if (!(c.state & NodeState::MINIMIZED)) { top = Some(child_id); }
        }
    }
    case top of {
        Some(win) -> focus_window(win);
        None -> dom.clear_active_window_id();
    };
    dom.damage_taskbar();
}

// The user closed a window. A window with an on_close handler is handed to
// its app (queued, so the app framework runs the handler and then removes
// everything the instance owns); any other window is removed here.
/**
 * Closes a window by queuing its close callback or removing it immediately.
 * @param win DOM node ID of the window to close.
 */
export void close_window(NodeId win) {
    fn(i32 owner, NodeId id, i32 arg) -> void handler = close_handler_or_zero(win);
    if (handler != 0) {
        dom.push_event(handler, dom.owner_of(win).unwrap_or(0), win, 0);
        return;
    }
    dom.remove_node(win);
    activate_topmost();
}

/**
 * Resizes a window in place, enforcing minimum dimensions and damaging invalidated areas.
 * @param win Window DOM Node ID.
 * @param w Target width in pixels.
 * @param h Target height in pixels.
 */
export void resize_window(NodeId win, i32 w, i32 h) {
    borrow NodeRow n = case dom.find_row(win) of { Some(row) -> row; None -> ({ return; }); };
    i32 s = dom.ui_scale();
    i32 min_w = 200 * s;
    i32 min_h = 120 * s;
    if (w < min_w) { w = min_w; }
    if (h < min_h) { h = min_h; }
    dom.damage_row(n);
    n.w = (u16)w;
    n.h = (u16)h;
    dom.damage_row(n);
    dom.touch();
}

/**
 * Minimizes a window to the taskbar, hiding its visible contents.
 * @param win Window DOM Node ID.
 */
export void minimize_window(NodeId win) {
    if (!dom.node_exists(win)) { return; }
    dom.set_state_flag(win, NodeState::MINIMIZED, 1);
    dom.set_state_flag(win, NodeState::VISIBLE, 0);
    if (focus_is_in(win)) { clear_focus(); }
    if (dom.holds(dom.active_window_id(), win)) {
        dom.set_state_flag(win, NodeState::FOCUSED, 0);
        dom.clear_active_window_id();
        activate_topmost();
    }
    dom.damage_taskbar();
    dom.touch();
}

/**
 * Checks whether a window is currently maximized.
 * @param win Window DOM Node ID.
 * @return True if maximized, false otherwise.
 */
export bool is_maximized(NodeId win) {
    return dom.get_state_flag(win, NodeState::MAXIMIZED);
}

/**
 * Toggles a window between maximized full-desktop state and previous restored bounds.
 * @param win Window DOM Node ID.
 */
export void maximize_window(NodeId win) {
    borrow NodeRow n = case dom.find_row(win) of { Some(row) -> row; None -> ({ return; }); };
    if (n.state & NodeState::MAXIMIZED) {
        i32 rx = n.sx;
        i32 ry = n.sy;
        dom.move_node(win, rx - n.x, ry - n.y);
        resize_window(win, n.sw, n.sh);
        dom.set_state_flag(win, NodeState::MAXIMIZED, 0);
        return;
    }
    n.sx = n.x;
    n.sy = n.y;
    n.sw = n.w;
    n.sh = n.h;
    i32 dw = ui_metrics.display_width();
    i32 dh = ui_metrics.display_height() - taskbar_height();
    dom.move_node(win, -n.x, -n.y);
    resize_window(win, dw, dh);
    dom.set_state_flag(win, NodeState::MAXIMIZED, 1);
}

// --- keyboard --------------------------------------------------------------------------------

/**
 * Inserts a character into a text buffer at current cursor position.
 * @param n Pointer to DOM Node.
 * @param c ASCII character code to insert.
 */
export void input_insert(borrow NodeRow n, i32 c) {
    i32 len = n.len;
    i32 cap = n.cap;
    if (len + 1 >= cap) { return; }
    Blob buf = n.text;
    i32 cur = n.cursor;
    i32 i = len;
    while (i > cur) {
        buf.put(i, buf.at(i - 1));
        i--;
    }
    buf.put(cur, (char)c);
    buf.put(len + 1, (char)0);
    n.len = (u16)(len + 1);
    n.cursor = (u16)(cur + 1);
}

/**
 * Deletes character at specified index in a text node buffer.
 * @param n Pointer to DOM Node.
 * @param at Byte index of character to remove.
 */
export void input_delete_at(borrow NodeRow n, i32 at) {
    i32 len = n.len;
    if (at < 0) { return; }
    if (at >= len) { return; }
    Blob buf = n.text;
    i32 i = at;
    while (i < len - 1) {
        buf.put(i, buf.at(i + 1));
        i++;
    }
    buf.put(len - 1, (char)0);
    n.len = (u16)(len - 1);
}

/**
 * Handles default editing keyboard events for a single-line TextInput node.
 * @param n Pointer to TextInput Node.
 * @param type KeyEventType value from the shared keyboard contract.
 * @param code Key code or ASCII character.
 * @return EditResult enum indicating outcome (Changed, Moved, Unhandled).
 */
export EditResult input_handle(borrow NodeRow n, i32 type, i32 code) {
    i32 cur = n.cursor;
    i32 len = n.len;
    if (type == KeyEventType::CHAR) {
        if (ascii.is_printable(code)) {
            input_insert(n, code);
            return EditResult::Changed;
        }
        return EditResult::Unhandled;
    }
    if (type != KeyEventType::DOWN) { return EditResult::Unhandled; }
    if (code == KeyCode::BACKSPACE) {
        if (cur > 0) {
            input_delete_at(n, cur - 1);
            n.cursor = (u16)(cur - 1);
            return EditResult::Changed;
        }
        return EditResult::Unhandled;
    }
    if (code == KeyCode::DELETE) {
        if (cur < len) { input_delete_at(n, cur); return EditResult::Changed; }
        return EditResult::Unhandled;
    }
    if (code == KeyCode::LEFT) {
        if (cur > 0) { n.cursor = (u16)(cur - 1); }
        return EditResult::Moved;
    }
    if (code == KeyCode::RIGHT) {
        if (cur < len) { n.cursor = (u16)(cur + 1); }
        return EditResult::Moved;
    }
    if (code == KeyCode::HOME) { n.cursor = 0; return EditResult::Moved; }
    if (code == KeyCode::END) { n.cursor = (u16)len; return EditResult::Moved; }
    return EditResult::Unhandled;
}

// Route one keyboard event (type = keyboard.EVT_*, code = key code or
// character) to the focused node; text inputs get their default editing
// behaviour.
// --- multi-line text (TextArea) ---
// The buffer holds the whole document with '\n' separators; `cursor` is a
// byte index, `scroll` the first visible line. Editing shares the insert/
// delete helpers with TextInput and adds newline, vertical movement and
// keeping the caret's line in view.

/**
 * Checks whether a node has the READONLY style bit set.
 * @param n Pointer to DOM Node.
 * @return True if read-only, false otherwise.
 */
export bool is_readonly(borrow NodeRow n) {
    return (n.style & NodeStyle::READONLY) != 0;
}

/**
 * Finds the 0-based line index containing byte offset `at` in a text buffer.
 * @param n Pointer to TextArea Node.
 * @param at Byte offset in text buffer.
 * @return 0-based line number.
 */
export i32 line_of(borrow NodeRow n, i32 at) {
    Blob buf = n.text;
    i32 line = 0;
    i32 i = 0;
    while (i < at) {
        if (buf.at(i) == 10) { line++; }
        i++;
    }
    return line;
}

/**
 * Returns the byte offset corresponding to the start of a given line index.
 * @param n Pointer to TextArea Node.
 * @param line 0-based line index.
 * @return Byte offset of line start.
 */
export i32 line_start(borrow NodeRow n, i32 line) {
    Blob buf = n.text;
    i32 len = n.len;
    i32 i = 0;
    i32 cur = 0;
    while (cur < line) {
        if (i >= len) { return len; }
        if (buf.at(i) == 10) { cur++; }
        i++;
    }
    return i;
}

/**
 * Computes byte length of a line starting at `start` (excluding newline).
 * @param n Pointer to TextArea Node.
 * @param start Byte offset of line start.
 * @return Line length in bytes.
 */
export i32 line_len_at(borrow NodeRow n, i32 start) {
    Blob buf = n.text;
    i32 len = n.len;
    i32 i = start;
    while (i < len) {
        if (buf.at(i) == 10) { return i - start; }
        i++;
    }
    return len - start;
}

/**
 * Returns total line count of a TextArea node.
 * @param id DOM Node ID.
 * @return Ok(line count), or Err when the node is missing or is not a TextArea.
 */
export Result<i32, UiError> text_area_line_count(NodeId id) {
    borrow NodeRow n = dom.require_row(id)?;
    if (n.kind != NodeKind::TEXT_AREA) { return Err(UiError::WrongNodeKind(id)); }
    return Ok(line_of(n, n.len) + 1);
}

/**
 * Calculates number of visible lines fitting inside a TextArea or List.
 * @param n Pointer to DOM Node.
 * @return Number of visible text lines.
 */
export i32 visible_lines(borrow NodeRow n) {
    i32 s = dom.ui_scale();
    i32 pad = 8 * s;
    i32 lh = ui_metrics.text_height(0, s);
    i32 rows = (n.h - 2 * pad) / lh;
    if (rows < 1) { rows = 1; }
    return rows;
}

/**
 * Adjusts TextArea scroll offset to ensure the cursor line is visible.
 * @param n Pointer to TextArea Node.
 */
export void text_area_reveal_cursor(borrow NodeRow n) {
    i32 line = line_of(n, n.cursor);
    i32 rows = visible_lines(n);
    i32 scroll = n.scroll;
    if (line < scroll) { scroll = line; }
    if (line >= scroll + rows) { scroll = line - rows + 1; }
    n.scroll = (u16)scroll;
}

/**
 * Moves TextArea cursor to the same column on target line.
 * @param n Pointer to TextArea Node.
 * @param line Target line index.
 */
export void text_area_goto_line(borrow NodeRow n, i32 line) {
    i32 total = line_of(n, n.len) + 1;
    if (line < 0) { line = 0; }
    if (line >= total) { line = total - 1; }
    i32 cur_start = line_start(n, line_of(n, n.cursor));
    i32 col = n.cursor - cur_start;
    i32 start = line_start(n, line);
    i32 llen = line_len_at(n, start);
    if (col > llen) { col = llen; }
    n.cursor = (u16)(start + col);
}

/**
 * Handles multi-line editing and navigation keyboard events for a TextArea node.
 * @param n Pointer to TextArea Node.
 * @param type KeyEventType value from the shared keyboard contract.
 * @param code Key code or ASCII character.
 * @param mods Active modifier keys bitmask.
 * @return EditResult enum indicating outcome (Changed, Moved, Unhandled).
 */
export EditResult text_area_handle(borrow NodeRow n, i32 type, i32 code, i32 mods) {
    bool ro = is_readonly(n);
    i32 cur = n.cursor;
    i32 len = n.len;
    if (type == KeyEventType::CHAR) {
        if (ro) { return EditResult::Unhandled; }
        if (ascii.is_printable(code)) {
            input_insert(n, code);
            text_area_reveal_cursor(n);
            return EditResult::Changed;
        }
        return EditResult::Unhandled;
    }
    if (type != KeyEventType::DOWN) { return EditResult::Unhandled; }
    if (code == KeyCode::ENTER) {
        if (ro) { return EditResult::Unhandled; }
        input_insert(n, 10);
        text_area_reveal_cursor(n);
        return EditResult::Changed;
    }
    if (code == KeyCode::BACKSPACE) {
        if (ro) { return EditResult::Unhandled; }
        if (cur > 0) {
            input_delete_at(n, cur - 1);
            n.cursor = (u16)(cur - 1);
            text_area_reveal_cursor(n);
            return EditResult::Changed;
        }
        return EditResult::Unhandled;
    }
    if (code == KeyCode::DELETE) {
        if (ro) { return EditResult::Unhandled; }
        if (cur < len) {
            input_delete_at(n, cur);
            return EditResult::Changed;
        }
        return EditResult::Unhandled;
    }
    if (code == KeyCode::LEFT) {
        if (cur > 0) { n.cursor = (u16)(cur - 1); }
        text_area_reveal_cursor(n);
        return EditResult::Moved;
    }
    if (code == KeyCode::RIGHT) {
        if (cur < len) { n.cursor = (u16)(cur + 1); }
        text_area_reveal_cursor(n);
        return EditResult::Moved;
    }
    if (code == KeyCode::UP) {
        text_area_goto_line(n, line_of(n, cur) - 1);
        text_area_reveal_cursor(n);
        return EditResult::Moved;
    }
    if (code == KeyCode::DOWN) {
        text_area_goto_line(n, line_of(n, cur) + 1);
        text_area_reveal_cursor(n);
        return EditResult::Moved;
    }
    if (code == KeyCode::PAGE_UP) {
        text_area_goto_line(n, line_of(n, cur) - visible_lines(n));
        text_area_reveal_cursor(n);
        return EditResult::Moved;
    }
    if (code == KeyCode::PAGE_DOWN) {
        text_area_goto_line(n, line_of(n, cur) + visible_lines(n));
        text_area_reveal_cursor(n);
        return EditResult::Moved;
    }
    if (code == KeyCode::HOME) {
        n.cursor = (u16)line_start(n, line_of(n, cur));
        return EditResult::Moved;
    }
    if (code == KeyCode::END) {
        i32 start = line_start(n, line_of(n, cur));
        n.cursor = (u16)(start + line_len_at(n, start));
        return EditResult::Moved;
    }
    return EditResult::Unhandled;
}

/**
 * Appends a null-terminated string to a TextArea, dropping oldest lines if capacity is exceeded.
 * @param id DOM Node ID of TextArea.
 * @param s Null-terminated string to append.
 */
export void append_text(NodeId id, str s) {
    borrow NodeRow n = case dom.find_row(id) of { Some(row) -> row; None -> ({ return; }); };
    if (n.kind != NodeKind::TEXT_AREA) { return; }
    Blob buf = n.text;
    i32 cap = n.cap;
    i32 add = s.length;
    i32 len = n.len;
    if (len + add + 1 > cap) {
        // Drop whole lines from the front until it fits (or everything).
        i32 need = len + add + 1 - cap;
        i32 drop = 0;
        while (drop < len) {
            if (drop >= need) {
                if (buf.at(drop - 1) == 10) { break; }
            }
            drop++;
        }
        i32 i = 0;
        while (drop + i < len) {
            buf.put(i, buf.at(drop + i));
            i++;
        }
        len = len - drop;
        if (len < 0) { len = 0; }
    }
    i32 i = 0;
    while (i < add) {
        if (len + 1 >= cap) { break; }
        buf.put(len, byte_of(s, i));
        len++;
        i++;
    }
    buf.put(len, (char)0);
    n.len = (u16)len;
    n.cursor = (u16)len;
    text_area_reveal_cursor(n);
    dom.damage_row(n);
    dom.touch();
}

/**
 * Appends bytes to a TextArea, filtering non-printable ASCII.
 * @param id DOM Node ID of TextArea.
 * @param bytes Source bytes.
 */
export void append_bytes(NodeId id, str bytes) {
    Text<64> tmp = Text<64> {};
    tmp.clear();
    i32 i = 0;
    while (i < bytes.length) {
        i32 c = byte_of(bytes, i);
        bool keep = c == '\n' || ascii.is_printable(c);
        if (keep) {
            if (!tmp.push((u8)c)) {
                append_text(id, tmp.as_str());
                tmp.clear();
                tmp.push((u8)c);
            }
        }
        i++;
    }
    if (!tmp.is_empty()) { append_text(id, tmp.as_str()); }
}

/**
 * Empties all text content and resets cursor and scroll position in a TextArea.
 * @param id DOM Node ID of TextArea.
 */
export void clear_text_area(NodeId id) {
    borrow NodeRow n = case dom.find_row(id) of { Some(row) -> row; None -> ({ return; }); };
    if (!n.text.is_live()) { return; }
    Blob buf = n.text;
    buf.put(0, (char)0);
    n.len = 0;
    n.cursor = 0;
    n.scroll = 0;
    n.sel = None;
    dom.damage_row(n);
    dom.touch();
}

/**
 * Scrolls a TextArea or List node by a relative number of lines.
 * @param id DOM Node ID.
 * @param lines Line delta (negative = scroll up, positive = scroll down).
 */
export void scroll_by(NodeId id, i32 lines) {
    borrow NodeRow n = case dom.find_row(id) of { Some(row) -> row; None -> ({ return; }); };
    if (n.kind != NodeKind::TEXT_AREA) { if (n.kind != NodeKind::LIST) { return; } }
    i32 total = line_of(n, n.len) + 1;
    i32 rows = visible_lines(n);
    i32 max_scroll = total - rows;
    if (max_scroll < 0) { max_scroll = 0; }
    i32 scroll = n.scroll + lines;
    if (scroll < 0) { scroll = 0; }
    if (scroll > max_scroll) { scroll = max_scroll; }
    if (scroll != n.scroll) {
        n.scroll = (u16)scroll;
        dom.damage_row(n);
    }
}

/**
 * Handles mouse wheel scroll events over a node.
 * @param id DOM Node ID.
 * @param steps Scroll step count (positive = wheel forward/up).
 */
export void dispatch_wheel(NodeId id, i32 steps) {
    if (steps == 0) { return; }
    scroll_by(id, -steps * 3);
}

// --- List ---
// Items are newline-separated in the node's buffer; `sel` is the selected
// row. A click selects a row (on_change); clicking the selected row again
// or pressing Enter activates it (on_click).

/**
 * Populates a List node with newline-separated item strings.
 * @param id DOM Node ID of List.
 * @param items Newline-separated list of items.
 */
export void list_set_items(NodeId id, str items) {
    borrow NodeRow n = case dom.find_row(id) of { Some(row) -> row; None -> ({ return; }); };
    if (n.kind != NodeKind::LIST) { return; }
    Blob buf = n.text;
    i32 cap = n.cap;
    i32 i = 0;
    for (; i < items.length && i + 1 < cap; i++) {
        buf.put(i, byte_of(items, i));
    }
    buf.put(i, (char)0);
    n.len = (u16)i;
    n.sel = None;
    n.scroll = 0;
    dom.damage_row(n);
    dom.touch();
}

/**
 * Returns the currently selected row index in a List. No selection is a
 * successful `None`; an invalid node is an error.
 * @param id DOM Node ID of List.
 * @return Result containing an optional 0-based row index.
 */
export Result<Option<i32>, UiError> list_selected(NodeId id) {
    borrow NodeRow n = dom.require_row(id)?;
    if (n.kind != NodeKind::LIST) { return Err(UiError::WrongNodeKind(id)); }
    return Ok(n.sel);
}

/**
 * Returns total row count of a List node.
 * @param id DOM Node ID of List.
 * @return Ok(row count), or Err when the node is missing or is not a List.
 */
export Result<i32, UiError> list_count(NodeId id) {
    borrow NodeRow n = dom.require_row(id)?;
    if (n.kind != NodeKind::LIST) { return Err(UiError::WrongNodeKind(id)); }
    if (n.len == 0) { return Ok(0); }
    return Ok(line_of(n, n.len) + 1);
}

/**
 * Retrieves the text of a specific item in a List node.
 * @param id DOM Node ID of List.
 * @param index 0-based item index.
 * @return A view of the row, valid until the list next changes.
 */
export Result<str, UiError> list_item(NodeId id, i32 index) {
    borrow NodeRow n = dom.require_row(id)?;
    if (n.kind != NodeKind::LIST) { return Err(UiError::WrongNodeKind(id)); }
    Result<i32, UiError> count_result = list_count(id);
    i32 count = count_result?;
    if (index < 0 || index >= count) { return Err(UiError::InvalidIndex(index)); }
    i32 start = line_start(n, index);
    i32 llen = line_len_at(n, start);
    str all = n.text.view(n.len);
    return case all.slice(start, start + llen) of {
        Some(line) -> Ok(line);
        None -> Err(UiError::InvalidIndex(index));
    };
}

/**
 * Sets the active selected row in a List node, scrolling it into view.
 * @param id DOM Node ID of List.
 * @param index 0-based item index to select.
 */
export void list_select(NodeId id, i32 index) {
    borrow NodeRow n = case dom.find_row(id) of { Some(row) -> row; None -> ({ return; }); };
    i32 count = line_of(n, n.len) + 1;
    if (n.len == 0) { count = 0; }
    if (index < 0 || index >= count) { n.sel = None; }
    else {
        n.sel = Some(index);
        // keep it in view
        i32 rows = visible_lines(n);
        i32 scroll = n.scroll;
        if (index < scroll) { scroll = index; }
        if (index >= scroll + rows) { scroll = index - rows + 1; }
        n.scroll = (u16)scroll;
    }
    dom.damage_row(n);
    dom.touch();
}

/**
 * Determines which row of a List is located at display point (px, py).
 * @param id DOM Node ID of List.
 * @param px Target X coordinate.
 * @param py Target Y coordinate.
 * @return Option containing 0-based row index, or None.
 */
export Option<i32> list_row_at(NodeId id, i32 px, i32 py) {
    borrow NodeRow n = case dom.find_row(id) of { Some(row) -> row; None -> ({ return None; }); };
    i32 s = dom.ui_scale();
    i32 pad = 8 * s;
    i32 lh = ui_metrics.text_height(0, s);
    i32 rel = py - n.y - pad;
    if (rel < 0) { return None; }
    i32 row = rel / lh + n.scroll;
    // A popup menu lays its items out like a List (see open_menu).
    if (n.kind != NodeKind::LIST && n.kind != NodeKind::MENU) { return None; }
    i32 count = line_of(n, n.len) + 1;
    if (n.len == 0) { count = 0; }
    if (row >= count) { return None; }
    return Some(row);
}

/**
 * Handles mouse click on a List control: selects the row or triggers activation if re-clicked.
 * @param id DOM Node ID of List.
 * @param px Click X coordinate.
 * @param py Click Y coordinate.
 */
export void list_click(NodeId id, i32 px, i32 py) {
    borrow NodeRow n = case dom.find_row(id) of { Some(row) -> row; None -> ({ return; }); };
    i32 row = case list_row_at(id, px, py) of { Some(v) -> v; None -> ({ return; }); };
    bool again = case n.sel of { Some(was) -> was == row; None -> false; };
    list_select(id, row);
    if (again) {
        dom.emit(n, UiEventKind::ACTIVATE, n.on_click, 0);
    } else {
        dom.fire_change(n);
    }
}

/**
 * Handles keyboard navigation (arrows/Home/End/Enter) on a focused List control.
 * @param n Pointer to List Node.
 * @param type Keyboard event type.
 * @param code Key code.
 * @return EditResult enum indicating outcome (Moved or Unhandled).
 */
export EditResult list_handle(borrow NodeRow n, i32 type, i32 code) {
    if (type != KeyEventType::DOWN) { return EditResult::Unhandled; }
    NodeId id = n.id;
    i32 count = line_of(n, n.len) + 1;
    if (n.len == 0) { count = 0; }
    if (count == 0) { return EditResult::Unhandled; }
    if (code == KeyCode::UP) {
        i32 above = case n.sel of { Some(row) -> row - 1; None -> 0; };
        list_select(id, above > 0 ? above : 0);
        dom.fire_change(n);
        return EditResult::Moved;
    }
    if (code == KeyCode::DOWN) {
        i32 below = case n.sel of { Some(row) -> row + 1; None -> 0; };
        if (below < count) { list_select(id, below); }
        dom.fire_change(n);
        return EditResult::Moved;
    }
    if (code == KeyCode::HOME) { list_select(id, 0); dom.fire_change(n); return EditResult::Moved; }
    if (code == KeyCode::END) { list_select(id, count - 1); dom.fire_change(n); return EditResult::Moved; }
    if (code == KeyCode::ENTER) {
        if (n.sel.is_some()) {
            dom.emit(n, UiEventKind::ACTIVATE, n.on_click, 0);
        }
        return EditResult::Moved;
    }
    return EditResult::Unhandled;
}

// --- popup menu ---
// One menu at a time, a top-level node on the desktop drawn above everything.
// Items are newline-separated; hovering highlights a row, clicking one calls
// handler(index) after closing. Escape or a click elsewhere closes it.

/**
 * Closes and removes the currently open popup menu from the desktop.
 */
export void close_menu() {
    case dom.menu_id() of {
        Some(id) -> ({
            dom.clear_menu_state();
            dom.remove_node(id);
            dom.touch();
        });
        None -> _;
    };
}

/**
 * Returns the DOM Node ID of the active popup menu, if one is open.
 * @return Menu DOM Node ID.
 */
export Option<NodeId> menu_id() {
    return dom.menu_id();
}

/**
 * Returns the target Node ID associated with the open popup menu.
 * @return Target DOM Node ID.
 */
export Option<NodeId> menu_target() {
    return dom.menu_target();
}

/**
 * Opens a popup menu at display coordinates (x, y) with newline-separated items.
 * @param x Display X position.
 * @param y Display Y position.
 * @param items Newline-separated list of menu options.
 * @param handler Callback function pointer invoked on selection: fn(index).
 * @param target Associated target Node ID, if the menu acts on one.
 * @return Menu DOM Node ID.
 */
export Result<NodeId, UiError> open_menu(i32 x, i32 y, str items,
                                         fn(i32 index) -> void handler, Option<NodeId> target) {
    close_menu();
    i32 s = dom.ui_scale();
    i32 count = 1;
    i32 i = 0;
    i32 widest = 0;
    i32 line_w = 0;
    while (i < items.length) {
        if (byte_of(items, i) == 10) {
            count++;
            line_w = 0;
        } else {
            line_w++;
        }
        i++;
    }
    i32 lh = ui_metrics.text_height(0, s);
    i32 pad = 8 * s;
    i32 h = count * lh + 2 * pad;
    i32 w = ui_metrics.text_width(items, 0, s);
    // text_width measures the whole string; a rough width from the longest
    // item is enough for a menu, so measure per line instead.
    w = 0;
    i32 start = 0;
    i32 j = 0;
    while (j <= items.length) {
        if (j == items.length || byte_of(items, j) == 10) {
            str line = case items.slice(start, j) of { Some(view) -> view; None -> ""; };
            i32 lw = ui_metrics.text_width(line, 0, s);
            if (lw > w) { w = lw; }
            start = j + 1;
        }
        j++;
    }
    w = w + 4 * pad;
    if (w < 140 * s) { w = 140 * s; }
    i32 dw = ui_metrics.display_width();
    i32 dh = ui_metrics.display_height();
    if (x + w > dw) { x = dw - w; }
    if (y + h > dh) { y = dh - h; }
    if (x < 0) { x = 0; }
    if (y < 0) { y = 0; }

    NewNode node = NewNode { id: dom.create_node(NodeKind::MENU, "menu")? };
    NodeId id = node.id;
    dom.set_role(id, NodeRole::MENU);
    borrow NodeRow n = dom.row_of(id);
    i32 cap = i + 2;
    Blob buf = case blob.blob_new(cap) of {
        Some(value) -> value;
        None -> ({ return Err(UiError::AllocationFailed(cap)); });
    };
    i32 k = 0;
    while (k < i) { buf.put(k, byte_of(items, k)); k++; }
    buf.put(i, (char)0);
    n.text = buf;
    n.cap = (u16)cap;
    n.len = (u16)i;
    n.x = (u16)x;
    n.y = (u16)y;
    n.w = (u16)w;
    n.h = (u16)h;
    n.on_change = 0;
    dom.set_state_flag(id, NodeState::VISIBLE, 1);
    dom.set_state_flag(id, NodeState::HIT_TESTABLE, 1);
    // Appended to the desktop like a window, but painted last (see
    // paint_desktop) and hit-tested first (see dom_hit_test.find_at).
    dom.append_child(dom.desktop_id(), id)?;
    // append_child translated by the desktop origin (0,0): bounds stand.
    dom.set_menu_state(id, handler, target);
    dom.touch();
    return Ok(node.keep());
}

// Whether two optional rows name the same row, or both none.
bool same_row(Option<i32> a, Option<i32> b) {
    return case a of {
        Some(x) -> case b of { Some(y) -> x == y; None -> false; };
        None -> b.is_none();
    };
}

/**
 * Updates highlighted row in active popup menu based on mouse hover position.
 * @param px Cursor display X coordinate.
 * @param py Cursor display Y coordinate.
 */
export void menu_hover(i32 px, i32 py) {
    borrow NodeRow n = case dom.row_in(dom.menu_id()) of { Some(row) -> row; None -> ({ return; }); };
    Option<i32> next = list_row_at(n.id, px, py);
    if (!same_row(next, n.sel)) {
        n.sel = next;
        dom.damage_row(n);
    }
}

/**
 * Handles mouse click on active popup menu, invoking callback and closing menu.
 * @param px Cursor display X coordinate.
 * @param py Cursor display Y coordinate.
 */
export void menu_click(i32 px, i32 py) {
    NodeId id = case dom.menu_id() of { Some(value) -> value; None -> ({ return; }); };
    Option<i32> row = list_row_at(id, px, py);
    fn(i32 index) -> void handler = dom.menu_handler();
    close_menu();
    case row of {
        Some(r) -> handler(r);
        None -> _;
    };
}

// --- Tab focus ---
// Focusable controls are visited in tree order within the active window.

/**
 * Tests whether a DOM node can accept keyboard focus.
 * @param n Pointer to DOM Node.
 * @return True if focusable, false otherwise.
 */
export bool is_focusable(borrow NodeRow n) {
    if (!(n.state & NodeState::VISIBLE)) { return false; }
    i32 k = n.kind;
    if (k == NodeKind::TEXT_INPUT) { return true; }
    if (k == NodeKind::TEXT_AREA) { return true; }
    if (k == NodeKind::BUTTON) { return true; }
    if (k == NodeKind::CHECKBOX) { return true; }
    if (k == NodeKind::LIST) { return true; }
    return false;
}

// Depth-first walk collecting focusable ids into g_focus_ring.
NodeId g_focus_ring[64];
i32 g_focus_ring_count = 0;

/**
 * Recursively collects all focusable node IDs in a subtree into the focus ring.
 * @param id Root DOM Node ID of subtree.
 */
export void collect_focusable(NodeId id) {
    borrow NodeRow n = case dom.find_row(id) of { Some(row) -> row; None -> ({ return; }); };
    if (is_focusable(n)) {
        if (g_focus_ring_count < ui_config.FOCUS_MAX) {
            g_focus_ring[g_focus_ring_count] = id;
            g_focus_ring_count++;
        }
    }
    for (NodeId child in dom.children(id)) {
        collect_focusable(child);
    }
}

/**
 * Moves keyboard focus to next or previous focusable control in the active window.
 * @param backwards Non-zero to move focus backward (Shift-Tab), 0 forward (Tab).
 */
export void focus_next(i32 backwards) {
    NodeId win = case dom.active_window_id() of { Some(id) -> id; None -> ({ return; }); };
    g_focus_ring_count = 0;
    collect_focusable(win);
    if (g_focus_ring_count == 0) { return; }

    Option<i32> cur = None;
    i32 i = 0;
    while (i < g_focus_ring_count) {
        if (dom.holds(dom.focus_id(), g_focus_ring[i])) {
            cur = Some(i);
            break;
        }
        i++;
    }

    i32 next_idx = 0;
    case cur of {
        Some(idx) -> ({
            if (backwards) {
                if (idx == 0) { next_idx = g_focus_ring_count - 1; }
                else { next_idx = idx - 1; }
            } else {
                if (idx + 1 >= g_focus_ring_count) { next_idx = 0; }
                else { next_idx = idx + 1; }
            }
        });
        None -> ({
            if (backwards) {
                next_idx = g_focus_ring_count - 1;
            } else {
                next_idx = 0;
            }
        });
    };

    set_focus(g_focus_ring[next_idx]);
}

/**
 * Dispatches a keyboard event to the currently focused node or handles window/menu shortcuts.
 * @param type KeyEventType value from the shared keyboard contract.
 * @param code Key code or ASCII character.
 * @param mods Active KeyModifier bitmask.
 */
export void dispatch_key_event(i32 type, i32 code, i32 mods) {
    if (type == KeyEventType::DOWN) {
        if (code == KeyCode::ESCAPE) {
            if (dom.menu_id().is_some()) { close_menu(); return; }
        }
        if (code == KeyCode::TAB) {
            focus_next(mods & KeyModifier::SHIFT);
            return;
        }
        // App shortcuts (@key) for the active window's app go first.
        fn(i32 owner, i32 code, i32 mods) -> bool filter = dom.key_filter();
        case dom.row_in(dom.active_window_id()) of {
            Some(win) -> ({ if (filter(win.owner, code, mods)) { return; } });
            None -> _;
        };
    }
    borrow NodeRow n = case dom.row_in(dom.focus_id()) of { Some(row) -> row; None -> ({ return; }); };
    NodeId id = n.id;
    i32 kind = n.kind;
    if (kind == NodeKind::TEXT_INPUT) {
        EditResult r = input_handle(n, type, code);
        case r of {
            EditResult::Changed -> ({
                dom.damage_row(n);
                dom.touch();
                dom.fire_change(n);
            });
            EditResult::Moved -> ({
                dom.damage_row(n);
                dom.touch();
            });
            EditResult::Unhandled -> _;
        };
        return;
    }
    if (kind == NodeKind::TEXT_AREA) {
        EditResult r = text_area_handle(n, type, code, mods);
        case r of {
            EditResult::Changed -> ({
                dom.damage_row(n);
                dom.touch();
                dom.fire_change(n);
            });
            EditResult::Moved -> ({
                dom.damage_row(n);
                dom.touch();
            });
            EditResult::Unhandled -> _;
        };
        return;
    }
    if (kind == NodeKind::LIST) {
        list_handle(n, type, code);
        return;
    }
    if (type == KeyEventType::DOWN) {
        if (kind == NodeKind::BUTTON) {
            if (code == KeyCode::ENTER) { dom.dispatch_click(id); return; }
            if (code == KeyCode::SPACE) { dom.dispatch_click(id); return; }
        }
        if (kind == NodeKind::CHECKBOX) {
            if (code == KeyCode::SPACE) { dom.dispatch_click(id); return; }
        }
    }
}

/**
 * Sets text content of a TextInput node, updating length, cursor and redrawing.
 * @param id DOM Node ID of TextInput.
 * @param s Replacement string.
 */
export void set_input_text(NodeId id, str s) {
    borrow NodeRow n = case dom.find_row(id) of { Some(row) -> row; None -> ({ return; }); };
    if (n.kind != NodeKind::TEXT_INPUT) { return; }
    Blob buf = n.text;
    i32 cap = n.cap;
    i32 i = 0;
    for (; i < s.length && i + 1 < cap; i++) {
        buf.put(i, byte_of(s, i));
    }
    buf.put(i, (char)0);
    n.len = (u16)i;
    n.cursor = (u16)i;
    dom.damage_row(n);
    dom.touch();
}

// --- timers --------------------------------------------------------------------------------------

// Queue every registered timer whose period has elapsed. The compositor
// calls this once per pass and drains the queue afterwards.
/**
 * Queues callbacks for all registered timers whose deadlines have elapsed.
 */
export void tick() {
    i32 now = scheduler.ticks();
    i32 i = 0;
    while (i < dom.timer_count()) {
        NodeId id = dom.timer_id_at(i);
        case dom.find_row(id) of {
            Some(t) -> ({
                if (now >= t.next_due) {
                    t.next_due = now + t.interval;
                    dom.emit(t, UiEventKind::TIMER, t.on_tick, 0);
                }
            });
            None -> _;
        };
        i++;
    }
}

/**
 * Creates and registers a recurring timer with a given interval and callback.
 * @param interval Periodic interval in system ticks.
 * @param handler Server-side tick callback, or 0 to deliver TIMER events to the owning app.
 * @return Timer DOM Node ID.
 */
export Result<NodeId, UiError> create_timer(
    i32 interval, fn(i32 owner, NodeId id, i32 arg) -> void handler) {
    NewNode node = NewNode { id: dom.create_node(NodeKind::TIMER, "timer")? };
    borrow NodeRow t = dom.row_of(node.id);
    t.interval = interval;
    t.on_tick = handler;
    t.next_due = scheduler.ticks() + interval;
    dom.register_timer(node.id)?;
    return Ok(node.keep());
}
