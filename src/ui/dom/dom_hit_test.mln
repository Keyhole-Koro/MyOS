package dom_hit_test;

import dom from "dom.mln";
import { NodeRow } from "dom_model.mln";
import { Blob } from "@std/memory/blob.mln";
import { NodeState, Children } from "dom.mln";
import { Option } from "@std/core/option.mln";

// Read-only pointer-to-node lookup. The DOM owns the tree and its state;
// this module owns the traversal policy used by input dispatch and automation.

// Whether a point is inside a row's rectangle; an empty one holds nothing.
bool row_contains(borrow NodeRow n, i32 px, i32 py) {
    if (n.w == 0 || n.h == 0) { return false; }
    return px >= n.x && py >= n.y && px < n.x + n.w && py < n.y + n.h;
}

// The topmost visible, hit-testable node within a row's subtree. Children are
// walked as rows, so a subtree costs one lookup per node.
Option<i32> hit_row(borrow NodeRow n, i32 px, i32 py) {
    if (!(n.state & NodeState::VISIBLE)) { return None; }

    bool inside = row_contains(n, px, py);
    i32 found = 0;
    if (inside) {
        if (n.state & NodeState::HIT_TESTABLE) { found = n.id; }
    }

    // Children of a clipping container cannot be hit outside its bounds.
    if (!inside) {
        if (dom.clips_children(n)) { return None; }
    }

    for (i32 child_id in dom.children(n.id)) {
        case hit_row(dom.row_of(child_id), px, py) of {
            Some(id) -> ({ found = id; });
            None -> _;
        };
    }
    if (found == 0) { return None; }
    return Some(found);
}

// The topmost visible, hit-testable node within a subtree.
Option<i32> hit_test(i32 node_id, i32 px, i32 py) {
    return case dom.find_row(node_id) of {
        Some(n) -> hit_row(n, px, py);
        None -> None;
    };
}

/** Finds the topmost interactive UI node at a display position. */
export Option<i32> find_at(i32 x, i32 y) {
    i32 menu_id = dom.menu_id();
    if (menu_id != 0) {
        case hit_test(menu_id, x, y) of { Some(id) -> ({ return Some(id); }); None -> _; };
    }

    i32 taskbar_id = dom.taskbar_id();
    if (taskbar_id != 0) {
        case hit_test(taskbar_id, x, y) of { Some(id) -> ({ return Some(id); }); None -> _; };
    }

    i32 found = 0;
    for (i32 child_id in dom.children(dom.desktop_id())) {
        if (child_id != taskbar_id) {
            if (child_id != menu_id) {
                case hit_row(dom.row_of(child_id), x, y) of { Some(id) -> ({ found = id; }); None -> _; };
            }
        }
    }
    if (found == 0) { return None; }
    return Some(found);
}
