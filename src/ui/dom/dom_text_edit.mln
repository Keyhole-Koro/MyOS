package dom_text_edit;

import dom from "dom.mln";
import { NodeRow } from "dom_model.mln";
import { Blob } from "@std/memory/blob.mln";
import ui_metrics from "@os/ui/ui_metrics.mln";
import theme from "@os/ui/theme.mln";
import { NodeKind, NodeStyle } from "dom.mln";
import { Option } from "@std/core/option.mln";
import { Text } from "@std/text/text.mln";
import ascii from "@std/text/ascii.mln";
import str from "@std/text/str.mln";
import { NodeId } from "@contracts/ui/widget.contract.mln";
import { KeyEventType, KeyCode, KeyModifier } from "@contracts/input/keyboard.contract.mln";

// Editing for the text controls: a TextInput's line and a TextArea's
// document, each kept in the node's text buffer with `cursor` a byte index.
// dom_widgets routes a key to the focused control; the functions here apply
// it to the row. The line helpers also count and scroll the rows of a List
// or Menu, whose items are lines of the same kind of buffer.

/** Result of applying a keyboard edit to a text-input widget. */
export enum EditResult {
    Unhandled,
    Changed,
    Moved,
}

// --- single-line text (TextInput) -----------------------------------------------------------

/**
 * Inserts a character into a text buffer at current cursor position.
 * @param n DOM Node row.
 * @param c ASCII character code to insert.
 */
export void input_insert(borrow NodeRow n, i32 c) {
    i32 len = n.len;
    i32 cap = n.cap;
    if (len + 1 >= cap) { return; }
    Blob buf = n.text;
    i32 cur = n.cursor;
    i32 i = len;
    while (i > cur) {
        buf.put(i, buf.at(i - 1));
        i--;
    }
    buf.put(cur, (char)c);
    buf.put(len + 1, (char)0);
    n.len = (u16)(len + 1);
    n.cursor = (u16)(cur + 1);
}

/**
 * Deletes character at specified index in a text node buffer.
 * @param n DOM Node row.
 * @param at Byte index of character to remove.
 */
export void input_delete_at(borrow NodeRow n, i32 at) {
    i32 len = n.len;
    if (at < 0) { return; }
    if (at >= len) { return; }
    Blob buf = n.text;
    i32 i = at;
    while (i < len - 1) {
        buf.put(i, buf.at(i + 1));
        i++;
    }
    buf.put(len - 1, (char)0);
    n.len = (u16)(len - 1);
}

/**
 * Handles default editing keyboard events for a single-line TextInput node.
 * @param n TextInput node row.
 * @param type KeyEventType value from the shared keyboard contract.
 * @param code Key code or ASCII character.
 * @return EditResult enum indicating outcome (Changed, Moved, Unhandled).
 */
export EditResult input_handle(borrow NodeRow n, i32 type, i32 code) {
    i32 cur = n.cursor;
    i32 len = n.len;
    if (type == KeyEventType::CHAR) {
        if (ascii.is_printable(code)) {
            input_insert(&n, code);
            return EditResult::Changed;
        }
        return EditResult::Unhandled;
    }
    if (type != KeyEventType::DOWN) { return EditResult::Unhandled; }
    if (code == KeyCode::BACKSPACE) {
        if (cur > 0) {
            input_delete_at(&n, cur - 1);
            n.cursor = (u16)(cur - 1);
            return EditResult::Changed;
        }
        return EditResult::Unhandled;
    }
    if (code == KeyCode::DELETE) {
        if (cur < len) { input_delete_at(&n, cur); return EditResult::Changed; }
        return EditResult::Unhandled;
    }
    if (code == KeyCode::LEFT) {
        if (cur > 0) { n.cursor = (u16)(cur - 1); }
        return EditResult::Moved;
    }
    if (code == KeyCode::RIGHT) {
        if (cur < len) { n.cursor = (u16)(cur + 1); }
        return EditResult::Moved;
    }
    if (code == KeyCode::HOME) { n.cursor = 0; return EditResult::Moved; }
    if (code == KeyCode::END) { n.cursor = (u16)len; return EditResult::Moved; }
    return EditResult::Unhandled;
}

// --- multi-line text (TextArea) -------------------------------------------------------------
// The buffer holds the whole document with '\n' separators; `cursor` is a
// byte index, `scroll` the first visible line. Editing shares the insert/
// delete helpers with TextInput and adds newline, vertical movement and
// keeping the caret's line in view.

/**
 * Checks whether a node has the READONLY style bit set.
 * @param n DOM Node row.
 * @return True if read-only, false otherwise.
 */
export bool is_readonly(borrow NodeRow n) {
    return (n.style & NodeStyle::READONLY) != 0;
}

/**
 * Finds the 0-based line index containing byte offset `at` in a text buffer.
 * @param n TextArea node row.
 * @param at Byte offset in text buffer.
 * @return 0-based line number.
 */
export i32 line_of(borrow NodeRow n, i32 at) {
    Blob buf = n.text;
    i32 line = 0;
    i32 i = 0;
    while (i < at) {
        if (buf.at(i) == 10) { line++; }
        i++;
    }
    return line;
}

/**
 * Returns the byte offset corresponding to the start of a given line index.
 * @param n TextArea node row.
 * @param line 0-based line index.
 * @return Byte offset of line start.
 */
export i32 line_start(borrow NodeRow n, i32 line) {
    Blob buf = n.text;
    i32 len = n.len;
    i32 i = 0;
    i32 cur = 0;
    while (cur < line) {
        if (i >= len) { return len; }
        if (buf.at(i) == 10) { cur++; }
        i++;
    }
    return i;
}

/**
 * Computes byte length of a line starting at `start` (excluding newline).
 * @param n TextArea node row.
 * @param start Byte offset of line start.
 * @return Line length in bytes.
 */
export i32 line_len_at(borrow NodeRow n, i32 start) {
    Blob buf = n.text;
    i32 len = n.len;
    i32 i = start;
    while (i < len) {
        if (buf.at(i) == 10) { return i - start; }
        i++;
    }
    return len - start;
}

/**
 * Calculates number of visible lines fitting inside a TextArea or List.
 * @param n DOM Node row.
 * @return Number of visible text lines.
 */
export i32 visible_lines(borrow NodeRow n) {
    i32 s = dom.ui_scale();
    i32 pad = 8 * s;
    i32 lh = ui_metrics.text_height(0, s);
    i32 rows = (n.h - 2 * pad) / lh;
    if (rows < 1) { rows = 1; }
    return rows;
}

// --- rows ---------------------------------------------------------------------------------------
// What a TextArea draws, scrolls and moves through with Up and Down are its
// rows: its lines, or with NodeStyle::WRAP its lines broken to fit its width,
// after the last space that fits, or mid-word when one word does not fit.
// `scroll` counts rows. A byte where a wrapped row breaks starts the next row.

/** The width a TextArea's text may take: its inside, less room for the scroll thumb. */
export i32 row_width(borrow NodeRow n) {
    i32 s = dom.ui_scale();
    i32 room = n.w - 24 * s;
    return room < 8 * s ? 8 * s : room;
}

/**
 * Where the row that starts at `start` ends: at its newline, at the end of the
 * text, or where a wrapped row breaks.
 * @param n TextArea node row.
 * @param text Its text.
 * @param start A row's first byte.
 * @return The index just past the row's last byte, its newline not included.
 */
export i32 row_end(borrow NodeRow n, str text, i32 start) {
    i32 i = start;
    if ((n.style & NodeStyle::WRAP) == 0) {
        while (i < text.length && text.byte(i) != '\n') { i++; }
        return i;
    }
    i32 s = dom.ui_scale();
    i32 room = row_width(&n);
    i32 used = 0;
    i32 after_space = -1;
    while (i < text.length) {
        i32 c = text.byte(i);
        if (c == '\n') { return i; }
        used = used + ui_metrics.char_width(c, s);
        if (used > room && i > start) {
            if (c == ' ') { return i + 1; }
            return after_space > start ? after_space : i;
        }
        if (c == ' ') { after_space = i + 1; }
        i++;
    }
    return i;
}

/** Where the row after one ending at `end` starts: past a newline, or right there. */
export i32 next_row_start(str text, i32 end) {
    if (end < text.length && text.byte(end) == '\n') { return end + 1; }
    return end;
}

// Whether a row ending at `end` holds the caret at `end`: it does when the row
// ends a line, and a wrapped row's break belongs to the next row.
bool ends_line(str text, i32 end) {
    return end >= text.length || text.byte(end) == '\n';
}

/**
 * The row holding byte `at` of a TextArea.
 * @param n TextArea node row.
 * @param at Byte offset, up to its length.
 * @return 0-based row.
 */
export i32 row_of(borrow NodeRow n, i32 at) {
    str text = n.text.as_str();
    i32 row = 0;
    i32 start = 0;
    while (1) {
        i32 end = row_end(&n, text, start);
        if (at < end || ends_line(text, end) && at == end || end >= text.length) { return row; }
        start = next_row_start(text, end);
        row++;
    }
}

/**
 * The first byte of a row of a TextArea, or of its last row.
 * @param n TextArea node row.
 * @param row 0-based row.
 */
export i32 row_start(borrow NodeRow n, i32 row) {
    str text = n.text.as_str();
    i32 start = 0;
    i32 r = 0;
    while (r < row) {
        i32 end = row_end(&n, text, start);
        if (end >= text.length) { return start; }
        start = next_row_start(text, end);
        r++;
    }
    return start;
}

/** How many rows a TextArea's text takes. */
export i32 row_count(borrow NodeRow n) {
    return row_of(&n, n.len) + 1;
}

/**
 * Adjusts TextArea scroll offset to ensure the cursor's row is visible.
 * @param n TextArea node row.
 */
export void text_area_reveal_cursor(borrow NodeRow n) {
    i32 row = row_of(&n, n.cursor);
    i32 rows = visible_lines(&n);
    i32 scroll = n.scroll;
    if (row < scroll) { scroll = row; }
    if (row >= scroll + rows) { scroll = row - rows + 1; }
    n.scroll = (u16)scroll;
}

/**
 * Moves the caret of a TextArea to a row, as near as it can to where it is
 * across: Up, Down and the page keys keep to a column of the screen.
 * @param n TextArea node row.
 * @param row Target row, clamped to the text.
 */
export void text_area_goto_row(borrow NodeRow n, i32 row) {
    i32 last = row_count(&n) - 1;
    if (row < 0) { row = 0; }
    if (row > last) { row = last; }
    str text = n.text.as_str();
    i32 s = dom.ui_scale();
    i32 here = row_start(&n, row_of(&n, n.cursor));
    Option<str> before = text.slice(here, n.cursor);
    i32 across = case before of { Some(part) -> ui_metrics.text_width(part, false, s); None -> 0; };
    i32 start = row_start(&n, row);
    i32 end = row_end(&n, text, start);
    Option<str> view = text.slice(start, end);
    str piece = case view of { Some(found) -> found; None -> ""; };
    i32 at = start + nearest_boundary(piece, across, s);
    // A wrapped row's break belongs to the row after it.
    if (at == end && !ends_line(text, end) && at > start) { at--; }
    n.cursor = (u16)at;
}

/**
 * Tells a TextArea's app where its caret is, when it asked to know
 * (NodeStyle::REPORT_CARET): the line and the column, counted from 1.
 * @param n TextArea node row.
 */
export void report_caret(borrow NodeRow n) {
    if ((n.style & NodeStyle::REPORT_CARET) == 0) { return; }
    i32 line = line_of(&n, n.cursor);
    i32 column = n.cursor - line_start(&n, line);
    dom.fire_caret(&n, (line + 1) << 16 | (column + 1));
}

/**
 * Handles multi-line editing and navigation keyboard events for a TextArea node.
 * @param n TextArea node row.
 * @param type KeyEventType value from the shared keyboard contract.
 * @param code Key code or ASCII character.
 * @param mods Active modifier keys bitmask.
 * @return EditResult enum indicating outcome (Changed, Moved, Unhandled).
 */
export EditResult text_area_handle(borrow NodeRow n, i32 type, i32 code, i32 mods) {
    bool ro = is_readonly(&n);
    i32 cur = n.cursor;
    i32 len = n.len;
    if (type == KeyEventType::CHAR) {
        if (ro) { return EditResult::Unhandled; }
        if (ascii.is_printable(code)) {
            input_insert(&n, code);
            text_area_reveal_cursor(&n);
            return EditResult::Changed;
        }
        return EditResult::Unhandled;
    }
    if (type != KeyEventType::DOWN) { return EditResult::Unhandled; }
    if (code == KeyCode::ENTER) {
        if (ro) { return EditResult::Unhandled; }
        input_insert(&n, 10);
        text_area_reveal_cursor(&n);
        return EditResult::Changed;
    }
    if (code == KeyCode::BACKSPACE) {
        if (ro) { return EditResult::Unhandled; }
        if (cur > 0) {
            input_delete_at(&n, cur - 1);
            n.cursor = (u16)(cur - 1);
            text_area_reveal_cursor(&n);
            return EditResult::Changed;
        }
        return EditResult::Unhandled;
    }
    if (code == KeyCode::DELETE) {
        if (ro) { return EditResult::Unhandled; }
        if (cur < len) {
            input_delete_at(&n, cur);
            return EditResult::Changed;
        }
        return EditResult::Unhandled;
    }
    if (code == KeyCode::LEFT) {
        if (cur > 0) { n.cursor = (u16)(cur - 1); }
        text_area_reveal_cursor(&n);
        return EditResult::Moved;
    }
    if (code == KeyCode::RIGHT) {
        if (cur < len) { n.cursor = (u16)(cur + 1); }
        text_area_reveal_cursor(&n);
        return EditResult::Moved;
    }
    if (code == KeyCode::UP) {
        text_area_goto_row(&n, row_of(&n, cur) - 1);
        text_area_reveal_cursor(&n);
        return EditResult::Moved;
    }
    if (code == KeyCode::DOWN) {
        text_area_goto_row(&n, row_of(&n, cur) + 1);
        text_area_reveal_cursor(&n);
        return EditResult::Moved;
    }
    if (code == KeyCode::PAGE_UP) {
        text_area_goto_row(&n, row_of(&n, cur) - visible_lines(&n));
        text_area_reveal_cursor(&n);
        return EditResult::Moved;
    }
    if (code == KeyCode::PAGE_DOWN) {
        text_area_goto_row(&n, row_of(&n, cur) + visible_lines(&n));
        text_area_reveal_cursor(&n);
        return EditResult::Moved;
    }
    // Ctrl+Home and Ctrl+End go to either end of the text.
    if (code == KeyCode::HOME && (mods & KeyModifier::CTRL) != 0) {
        n.cursor = 0;
        text_area_reveal_cursor(&n);
        return EditResult::Moved;
    }
    if (code == KeyCode::END && (mods & KeyModifier::CTRL) != 0) {
        n.cursor = (u16)len;
        text_area_reveal_cursor(&n);
        return EditResult::Moved;
    }
    if (code == KeyCode::HOME) {
        n.cursor = (u16)row_start(&n, row_of(&n, cur));
        return EditResult::Moved;
    }
    if (code == KeyCode::END) {
        str text = n.text.as_str();
        i32 start = row_start(&n, row_of(&n, cur));
        i32 end = row_end(&n, text, start);
        // A wrapped row's break belongs to the row after it.
        if (!ends_line(text, end) && end > start) { end--; }
        n.cursor = (u16)end;
        return EditResult::Moved;
    }
    return EditResult::Unhandled;
}

// --- the caret from a click ------------------------------------------------------------------

// The boundary in `line` nearest to `dx` pixels right of where it is drawn:
// the caret goes before the byte at that index.
i32 nearest_boundary(str line, i32 dx, i32 s) {
    if (dx <= 0) { return 0; }
    i32 before = 0;
    i32 k = 0;
    while (k < line.length) {
        Option<str> prefix = line.slice(0, k + 1);
        i32 after = case prefix of { Some(p) -> ui_metrics.text_width(p, false, s); None -> before; };
        if (dx < (before + after) / 2) { return k; }
        before = after;
        k++;
    }
    return line.length;
}

/**
 * Puts the caret of a TextInput or TextArea at the character boundary nearest
 * a click, as the text is drawn (dom_render).
 * @param id DOM Node ID.
 * @param px Click X in display pixels.
 * @param py Click Y in display pixels.
 */
export void place_caret(NodeId id, i32 px, i32 py) {
    borrow NodeRow n = case dom.find_row(id) of { Some(row) -> row; None -> ({ return; }); };
    i32 s = dom.ui_scale();
    str text = n.text.as_str();
    if (n.kind == NodeKind::TEXT_INPUT) {
        n.cursor = (u16)nearest_boundary(text, px - n.x - theme.INPUT_PADDING_X * s, s);
    } else if (n.kind == NodeKind::TEXT_AREA) {
        i32 pad = 8 * s;
        i32 row = (py - n.y - pad) / ui_metrics.text_height(false, s);
        if (row < 0) { row = 0; }
        i32 start = row_start(&n, n.scroll + row);
        i32 end = row_end(&n, text, start);
        Option<str> view = text.slice(start, end);
        str piece = case view of { Some(found) -> found; None -> ""; };
        i32 at = start + nearest_boundary(piece, px - n.x - pad, s);
        if (at == end && !ends_line(text, end) && at > start) { at--; }
        n.cursor = (u16)at;
        report_caret(&n);
    } else {
        return;
    }
    dom.damage_row(&n);
    dom.touch();
}

/**
 * Appends a string to a TextArea, dropping its oldest lines if capacity is exceeded.
 * @param id DOM Node ID of TextArea.
 * @param s Text to append.
 */
export void append_text(NodeId id, str s) {
    borrow NodeRow n = case dom.find_row(id) of { Some(row) -> row; None -> ({ return; }); };
    if (n.kind != NodeKind::TEXT_AREA) { return; }
    Blob buf = n.text;
    i32 cap = n.cap;
    i32 add = s.length;
    i32 len = n.len;
    if (len + add + 1 > cap) {
        // Drop whole lines from the front until it fits (or everything).
        i32 need = len + add + 1 - cap;
        i32 drop = 0;
        while (drop < len) {
            if (drop >= need) {
                if (buf.at(drop - 1) == 10) { break; }
            }
            drop++;
        }
        i32 i = 0;
        while (drop + i < len) {
            buf.put(i, buf.at(drop + i));
            i++;
        }
        len = len - drop;
        if (len < 0) { len = 0; }
    }
    i32 i = 0;
    while (i < add) {
        if (len + 1 >= cap) { break; }
        buf.put(len, s.byte(i));
        len++;
        i++;
    }
    buf.put(len, (char)0);
    n.len = (u16)len;
    n.cursor = (u16)len;
    text_area_reveal_cursor(&n);
    dom.damage_row(&n);
    dom.touch();
}

/**
 * Appends bytes to a TextArea, filtering non-printable ASCII.
 * @param id DOM Node ID of TextArea.
 * @param bytes Source bytes.
 */
export void append_bytes(NodeId id, str bytes) {
    Text<64> tmp = Text<64> {};
    tmp.clear();
    i32 i = 0;
    while (i < bytes.length) {
        i32 c = bytes.byte(i);
        bool keep = c == '\n' || ascii.is_printable(c);
        if (keep) {
            if (!tmp.push((u8)c)) {
                append_text(id, tmp.as_str());
                tmp.clear();
                tmp.push((u8)c);
            }
        }
        i++;
    }
    if (!tmp.is_empty()) { append_text(id, tmp.as_str()); }
}

/**
 * Empties all text content and resets cursor and scroll position in a TextArea.
 * @param id DOM Node ID of TextArea.
 */
export void clear_text_area(NodeId id) {
    borrow NodeRow n = case dom.find_row(id) of { Some(row) -> row; None -> ({ return; }); };
    if (!n.text.is_live()) { return; }
    Blob buf = n.text;
    buf.put(0, (char)0);
    n.len = 0;
    n.cursor = 0;
    n.scroll = 0;
    n.sel = None;
    dom.damage_row(&n);
    dom.touch();
}

/**
 * Scrolls a TextArea or List node by a relative number of lines.
 * @param id DOM Node ID.
 * @param lines Line delta (negative = scroll up, positive = scroll down).
 */
export void scroll_by(NodeId id, i32 lines) {
    borrow NodeRow n = case dom.find_row(id) of { Some(row) -> row; None -> ({ return; }); };
    if (n.kind != NodeKind::TEXT_AREA) { if (n.kind != NodeKind::LIST) { return; } }
    i32 total = n.kind == NodeKind::TEXT_AREA ? row_count(&n) : line_of(&n, n.len) + 1;
    i32 rows = visible_lines(&n);
    i32 max_scroll = total - rows;
    if (max_scroll < 0) { max_scroll = 0; }
    i32 scroll = n.scroll + lines;
    if (scroll < 0) { scroll = 0; }
    if (scroll > max_scroll) { scroll = max_scroll; }
    if (scroll != n.scroll) {
        n.scroll = (u16)scroll;
        dom.damage_row(&n);
    }
}

/**
 * Handles mouse wheel scroll events over a node.
 * @param id DOM Node ID.
 * @param steps Scroll step count (positive = wheel forward/up).
 */
export void dispatch_wheel(NodeId id, i32 steps) {
    if (steps == 0) { return; }
    scroll_by(id, -steps * 3);
}

/**
 * Sets text content of a TextInput or TextArea node, updating length, cursor and redrawing.
 * @param id DOM Node ID of the node.
 * @param s Replacement string.
 */
export void set_input_text(NodeId id, str s) {
    borrow NodeRow n = case dom.find_row(id) of { Some(row) -> row; None -> ({ return; }); };
    if (n.kind == NodeKind::TEXT_AREA) {
        clear_text_area(id);
        append_text(id, s);
        return;
    }
    if (n.kind != NodeKind::TEXT_INPUT) { return; }
    Blob buf = n.text;
    i32 cap = n.cap;
    i32 i = 0;
    for (; i < s.length && i + 1 < cap; i++) {
        buf.put(i, s.byte(i));
    }
    buf.put(i, (char)0);
    n.len = (u16)i;
    n.cursor = (u16)i;
    dom.damage_row(&n);
    dom.touch();
}
