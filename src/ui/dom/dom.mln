package dom;

import dom_model from "dom_model.mln";
import { Node, NodeRow, node_children_Iter, node_all_Iter } from "dom_model.mln";
import blob from "@std/memory/blob.mln";
import { Blob } from "@std/memory/blob.mln";
import scheduler from "@kernel/kernel/scheduler.mln";
import ui_metrics from "@os/ui/ui_metrics.mln";
import ui_event from "@os/ui/events.mln";
import irq from "@kernel/arch/irq.mln";
import { UiEventKind } from "@os/ui/events.mln";
import { Option } from "@std/core/option.mln";
import { Iterator } from "@std/core/iter.mln";
import { Result } from "@std/core/result.mln";
import { NodeId, UiError } from "@contracts/ui/widget.contract.mln";
import { Pid } from "@contracts/process/control.contract.mln";
import { Drop } from "@std/core/drop.mln";

// Kernel object tree + UI DOM. See docs/DOM_SPEC.md and MYOS-014.
//
// One tree holds both the OS object model (root/system/process/device/ui)
// and the UI: windows and their controls hang under ui/desktop. UI nodes
// carry bounds in *absolute display pixels*; the create_* helpers take
// logical 1024x768 coordinates, scale them, and append_child then offsets a
// child by its parent's content origin, so app code writes positions
// relative to the window it is building. Sibling order is paint order and
// z-order (later on top); bring_to_front re-links a window to the end.

// --- node kinds --------------------------------------------------------------
/** Structural and interactive node types supported by the DOM renderer. */
export enum NodeKind {
    ROOT,
    SYSTEM,
    PROCESS,
    DEVICE,
    DIRECTORY,
    FILE,
    UI,
    DESKTOP,
    WINDOW,
    BOX,
    TEXT,
    BUTTON,
    TIMER,
    COLUMN,
    ROW,
    TEXT_INPUT,
    CHECKBOX,
    SEPARATOR,
    PANEL,
    TASKBAR,
    TEXT_AREA,
    LIST,
    MENU,
}

/** Accessibility and automation roles assigned to DOM nodes. */
export enum NodeRole {
    NONE,
    ROOT,
    DESKTOP,
    WINDOW,
    BUTTON,
    TEXT,
    TEXTBOX,
    CHECKBOX,
    TOOLBAR,
    SEPARATOR,
    TEXTAREA,
    LIST,
    MENU,
}

/** Bit flags describing visibility, interaction, focus, and widget state. */
export enum NodeState {
    VISIBLE      = 0b0000001,
    ENABLED      = 0b0000010,
    HOVERED      = 0b0000100,
    PRESSED      = 0b0001000,
    FOCUSED      = 0b0010000, // keyboard focus, or the active window
    HIT_TESTABLE = 0b0100000, // dom_hit_test.find_at may return this node
    CHECKED      = 0b1000000, // Checkbox
    MAXIMIZED    = 128,       // Window fills the desktop; sx..sh hold the restore bounds
    MINIMIZED    = 256,       // Window hidden to the taskbar
}

/** Presentation flags that change how text and controls are rendered. */
export enum NodeStyle {
    BOLD     = 1, // Text: heavier face
    PRIMARY  = 2, // Button: accent-coloured call to action
    CENTER   = 4, // Text: centre within w when w > 0
    READONLY = 8, // TextArea: displays text, no editing (console output)
}

// Handlers all share one ABI, `void handler(Option<Pid> owner, NodeId id, i32 arg)`:
// `owner` is the app process the node belongs to (see `owner` below), `id`
// the node, `arg` event data (a key handler gets code | mods << 16).
// The on_* fields hold server-side functions only -- the taskbar, menus,
// the shell's window-close hook, the clock. A node an app owns (a Some owner)
// never carries a function pointer: what happens to it is emitted through
// the UI event port; the IPC event endpoint turns that into a protocol event,
// and the app's own runtime calls the handler. Server handlers are not called where the event is detected
// either: they are queued (push_event) and run by drain_events() at a point
// the compositor chooses, with g_current_owner set so anything the handler
// creates is owned by the same app.
//
// The rows themselves are declared in dom_model.model.mln.

// Damage rectangles: the areas that changed since the last render, in
// display coordinates. render_scene repaints each one under a clip. Keeping
// several instead of one union matters because the taskbar spans the full
// width at the bottom: one rect for it plus one for a window near the top
// would otherwise union into nearly the whole screen. When the list is
// full, new areas merge into the first entry.
export const i32 DAMAGE_MAX = 8;
struct DamageRect {
    i32 x0;
    i32 y0;
    i32 x1;
    i32 y1;
};
DamageRect g_damage[8];
i32 g_damage_count = 0;

// The rect render_scene is currently repainting, so node_in_damage can test
// against just that one; g_painting_all short-circuits it for full paints.
DamageRect g_paint;
bool g_painting_all = true;

i32 g_revision = 0;     // increments on externally observable DOM mutation
NodeId g_root_node_id;
NodeId g_desktop_node_id;  // set while the desktop is built; UI attaches under this

Option<NodeId> g_taskbar_id;    // the desktop's taskbar node, drawn above windows
Option<NodeId> g_active_window; // window with STATE_FOCUSED (front-most, gets keys)
Option<NodeId> g_focus_id;      // node with keyboard focus (a TextInput)
void no_launcher() { }
fn() -> void g_launcher = no_launcher; // taskbar launcher button

// The app instance whose code is running right now (a handler drained from
// the event queue, or a view() being mounted); create_node stamps it into
// each new node's `owner`, so dialogs and timers an app makes on the fly are
// swept with it by remove_owned(). None while the system itself runs.
Option<Pid> g_current_owner;

// Apps the shell has started whose window has not arrived yet. Reported in
// the automation snapshot ("starting") so a test harness can tell a
// desktop that is still booting from a settled one.
i32 g_apps_starting = 0;
/**
 * Adjusts the count of app processes still waiting to create their first window.
 * @param delta Amount to add or subtract; the stored count is clamped at zero.
 */
export void note_app_starting(i32 delta) { g_apps_starting = g_apps_starting + delta; if (g_apps_starting < 0) { g_apps_starting = 0; } }

/**
 * Returns the number of apps still starting their first window.
 * @return Nonnegative count of app launches awaiting a window.
 */
export i32 apps_starting() { return g_apps_starting; }

// Pending handler calls.
export const i32 EVENT_MAX = 64;
struct PendingEvent {
    fn(Option<Pid> owner, NodeId id, i32 arg) -> void handler;
    Option<Pid> owner;
    NodeId id;
    i32 arg;
};
PendingEvent g_events[64];
i32 g_event_head = 0;
i32 g_event_tail = 0;

// Each owner (an app process) may hold at most NODES_PER_OWNER nodes, so
// one app cannot take the whole table from the others; create_node()
// fails past that, and past the table's size.
export const i32 NODES_PER_OWNER = 96;
struct OwnerNodes {
    Option<Pid> owner;   // None = free slot
    i32 count;
};
OwnerNodes g_owner_nodes[32];

// The owner's slot in g_owner_nodes, or None if it has none. With `make`, an
// owner without one takes a free slot (None when the table is full).
Option<i32> owner_slot(Pid owner, bool make) {
    Option<i32> free = None;
    i32 i = 0;
    while (i < 32) {
        case g_owner_nodes[i].owner of {
            Some(held) -> ({ if (held == owner) { return Some(i); } });
            None -> ({ if (free.is_none()) { free = Some(i); } });
        };
        i++;
    }
    if (!make) { return None; }
    i32 slot = free?;
    g_owner_nodes[slot] = OwnerNodes { owner: Some(owner), count: 0 };
    return Some(slot);
}

// Registered timers (ids), scanned by tick().
export const i32 TIMER_MAX = 16;
NodeId g_timer_ids[16];
i32 g_timer_count = 0;

/**
 * Increments the global DOM revision counter when observable tree changes occur.
 */
export void touch() { g_revision = g_revision + 1; }

/**
 * Returns the current DOM mutation revision number.
 * @return Monotonically increasing revision counter.
 */
export i32 revision() { return g_revision; }

// DOM markup uses logical 1024x768 coordinates. Scale it uniformly to the
// physical display so its proportions remain intact on larger resolutions.
// A display smaller than the base size keeps scale 1, avoiding zero-size
// controls; responsive downscaling can be added when sub-pixel layout exists.
export const i32 BASE_DISPLAY_WIDTH = 1024;
export const i32 BASE_DISPLAY_HEIGHT = 768;

/**
 * Calculates the integer UI scaling factor based on current display resolution.
 * @return Scaling factor (>= 1).
 */
export i32 ui_scale() {
    return ui_metrics.scale_for(BASE_DISPLAY_WIDTH, BASE_DISPLAY_HEIGHT);
}

/**
 * Scales a logical coordinate or dimension by the current UI scale.
 * @param value Logical pixel value.
 * @return Scaled physical pixel value.
 */
export i32 scale_ui(i32 value) {
    return value * ui_scale();
}

/**
 * Checks whether a DOM node ID names a live node. An ID whose node is gone
 * stays dead even after its row is reused.
 * @param id DOM Node ID.
 * @return True if node exists, false otherwise.
 */
export bool node_exists(NodeId id) {
    return dom_model.node_live_id((i32)id);
}

/**
 * The row of a node that may be gone: the lookup for an ID from outside.
 * @param id DOM Node ID.
 * @return Some(row) for a live node, None for a dead ID.
 */
export Option<borrow NodeRow> find_row(NodeId id) {
    return dom_model.node_find_id((i32)id);
}

/**
 * The row of a node, for a function that reports a dead ID as an error.
 * @param id DOM Node ID.
 * @return Ok(row), or Err(UiError::NodeNotFound) for a dead ID.
 */
export Result<borrow NodeRow, UiError> require_row(NodeId id) {
    return case find_row(id) of {
        Some(row) -> Ok(row);
        None -> Err(UiError::NodeNotFound(id));
    };
}

/**
 * The row of a node known to be live, such as a child being walked or a
 * parent just read from a live node. A dead ID traps; use find_row() otherwise.
 * @param id DOM Node ID.
 * @return The node's row.
 */
export borrow NodeRow row_of(NodeId id) {
    return dom_model.node_row_id((i32)id);
}

/**
 * The row of an optional node.
 * @param slot DOM Node ID, if there is one.
 * @return Some(row) for a live node, None otherwise.
 */
export Option<borrow NodeRow> row_in(Option<NodeId> slot) {
    return case slot of {
        Some(id) -> find_row(id);
        None -> None;
    };
}

/**
 * Whether an optional node is a given node.
 * @param slot DOM Node ID, if there is one.
 * @param id DOM Node ID to compare with.
 */
export bool holds(Option<NodeId> slot, NodeId id) {
    return case slot of { Some(held) -> held == id; None -> false; };
}

/**
 * Whether two optional nodes are the same node, or both none.
 */
export bool same_node(Option<NodeId> a, Option<NodeId> b) {
    return case a of {
        Some(id) -> holds(b, id);
        None -> b.is_none();
    };
}

/**
 * The ID of a node's parent.
 * @param id DOM Node ID.
 * @return The parent's ID, or None for a root, detached or dead node.
 */
export Option<NodeId> parent_id(NodeId id) {
    if (!node_exists(id)) { return None; }
    i32 parent = dom_model.node_parent_id((i32)id);
    if (parent == 0) { return None; }
    return Some(NodeId(parent));
}

// Lays out a node's parent again after the node changed size.
void relayout_parent(NodeId id) {
    case parent_id(id) of {
        Some(parent) -> relayout_container(&row_of(parent));
        None -> _;
    };
}

// Replaces a string column's buffer. The old one is released; an empty
// string needs none.
Blob replaced_text(Blob old, str text) {
    old.free();
    return case blob.blob_from(text) of {
        Some(copy) -> copy;
        None -> Blob {};
    };
}

/**
 * A node still being built: it is removed again if the builder returns
 * early, so a failed create leaves nothing behind. `keep()` hands the
 * finished node over.
 *
 *     NewNode node = NewNode { id: dom.create_node(kind, name)? };
 *     ...setup that may `return Err(...)`...
 *     return Ok(node.keep());
 */
export struct NewNode {
    NodeId id;
    bool kept;
};

export impl Drop for NewNode {
    void (borrow Self self) drop() {
        if (!self.kept) { remove_node(self.id); }
        self.kept = true;
    }
}

/** Gives up the guard and returns the node ID. */
export NodeId (borrow NewNode self) keep() {
    self.kept = true;
    return self.id;
}

/**
 * Allocates and initializes a new DOM node of the given kind with default values.
 * @param kind NodeKind enum variant.
 * @param name Node name.
 * @return Newly allocated Node ID.
 */
export Result<NodeId, UiError> create_node(i32 kind, str name) {
    i32 oslot = 0;
    bool has_owner_slot = false;
    case g_current_owner of {
        Some(owner) -> ({
            oslot = case owner_slot(owner, true) of {
                Some(v) -> ({ has_owner_slot = true; v; });
                None -> ({ return Err(UiError::OwnerTableFull(owner)); });
            };
            if (g_owner_nodes[oslot].count >= NODES_PER_OWNER) {
                return Err(UiError::OwnerNodeLimit(owner));
            }
        });
        None -> _;
    };
    Node made = case dom_model.new_node() of {
        Some(value) -> value;
        None -> ({ return Err(UiError::NodeIdLimit); });
    };
    NodeId id = NodeId(made.raw());
    if (has_owner_slot) { g_owner_nodes[oslot].count = g_owner_nodes[oslot].count + 1; }
    borrow NodeRow n = made.row();
    n.id = id;
    n.kind = (u16)kind;
    n.name = replaced_text(n.name, name);
    n.owner = g_current_owner;
    touch();
    return Ok(id);
}

// --- ownership ------------------------------------------------------------------------

/**
 * Returns the process that owns a DOM node.
 * @param id DOM node ID.
 * @return Ok(owner), None for system-owned nodes, or Err for an invalid ID.
 */
export Result<Option<Pid>, UiError> owner_of(NodeId id) {
    borrow NodeRow n = require_row(id)?;
    return Ok(n.owner);
}

/**
 * Assigns an owner process ID recursively to a node and its descendants.
 * @param id Root DOM node ID of the subtree.
 * @param owner Process ID to assign.
 */
export void set_owner(NodeId id, Pid owner) {
    borrow NodeRow n = case find_row(id) of { Some(row) -> row; None -> ({ return; }); };
    n.owner = Some(owner);
    for (NodeId child in children(id)) {
        set_owner(child, owner);
    }
}

/**
 * Returns the app process ID whose view or event handler is currently running.
 * @return Current app owner, or None while system-owned code is running.
 */
export Option<Pid> current_owner() { return g_current_owner; }

/**
 * Sets the owner stamped onto DOM nodes created by subsequent operations.
 * @param owner Process ID to make current, or None for system-owned nodes.
 */
export void set_current_owner(Option<Pid> owner) { g_current_owner = owner; }

bool owned_by(borrow NodeRow n, Pid owner) {
    return case n.owner of { Some(held) -> held == owner; None -> false; };
}

/**
 * Removes every DOM node owned by an application process, including its windows, dialogs, and timers.
 * @param owner Process ID whose nodes should be removed.
 */
export void remove_owned(Pid owner) {
    for (Node each in dom_model.node_all()) {
        if (each.is_live() && owned_by(&each.row(), owner)) { remove_node(NodeId(each.raw())); }
    }
}

// --- event queue ----------------------------------------------------------------------

/**
 * Queues a server-side event handler call for later execution.
 * A full event queue drops the event rather than calling the handler inline.
 * @param handler Callback function pointer to enqueue; zero is ignored.
 * @param owner Process associated with the queued handler, or None for the system.
 * @param id DOM node ID associated with the event.
 * @param arg Event-specific integer argument.
 */
export void push_event(fn(Option<Pid> owner, NodeId id, i32 arg) -> void handler,
                       Option<Pid> owner, NodeId id, i32 arg) {
    if (handler == 0) { return; }
    i32 next = g_event_tail + 1;
    if (next >= EVENT_MAX) { next = 0; }
    if (next == g_event_head) { return; }
    g_events[g_event_tail] = PendingEvent { handler: handler, owner: owner, id: id, arg: arg };
    g_event_tail = next;
}

/**
 * Routes a node event to its owning app or queues a server-side callback.
 * @param n Node that produced the event.
 * @param kind UiEventKind event code.
 * @param handler Server-side callback to queue when the node has no app owner.
 * @param arg Event-specific integer argument.
 * @return 1 when an app event or callback was delivered/queued, otherwise 0.
 */
export bool emit(borrow NodeRow n, i32 kind,
                 fn(Option<Pid> owner, NodeId id, i32 arg) -> void handler, i32 arg) {
    case n.owner of {
        Some(owner) -> ({
            ui_event.emit(owner, n.id, kind, arg);
            return true;
        });
        None -> _;
    };
    if (handler == 0) { return false; }
    push_event(handler, None, n.id, arg);
    return true;
}

/**
 * Runs queued server-side handlers in order with the associated owner context set.
 * Handlers may enqueue more events, which are drained in the same pass.
 */
export void drain_events() {
    while (g_event_head != g_event_tail) {
        PendingEvent event = g_events[g_event_head];
        g_event_head = g_event_head + 1;
        if (g_event_head >= EVENT_MAX) { g_event_head = 0; }
        Option<Pid> outer = g_current_owner;
        g_current_owner = event.owner;
        defer set_current_owner(outer);
        fn(Option<Pid> owner, NodeId id, i32 arg) -> void handler = event.handler;
        handler(event.owner, event.id, event.arg);
    }
}

// --- the DOM lock ----------------------------------------------------------------------
// The DOM is the UI server's: its task holds this lock for every pass
// (input, requests, handlers, paint) and gives it up while it sleeps. The
// only other task that reads the tree is the automation service; it takes
// the lock around a dump. Apps never touch the DOM -- they send requests.
// Kernel tasks preempt on the timer, so the test-and-set is done with
// interrupts off.

bool g_lock = false; // held
i32 g_want = 0;      // tasks waiting for it
bool g_handoff = false; // unlock() passed the lock straight to a waiter

/**
 * Acquires the DOM lock, sleeping until ownership is handed to this task when contended.
 * Unlock hands the lock directly to a waiter so the compositor cannot starve
 * the automation reader by repeatedly reacquiring it.
 */
export void lock() {
    {
        i32 was = irq.save_disable();
        defer irq.restore(was);
        if (!g_lock) {
            g_lock = true;
            return;
        }
        g_want = g_want + 1;
    }
    while (1) {
        {
            i32 was = irq.save_disable();
            defer irq.restore(was);
            if (g_handoff) {
                g_handoff = false;
                g_want = g_want - 1;
                return;   // g_lock stays set: it is ours now
            }
        }
        scheduler.sleep(1);
    }
}

/** Releases the DOM lock, handing it directly to a waiting task when one exists. */
export void unlock() {
    i32 was = irq.save_disable();
    defer irq.restore(was);
    if (g_want != 0) {
        g_handoff = true;   // the next waiter to look owns it
    } else {
        g_lock = false;
    }
}

// --- scalar queries -------------------------------------------------------------

/**
 * Returns the NodeKind of a node, or None if the node ID is invalid.
 * @param id DOM Node ID.
 * @return Some(kind) or None.
 */
export Option<NodeKind> kind_of(NodeId id) {
    borrow NodeRow n = find_row(id)?;
    return Some(n.kind);
}

/**
 * Returns the absolute X coordinate of a node in screen pixels.
 * @param id DOM node ID.
 * @return Some(X coordinate), or None when the node ID is invalid.
 */
export Option<i32> node_x(NodeId id) {
    return case find_row(id) of { Some(n) -> Some(n.x); None -> None; };
}

/**
 * Returns the absolute Y coordinate of a node in screen pixels.
 * @param id DOM node ID.
 * @return Some(Y coordinate), or None when the node ID is invalid.
 */
export Option<i32> node_y(NodeId id) {
    return case find_row(id) of { Some(n) -> Some(n.y); None -> None; };
}

/**
 * Returns the text content of a node.
 * @param id DOM Node ID.
 * @return View of the node's text, or an empty string for a dead ID.
 */
export str text_of(NodeId id) {
    borrow NodeRow n = case find_row(id) of { Some(row) -> row; None -> ({ return ""; }); };
    return n.text.as_str();
}

/**
 * Returns the debug / identifier name of a node.
 * @param id DOM Node ID.
 * @return View of the node's name, or an empty string for a dead ID.
 */
export str name_of(NodeId id) {
    borrow NodeRow n = case find_row(id) of { Some(row) -> row; None -> ({ return ""; }); };
    return n.name.as_str();
}

/**
 * Returns the root node ID of the DOM tree.
 * @return Root Node ID.
 */
export NodeId root_node_id() { return g_root_node_id; }

/**
 * Returns the automation-visible value of a node (text content for textbox/textarea).
 * @param n DOM Node row.
 * @return String value of the node, or empty string.
 */
export str automation_value_of(borrow NodeRow n) {
    i32 role = n.role;
    if (role == NodeRole::TEXTBOX) { return n.text.as_str(); }
    if (role == NodeRole::TEXTAREA) { return n.text.as_str(); }
    return "";
}

// --- damage -------------------------------------------------------------------------

// Whether two rectangles overlap or touch.
bool rects_touch(DamageRect a, DamageRect b) {
    if (a.x1 < b.x0) { return false; }
    if (b.x1 < a.x0) { return false; }
    if (a.y1 < b.y0) { return false; }
    if (b.y1 < a.y0) { return false; }
    return true;
}

// Grows a damage entry to include another rectangle.
void damage_union_into(borrow DamageRect entry, DamageRect rect) {
    if (rect.x0 < entry.x0) { entry.x0 = rect.x0; }
    if (rect.y0 < entry.y0) { entry.y0 = rect.y0; }
    if (rect.x1 > entry.x1) { entry.x1 = rect.x1; }
    if (rect.y1 > entry.y1) { entry.y1 = rect.y1; }
}

/**
 * Adds a rectangle to the damage list, clipped to the display.
 * Merges into an overlapping entry if present, or creates a new entry.
 * @param rect Rectangle in display coordinates.
 */
void damage_rect(DamageRect rect) {
    i32 display_width = ui_metrics.display_width();
    i32 display_height = ui_metrics.display_height();

    if (rect.x0 < 0) { rect.x0 = 0; }
    if (rect.y0 < 0) { rect.y0 = 0; }
    if (rect.x1 > display_width) { rect.x1 = display_width; }
    if (rect.y1 > display_height) { rect.y1 = display_height; }
    if (rect.x1 <= rect.x0) { return; }
    if (rect.y1 <= rect.y0) { return; }

    i32 i = 0;
    while (i < g_damage_count) {
        if (rects_touch(rect, g_damage[i])) {
            damage_union_into(&g_damage[i], rect);
            return;
        }
        i++;
    }
    if (g_damage_count < DAMAGE_MAX) {
        g_damage[g_damage_count] = rect;
        g_damage_count = g_damage_count + 1;
        return;
    }
    damage_union_into(&g_damage[0], rect);
}

/**
 * Calculates the full painted extent of a node (including window shadows).
 * @param n DOM Node row.
 * @return The extent in display coordinates.
 */
DamageRect node_extent(borrow NodeRow n) {
    i32 x = n.x;
    i32 y = n.y;
    i32 w = n.w;
    i32 h = n.h;
    if (n.kind == NodeKind::WINDOW) {
        i32 s = ui_scale();
        i32 size = ui_metrics.window_shadow_size() * s;
        i32 off = ui_metrics.window_shadow_offset() * s;
        x = x - size;
        y = y - size;
        w = w + 2 * size;
        h = h + 2 * size + off;
    }
    return DamageRect { x0: x, y0: y, x1: x + w, y1: y + h };
}

/**
 * Marks a row's full extent as needing repaint.
 * @param n DOM Node row.
 */
export void damage_row(borrow NodeRow n) {
    damage_rect(node_extent(&n));
}

/**
 * Marks a node's full extent as needing repaint.
 * @param id DOM Node ID.
 */
export void damage_node(NodeId id) {
    borrow NodeRow n = case find_row(id) of { Some(row) -> row; None -> ({ return; }); };
    damage_row(&n);
}

/**
 * Checks whether any damaged regions exist.
 * @return 1 if damage regions exist, 0 otherwise.
 */
export bool has_damage() {
    return g_damage_count > 0;
}

/**
 * Clears the damage region list.
 */
export void clear_damage() {
    g_damage_count = 0;
}

// --- text metrics ---------------------------------------------------------------------

/**
 * Checks if a node uses bold text styling.
 * @param n DOM Node row.
 * @return True if bold, false otherwise.
 */
export bool text_bold(borrow NodeRow n) {
    return (n.style & NodeStyle::BOLD) != 0;
}

/**
 * Computes rendered text width for a node based on UI scale and bold flag.
 * @param n DOM Node row.
 * @return Rendered text width in pixels.
 */
export i32 text_width_of(borrow NodeRow n) {
    if (!n.text.is_live()) { return 0; }
    i32 bold = 0;
    if (text_bold(&n)) { bold = 1; }
    i32 s = ui_scale();
    return ui_metrics.text_width(n.text.as_str(), bold, s);
}

/**
 * Computes rendered text height for a node based on UI scale and bold flag.
 * @param n DOM Node row.
 * @return Rendered text height in pixels.
 */
export i32 text_height_of(borrow NodeRow n) {
    i32 bold = 0;
    if (text_bold(&n)) { bold = 1; }
    i32 s = ui_scale();
    return ui_metrics.text_height(bold, s);
}

// --- layout ---------------------------------------------------------------------------------

/**
 * Translates a subtree by (dx, dy) without damage bookkeeping.
 * @param id DOM Node ID.
 * @param dx Horizontal offset.
 * @param dy Vertical offset.
 */
export void offset_subtree(NodeId id, i32 dx, i32 dy) {
    borrow NodeRow n = case find_row(id) of { Some(row) -> row; None -> ({ return; }); };
    n.x = (u16)(n.x + dx);
    n.y = (u16)(n.y + dy);
    for (NodeId child_id in children(id)) {
        offset_subtree(child_id, dx, dy);
    }
}

/**
 * Positions a child node and its subtree at absolute coordinates (x, y).
 * @param child_id DOM Node ID of the child.
 * @param x Target X coordinate.
 * @param y Target Y coordinate.
 */
export void place_child(NodeId child_id, i32 x, i32 y) {
    borrow NodeRow child = case find_row(child_id) of { Some(row) -> row; None -> ({ return; }); };
    i32 dx = x - child.x;
    i32 dy = y - child.y;
    if (dx == 0) {
        if (dy == 0) { return; }
    }
    damage_row(&child);
    offset_subtree(child_id, dx, dy);
    damage_row(&child);
}

/**
 * Recursively updates layout for container nodes (COLUMN or ROW).
 * @param n DOM Node row of the container.
 */
export void relayout_container(borrow NodeRow n);

/**
 * Lays out direct children of a column container top-to-bottom.
 * @param column DOM Node row of the Column.
 */
export void relayout_column(borrow NodeRow column) {
    i32 child_x = column.x + column.padding;
    i32 cursor_y = column.y + column.padding;
    i32 gap = column.gap;

    for (NodeId child_id in children(column.id)) {
        borrow NodeRow child = row_of(child_id);
        i32 child_h = child.h;
        place_child(child_id, child_x, cursor_y);
        relayout_container(&child);
        cursor_y = cursor_y + child_h + gap;
    }
}

/**
 * Lays out direct children of a row container left-to-right, top-aligned.
 * @param row DOM Node row of the Row.
 */
export void relayout_row(borrow NodeRow row) {
    i32 cursor_x = row.x + row.padding;
    i32 child_y = row.y + row.padding;
    i32 gap = row.gap;

    for (NodeId child_id in children(row.id)) {
        borrow NodeRow child = row_of(child_id);
        i32 child_w = child.w;
        place_child(child_id, cursor_x, child_y);
        relayout_container(&child);
        cursor_x = cursor_x + child_w + gap;
    }
}

/**
 * Dispatches layout calculation for a container node to relayout_column or relayout_row.
 * @param n DOM Node row of the container.
 */
export void relayout_container(borrow NodeRow n) {
    i32 k = n.kind;
    if (k == NodeKind::COLUMN) { relayout_column(&n); }
    if (k == NodeKind::ROW) { relayout_row(&n); }
}

// --- prop accessors ---------------------------------------------------------------------

/**
 * Sets absolute bounds for a node, reflowing layouts and damaging old and new areas.
 * @param id DOM Node ID.
 * @param x Left coordinate.
 * @param y Top coordinate.
 * @param w Width in pixels.
 * @param h Height in pixels.
 */
export void set_bounds(NodeId id, i32 x, i32 y, i32 w, i32 h) {
    borrow NodeRow n = case find_row(id) of { Some(row) -> row; None -> ({ return; }); };
    // Damage the old area as well as the new one, so vacating a region repaints
    // the background that was underneath.
    damage_row(&n);
    n.x = (u16)x;
    n.y = (u16)y;
    n.w = (u16)w;
    n.h = (u16)h;
    damage_row(&n);
    relayout_container(&n);
    relayout_parent(id);
    touch();
}

/**
 * Translates a node and its entire subtree by (dx, dy) with damage tracking.
 * @param id DOM Node ID.
 * @param dx Horizontal delta.
 * @param dy Vertical delta.
 */
export void move_node(NodeId id, i32 dx, i32 dy) {
    borrow NodeRow n = case find_row(id) of { Some(row) -> row; None -> ({ return; }); };
    damage_row(&n);
    offset_subtree(id, dx, dy);
    damage_row(&n);
    touch();
}

/**
 * Sets the text content of a node, updating bounds for TEXT nodes and triggering damage.
 * @param id DOM Node ID.
 * @param text Text to show.
 */
export void set_text(NodeId id, str text) {
    borrow NodeRow n = case find_row(id) of { Some(row) -> row; None -> ({ return; }); };
    damage_row(&n);   // old string's extent
    n.text = replaced_text(n.text, text);
    // Text keeps physical bounds equal to its measured size so damage,
    // clipping, layout, and hit testing all agree. Windows and buttons also
    // have text, but their authored layout bounds must never be replaced by
    // caption size.
    if (n.kind == NodeKind::TEXT) {
        n.w = (u16)text_width_of(&n);
        n.h = (u16)text_height_of(&n);
        relayout_parent(id);
    }
    damage_row(&n);   // new string may be longer
    touch();
}

/**
 * Sets the accessibility / automation role of a node.
 * @param id DOM Node ID.
 * @param role NodeRole value.
 */
export void set_role(NodeId id, i32 role) {
    borrow NodeRow n = case find_row(id) of { Some(row) -> row; None -> ({ return; }); };
    n.role = (u16)role;
    touch();
}

/**
 * Sets the automation test identifier for a node.
 * @param id DOM Node ID.
 * @param test_id Test identifier string.
 */
export void set_test_id(NodeId id, str test_id) {
    borrow NodeRow n = case find_row(id) of { Some(row) -> row; None -> ({ return; }); };
    n.test_id = replaced_text(n.test_id, test_id);
    touch();
}

/**
 * Sets background and border colors of a node.
 * @param id DOM Node ID.
 * @param background Background color (RGB).
 * @param border Border color (RGB).
 */
export void set_colors(NodeId id, i32 background, i32 border) {
    borrow NodeRow n = case find_row(id) of { Some(row) -> row; None -> ({ return; }); };
    damage_row(&n);
    n.background_color = background;
    n.border_color = border;
}

/**
 * Sets foreground/text color of a node, in place of the theme default.
 * @param id DOM Node ID.
 * @param color Text color (RGB).
 */
export void set_color(NodeId id, i32 color) {
    borrow NodeRow n = case find_row(id) of { Some(row) -> row; None -> ({ return; }); };
    n.color = Some(color);
    damage_row(&n);
}

/**
 * Sets the text style flags (e.g. NodeStyle::BOLD) for a node.
 * @param id DOM Node ID.
 * @param style Style bitmask.
 */
export void set_style(NodeId id, i32 style) {
    borrow NodeRow n = case find_row(id) of { Some(row) -> row; None -> ({ return; }); };
    n.style = (u16)style;
    if (n.kind == NodeKind::TEXT) {
        n.w = (u16)text_width_of(&n);
        n.h = (u16)text_height_of(&n);
    }
    damage_row(&n);
}

/**
 * Sets padding and gap for a COLUMN/ROW node and updates layout.
 * @param id DOM Node ID.
 * @param padding Inset padding in pixels.
 * @param gap Gap between children in pixels.
 */
export void set_column_layout(NodeId id, i32 padding, i32 gap) {
    borrow NodeRow n = case find_row(id) of { Some(row) -> row; None -> ({ return; }); };
    n.padding = (u16)padding;
    n.gap = (u16)gap;
    relayout_container(&n);
}

/**
 * Determines whether a state flag change visibly alters a node's rendering.
 * @param n DOM Node row.
 * @param flag NodeState flag.
 * @return True if visible appearance changes, false otherwise.
 */
export bool state_is_visible(borrow NodeRow n, i32 flag) {
    i32 kind = n.kind;
    if (flag == NodeState::HOVERED) {
        if (kind == NodeKind::BUTTON) { return true; }
        if (kind == NodeKind::CHECKBOX) { return true; }
        if (kind == NodeKind::WINDOW) { return true; } // title-bar button highlight
        if (kind == NodeKind::MENU) { return true; }
        return false;
    }
    if (flag == NodeState::PRESSED) {
        if (kind == NodeKind::BUTTON) { return true; }
        if (kind == NodeKind::CHECKBOX) { return true; }
        return false;
    }
    if (flag == NodeState::FOCUSED) {
        if (kind == NodeKind::TEXT_INPUT) { return true; }
        if (kind == NodeKind::WINDOW) { return true; }
        if (kind == NodeKind::TEXT_AREA) { return true; }
        if (kind == NodeKind::LIST) { return true; }
        if (kind == NodeKind::BUTTON) { return true; }  // focus ring
        if (kind == NodeKind::CHECKBOX) { return true; }
        return false;
    }
    if (flag == NodeState::HIT_TESTABLE) { return false; }
    return true; // visibility, checked and everything else always matter
}

/**
 * Sets or clears an individual state flag bit on a node.
 * @param id DOM Node ID.
 * @param flag NodeState bitmask.
 * @param on Non-zero to set flag, 0 to clear.
 */
export void set_state_flag(NodeId id, i32 flag, i32 on) {
    borrow NodeRow n = case find_row(id) of { Some(row) -> row; None -> ({ return; }); };
    i32 state = n.state;
    i32 next = state & (~flag);
    if (on != 0) { next = state | flag; }
    // Only damage when the bit actually changes: the compositor sets
    // hovered/pressed every pass, and repainting on a no-op change would
    // defeat the whole point.
    if (next != state) {
        n.state = (u16)next;
        if (state_is_visible(&n, flag)) {
            damage_row(&n);
        }
        touch();
    }
}

/**
 * Tests whether a specific state flag bit is set on a node.
 * @param id DOM Node ID.
 * @param flag NodeState bitmask.
 * @return True if flag is set, false otherwise.
 */
export bool get_state_flag(NodeId id, i32 flag) {
    borrow NodeRow n = case find_row(id) of { Some(row) -> row; None -> ({ return false; }); };
    i32 state = n.state;
    if (state & flag) { return true; }
    return false;
}

/**
 * Sets or clears the HOVERED state flag on a node.
 * @param id DOM Node ID.
 * @param on Non-zero to set, 0 to clear.
 */
export void set_hovered(NodeId id, i32 on) { set_state_flag(id, NodeState::HOVERED, on); }

/**
 * Sets or clears the PRESSED state flag on a node.
 * @param id DOM Node ID.
 * @param on Non-zero to set, 0 to clear.
 */
export void set_pressed(NodeId id, i32 on) { set_state_flag(id, NodeState::PRESSED, on); }

/**
 * Sets or clears the HIT_TESTABLE state flag on a node.
 * @param id DOM Node ID.
 * @param on Non-zero to set, 0 to clear.
 */
export void set_hit_testable(NodeId id, i32 on) { set_state_flag(id, NodeState::HIT_TESTABLE, on); }

/**
 * Sets or clears the CHECKED state flag on a checkbox node.
 * @param id DOM Node ID.
 * @param on Non-zero to set, 0 to clear.
 */
export void set_checked(NodeId id, i32 on) { set_state_flag(id, NodeState::CHECKED, on); }

/**
 * Checks if a node has the CHECKED state flag set.
 * @param id DOM Node ID.
 * @return True if checked, false otherwise.
 */
export bool is_checked(NodeId id) { return get_state_flag(id, NodeState::CHECKED); }

/**
 * Stores a click handler function pointer on a node and marks it hit-testable.
 * @param id DOM Node ID.
 * @param handler Function pointer to click callback.
 */
export void set_on_click(NodeId id, fn(Option<Pid> owner, NodeId id, i32 arg) -> void handler) {
    borrow NodeRow n = case find_row(id) of { Some(row) -> row; None -> ({ return; }); };
    n.on_click = handler;
    set_hit_testable(id, handler != 0);
}

/**
 * Stores a value change handler function pointer on a node.
 * @param id DOM Node ID.
 * @param handler Function pointer to change event handler.
 */
export void set_on_change(NodeId id, fn(Option<Pid> owner, NodeId id, i32 arg) -> void handler) {
    borrow NodeRow n = case find_row(id) of { Some(row) -> row; None -> ({ return; }); };
    n.on_change = handler;
}

/**
 * Stores a window-close handler function pointer on a node.
 * @param id DOM Node ID.
 * @param handler Function pointer to close event handler.
 */
export void set_on_close(NodeId id, fn(Option<Pid> owner, NodeId id, i32 arg) -> void handler) {
    borrow NodeRow n = case find_row(id) of { Some(row) -> row; None -> ({ return; }); };
    n.on_close = handler;
}

/**
 * Returns a node's registered close handler function pointer, if any.
 * @param id DOM Node ID.
 * @return Ok(Some(handler)) when registered, Ok(None) when absent, or Err for an invalid ID.
 */
export Result<Option<fn(Option<Pid> owner, NodeId id, i32 arg) -> void>, UiError> on_close_of(NodeId id) {
    borrow NodeRow n = require_row(id)?;
    if (n.on_close == 0) { return Ok(None); }
    return Ok(Some(n.on_close));
}

/**
 * Queues the value change handler of a node if registered, via the
 * (owner, id, arg) event queue -- not a direct call.
 * @param n DOM Node row.
 */
export void fire_change(borrow NodeRow n) {
    emit(&n, UiEventKind::CHANGE, n.on_change, change_value(&n));
}

/**
 * Reports that the user activated a List's selected row.
 * @param n The List.
 */
export void fire_activate(borrow NodeRow n) {
    emit(&n, UiEventKind::ACTIVATE, n.on_click, change_value(&n));
}

// The value a change event carries, which is the node's new value.
i32 change_value(borrow NodeRow n) {
    if (n.kind == NodeKind::CHECKBOX) { return (n.state & NodeState::CHECKED) != 0 ? 1 : 0; }
    if (n.kind == NodeKind::LIST) {
        return case n.sel of { Some(row) -> row; None -> -1; };
    }
    return 0;
}

/**
 * Dispatches a click to the node's owner or registered server-side handler.
 * Checkboxes toggle before the event is queued.
 * @param id DOM node ID that was clicked.
 * @return 1 when an app event or handler was queued, otherwise 0.
 */
export bool dispatch_click(NodeId id) {
    borrow NodeRow n = case find_row(id) of { Some(row) -> row; None -> ({ return false; }); };
    if (n.kind == NodeKind::CHECKBOX) {
        i32 now = n.state & NodeState::CHECKED;
        set_state_flag(id, NodeState::CHECKED, !now);
        fire_change(&n);
    }
    return emit(&n, UiEventKind::CLICK, n.on_click, 0);
}

// --- tree structure -----------------------------------------------------------------------

/**
 * Computes where children's content starts within a parent node: its top,
 * or below the title bar of a window. Content starts at the parent's left edge.
 * @param parent DOM Node row of the parent.
 * @return Display Y coordinate of the content origin.
 */
i32 content_top(borrow NodeRow parent) {
    i32 top = parent.y;
    if (parent.kind == NodeKind::WINDOW) {
        top = top + ui_metrics.titlebar_height() * ui_scale();
    }
    return top;
}

/**
 * Appends a child node to a parent node, shifting coordinates and updating layout.
 * @param parent_id DOM Node ID of parent.
 * @param child_id DOM Node ID of child to append.
 * @return Ok(_) on success, or Err(UiError::NodeNotFound) if either node ID is invalid.
 */
export Result<_, UiError> append_child(NodeId parent_id, NodeId child_id) {
    borrow NodeRow parent = require_row(parent_id)?;
    if (!node_exists(child_id)) { return Err(UiError::NodeNotFound(child_id)); }
    dom_model.node_from_raw((i32)parent_id).children_add(dom_model.node_from_raw((i32)child_id));

    // Authored coordinates are relative to the parent's content origin;
    // stored coordinates are absolute, so shift the whole subtree once.
    offset_subtree(child_id, parent.x, content_top(&parent));
    damage_node(child_id);

    // A Column/Row controls the positions of its direct children. This runs
    // after linking so the new child participates immediately.
    relayout_container(&parent);
    touch();
    return Ok(_);
}

/**
 * Unlinks a node from its parent's sibling linked-list without freeing or damaging.
 * @param n DOM Node row.
 */
export void unlink(borrow NodeRow n) {
    dom_model.node_from_raw((i32)n.id).children_detach();
}

/**
 * Moves a node to be the last child of its parent, painting it on top of siblings.
 * @param id DOM Node ID.
 */
export void bring_to_front(NodeId id) {
    NodeId parent = case parent_id(id) of { Some(value) -> value; None -> ({ return; }); };
    // Coordinates are already absolute, so only the order changes.
    dom_model.node_from_raw((i32)parent).children_add(dom_model.node_from_raw((i32)id));
    damage_node(id);
    touch();
}

/**
 * Recursively frees a node's subtree from memory and drops timers/focus.
 * @param id DOM Node ID.
 */
export void free_subtree(NodeId id) {
    borrow NodeRow n = case find_row(id) of { Some(row) -> row; None -> ({ return; }); };
    for (NodeId child_id in children(id)) { free_subtree(child_id); }
    if (holds(g_focus_id, id)) { g_focus_id = None; }
    if (holds(g_active_window, id)) { g_active_window = None; }
    // Drop it from the timer list.
    i32 i = 0;
    while (i < g_timer_count) {
        if (g_timer_ids[i] == id) {
            g_timer_ids[i] = g_timer_ids[g_timer_count - 1];
            g_timer_count = g_timer_count - 1;
        } else {
            i++;
        }
    }
    n.name.free();
    n.text.free();
    n.test_id.free();
    case n.owner of {
        Some(owner) -> ({
            case owner_slot(owner, false) of {
                Some(oslot) -> ({
                    g_owner_nodes[oslot].count = g_owner_nodes[oslot].count - 1;
                    if (g_owner_nodes[oslot].count <= 0) { g_owner_nodes[oslot].owner = None; }
                });
                None -> _;
            };
        });
        None -> _;
    };
    dom_model.node_from_raw((i32)id).delete();
}

/**
 * Removes a node and its entire subtree from DOM, damaging old area and freeing memory.
 * @param id DOM Node ID.
 */
export void remove_node(NodeId id) {
    borrow NodeRow n = case find_row(id) of { Some(row) -> row; None -> ({ return; }); };
    damage_row(&n);
    unlink(&n);
    free_subtree(id);
    touch();
}

/**
 * Returns the node ID of the root desktop node.
 * @return Desktop DOM Node ID.
 */
export NodeId desktop_id() {
    return g_desktop_node_id;
}

/**
 * Returns the node ID of the system taskbar node.
 * @return Taskbar DOM Node ID, or None if not created.
 */
export Option<NodeId> taskbar_id() {
    return g_taskbar_id;
}

/** Marks the taskbar, if there is one, as needing repaint. */
export void damage_taskbar() {
    case g_taskbar_id of { Some(id) -> damage_node(id); None -> _; };
}

/**
 * The children of a node, first to last: `for (NodeId child in dom.children(id))`.
 * Each child's next sibling is read when the child is handed out, before the
 * loop body runs, so the body may move or unlink that child but not the one
 * after it.
 * @property rows The model's walk over the node's children.
 */
export struct Children {
    node_children_Iter rows;
};

export impl Iterator<NodeId> for Children {
    Option<NodeId> (borrow Self self) next() {
        Option<Node> child = self.rows.next();
        return case child of {
            Some(node) -> Some(NodeId(node.raw()));
            None -> None;
        };
    }
}

/**
 * Iterates the children of a node.
 * @param id DOM Node ID; an unknown ID has no children.
 * @return An Iterator over the child node IDs, first to last.
 */
export Children children(NodeId id) {
    if (!node_exists(id)) { return Children {}; }
    return Children { rows: dom_model.node_from_raw((i32)id).children() };
}

/**
 * Returns the enclosing WINDOW node ID for a node that may be gone.
 * @param id DOM Node ID.
 * @return Some(window) when inside a window, None otherwise or for a dead ID.
 */
export Option<NodeId> enclosing_window(NodeId id) {
    if (!node_exists(id)) { return None; }
    i32 cur = (i32)id;   // the model's chain, as words: zero ends it
    while (cur != 0) {
        NodeId node = NodeId(cur);
        if (row_of(node).kind == NodeKind::WINDOW) { return Some(node); }
        cur = dom_model.node_parent_id(cur);
    }
    return None;
}


// --- subsystem state -------------------------------------------------------------------------

/** Starts with no taskbar, active window or focus. */
export void init() {
    g_taskbar_id = None;
    g_active_window = None;
    g_focus_id = None;
}

/** Selects the root node created during desktop initialization. */
export void set_root_node_id(NodeId id) { g_root_node_id = id; }

/** Selects the desktop container created during desktop initialization. */
export void set_desktop_id(NodeId id) { g_desktop_node_id = id; }

/** Selects the system taskbar node. */
export void set_taskbar_id(NodeId id) { g_taskbar_id = Some(id); }

/** Returns the active top-level window ID, if there is one. */
export Option<NodeId> active_window_id() { return g_active_window; }

/** Updates the active top-level window ID; None records that no window is active. */
export void set_active_window_id(Option<NodeId> id) { g_active_window = id; }

/** Returns the focused control ID, if there is one. */
export Option<NodeId> focus_id() { return g_focus_id; }

/** Updates the focused control ID; None records that no control has focus. */
export void set_focus_id(Option<NodeId> id) { g_focus_id = id; }

/** Returns the taskbar launcher callback address. */
export fn() -> void launcher_handler() { return g_launcher; }

/** Installs the taskbar launcher callback address. */
export void set_launcher_handler(fn() -> void handler) { g_launcher = handler; }

/** Returns the number of registered timer nodes. */
export i32 timer_count() { return g_timer_count; }

/** Returns a registered timer ID by table index. */
export NodeId timer_id_at(i32 index) { return g_timer_ids[index]; }

/** Adds a timer ID to the bounded timer registry. */
export Result<_, UiError> register_timer(NodeId id) {
    if (g_timer_count >= TIMER_MAX) { return Err(UiError::TimerLimit); }
    g_timer_ids[g_timer_count] = id;
    g_timer_count++;
    return Ok(_);
}

/** Returns the number of damage rectangles awaiting paint. */
export i32 damage_count() { return g_damage_count; }

/** Selects one queued damage rectangle as the current paint region. */
export void select_damage(i32 index) {
    g_paint = g_damage[index];
    g_painting_all = false;
}

/** Selects an unrestricted full-scene paint. */
export void select_full_paint() { g_painting_all = true; }

/** Returns true when a node overlaps the selected paint region. */
export bool node_intersects_paint(borrow NodeRow node) {
    if (g_painting_all) { return true; }
    DamageRect extent = node_extent(&node);
    if (extent.x1 <= g_paint.x0) { return false; }
    if (extent.y1 <= g_paint.y0) { return false; }
    if (extent.x0 >= g_paint.x1) { return false; }
    if (extent.y0 >= g_paint.y1) { return false; }
    return true;
}

/** Applies the selected damage rectangle to a renderer clip. */
export i32 paint_x() { return g_paint.x0; }
export i32 paint_y() { return g_paint.y0; }
export i32 paint_width() { return g_paint.x1 - g_paint.x0; }
export i32 paint_height() { return g_paint.y1 - g_paint.y0; }

/**
 * Checks whether a node clips its children to its bounding box.
 * @param n DOM Node row.
 * @return True if container clips children, false otherwise.
 */
export bool clips_children(borrow NodeRow n) {
    i32 k = n.kind;
    if (k == NodeKind::WINDOW) { return true; }
    if (k == NodeKind::PANEL) { return true; }
    return false;
}

