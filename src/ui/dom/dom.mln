/**
 * Checks whether a node clips its children to its bounding box.
 * @param n Pointer to DOM Node.
 * @return True if container clips children, false otherwise.
 */
export bool clips_children(Node *n) {
    i32 k = n->kind;
    if (k == NodeKind::WINDOW) { return true; }
    if (k == NodeKind::PANEL) { return true; }
    return false;
}

// --- hit-test --------------------------------------------------------------------------------------

/**
 * Checks whether a point (px, py) is inside a node's bounding rectangle.
 * @param n Pointer to DOM Node.
 * @param px Target X coordinate.
 * @param py Target Y coordinate.
 * @return True if point is inside node bounds, false otherwise.
 */
export bool node_contains(Node *n, i32 px, i32 py) {
    i32 x = n->x;
    i32 y = n->y;
    i32 w = n->w;
    i32 h = n->h;
    if (w == 0) { return false; }
    if (h == 0) { return false; }
    if (px < x) { return false; }
    if (py < y) { return false; }
    if (px >= x + w) { return false; }
    if (py >= y + h) { return false; }
    return true;
}

/**
 * Finds topmost hit-testable and visible node within a subtree at (px, py).
 * @param node_id Root of subtree to hit-test.
 * @param px Target X coordinate.
 * @param py Target Y coordinate.
 * @return Hit DOM Node ID, or 0 if no match.
 */
export i32 hit_test(i32 node_id, i32 px, i32 py) {
    Node *n = node_ptr(node_id);
    if (n == 0) { return 0; }
    if ((n->state & NodeState::VISIBLE) == 0) { return 0; }

    bool inside = node_contains(n, px, py);
    i32 found = 0;
    if (inside) {
        if ((n->state & NodeState::HIT_TESTABLE) != 0) {
            found = node_id;
        }
    }

    // Children of a clipping container cannot be hit outside it.
    if (!inside) {
        if (clips_children(n)) { return 0; }
    }

    i32 child_id = n->first_child;
    while (child_id != 0) {
        i32 child_hit = hit_test(child_id, px, py);
        if (child_hit != 0) {
            found = child_hit;
        }
        child_id = next_sibling(child_id);
    }
    return found;
}

/**
 * Finds the topmost interactive UI node at display position (x, y).
 * Searches menus, taskbar, and desktop windows/widgets in z-order.
 * @param x Screen X coordinate.
 * @param y Screen Y coordinate.
 * @return Topmost DOM Node ID, or 0 if background.
 */
export i32 find_at(i32 x, i32 y) {
    if (g_menu_id != 0) {
        i32 m = hit_test(g_menu_id, x, y);
        if (m != 0) { return m; }
    }
    if (g_taskbar_id != 0) {
        i32 tb = hit_test(g_taskbar_id, x, y);
        if (tb != 0) { return tb; }
    }
    i32 child_id = first_child(g_desktop_node_id);
    i32 found = 0;
    while (child_id != 0) {
        if (child_id != g_taskbar_id) {
            if (child_id != g_menu_id) {
                i32 hit = hit_test(child_id, x, y);
                if (hit != 0) {
                    found = hit;
                }
            }
        }
        child_id = next_sibling(child_id);
    }
    return found;
}

// --- init ------------------------------------------------------------------------------------------

/**
 * Initializes graphics subsystem and constructs the initial DOM tree hierarchy.
 */
export void init() {
    graphics.init();
    i32 root = create_node(NodeKind::ROOT, "root");
    g_root_node_id = root;
    set_role(root, NodeRole::ROOT);

    i32 sys = create_node(NodeKind::SYSTEM, "system");
    append_child(root, sys);

    i32 proc = create_node(NodeKind::PROCESS, "process");
    append_child(sys, proc);

    i32 dev = create_node(NodeKind::DEVICE, "device");
    append_child(sys, dev);

    i32 fs_node = create_node(NodeKind::DIRECTORY, "fs");
    append_child(dev, fs_node);

    i32 ui = create_node(NodeKind::UI, "ui");
    append_child(sys, ui);

    i32 desktop = create_node(NodeKind::DESKTOP, "desktop");
    append_child(ui, desktop);
    g_desktop_node_id = desktop;
    set_role(desktop, NodeRole::DESKTOP);

    i32 timers = create_node(NodeKind::UI, "timers");
    append_child(ui, timers);
    g_timers_node_id = timers;
    g_timer_count = 0;

    g_active_window = 0;
    g_focus_id = 0;
    g_taskbar_id = 0;
}

/**
 * Creates and docks the taskbar at the bottom of the desktop screen.
 * @return Taskbar DOM Node ID.
 */
export i32 create_taskbar() {
    if (g_taskbar_id != 0) { return g_taskbar_id; }
    i32 s = ui_scale();
    i32 h = theme.taskbar_h() * s;
    i32 dw = graphics.display_width();
    i32 dh = graphics.display_height();
    i32 id = create_node(NodeKind::TASKBAR, "taskbar");
    set_role(id, NodeRole::TOOLBAR);
    set_text(id, "taskbar");
    set_bounds(id, 0, dh - h, dw, h);
    set_state_flag(id, NodeState::VISIBLE, 1);
    set_state_flag(id, NodeState::HIT_TESTABLE, 1);
    append_child(g_desktop_node_id, id);
    g_taskbar_id = id;
    return id;
}
