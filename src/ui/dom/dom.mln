package dom;

import debug from "../../../../MyKernel/src/debug/debug.mln";
import heap from "../../../../MyKernel/src/mm/heap.mln";
import scheduler from "../../../../MyKernel/src/kernel/scheduler.mln";
import graphics from "../graphics.mln";
import theme from "../theme.mln";
import ui_events from "../ui_events.mln";
import irq from "../../../../MyKernel/src/arch/irq.mln";
import { UiEventKind } from "../../../../MyAppFramework/src/protocol/ui.mln";
import { Option } from "../../../../../toolchain/MyStdLib/option.mln";

// Kernel object tree + UI DOM. See docs/DOM_SPEC.md and MYOS-014.
//
// One tree holds both the OS object model (root/system/process/device/ui)
// and the UI: windows and their controls hang under ui/desktop. UI nodes
// carry bounds in *absolute display pixels*; the create_* helpers take
// logical 1024x768 coordinates, scale them, and append_child then offsets a
// child by its parent's content origin, so app code writes positions
// relative to the window it is building. Sibling order is paint order and
// z-order (later on top); bring_to_front re-links a window to the end.

// --- node kinds --------------------------------------------------------------
export enum NodeKind {
    ROOT,
    SYSTEM,
    PROCESS,
    DEVICE,
    DIRECTORY,
    FILE,
    UI,
    DESKTOP,
    WINDOW,
    BOX,
    TEXT,
    BUTTON,
    TIMER,
    COLUMN,
    ROW,
    TEXT_INPUT,
    CHECKBOX,
    SEPARATOR,
    PANEL,
    TASKBAR,
    TEXT_AREA,
    LIST,
    MENU,
}

export enum NodeRole {
    NONE,
    ROOT,
    DESKTOP,
    WINDOW,
    BUTTON,
    TEXT,
    TEXTBOX,
    CHECKBOX,
    TOOLBAR,
    SEPARATOR,
    TEXTAREA,
    LIST,
    MENU,
}

export enum NodeState {
    VISIBLE      = 0b0000001,
    ENABLED      = 0b0000010,
    HOVERED      = 0b0000100,
    PRESSED      = 0b0001000,
    FOCUSED      = 0b0010000, // keyboard focus, or the active window
    HIT_TESTABLE = 0b0100000, // find_at may return this node
    CHECKED      = 0b1000000, // Checkbox
    MAXIMIZED    = 128,       // Window fills the desktop; sx..sh hold the restore bounds
    MINIMIZED    = 256,       // Window hidden to the taskbar
    TEXT_OWNED   = 512,       // `text` is a heap copy this node frees (set_text_copy)
}

export enum NodeStyle {
    BOLD     = 1, // Text: heavier face
    PRIMARY  = 2, // Button: accent-coloured call to action
    CENTER   = 4, // Text: centre within w when w > 0
    READONLY = 8, // TextArea: displays text, no editing (console output)
}

// Node layout (offsets, bytes; measured u16=2B, pointers 4B-aligned, no tail
// padding): id=0 kind=2 name=4 parent=8 first_child=10 next_sibling=12 role=14
// text=16 x=20 y=22 w=24 h=26 state=28 style=30 on_click=32
// background_color=36 border_color=40 padding=44 gap=46 color=48 on_key=52
// on_change=56 cap=60 len=62 cursor=64 radius=66 on_tick=68 interval=72
// next_due=76 test_id=80 scroll=84 sel=86 sx=88 sy=90 sw=92 sh=94
// owner=96 on_close=100 -> sizeof = 104.
//
// Handlers all share one ABI, `void handler(i32 owner, i32 id, i32 arg)`:
// `owner` is the app instance the node belongs to (see `owner` below), `id`
// the node, `arg` event data (a key handler gets code | mods << 16).
// The on_* fields hold server-side functions only -- the taskbar, menus,
// the shell's window-close hook, the clock. A node an app owns (owner != 0)
// never carries a function pointer: what happens to it is emitted as a UI
// protocol event (emit -> ui_events) and the app's own runtime calls the
// handler. Server handlers are not called where the event is detected
// either: they are queued (push_event) and run by drain_events() at a point
// the compositor chooses, with g_current_owner set so anything the handler
// creates is owned by the same app.
//
// Public because it is the payload type of get_node(). Mutation still goes
// through the DOM setters by convention.
export typedef struct {
    u16 id;
    u16 kind;
    char *name;
    u16 parent;
    u16 first_child;
    u16 next_sibling;
    u16 role;        // ROLE_* ; 0 = none
    char *text;      // display text / accessible name ; 0 = none
    u16 x;           // bounds in display pixels (UI nodes only, else 0)
    u16 y;
    u16 w;
    u16 h;
    u16 state;       // STATE_* bitmask
    u16 style;       // STYLE_* bitmask
    i32 on_click;    // click handler(owner, id, 0) ; 0 = none
    i32 background_color; // NODE_BOX fill colour (0 is valid black)
    i32 border_color;     // NODE_BOX border colour
    u16 padding;          // NODE_COLUMN/ROW inset, in display pixels
    u16 gap;              // NODE_COLUMN/ROW gap between children, in display pixels
    i32 color;            // foreground/text colour ; 0 = theme default
    i32 on_key;           // key filter i32(owner, id, code | mods << 16) for DOWN events, run
                          // inline (it returns 1 to claim the key); 0 = default
    i32 on_change;        // change handler(owner, id, 0): TextInput edits, Checkbox toggles
    u16 cap;              // TextInput: buffer capacity in bytes (incl. NUL)
    u16 len;              // TextInput: current text length
    u16 cursor;           // TextInput: caret position (0..len)
    u16 radius;           // Panel corner radius, display pixels
    i32 on_tick;          // Timer handler(owner, id, 0)
    i32 interval;         // Timer period in scheduler ticks
    i32 next_due;         // Timer: tick at which it next fires
    char *test_id;        // stable automation identity; 0 = none
    u16 scroll;           // TextArea/List: first visible line/row
    u16 sel;              // List: selected row + 1 (0 = none); Menu: hovered row + 1
    u16 sx;               // Window: bounds saved by maximize_window
    u16 sy;
    u16 sw;
    u16 sh;
    i32 owner;            // app instance (a struct pointer) this node belongs to; 0 = system
    i32 on_close;         // Window: handler(owner, id, 0) when the user closes it; 0 = just remove
} Node;

export i32 NODE_SIZE = 104;

// Damage rectangles: the areas that changed since the last render, in
// display coordinates. render_scene repaints each one under a clip. Keeping
// several instead of one union matters because the taskbar spans the full
// width at the bottom: one rect for it plus one for a window near the top
// would otherwise union into nearly the whole screen. When the list is
// full, new areas merge into the first entry.
export i32 DAMAGE_MAX = 8;
export i32 g_damage_x0[8];
export i32 g_damage_y0[8];
export i32 g_damage_x1[8];
export i32 g_damage_y1[8];
export i32 g_damage_count = 0;

// The rect render_scene is currently repainting, so node_in_damage can test
// against just that one; g_painting_all short-circuits it for full paints.
export i32 g_paint_x0 = 0;
export i32 g_paint_y0 = 0;
export i32 g_paint_x1 = 0;
export i32 g_paint_y1 = 0;
export i32 g_painting_all = 1;

export i32 g_next_node_id = 1; // 0 is invalid/null
export i32 g_revision = 0;     // increments on externally observable DOM mutation
export i32 g_root_node_id = 0;
export i32 g_desktop_node_id = 0; // set in init(); UI attaches under this
export i32 g_taskbar_id = 0;      // the desktop's taskbar node, drawn above windows
export i32 g_timers_node_id = 0;  // structural parent for Timer nodes

export i32 g_active_window = 0;   // window with STATE_FOCUSED (front-most, gets keys)
export i32 g_focus_id = 0;        // node with keyboard focus (a TextInput), or 0
export i32 g_launcher = 0;        // handler() for the taskbar's launcher button
export i32 g_menu_id = 0;         // the open popup menu, or 0
export i32 g_menu_handler = 0;    // handler(index) for the open menu
export i32 g_menu_target = 0;     // the window a window-menu acts on (0 for the desktop menu)

// The app instance whose code is running right now (a handler drained from
// the event queue, or a view() being mounted); create_node stamps it into
// each new node's `owner`, so dialogs and timers an app makes on the fly are
// swept with it by remove_owned(). 0 while the system itself runs.
export i32 g_current_owner = 0;

// Apps the shell has started whose window has not arrived yet. Reported in
// the automation snapshot ("starting") so a test harness can tell a
// desktop that is still booting from a settled one.
i32 g_apps_starting = 0;
export void note_app_starting(i32 delta) { g_apps_starting = g_apps_starting + delta; if (g_apps_starting < 0) { g_apps_starting = 0; } }
export i32 apps_starting() { return g_apps_starting; }

// Installed by the app framework: i32 filter(owner, code, mods) sees every
// key DOWN before the focused widget and returns 1 to claim it (shortcuts).
export i32 g_key_filter = 0;

// Pending handler calls: 4 words each (handler, owner, id, arg).
export i32 EVENT_MAX = 64;
export i32 g_events[256];
export i32 g_event_head = 0;
export i32 g_event_tail = 0;

// Up to NODE_IDS nodes at once. Ids are reused: remove_node() returns an id
// to a free list and create_node() takes from it before growing the high-
// water mark (g_next_node_id), so opening and closing apps does not run
// the space out. A node's id is only ever handed out again after the node
// is gone; anything that kept the old id (the shell's instance tables, an
// automation snapshot) checks the node it names, not the number.
//
// Each owner (an app process) may hold at most NODES_PER_OWNER nodes, so
// one app cannot take the whole table from the others; create_node()
// returns 0 past that, and past NODE_IDS.
i32 NODE_IDS = 512;
export i32 NODES_PER_OWNER = 96;
Node *g_node_table[512];
i32 g_free_ids[512];
i32 g_free_count = 0;
i32 g_owner_nodes_owner[32];   // per-owner node counts, 0 = free slot
i32 g_owner_nodes_count[32];

i32 owner_slot(i32 owner, i32 make) {
    i32 free = -1;
    i32 i = 0;
    while (i < 32) {
        if (g_owner_nodes_owner[i] == owner) { return i; }
        if (g_owner_nodes_owner[i] == 0 && free < 0) { free = i; }
        i++;
    }
    if (make == 0) { return -1; }
    if (free < 0) { return -1; }
    g_owner_nodes_owner[free] = owner;
    g_owner_nodes_count[free] = 0;
    return free;
}

// Nodes the owner holds right now.
export i32 nodes_of(i32 owner) {
    i32 s = owner_slot(owner, 0);
    if (s < 0) { return 0; }
    return g_owner_nodes_count[s];
}
export Node **get_g_node_table() { return (Node**)(&g_node_table[0]); }

// Registered timers (ids), scanned by tick().
export i32 TIMER_MAX = 16;
export i32 g_timer_ids[16];
export i32 g_timer_count = 0;

// Scratch rectangle for helpers that hand back a rect (no multiple returns).
export i32 g_ext_x = 0;
export i32 g_ext_y = 0;
export i32 g_ext_w = 0;
export i32 g_ext_h = 0;

// Formatted uptime clock for the taskbar.
export char g_clock_buf[16];

/**
 * Increments the global DOM revision counter when observable tree changes occur.
 */
export void touch() { g_revision = g_revision + 1; }

/**
 * Returns the current DOM mutation revision number.
 * @return Monotonically increasing revision counter.
 */
export i32 revision() { return g_revision; }

// DOM markup uses logical 1024x768 coordinates. Scale it uniformly to the
// physical display so its proportions remain intact on larger resolutions.
// A display smaller than the base size keeps scale 1, avoiding zero-size
// controls; responsive downscaling can be added when sub-pixel layout exists.
export i32 BASE_DISPLAY_WIDTH = 1024;
export i32 BASE_DISPLAY_HEIGHT = 768;

/**
 * Calculates the integer UI scaling factor based on current display resolution.
 * @return Scaling factor (>= 1).
 */
export i32 ui_scale() {
    i32 sx = graphics.display_width() / BASE_DISPLAY_WIDTH;
    i32 sy = graphics.display_height() / BASE_DISPLAY_HEIGHT;
    i32 scale = sx;
    if (sy < scale) { scale = sy; }
    if (scale < 1) { scale = 1; }
    return scale;
}

/**
 * Scales a logical coordinate or dimension by the current UI scale.
 * @param value Logical pixel value.
 * @return Scaled physical pixel value.
 */
export i32 scale_ui(i32 value) {
    return value * ui_scale();
}

/**
 * Returns a direct pointer to the Node struct for the given NodeId, or null if invalid.
 * @param id DOM Node ID.
 * @return Pointer to Node struct, or 0.
 */
export Node* node_ptr(i32 id) {
    if (id <= 0) { return (Node*)0; }
    if (id >= g_next_node_id) { return (Node*)0; }
    return g_node_table[id];
}

// The sole Option-returning boundary. It remains internal because MyLang's
// cross-module signature ABI cannot expose an Option of a package-private
// struct. External callers use node_exists() or the scalar DOM operations.
Option<Node*> get_node(i32 id) {
    Node *node = node_ptr(id);
    if (node == 0) { return None; }
    return Some(node);
}

/**
 * Checks whether a DOM node ID exists and is currently allocated.
 * @param id DOM Node ID.
 * @return True if node exists, false otherwise.
 */
export bool node_exists(i32 id) {
    return node_ptr(id) != 0;
}

/**
 * Allocates and initializes a new DOM node of the given kind with default values.
 * @param kind NodeKind enum variant.
 * @param name Null-terminated node name string.
 * @return Newly allocated Node ID.
 */
export i32 create_node(i32 kind, char *name) {
    // The owner's share first: an app past its limit gets 0, not a panic.
    i32 oslot = -1;
    if (g_current_owner != 0) {
        oslot = owner_slot(g_current_owner, 1);
        if (oslot < 0) { return 0; }
        if (g_owner_nodes_count[oslot] >= NODES_PER_OWNER) { return 0; }
    }
    i32 id = 0;
    if (g_free_count > 0) {
        g_free_count = g_free_count - 1;
        id = g_free_ids[g_free_count];
    } else {
        if (g_next_node_id >= NODE_IDS) {
            if (g_current_owner != 0) { return 0; }
            debug.panic("dom: out of node ids");
        }
        id = g_next_node_id;
        g_next_node_id = g_next_node_id + 1;
    }
    if (oslot >= 0) { g_owner_nodes_count[oslot] = g_owner_nodes_count[oslot] + 1; }

    Node *n = (Node *)heap.alloc(NODE_SIZE);

    n->id = (u16)id;
    n->kind = (u16)kind;
    n->name = name;
    n->parent = 0;
    n->first_child = 0;
    n->next_sibling = 0;

    n->role = NodeRole::NONE;
    n->text = (char*)0;
    n->x = 0;
    n->y = 0;
    n->w = 0;
    n->h = 0;
    n->state = 0;
    n->style = 0;
    n->on_click = 0;
    n->background_color = 0;
    n->border_color = 0;
    n->padding = 0;
    n->gap = 0;
    n->color = 0;
    n->on_key = 0;
    n->on_change = 0;
    n->cap = 0;
    n->len = 0;
    n->cursor = 0;
    n->radius = 0;
    n->on_tick = 0;
    n->interval = 0;
    n->next_due = 0;
    n->test_id = (char*)0;
    n->scroll = 0;
    n->sel = 0;
    n->sx = 0;
    n->sy = 0;
    n->sw = 0;
    n->sh = 0;
    n->owner = g_current_owner;
    n->on_close = 0;

    g_node_table[id] = n;
    touch();
    return id;
}

// --- ownership ------------------------------------------------------------------------

export i32 owner_of(i32 id) {
    Node *n = node_ptr(id);
    if (n == 0) { return 0; }
    return n->owner;
}

// Re-stamp a subtree with `owner`, for trees built before the owner existed.
export void set_owner(i32 id, i32 owner) {
    Node *n = node_ptr(id);
    if (n == 0) { return; }
    n->owner = owner;
    i32 child = n->first_child;
    while (child != 0) {
        set_owner(child, owner);
        Node *c = node_ptr(child);
        if (c == 0) { child = 0; } else { child = c->next_sibling; }
    }
}

export void set_key_filter(i32 handler) { g_key_filter = handler; }
export i32 key_filter() { return g_key_filter; }

export i32 current_owner() { return g_current_owner; }
export void set_current_owner(i32 owner) { g_current_owner = owner; }

// Delete every node an app instance owns: its windows, any dialog it opened
// and its timers. Ids are walked in order; a node freed as part of an
// earlier subtree simply reads back as absent.
export void remove_owned(i32 owner) {
    if (owner == 0) { return; }
    i32 id = 1;
    while (id < g_next_node_id) {
        Node *n = node_ptr(id);
        if (n != 0) {
            if (n->owner == owner) { remove_node(id); }
        }
        id++;
    }
}

// --- event queue ----------------------------------------------------------------------

// Queue a handler call. A full queue drops the event: the alternative,
// running it inline, is exactly what the queue exists to avoid.
export void push_event(i32 handler, i32 owner, i32 id, i32 arg) {
    if (handler == 0) { return; }
    i32 next = g_event_tail + 1;
    if (next >= EVENT_MAX) { next = 0; }
    if (next == g_event_head) { return; }
    i32 at = g_event_tail * 4;
    g_events[at] = handler;
    g_events[at + 1] = owner;
    g_events[at + 2] = id;
    g_events[at + 3] = arg;
    g_event_tail = next;
}

export i32 has_events() {
    if (g_event_head == g_event_tail) { return 0; }
    return 1;
}

// Something happened to node `n`: an app-owned node emits a protocol event
// to its owner (the app's runtime runs the handler); a server node queues
// its own `handler`, if any. Returns 1 when either was done.
export i32 emit(Node *n, i32 kind, i32 handler, i32 arg) {
    if (n->owner != 0) {
        ui_events.push(n->owner, n->id, kind, arg, 0, (char*)0);
        return 1;
    }
    if (handler == 0) { return 0; }
    push_event(handler, 0, n->id, arg);
    return 1;
}

// Run every queued handler, in order, each with g_current_owner set to the
// app it belongs to. Handlers may queue further events; those run in the
// same pass.
export void drain_events() {
    while (g_event_head != g_event_tail) {
        i32 at = g_event_head * 4;
        i32 handler = g_events[at];
        i32 owner = g_events[at + 1];
        i32 id = g_events[at + 2];
        i32 arg = g_events[at + 3];
        g_event_head = g_event_head + 1;
        if (g_event_head >= EVENT_MAX) { g_event_head = 0; }
        i32 outer = g_current_owner;
        g_current_owner = owner;
        handler(owner, id, arg);
        g_current_owner = outer;
    }
}

// --- the DOM lock ----------------------------------------------------------------------
// The DOM is the UI server's: its task holds this lock for every pass
// (input, requests, handlers, paint) and gives it up while it sleeps. The
// only other task that reads the tree is the automation service; it takes
// the lock around a dump. Apps never touch the DOM -- they send requests.
// Kernel tasks preempt on the timer, so the test-and-set is done with
// interrupts off.

i32 g_lock = 0;      // held
i32 g_want = 0;      // tasks waiting for it
i32 g_handoff = 0;   // unlock() passed the lock straight to a waiter

// Take the lock. A waiter sleeps a tick at a time; when the holder lets go
// while someone waits, the lock is handed over rather than released, so a
// long-running holder (the UI server's pass) cannot grab it again ahead of
// a task that was already waiting -- the automation dump would otherwise
// starve behind the compositor.
export void lock() {
    i32 was = irq.save_disable();
    if (g_lock == 0) {
        g_lock = 1;
        irq.restore(was);
        return;
    }
    g_want = g_want + 1;
    irq.restore(was);
    while (1) {
        was = irq.save_disable();
        if (g_handoff != 0) {
            g_handoff = 0;
            g_want = g_want - 1;
            irq.restore(was);
            return;   // g_lock stays 1: it is ours now
        }
        irq.restore(was);
        scheduler.sleep(1);
    }
}

export void unlock() {
    i32 was = irq.save_disable();
    if (g_want != 0) {
        g_handoff = 1;   // the next waiter to look owns it
    } else {
        g_lock = 0;
    }
    irq.restore(was);
}

// --- scalar queries -------------------------------------------------------------

/**
 * Returns the NodeKind of a node, or None if the node ID is invalid.
 * @param id DOM Node ID.
 * @return Some(kind) or None.
 */
export Option<i32> kind_of(i32 id) {
    Node *n = node_ptr(id);
    if (n == 0) { return None; }
    return Some(n->kind);
}

/**
 * Returns the parent node ID of a node.
 * @param id DOM Node ID.
 * @return Parent Node ID, or 0 if root or detached.
 */
export i32 parent_of(i32 id) {
    Node *n = node_ptr(id);
    if (n == 0) { return 0; }
    return n->parent;
}

/** Returns the absolute X coordinate in screen pixels of a node. */
export i32 node_x(i32 id) { Node *n = node_ptr(id); if (n == 0) { return 0; } return n->x; }
/** Returns the absolute Y coordinate in screen pixels of a node. */
export i32 node_y(i32 id) { Node *n = node_ptr(id); if (n == 0) { return 0; } return n->y; }
/** Returns the width in screen pixels of a node. */
export i32 node_w(i32 id) { Node *n = node_ptr(id); if (n == 0) { return 0; } return n->w; }
/** Returns the height in screen pixels of a node. */
export i32 node_h(i32 id) { Node *n = node_ptr(id); if (n == 0) { return 0; } return n->h; }

/**
 * Returns the text content of a node, or null.
 * @param id DOM Node ID.
 * @return Pointer to text string.
 */
export char* text_of(i32 id) {
    Node *n = node_ptr(id);
    if (n == 0) { return (char*)0; }
    return (char*)n->text;
}

/**
 * Returns the accessibility / automation role of a node.
 * @param id DOM Node ID.
 * @return NodeRole value.
 */
export i32 role_of(i32 id) {
    Node *n = node_ptr(id);
    if (n == 0) { return 0; }
    return n->role;
}

/**
 * Returns the debug / identifier name of a node.
 * @param id DOM Node ID.
 * @return Pointer to name string.
 */
export char* name_of(i32 id) {
    Node *n = node_ptr(id);
    if (n == 0) { return (char*)0; }
    return (char*)n->name;
}

/**
 * Returns the automation test ID of a node.
 * @param id DOM Node ID.
 * @return Pointer to test_id string.
 */
export char* test_id_of(i32 id) {
    Node *n = node_ptr(id);
    if (n == 0) { return (char*)0; }
    return (char*)n->test_id;
}

/**
 * Returns the root node ID of the DOM tree.
 * @return Root Node ID.
 */
export i32 root_node_id() { return g_root_node_id; }

/**
 * Returns the automation-visible value of a node (text content for textbox/textarea).
 * @param id DOM Node ID.
 * @return String value of the node, or empty string.
 */
export char* automation_value_of(i32 id) {
    Node *n = node_ptr(id);
    if (n == 0) { return ""; }
    i32 role = n->role;
    if (role == NodeRole::TEXTBOX) { return (char*)n->text; }
    if (role == NodeRole::TEXTAREA) { return (char*)n->text; }
    return "";
}

// --- damage -------------------------------------------------------------------------

/**
 * Checks whether two rectangles overlap or touch.
 * @param ax0 First rectangle left.
 * @param ay0 First rectangle top.
 * @param ax1 First rectangle right.
 * @param ay1 First rectangle bottom.
 * @param bx0 Second rectangle left.
 * @param by0 Second rectangle top.
 * @param bx1 Second rectangle right.
 * @param by1 Second rectangle bottom.
 * @return 1 if rectangles touch or overlap, 0 otherwise.
 */
export i32 rects_touch(i32 ax0, i32 ay0, i32 ax1, i32 ay1, i32 bx0, i32 by0, i32 bx1, i32 by1) {
    if (ax1 < bx0) { return 0; }
    if (bx1 < ax0) { return 0; }
    if (ay1 < by0) { return 0; }
    if (by1 < ay0) { return 0; }
    return 1;
}

/**
 * Expands a damage rectangle entry to include another bounding box.
 * @param i Index of damage entry in table.
 * @param x0 Bounding box left.
 * @param y0 Bounding box top.
 * @param x1 Bounding box right.
 * @param y1 Bounding box bottom.
 */
export void damage_union_into(i32 i, i32 x0, i32 y0, i32 x1, i32 y1) {
    if (x0 < g_damage_x0[i]) { g_damage_x0[i] = x0; }
    if (y0 < g_damage_y0[i]) { g_damage_y0[i] = y0; }
    if (x1 > g_damage_x1[i]) { g_damage_x1[i] = x1; }
    if (y1 > g_damage_y1[i]) { g_damage_y1[i] = y1; }
}

/**
 * Adds a rectangle to the damage list, clipped to the display.
 * Merges into an overlapping entry if present, or creates a new entry.
 * @param x Rectangle X position.
 * @param y Rectangle Y position.
 * @param w Rectangle width.
 * @param h Rectangle height.
 */
export void damage_rect(i32 x, i32 y, i32 w, i32 h) {
    i32 display_width = graphics.display_width();
    i32 display_height = graphics.display_height();
    i32 x0 = x;
    i32 y0 = y;
    i32 x1 = x + w;
    i32 y1 = y + h;

    if (x0 < 0) { x0 = 0; }
    if (y0 < 0) { y0 = 0; }
    if (x1 > display_width) { x1 = display_width; }
    if (y1 > display_height) { y1 = display_height; }
    if (x1 <= x0) { return; }
    if (y1 <= y0) { return; }

    i32 i = 0;
    while (i < g_damage_count) {
        if (rects_touch(x0, y0, x1, y1, g_damage_x0[i], g_damage_y0[i], g_damage_x1[i], g_damage_y1[i]) != 0) {
            damage_union_into(i, x0, y0, x1, y1);
            return;
        }
        i++;
    }
    if (g_damage_count < DAMAGE_MAX) {
        g_damage_x0[g_damage_count] = x0;
        g_damage_y0[g_damage_count] = y0;
        g_damage_x1[g_damage_count] = x1;
        g_damage_y1[g_damage_count] = y1;
        g_damage_count = g_damage_count + 1;
        return;
    }
    damage_union_into(0, x0, y0, x1, y1);
}

/**
 * Calculates the full painted extent of a node (including window shadows).
 * Results are stored in g_ext_x, g_ext_y, g_ext_w, g_ext_h.
 * @param n Pointer to DOM Node.
 */
export void node_extent(Node *n) {
    i32 x = n->x;
    i32 y = n->y;
    i32 w = n->w;
    i32 h = n->h;
    if (n->kind == NodeKind::WINDOW) {
        i32 s = ui_scale();
        i32 size = theme.shadow_size() * s;
        i32 off = theme.shadow_offset() * s;
        x = x - size;
        y = y - size;
        w = w + 2 * size;
        h = h + 2 * size + off;
    }
    g_ext_x = x;
    g_ext_y = y;
    g_ext_w = w;
    g_ext_h = h;
}

/**
 * Marks a node's full extent as needing repaint.
 * @param id DOM Node ID.
 */
export void damage_node(i32 id) {
    Node *n = node_ptr(id);
    if (n == 0) { return; }
    node_extent(n);
    damage_rect(g_ext_x, g_ext_y, g_ext_w, g_ext_h);
}

/**
 * Checks whether any damaged regions exist.
 * @return 1 if damage regions exist, 0 otherwise.
 */
export i32 has_damage() {
    if (g_damage_count > 0) { return 1; }
    return 0;
}

/**
 * Clears the damage region list.
 */
export void clear_damage() {
    g_damage_count = 0;
}

// --- text metrics ---------------------------------------------------------------------

/**
 * Checks if a node uses bold text styling.
 * @param n Pointer to DOM Node.
 * @return 1 if bold, 0 otherwise.
 */
export i32 text_bold(Node *n) {
    if ((n->style & NodeStyle::BOLD) != 0) { return 1; }
    return 0;
}

/**
 * Computes rendered text width for a node based on UI scale and bold flag.
 * @param n Pointer to DOM Node.
 * @return Rendered text width in pixels.
 */
export i32 text_width_of(Node *n) {
    if (n->text == 0) { return 0; }
    i32 bold = text_bold(n);
    i32 s = ui_scale();
    return graphics.text_width((char*)n->text, bold, s);
}

/**
 * Computes rendered text height for a node based on UI scale and bold flag.
 * @param n Pointer to DOM Node.
 * @return Rendered text height in pixels.
 */
export i32 text_height_of(Node *n) {
    i32 bold = text_bold(n);
    i32 s = ui_scale();
    return graphics.text_height(bold, s);
}

// --- layout ---------------------------------------------------------------------------------

/**
 * Translates a subtree by (dx, dy) without damage bookkeeping.
 * @param id DOM Node ID.
 * @param dx Horizontal offset.
 * @param dy Vertical offset.
 */
export void offset_subtree(i32 id, i32 dx, i32 dy) {
    Node *n = node_ptr(id);
    if (n == 0) { return; }
    n->x = (u16)(n->x + dx);
    n->y = (u16)(n->y + dy);
    i32 child_id = n->first_child;
    while (child_id != 0) {
        offset_subtree(child_id, dx, dy);
        Node *c = node_ptr(child_id);
        if (c == 0) { child_id = 0; } else { child_id = c->next_sibling; }
    }
}

/**
 * Positions a child node and its subtree at absolute coordinates (x, y).
 * @param child_id DOM Node ID of the child.
 * @param x Target X coordinate.
 * @param y Target Y coordinate.
 */
export void place_child(i32 child_id, i32 x, i32 y) {
    Node *child = node_ptr(child_id);
    if (child == 0) { return; }
    i32 dx = x - child->x;
    i32 dy = y - child->y;
    if (dx == 0) {
        if (dy == 0) { return; }
    }
    damage_node(child_id);
    offset_subtree(child_id, dx, dy);
    damage_node(child_id);
}

/**
 * Recursively updates layout for container nodes (COLUMN or ROW).
 * @param n Pointer to container Node.
 */
export void relayout_container(Node *n);

/**
 * Lays out direct children of a column container top-to-bottom.
 * @param column Pointer to Column Node.
 */
export void relayout_column(Node *column) {
    i32 child_x = column->x + column->padding;
    i32 cursor_y = column->y + column->padding;
    i32 gap = column->gap;
    i32 child_id = column->first_child;

    while (child_id != 0) {
        Node *child = node_ptr(child_id);
        if (child == 0) { child_id = 0; }
        else {
            i32 child_h = child->h;
            place_child(child_id, child_x, cursor_y);
            relayout_container(child);
            cursor_y = cursor_y + child_h + gap;
            child_id = child->next_sibling;
        }
    }
}

/**
 * Lays out direct children of a row container left-to-right, top-aligned.
 * @param row Pointer to Row Node.
 */
export void relayout_row(Node *row) {
    i32 cursor_x = row->x + row->padding;
    i32 child_y = row->y + row->padding;
    i32 gap = row->gap;
    i32 child_id = row->first_child;

    while (child_id != 0) {
        Node *child = node_ptr(child_id);
        if (child == 0) { child_id = 0; }
        else {
            i32 child_w = child->w;
            place_child(child_id, cursor_x, child_y);
            relayout_container(child);
            cursor_x = cursor_x + child_w + gap;
            child_id = child->next_sibling;
        }
    }
}

/**
 * Dispatches layout calculation for a container node to relayout_column or relayout_row.
 * @param n Pointer to container Node.
 */
export void relayout_container(Node *n) {
    i32 k = n->kind;
    if (k == NodeKind::COLUMN) { relayout_column(n); }
    if (k == NodeKind::ROW) { relayout_row(n); }
}

// --- prop accessors ---------------------------------------------------------------------

/**
 * Sets absolute bounds for a node, reflowing layouts and damaging old and new areas.
 * @param id DOM Node ID.
 * @param x Left coordinate.
 * @param y Top coordinate.
 * @param w Width in pixels.
 * @param h Height in pixels.
 */
export void set_bounds(i32 id, i32 x, i32 y, i32 w, i32 h) {
    Node *n = node_ptr(id);
    if (n == 0) { return; }
    // Damage the old area as well as the new one, so vacating a region repaints
    // the background that was underneath.
    damage_node(id);
    n->x = (u16)x;
    n->y = (u16)y;
    n->w = (u16)w;
    n->h = (u16)h;
    damage_node(id);
    relayout_container(n);
    Node *parent = node_ptr(n->parent);
    if (parent != 0) { relayout_container(parent); }
    touch();
}

/**
 * Translates a node and its entire subtree by (dx, dy) with damage tracking.
 * @param id DOM Node ID.
 * @param dx Horizontal delta.
 * @param dy Vertical delta.
 */
export void move_node(i32 id, i32 dx, i32 dy) {
    Node *n = node_ptr(id);
    if (n == 0) { return; }
    damage_node(id);
    offset_subtree(id, dx, dy);
    damage_node(id);
    touch();
}

/**
 * Sets the text content of a node, updating bounds for TEXT nodes and triggering damage.
 * @param id DOM Node ID.
 * @param text Null-terminated text string.
 */
export void set_text(i32 id, char *text) {
    Node *n = node_ptr(id);
    if (n == 0) { return; }
    damage_node(id);   // old string's extent
    if ((n->state & NodeState::TEXT_OWNED) != 0) {
        if (n->text != 0) { heap.free((i32)n->text); }
        n->state = (u16)(n->state & ~NodeState::TEXT_OWNED);
    }
    n->text = text;
    // Text keeps physical bounds equal to its measured size so damage,
    // clipping, layout, and hit testing all agree. Windows and buttons also
    // have text, but their authored layout bounds must never be replaced by
    // caption size.
    if (n->kind == NodeKind::TEXT) {
        n->w = (u16)text_width_of(n);
        n->h = (u16)text_height_of(n);
        Node *parent = node_ptr(n->parent);
        if (parent != 0) { relayout_container(parent); }
    }
    damage_node(id);   // new string may be longer
    touch();
}

// set_text with a copy the node owns: for text that comes from an app
// (another address space, or a buffer it will reuse). Freed when the text
// is replaced or the node removed.
export void set_text_copy(i32 id, char *text) {
    Node *n = node_ptr(id);
    if (n == 0) { return; }
    i32 len = 0;
    while (text[len] != 0) { len++; }
    char *copy = (char*)heap.alloc(len + 1);
    if (copy == 0) { return; }
    i32 k = 0;
    while (k <= len) { copy[k] = text[k]; k++; }
    set_text(id, copy);
    n->state = (u16)(n->state | NodeState::TEXT_OWNED);
}

/**
 * Sets the accessibility / automation role of a node.
 * @param id DOM Node ID.
 * @param role NodeRole value.
 */
export void set_role(i32 id, i32 role) {
    Node *n = node_ptr(id);
    if (n == 0) { return; }
    n->role = (u16)role;
    touch();
}

/**
 * Sets the automation test identifier for a node.
 * @param id DOM Node ID.
 * @param test_id Test identifier string.
 */
export void set_test_id(i32 id, char *test_id) {
    Node *n = node_ptr(id);
    if (n == 0) { return; }
    n->test_id = test_id;
    touch();
}

/**
 * Sets background and border colors of a node.
 * @param id DOM Node ID.
 * @param background Background color (RGB).
 * @param border Border color (RGB).
 */
export void set_colors(i32 id, i32 background, i32 border) {
    Node *n = node_ptr(id);
    if (n == 0) { return; }
    damage_node(id);
    n->background_color = background;
    n->border_color = border;
}

/**
 * Sets foreground/text color of a node (0 restores theme default).
 * @param id DOM Node ID.
 * @param color Text color (RGB).
 */
export void set_color(i32 id, i32 color) {
    Node *n = node_ptr(id);
    if (n == 0) { return; }
    n->color = color;
    damage_node(id);
}

/**
 * Sets the text style flags (e.g. NodeStyle::BOLD) for a node.
 * @param id DOM Node ID.
 * @param style Style bitmask.
 */
export void set_style(i32 id, i32 style) {
    Node *n = node_ptr(id);
    if (n == 0) { return; }
    n->style = (u16)style;
    if (n->kind == NodeKind::TEXT) {
        n->w = (u16)text_width_of(n);
        n->h = (u16)text_height_of(n);
    }
    damage_node(id);
}

/**
 * Sets padding and gap for a COLUMN/ROW node and updates layout.
 * @param id DOM Node ID.
 * @param padding Inset padding in pixels.
 * @param gap Gap between children in pixels.
 */
export void set_column_layout(i32 id, i32 padding, i32 gap) {
    Node *n = node_ptr(id);
    if (n == 0) { return; }
    n->padding = (u16)padding;
    n->gap = (u16)gap;
    relayout_container(n);
}

/**
 * Determines whether a state flag change visibly alters a node's rendering.
 * @param n Pointer to DOM Node.
 * @param flag NodeState flag.
 * @return True if visible appearance changes, false otherwise.
 */
export bool state_is_visible(Node *n, i32 flag) {
    i32 kind = n->kind;
    if (flag == NodeState::HOVERED) {
        if (kind == NodeKind::BUTTON) { return true; }
        if (kind == NodeKind::CHECKBOX) { return true; }
        if (kind == NodeKind::WINDOW) { return true; } // title-bar button highlight
        if (kind == NodeKind::MENU) { return true; }
        return false;
    }
    if (flag == NodeState::PRESSED) {
        if (kind == NodeKind::BUTTON) { return true; }
        if (kind == NodeKind::CHECKBOX) { return true; }
        return false;
    }
    if (flag == NodeState::FOCUSED) {
        if (kind == NodeKind::TEXT_INPUT) { return true; }
        if (kind == NodeKind::WINDOW) { return true; }
        if (kind == NodeKind::TEXT_AREA) { return true; }
        if (kind == NodeKind::LIST) { return true; }
        if (kind == NodeKind::BUTTON) { return true; }  // focus ring
        if (kind == NodeKind::CHECKBOX) { return true; }
        return false;
    }
    if (flag == NodeState::HIT_TESTABLE) { return false; }
    return true; // visibility, checked and everything else always matter
}

/**
 * Sets or clears an individual state flag bit on a node.
 * @param id DOM Node ID.
 * @param flag NodeState bitmask.
 * @param on Non-zero to set flag, 0 to clear.
 */
export void set_state_flag(i32 id, i32 flag, i32 on) {
    Node *n = node_ptr(id);
    if (n == 0) { return; }
    i32 state = n->state;
    i32 next = state & (~flag);
    if (on != 0) { next = state | flag; }
    // Only damage when the bit actually changes: the compositor sets
    // hovered/pressed every pass, and repainting on a no-op change would
    // defeat the whole point.
    if (next != state) {
        n->state = (u16)next;
        if (state_is_visible(n, flag)) {
            damage_node(id);
        }
        touch();
    }
}

/**
 * Tests whether a specific state flag bit is set on a node.
 * @param id DOM Node ID.
 * @param flag NodeState bitmask.
 * @return True if flag is set, false otherwise.
 */
export bool get_state_flag(i32 id, i32 flag) {
    Node *n = node_ptr(id);
    if (n == 0) { return false; }
    i32 state = n->state;
    if ((state & flag) != 0) { return true; }
    return false;
}

/**
 * Sets or clears the HOVERED state flag on a node.
 * @param id DOM Node ID.
 * @param on Non-zero to set, 0 to clear.
 */
export void set_hovered(i32 id, i32 on) { set_state_flag(id, NodeState::HOVERED, on); }

/**
 * Sets or clears the PRESSED state flag on a node.
 * @param id DOM Node ID.
 * @param on Non-zero to set, 0 to clear.
 */
export void set_pressed(i32 id, i32 on) { set_state_flag(id, NodeState::PRESSED, on); }

/**
 * Sets or clears the VISIBLE state flag on a node.
 * @param id DOM Node ID.
 * @param on Non-zero to set, 0 to clear.
 */
export void set_visible(i32 id, i32 on) { set_state_flag(id, NodeState::VISIBLE, on); }

/**
 * Sets or clears the HIT_TESTABLE state flag on a node.
 * @param id DOM Node ID.
 * @param on Non-zero to set, 0 to clear.
 */
export void set_hit_testable(i32 id, i32 on) { set_state_flag(id, NodeState::HIT_TESTABLE, on); }

/**
 * Sets or clears the CHECKED state flag on a checkbox node.
 * @param id DOM Node ID.
 * @param on Non-zero to set, 0 to clear.
 */
export void set_checked(i32 id, i32 on) { set_state_flag(id, NodeState::CHECKED, on); }

/**
 * Checks if a node has the CHECKED state flag set.
 * @param id DOM Node ID.
 * @return True if checked, false otherwise.
 */
export bool is_checked(i32 id) { return get_state_flag(id, NodeState::CHECKED); }

/**
 * Checks if a node has the VISIBLE state flag set.
 * @param id DOM Node ID.
 * @return True if visible, false otherwise.
 */
export bool is_visible(i32 id) { return get_state_flag(id, NodeState::VISIBLE); }

/**
 * Checks if a node has the ENABLED state flag set.
 * @param id DOM Node ID.
 * @return True if enabled, false otherwise.
 */
export bool is_enabled(i32 id) { return get_state_flag(id, NodeState::ENABLED); }

/**
 * Checks if a node has the FOCUSED state flag set.
 * @param id DOM Node ID.
 * @return True if focused, false otherwise.
 */
export bool is_focused(i32 id) { return get_state_flag(id, NodeState::FOCUSED); }

/**
 * Checks if a node has the HIT_TESTABLE state flag set.
 * @param id DOM Node ID.
 * @return True if hit-testable, false otherwise.
 */
export bool is_hit_testable(i32 id) { return get_state_flag(id, NodeState::HIT_TESTABLE); }

/**
 * Checks if a node has the HOVERED state flag set.
 * @param id DOM Node ID.
 * @return True if hovered, false otherwise.
 */
export bool is_hovered(i32 id) { return get_state_flag(id, NodeState::HOVERED); }

/**
 * Checks if a node has the PRESSED state flag set.
 * @param id DOM Node ID.
 * @return True if pressed, false otherwise.
 */
export bool is_pressed(i32 id) { return get_state_flag(id, NodeState::PRESSED); }

/**
 * Returns raw state bitmask of a node.
 * @param id DOM Node ID.
 * @return State flags bitmask.
 */
export i32 state_of(i32 id) {
    Node *n = node_ptr(id);
    if (n == 0) { return 0; }
    return n->state;
}

/**
 * Stores a click handler function pointer on a node and marks it hit-testable.
 * @param id DOM Node ID.
 * @param handler Function pointer to click callback.
 */
export void set_on_click(i32 id, i32 handler) {
    Node *n = node_ptr(id);
    if (n == 0) { return; }
    n->on_click = handler;
    set_hit_testable(id, handler != 0);
}

/**
 * Returns the click handler function pointer of a node.
 * @param id DOM Node ID.
 * @return Function pointer to click handler, or 0.
 */
export i32 get_on_click(i32 id) {
    Node *n = node_ptr(id);
    if (n == 0) { return 0; }
    return n->on_click;
}

/**
 * Stores a keyboard event handler function pointer on a node.
 * @param id DOM Node ID.
 * @param handler Function pointer to key event handler.
 */
export void set_on_key(i32 id, i32 handler) {
    Node *n = node_ptr(id);
    if (n == 0) { return; }
    n->on_key = handler;
}

/**
 * Stores a value change handler function pointer on a node.
 * @param id DOM Node ID.
 * @param handler Function pointer to change event handler.
 */
export void set_on_change(i32 id, i32 handler) {
    Node *n = node_ptr(id);
    if (n == 0) { return; }
    n->on_change = handler;
}

/**
 * Stores a window-close handler function pointer on a node.
 * @param id DOM Node ID.
 * @param handler Function pointer to close event handler.
 */
export void set_on_close(i32 id, i32 handler) {
    Node *n = node_ptr(id);
    if (n == 0) { return; }
    n->on_close = handler;
}

/**
 * Returns a node's registered close handler function pointer, if any.
 * @param id DOM Node ID.
 */
export i32 on_close_of(i32 id) {
    Node *n = node_ptr(id);
    if (n == 0) { return 0; }
    return n->on_close;
}

/**
 * Queues the value change handler of a node if registered, via the
 * (owner, id, arg) event queue -- not a direct call.
 * @param n Pointer to DOM Node.
 */
export void fire_change(Node *n) {
    emit(n, UiEventKind::CHANGE, n->on_change, 0);
}

// Queue a node's click handler, if any. Checkboxes toggle first, so the
// handler observes the new state. Returns 1 if a handler was queued, else 0.
export i32 dispatch_click(i32 id) {
    Node *n = node_ptr(id);
    if (n == 0) { return 0; }
    if (n->kind == NodeKind::CHECKBOX) {
        i32 now = n->state & NodeState::CHECKED;
        set_state_flag(id, NodeState::CHECKED, now == 0);
        fire_change(n);
    }
    return emit(n, UiEventKind::CLICK, n->on_click, 0);
}

// --- tree structure -----------------------------------------------------------------------

/**
 * Computes origin offset for children within a parent node (below window titlebar).
 * Results are stored in g_ext_x and g_ext_y.
 * @param parent Pointer to parent Node.
 */
export void content_origin(Node *parent) {
    g_ext_x = parent->x;
    g_ext_y = parent->y;
    if (parent->kind == NodeKind::WINDOW) {
        g_ext_y = g_ext_y + theme.titlebar_h() * ui_scale();
    }
}

/**
 * Appends a child node to a parent node, shifting coordinates and updating layout.
 * @param parent_id DOM Node ID of parent.
 * @param child_id DOM Node ID of child to append.
 */
export void append_child(i32 parent_id, i32 child_id) {
    Node *parent = node_ptr(parent_id);
    Node *child = node_ptr(child_id);
    if (parent == 0) { return; }
    if (child == 0) { return; }

    child->parent = (u16)parent_id;
    child->next_sibling = 0;

    if (parent->first_child == 0) {
        parent->first_child = (u16)child_id;
    } else {
        i32 current_id = parent->first_child;
        while (current_id != 0) {
            Node *curr = node_ptr(current_id);
            if (curr == 0) { current_id = 0; }
            else if (curr->next_sibling == 0) {
                curr->next_sibling = (u16)child_id;
                current_id = 0;
            } else {
                current_id = curr->next_sibling;
            }
        }
    }

    // Authored coordinates are relative to the parent's content origin;
    // stored coordinates are absolute, so shift the whole subtree once.
    content_origin(parent);
    offset_subtree(child_id, g_ext_x, g_ext_y);
    damage_node(child_id);

    // A Column/Row controls the positions of its direct children. This runs
    // after linking so the new child participates immediately.
    relayout_container(parent);
    touch();
}

/**
 * Unlinks a node from its parent's sibling linked-list without freeing or damaging.
 * @param n Pointer to DOM Node.
 */
export void unlink(Node *n) {
    Node *parent = node_ptr(n->parent);
    if (parent == 0) { return; }
    i32 id = n->id;
    if (parent->first_child == id) {
        parent->first_child = n->next_sibling;
    } else {
        i32 cur = parent->first_child;
        while (cur != 0) {
            Node *c = node_ptr(cur);
            if (c == 0) { cur = 0; }
            else if (c->next_sibling == id) {
                c->next_sibling = n->next_sibling;
                cur = 0;
            } else {
                cur = c->next_sibling;
            }
        }
    }
    n->next_sibling = 0;
}

/**
 * Moves a node to be the last child of its parent, painting it on top of siblings.
 * @param id DOM Node ID.
 */
export void bring_to_front(i32 id) {
    Node *n = node_ptr(id);
    if (n == 0) { return; }
    Node *parent = node_ptr(n->parent);
    if (parent == 0) { return; }
    if (n->next_sibling == 0) { return; } // already last
    unlink(n);
    // Re-append without re-translating: coordinates are already absolute.
    i32 last_id = parent->first_child;
    if (last_id == 0) {
        parent->first_child = (u16)id;
    } else {
        Node *last = node_ptr(last_id);
        while (last->next_sibling != 0) {
            last = node_ptr(last->next_sibling);
        }
        last->next_sibling = (u16)id;
    }
    damage_node(id);
    touch();
}

/**
 * Checks if a node owns its text buffer in heap memory.
 * @param n Pointer to DOM Node.
 * @return 1 if node owns text buffer, 0 otherwise.
 */
export i32 owns_buffer(Node *n) {
    i32 k = n->kind;
    if (k == NodeKind::TEXT_INPUT) { return 1; }
    if (k == NodeKind::TEXT_AREA) { return 1; }
    if (k == NodeKind::LIST) { return 1; }
    if (k == NodeKind::MENU) { return 1; }
    return 0;
}

/**
 * Recursively frees a node's subtree from memory and drops timers/focus.
 * @param id DOM Node ID.
 */
export void free_subtree(i32 id) {
    Node *n = node_ptr(id);
    if (n == 0) { return; }
    i32 child_id = n->first_child;
    while (child_id != 0) {
        Node *c = node_ptr(child_id);
        i32 next = 0;
        if (c != 0) { next = c->next_sibling; }
        free_subtree(child_id);
        child_id = next;
    }
    if (g_focus_id == id) { g_focus_id = 0; }
    if (g_active_window == id) { g_active_window = 0; }
    // Drop it from the timer list.
    i32 i = 0;
    while (i < g_timer_count) {
        if (g_timer_ids[i] == id) {
            g_timer_ids[i] = g_timer_ids[g_timer_count - 1];
            g_timer_count = g_timer_count - 1;
        } else {
            i++;
        }
    }
    if (owns_buffer(n) != 0 || (n->state & NodeState::TEXT_OWNED) != 0) {
        if (n->text != 0) { heap.free((i32)n->text); }
    }
    if (g_menu_id == id) { g_menu_id = 0; }
    if (n->owner != 0) {
        i32 oslot = owner_slot(n->owner, 0);
        if (oslot >= 0) {
            g_owner_nodes_count[oslot] = g_owner_nodes_count[oslot] - 1;
            if (g_owner_nodes_count[oslot] <= 0) { g_owner_nodes_owner[oslot] = 0; }
        }
    }
    g_node_table[id] = (Node*)0;
    g_free_ids[g_free_count] = id;
    g_free_count = g_free_count + 1;
    heap.free((i32)n);
}

/**
 * Removes a node and its entire subtree from DOM, damaging old area and freeing memory.
 * @param id DOM Node ID.
 */
export void remove_node(i32 id) {
    Node *n = node_ptr(id);
    if (n == 0) { return; }
    damage_node(id);
    unlink(n);
    free_subtree(id);
    touch();
}

/**
 * Returns the node ID of the root desktop node.
 * @return Desktop DOM Node ID.
 */
export i32 desktop_id() {
    return g_desktop_node_id;
}

/**
 * Returns the node ID of the system taskbar node.
 * @return Taskbar DOM Node ID, or 0 if not created.
 */
export i32 taskbar_id() {
    return g_taskbar_id;
}

/**
 * Returns the node ID of the first child of a node.
 * @param id DOM Node ID.
 * @return First child DOM Node ID, or 0 if none.
 */
export i32 first_child(i32 id) {
    Node *n = node_ptr(id);
    if (n == 0) { return 0; }
    return n->first_child;
}

/**
 * Returns the node ID of the next sibling of a node.
 * @param id DOM Node ID.
 * @return Next sibling DOM Node ID, or 0 if none.
 */
export i32 next_sibling(i32 id) {
    Node *n = node_ptr(id);
    if (n == 0) { return 0; }
    return n->next_sibling;
}

/**
 * Returns the enclosing WINDOW node ID for a given node.
 * @param id DOM Node ID.
 * @return Window DOM Node ID, or 0 if not inside a window.
 */
export i32 window_of(i32 id) {
    i32 cur = id;
    while (cur != 0) {
        Node *n = node_ptr(cur);
        if (n == 0) { return 0; }
        if (n->kind == NodeKind::WINDOW) { return cur; }
        cur = n->parent;
    }
    return 0;
}


