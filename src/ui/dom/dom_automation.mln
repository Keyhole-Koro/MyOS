import dom_elements from "dom_elements.mln";
import { Option } from "@std/core/option.mln";
package dom_automation;

import dom from "dom.mln";
import { NodeRow } from "dom_model.mln";
import { Blob } from "@std/memory/blob.mln";
import dom_hit_test from "dom_hit_test.mln";
import automation_transport from "@os/meta/automation_transport.mln";
import debug from "@kernel/debug/debug.mln";
import str from "@std/text/str.mln";
import { Result } from "@std/core/result.mln";
import { Text } from "@std/text/text.mln";
import { NodeId, UiError } from "@contracts/ui/widget.contract.mln";
import { NodeRole, NodeState, Children } from "dom.mln";

// Human-readable tree dump (the kernel debug shell's `dump` command) and the
// machine-readable JSON snapshot for the MYOS-004 UI automation bridge.
// Split out of dom.mln: neither reads nor mutates tree state, they only walk
// it through dom's exported accessors -- kept dom.mln itself readable as it
// grew past 3000 lines.

// --- human-readable dump -----------------------------------------------------------------

/**
 * Prints indentation spaces for debug tree dumps.
 * @param depth Indentation level to print.
 */
void print_indent(i32 depth) {
    i32 i = 0;
    while (i < depth) {
        debug.print_str("  ");
        i++;
    }
}

/**
 * Prints formatted UI properties for a DOM node to the debug console.
 *
 * Structural nodes with role 0, no bounds, and zero state print nothing.
 * @param id DOM node ID.
 */
void dump_props(NodeId id) {
    borrow NodeRow n = case dom.find_row(id) of { Some(row) -> row; None -> ({ return; }); };
    i32 state = n.state;
    if (n.role == 0) {
        if (n.w == 0) {
            if (n.h == 0) {
                if (!state) { return; }
            }
        }
    }
    debug.print_str(" [role=");
    debug.print_i32(n.role);
    debug.print_str(" x=");
    debug.print_i32(n.x);
    debug.print_str(" y=");
    debug.print_i32(n.y);
    debug.print_str(" w=");
    debug.print_i32(n.w);
    debug.print_str(" h=");
    debug.print_i32(n.h);
    if (state & NodeState::VISIBLE) { debug.print_str(" vis"); }
    if (state & NodeState::ENABLED) { debug.print_str(" en"); }
    if (state & NodeState::HOVERED) { debug.print_str(" ho"); }
    if (state & NodeState::PRESSED) { debug.print_str(" pr"); }
    if (state & NodeState::FOCUSED) { debug.print_str(" fo"); }
    if (state & NodeState::HIT_TESTABLE) { debug.print_str(" ht"); }
    if (state & NodeState::CHECKED) { debug.print_str(" ck"); }
    debug.print_str("]");
}

/**
 * Recursively prints a DOM node and its descendants to the debug console.
 * @param id DOM node ID to dump.
 * @param depth Current indentation depth in the tree.
 */
void dump_node(NodeId id, i32 depth) {
    print_indent(depth);
    debug.print_str("Node(id=");
    debug.print_i32((i32)id);
    debug.print_str(") ");
    case dom.kind_of(id) of {
        Some(v) -> ({ debug.print_str("kind="); debug.print_i32(v); debug.print_str(" "); });
        None -> debug.print_str("kind=? ");
    };
    str name = dom.name_of(id);
    if (!name.is_empty()) {
        debug.print_str(name);
    } else {
        debug.print_str("?");
    }
    dump_props(id);
    debug.println_str("");

    for (NodeId child_id in dom.children(id)) {
        dump_node(child_id, depth + 1);
    }
}

/**
 * Dumps the entire kernel DOM node tree to the debug console.
 */
export void dump() {
    debug.println_str("--- Kernel Object Tree ---");
    dump_node(dom.root_node_id(), 0);
    debug.println_str("--------------------------");
}

// --- automation bridge snapshot -----------------------------------------------------------
// This never touches serial. The host reads the dedicated automation MMIO TX
// FIFO, so a shell prompt or another task's log line cannot corrupt a response.

bool g_automation_first = true;

/**
 * Transmits a raw string to the automation MMIO transport.
 * @param s Text to send.
 */
void automation_raw(str s) { automation_transport.put_view(s); }

/**
 * Transmits an integer as ASCII digits over the automation transport.
 * @param value Integer value to transmit.
 */
void automation_i32(i32 value) {
    Text<12> decimal = value.to_string();
    i32 i = 0;
    while (i < decimal.len()) {
        automation_transport.putc(decimal.data[i]);
        i++;
    }
}

// A node on the automation wire: its word, or zero for none.
void automation_node_id(Option<NodeId> id) {
    automation_i32(case id of { Some(value) -> (i32)value; None -> 0; });
}

/**
 * Transmits an escaped JSON string over the automation transport.
 * @param s String content to escape and write within quotes.
 */
void automation_json_string(str s) { automation_transport.put_json_string(s); }

/**
 * Transmits a boolean as "true" or "false" over the automation transport.
 * @param value Boolean flag.
 */
void automation_bool(bool value) {
    if (value) { automation_raw("true"); }
    else { automation_raw("false"); }
}

/**
 * Recursively transmits a DOM node and its descendants as JSON objects.
 * @param id DOM node ID to serialize.
 */
void automation_node(NodeId id) {
    borrow NodeRow n = case dom.find_row(id) of { Some(row) -> row; None -> ({ return; }); };
    i32 state = n.state;
    if (!g_automation_first) { automation_transport.putc(','); }
    g_automation_first = false;

    automation_raw("{\"id\":"); automation_i32((i32)id);
    automation_raw(",\"parent\":"); automation_node_id(dom.parent_id(id));
    automation_raw(",\"role\":"); automation_json_string(dom_elements.role_name(n.role));
    automation_raw(",\"name\":"); automation_json_string(n.name.as_str());
    automation_raw(",\"text\":"); automation_json_string(n.text.as_str());
    automation_raw(",\"testId\":"); automation_json_string(n.test_id.as_str());
    automation_raw(",\"value\":"); automation_json_string(dom.automation_value_of(&n));
    automation_raw(",\"bounds\":{\"x\":"); automation_i32(n.x);
    automation_raw(",\"y\":"); automation_i32(n.y);
    automation_raw(",\"width\":"); automation_i32(n.w);
    automation_raw(",\"height\":"); automation_i32(n.h);
    automation_raw("},\"visible\":"); automation_bool((state & NodeState::VISIBLE) != 0);
    automation_raw(",\"enabled\":"); automation_bool((state & NodeState::ENABLED) != 0);
    automation_raw(",\"focused\":"); automation_bool((state & NodeState::FOCUSED) != 0);
    automation_raw(",\"checked\":"); automation_bool((state & NodeState::CHECKED) != 0);
    automation_raw(",\"hitTestable\":"); automation_bool((state & NodeState::HIT_TESTABLE) != 0);
    automation_transport.putc('}');

    for (NodeId child in dom.children(id)) {
        automation_node(child);
    }
}

/**
 * Serializes and transmits the complete DOM tree snapshot as JSON.
 */
export void write_automation_snapshot() {
    g_automation_first = true;
    automation_raw("{\"revision\":"); automation_i32(dom.revision());
    automation_raw(",\"starting\":"); automation_i32(dom.apps_starting());
    automation_raw(",\"nodes\":[");
    automation_node(dom.root_node_id());
    automation_raw("]}");
}

/**
 * Performs a hit-test at the given coordinates and transmits the hit node ID as JSON.
 * @param x Horizontal screen coordinate in logical pixels.
 * @param y Vertical screen coordinate in logical pixels.
 */
export void write_automation_hit_test(i32 x, i32 y) {
    automation_raw("{\"id\":");
    automation_node_id(dom_hit_test.find_at(x, y));
    automation_raw("}");
}
