package ui_server;

import str from "../../../../toolchain/MyStdLib/str.mln";
import { Option } from "../../../../toolchain/MyStdLib/option.mln";
import dom from "dom/dom.mln";
import dom_widgets from "dom/dom_widgets.mln";
import graphics from "graphics.mln";
import irq from "../../../MyKernel/src/arch/irq.mln";
import app from "../shell/app.mln";
import elements_server from "elements_server.mln";
import { UiMsg, UiOp } from "../../../MyAppFramework/src/protocol/ui.mln";

// The UI server's end of the request side of the UI protocol
// (system/MyAppFramework/src/protocol/ui.mln; table in
// docs/design/ui-protocol.md). handle() takes one UiMsg from an app, runs
// it against the DOM as that app's instance -- nodes it creates are owned
// by m->owner -- and returns the i32 result. The functions below are the
// bodies of the app-facing `ui` API (MyAppFramework/src/ui.mln), one per
// op; element creation is elements_server.mln. Apps never import this
// file: they send messages.

// Run one request. The owner is set around it so anything the request
// creates (a dialog from SHOW, a node from CREATE_*) belongs to the app.
export i32 handle(UiMsg *m) {
    i32 outer = dom.current_owner();
    dom.set_current_owner(m->owner);
    i32 r = run_request(m);
    dom.set_current_owner(outer);
    return r;
}

i32 run_request(UiMsg *m) {
    i32 op = m->op;
    i32 id = m->a0;
    if (op == UiOp::SET_TEXT)       { set_text(id, m->s0); return 0; }
    if (op == UiOp::TEXT_COPY)      { return text_copy(id, (char*)m->a1, m->a2); }
    if (op == UiOp::IS_CHECKED)     { if (is_checked(id)) { return 1; } return 0; }
    if (op == UiOp::SET_CHECKED)    { set_checked(id, m->a1); return 0; }
    if (op == UiOp::INPUT_SET)      { input_set(id, m->s0); return 0; }
    if (op == UiOp::AREA_APPEND)    { area_append(id, m->s0); return 0; }
    if (op == UiOp::AREA_CLEAR)     { area_clear(id); return 0; }
    if (op == UiOp::AREA_LINES)     { return area_lines(id); }
    if (op == UiOp::LIST_SET_ITEMS) { list_set_items(id, m->s0); return 0; }
    if (op == UiOp::LIST_COUNT)     { return list_count(id); }
    if (op == UiOp::LIST_SELECTED)  { return list_selected(id); }
    if (op == UiOp::LIST_ITEM)      { return list_item(id, m->a1, (char*)m->a2, m->a3); }
    if (op == UiOp::FOCUS)          { focus(id); return 0; }
    if (op == UiOp::FOCUS_WINDOW)   { focus_window(id); return 0; }
    if (op == UiOp::CLOSE)          { close(id); return 0; }
    if (op == UiOp::WINDOW_OF)      { return window_of(id); }
    if (op == UiOp::WINDOW_X)       { return window_x(id); }
    if (op == UiOp::WINDOW_Y)       { return window_y(id); }
    if (op == UiOp::SHOW)           { show(id); return 0; }
    if (op == UiOp::TEST_ID)        { test_id(id, m->s0); return 0; }
    if (op == UiOp::SEND_KEY)       { send_key(m->a0, m->a1, m->a2); return 0; }
    if (op == UiOp::RGB)            { return rgb(m->a0, m->a1, m->a2); }
    if (op == UiOp::OPEN)           { return app.open(m->s0); }
    if (op == UiOp::CLAIM_KEY)      { return app.claim_key(m->owner, m->s0); }
    if (op == UiOp::MAIN_WINDOW)    { app.window_ready(m->owner, m->a0); return 0; }
    if (op == UiOp::EXIT)           { app.instance_exited(m->owner); return 0; }
    if (op >= UiOp::CREATE_WINDOW) {
        if (op <= UiOp::APPEND_CHILD) { return elements_server.create(m); }
    }
    return 0;
}

// --- text -------------------------------------------------------------------------------------

void set_text(i32 id, char *s) { dom.set_text_copy(id, s); }
// The node's text into the app's buffer (cap bytes incl. NUL); its length.
i32 text_copy(i32 id, char *out, i32 cap) {
    char *t = dom.text_of(id);
    if (t == 0) { out[0] = (char)0; return 0; }
    return str.ncopy(out, t, cap);
}

// --- widgets --------------------------------------------------------------------------------

bool is_checked(i32 id) { return dom.is_checked(id); }
void set_checked(i32 id, i32 on) { dom.set_checked(id, on); }

void input_set(i32 id, char *s) { dom_widgets.set_input_text(id, s); }
// A user process writes to a terminal's TextArea from its stdout syscall,
// which runs with interrupts off; this append runs on the UI server's task
// with them on. Keep a timer tick from switching to the process mid-append
// and letting the two interleave in the shared buffer.
void area_append(i32 id, char *s) {
    i32 was = irq.save_disable();
    dom_widgets.append_text(id, s);
    irq.restore(was);
}
void area_clear(i32 id) { dom_widgets.clear_text_area(id); }
i32 area_lines(i32 id) { return dom_widgets.text_area_line_count(id); }

void list_set_items(i32 id, char *items) { dom_widgets.list_set_items(id, items); }
i32 list_count(i32 id) { return dom_widgets.list_count(id); }

// Selected row, or -1.
i32 list_selected(i32 id) {
    i32 row = case dom_widgets.list_selected(id) of {
        Some(v) -> v;
        None -> -1;
    };
    return row;
}

// Copy row `index`'s text into `out` (at most `cap` bytes incl. NUL);
// returns its length, or -1 for no such row.
i32 list_item(i32 id, i32 index, char *out, i32 cap) {
    i32 len = case dom_widgets.list_item(id, index, out, cap) of {
        Some(v) -> v;
        None -> -1;
    };
    return len;
}

// --- focus and windows ------------------------------------------------------------------------

void focus(i32 id) { dom_widgets.set_focus(id); }
void focus_window(i32 win) { dom_widgets.focus_window(win); }

// Close a window the app opened itself (a dialog). The app's own main
// window is closed by the framework when the user closes it.
void close(i32 win) {
    dom.remove_node(win);
    dom_widgets.activate_topmost();
}

i32 window_of(i32 id) { return dom.window_of(id); }
i32 window_x(i32 win) { return dom.node_x(win) / dom.ui_scale(); }
i32 window_y(i32 win) { return dom.node_y(win) / dom.ui_scale(); }

// Mount a tree the app built (a dialog) on the desktop and focus it.
void show(i32 win) {
    dom.append_child(dom.desktop_id(), win);
    dom_widgets.focus_window(win);
}

// Name a node for automation (dom-tester locators).
void test_id(i32 id, char *name) { dom.set_test_id(id, name); }

// --- keys ---------------------------------------------------------------------------------------

// Simulate a key on the focused node; `type` 1 = down, 3 = char.
void send_key(i32 type, i32 code, i32 mods) { dom_widgets.dispatch_key_event(type, code, mods); }

// --- colours -----------------------------------------------------------------------------------

i32 rgb(i32 r, i32 g, i32 b) { return graphics.rgb(r, g, b); }

