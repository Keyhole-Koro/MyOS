/**
 * The UI server's request-side handler of the UI protocol.
 *
 * Executes application UI requests against the desktop DOM.
 * Automatically sets the DOM current owner to the requesting process so that
 * any newly created nodes, windows, or dialogs belong to that application.
 */
package ui_protocol;

import str from "@std/text/str.mln";
import { Option } from "@std/core/option.mln";
import { Pid } from "@contracts/process/control.contract.mln";
import { Result } from "@std/core/result.mln";
import { NodeId, UiError } from "@contracts/ui/widget.contract.mln";
import dom from "dom/dom.mln";
import dom_widgets from "dom/dom_widgets.mln";
import irq from "@kernel/arch/irq.mln";
import protocol_elements from "protocol_elements.mln";
import { NodeRow } from "dom/dom_model.mln";
import { Blob } from "@std/memory/blob.mln";
import { NodeKind, NodeState } from "dom/dom.mln";
import { Request, RequestStatus } from "@contracts/myapp/message.contract.mln";
import { UiOp } from "@contracts/myapp/ui.contract.mln";

bool writes_typed_result(i32 op) {
    if (op == UiOp::TEXT_COPY || op == UiOp::IS_CHECKED) { return true; }
    if (op == UiOp::AREA_LINES || op == UiOp::LIST_COUNT) { return true; }
    if (op == UiOp::LIST_SELECTED || op == UiOp::LIST_ITEM) { return true; }
    if (op == UiOp::WINDOW_OF || op == UiOp::WINDOW_X || op == UiOp::WINDOW_Y) { return true; }
    return op >= UiOp::CREATE_WINDOW && op <= UiOp::APPEND_CHILD;
}

// The operations return their results; this is where one leaves for the
// result the gateway staged, since the request crosses as words.
RequestStatus answer<T>(Request *m, T value) {
    T *out = (T*)m->result_out;
    *out = value;
    return RequestStatus::OK;
}

// Copies a view into a staged NUL-terminated buffer; a longer view is cut.
// The buffer is the wire's: the view is what the operations return.
Result<i32, UiError> staged(Result<str, UiError> view, char *out, i32 cap) {
    str text = view?;
    if (cap <= 0) { return Err(UiError::InvalidCapacity(cap)); }
    i32 n = text.length;
    if (n > cap - 1) { n = cap - 1; }
    i32 i = 0;
    while (i < n) { out[i] = text.data[i]; i++; }
    out[n] = (char)0;
    return Ok(n);
}

/**
 * Executes a single UI protocol request within the caller's owner scope.
 *
 * Temporarily switches the active DOM owner to `m->owner` during execution,
 * ensuring proper resource ownership for windows and child elements.
 *
 * @param m Pointer to Request structure.
 * @return Request dispatch status. Typed operation results use Request.result_out.
 */
export RequestStatus handle(Request *m) {
    Option<Pid> outer = dom.current_owner();
    dom.set_current_owner(Some(Pid(m->owner)));
    defer dom.set_current_owner(outer);
    return run_request(m);
}

/**
 * Dispatches an unpacked UI request to the corresponding internal handler.
 *
 * @param m Pointer to Request structure.
 * @return Request dispatch status.
 */
RequestStatus run_request(Request *m) {
    i32 op = m->op;
    NodeId id = NodeId(m->a0);   // what a0 means to the operations that take a node
    if (writes_typed_result(op) && m->result_out == 0) {
        return RequestStatus::MISSING_RESULT;
    }
    if (op == UiOp::SET_TEXT)       { set_text(id, m->s0); return RequestStatus::OK; }
    if (op == UiOp::TEXT_COPY) {
        return answer<Result<i32, UiError>>(m, staged(text_of(id), (char*)m->a1, m->a2));
    }
    if (op == UiOp::IS_CHECKED)     { return answer<Result<bool, UiError>>(m, is_checked(id)); }
    if (op == UiOp::SET_CHECKED)    { set_checked(id, m->a1); return RequestStatus::OK; }
    if (op == UiOp::INPUT_SET)      { input_set(id, m->s0); return RequestStatus::OK; }
    if (op == UiOp::AREA_APPEND)    { area_append(id, m->s0); return RequestStatus::OK; }
    if (op == UiOp::AREA_CLEAR)     { area_clear(id); return RequestStatus::OK; }
    if (op == UiOp::AREA_LINES)     { return answer<Result<i32, UiError>>(m, area_lines(id)); }
    if (op == UiOp::LIST_SET_ITEMS) { list_set_items(id, m->s0); return RequestStatus::OK; }
    if (op == UiOp::LIST_SELECT)    { dom_widgets.list_select(id, m->a1); return RequestStatus::OK; }
    if (op == UiOp::LIST_COUNT)     { return answer<Result<i32, UiError>>(m, list_count(id)); }
    if (op == UiOp::LIST_SELECTED) {
        return answer<Result<Option<i32>, UiError>>(m, dom_widgets.list_selected(id));
    }
    if (op == UiOp::LIST_ITEM) {
        return answer<Result<i32, UiError>>(
            m, staged(dom_widgets.list_item(id, m->a1), (char*)m->a2, m->a3));
    }
    if (op == UiOp::FOCUS)          { focus(id); return RequestStatus::OK; }
    if (op == UiOp::FOCUS_WINDOW)   { focus_window(id); return RequestStatus::OK; }
    if (op == UiOp::CLOSE)          { close(id); return RequestStatus::OK; }
    if (op == UiOp::WINDOW_OF)      { return answer<Result<Option<NodeId>, UiError>>(m, window_of(id)); }
    if (op == UiOp::WINDOW_X)       { return answer<Result<i32, UiError>>(m, window_x(id)); }
    if (op == UiOp::WINDOW_Y)       { return answer<Result<i32, UiError>>(m, window_y(id)); }
    if (op == UiOp::SHOW)           { show(id); return RequestStatus::OK; }
    if (op == UiOp::TEST_ID)        { test_id(id, m->s0); return RequestStatus::OK; }
    if (op == UiOp::SEND_KEY)       { send_key(m->a0, m->a1, m->a2); return RequestStatus::OK; }
    if (op >= UiOp::CREATE_WINDOW && op <= UiOp::APPEND_CHILD) {
        return answer<Result<NodeId, UiError>>(m, protocol_elements.create(m));
    }
    return RequestStatus::INVALID_OPERATION;
}

// --- text -------------------------------------------------------------------------------------

/**
 * Sets the displayed text of a node.
 *
 * @param id UI node ID.
 * @param s Text string to set.
 */
void set_text(NodeId id, char *s) { dom.set_text(id, str.from_c(s)); }

/**
 * Reads a node's text.
 *
 * @param id UI node ID.
 * @return Ok(a view of the text), or Err for an invalid node.
 */
Result<str, UiError> text_of(NodeId id) {
    borrow NodeRow n = dom.require_row(id)?;
    return Ok(n.text.as_str());
}

// --- widgets --------------------------------------------------------------------------------

/**
 * Checks whether a checkbox node is checked.
 *
 * @param id UI node ID.
 * @return Ok(true/false) for a Checkbox, or Err for an invalid ID or wrong node kind.
 */
Result<bool, UiError> is_checked(NodeId id) {
    borrow NodeRow n = dom.require_row(id)?;
    if (n.kind != NodeKind::CHECKBOX) { return Err(UiError::WrongNodeKind(id)); }
    return Ok((n.state & NodeState::CHECKED) != 0);
}

/**
 * Sets the checked state of a checkbox node.
 *
 * @param id UI node ID.
 * @param on 1 to check, 0 to uncheck.
 */
void set_checked(NodeId id, i32 on) { dom.set_checked(id, on); }

/**
 * Sets the value of a text input or a text area.
 *
 * @param id UI node ID.
 * @param s Input text.
 */
void input_set(NodeId id, char *s) { dom_widgets.set_input_text(id, str.from_c(s)); }

/**
 * Appends text to a multi-line text area with IRQ protection.
 *
 * Temporarily disables interrupts to prevent race conditions with user-process
 * stdout syscall writes into the same text area buffer.
 *
 * @param id UI node ID.
 * @param s Text to append.
 */
void area_append(NodeId id, char *s) {
    i32 was = irq.save_disable();
    defer irq.restore(was);
    dom_widgets.append_text(id, str.from_c(s));
}

/**
 * Clears all content from a multi-line text area.
 *
 * @param id UI node ID.
 */
void area_clear(NodeId id) { dom_widgets.clear_text_area(id); }

/**
 * Returns the line count of a multi-line text area.
 *
 * @param id UI node ID.
 * @return Ok(line count), or Err for an invalid ID or wrong node kind.
 */
Result<i32, UiError> area_lines(NodeId id) { return dom_widgets.text_area_line_count(id); }

/**
 * Replaces the item list of a list widget with newline-separated strings.
 *
 * @param id UI node ID.
 * @param items Newline-separated item string.
 */
void list_set_items(NodeId id, char *items) { dom_widgets.list_set_items(id, str.from_c(items)); }

/**
 * Returns the number of items in a list widget.
 *
 * @param id UI node ID.
 * @return Ok(item count), or Err for an invalid ID or wrong node kind.
 */
Result<i32, UiError> list_count(NodeId id) { return dom_widgets.list_count(id); }

// --- focus and windows ------------------------------------------------------------------------

/**
 * Sets input focus to a specific control node.
 *
 * @param id UI node ID.
 */
void focus(NodeId id) { dom_widgets.set_focus(id); }

/**
 * Sets focus to an entire window and activates it.
 *
 * @param win Window node ID.
 */
void focus_window(NodeId win) { dom_widgets.focus_window(win); }

/**
 * Closes an application-opened window or dialog.
 *
 * Removes the node from the DOM and activates the topmost remaining window.
 *
 * @param win Window node ID.
 */
void close(NodeId win) {
    dom.remove_node(win);
    dom_widgets.activate_topmost();
}

/**
 * Resolves the enclosing window node ID for a given descendant control node.
 *
 * @param id UI node ID.
 * @return Ok(Some(window)), Ok(None) outside any window, or Err for an invalid ID.
 */
Result<Option<NodeId>, UiError> window_of(NodeId id) {
    return dom.window_of(id);
}

// The row of a node that must be a window.
Result<borrow NodeRow, UiError> window_row(NodeId win) {
    borrow NodeRow n = dom.require_row(win)?;
    if (n.kind != NodeKind::WINDOW) { return Err(UiError::WrongNodeKind(win)); }
    return Ok(n);
}

/**
 * Returns the X position of a window in logical coordinates.
 *
 * @param win Window node ID.
 * @return X coordinate adjusted for UI scaling.
 */
Result<i32, UiError> window_x(NodeId win) {
    borrow NodeRow n = window_row(win)?;
    return Ok(n.x / dom.ui_scale());
}

/**
 * Returns the Y position of a window in logical coordinates.
 *
 * @param win Window node ID.
 * @return Y coordinate adjusted for UI scaling.
 */
Result<i32, UiError> window_y(NodeId win) {
    borrow NodeRow n = window_row(win)?;
    return Ok(n.y / dom.ui_scale());
}

/**
 * Mounts a window tree onto the desktop and focuses it.
 *
 * @param win Window node ID.
 */
void show(NodeId win) {
    case dom.append_child(dom.desktop_id(), win) of { Ok(_) -> _; Err(_) -> ({ return; }); };
    dom_widgets.focus_window(win);
}

/**
 * Assigns an automation test identifier to a node.
 *
 * @param id UI node ID.
 * @param name Test identifier name.
 */
void test_id(NodeId id, char *name) { dom.set_test_id(id, str.from_c(name)); }

// --- keys ---------------------------------------------------------------------------------------

/**
 * Dispatches a simulated key event to the focused widget.
 *
 * @param type Event type (1 = key down, 3 = character input).
 * @param code Key code or character code.
 * @param mods Active modifier keys (shift, ctrl, alt).
 */
void send_key(i32 type, i32 code, i32 mods) { dom_widgets.dispatch_key_event(type, code, mods); }
