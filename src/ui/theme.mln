package theme;

// Desktop theme constants. Colors use the same 0xAARRGGBB representation as
// graphics.rgba; RGB colors leave the alpha byte at zero. Metrics are logical
// pixels in the 1024x768 design space and callers apply the current UI scale.

// Desktop
export const i32 DESKTOP_TOP = 0x2B3A5C;
export const i32 DESKTOP_BOTTOM = 0x0E1424;

// Accent
export const i32 ACCENT = 0x3B82F6;
export const i32 ACCENT_HOVER = 0x609AF8;
export const i32 ACCENT_PRESSED = 0x2563EB;
export const i32 ON_ACCENT = 0xFFFFFF;

// Text
export const i32 TEXT_PRIMARY = 0x1F2328;
export const i32 TEXT_SECONDARY = 0x6B7280;
export const i32 TEXT_DISABLED = 0xA0A6B0;
export const i32 TEXT_ON_DARK = 0xF3F4F6;
export const i32 TEXT_ON_DARK_DIM = 0xA8B0BE;

// Window
export const i32 WINDOW_BG = 0xF6F7F9;
export const i32 WINDOW_BORDER = 0x46000000;
export const i32 WINDOW_BORDER_INACTIVE = 0x2D000000;
export const i32 TITLEBAR_TOP = 0xECEEF2;
export const i32 TITLEBAR_BOTTOM = 0xDFE2E8;
export const i32 TITLEBAR_INACTIVE = 0xF0F1F4;
export const i32 TITLEBAR_DIVIDER = 0x23000000;
export const i32 CLOSE_BUTTON = 0xFF5F57;
export const i32 CLOSE_BUTTON_RING = 0x2D000000;
export const i32 CLOSE_BUTTON_INACTIVE = 0xC8CBD1;
export const i32 CLOSE_BUTTON_HOVER = 0xE0443E;
export const i32 MINIMIZE_BUTTON = 0xFEBC2E;
export const i32 MAXIMIZE_BUTTON = 0x28C840;
export const i32 CLOSE_GLYPH = 0x4A0000;

export const i32 TITLEBAR_H = 32;
export const i32 WINDOW_RADIUS = 8;
export const i32 SHADOW_SIZE = 12;
export const i32 SHADOW_OFFSET = 5;
export const i32 SHADOW_ALPHA = 90;
export const i32 SHADOW_ALPHA_INACTIVE = 50;

// Controls
export const i32 BUTTON_FACE = 0xFFFFFF;
export const i32 BUTTON_FACE_HOVER = 0xF1F3F7;
export const i32 BUTTON_FACE_PRESSED = 0xE2E6EC;
export const i32 BUTTON_BORDER = 0x37000000;
export const i32 BUTTON_RADIUS = 6;

export const i32 PANEL_BG = 0xFFFFFF;
export const i32 PANEL_BORDER = 0x1E000000;
export const i32 SEPARATOR = 0x1E000000;

export const i32 INPUT_BG = 0xFFFFFF;
export const i32 INPUT_BORDER = 0x3C000000;
export const i32 INPUT_BORDER_FOCUS = 0x3B82F6;
export const i32 INPUT_PLACEHOLDER = 0xA0A6B0;
export const i32 CARET = 0x3B82F6;
export const i32 INPUT_RADIUS = 6;
export const i32 INPUT_PADDING_X = 8;

export const i32 CHECKBOX_SIZE = 18;
export const i32 CHECKBOX_RADIUS = 4;
export const i32 CHECKBOX_BORDER = 0x50000000;
export const i32 CHECKBOX_BG = 0xFFFFFF;

// Taskbar
export const i32 TASKBAR_H = 40;
export const i32 TASKBAR_BG = 0xE110141E;
export const i32 TASKBAR_EDGE = 0x1CFFFFFF;
export const i32 TASKBAR_ENTRY = 0x16FFFFFF;
export const i32 TASKBAR_ENTRY_ACTIVE = 0x32FFFFFF;
export const i32 TASKBAR_ENTRY_W = 168;
export const i32 TASKBAR_ENTRY_RADIUS = 6;
export const i32 TASKBAR_LAUNCHER_W = 88;
