package compositor;

import dom from "dom/dom.mln";
import graphics from "graphics.mln";
import mouse from "../../../MyKernel/src/io/mouse.mln";
import keyboard from "../../../MyKernel/src/io/keyboard.mln";
import scheduler from "../../../MyKernel/src/kernel/scheduler.mln";
import irq from "../../../MyKernel/src/arch/irq.mln";

// Presents the DOM scene and turns mouse and keyboard events into DOM
// interactions: hover, press/click, window focus and z-order, title-bar
// dragging, the close button, the taskbar, keyboard focus and timers.
//
// The compositor knows no node ids of its own. Every interaction starts from
// dom.find_at(x, y), so whatever tree the running apps built is what gets
// hovered, pressed and clicked; a node participates simply by being hit-
// testable, and it reacts to a click by having an on_click handler.

// Repaint whatever changed and flip the frame. render_scene repaints only the
// damaged region, which the dom setters record as nodes change; the pointer is
// not drawn here at all, since the display controller composites it at
// scan-out (graphics.set_cursor).
void present_frame() {
    dom.render_scene();
    graphics.present();
}

// Paint the whole desktop once, unconditionally. Call this before interrupts
// are enabled (see main.mln's kernel_init): scheduler.init() documents that
// the first timer interrupt can preempt task 0 anywhere, and render_all()
// recursively walks every node doing DMA2D fills and glyph draws, so a tick
// landing mid-walk left the desktop showing only whatever had been drawn so
// far until enough scheduler slices later let it finish. Doing this paint
// before scheduler.init()/irq.enable() makes it atomic: nothing can preempt it.
export void paint_first_frame() {
    graphics.show_cursor(1);
    dom.render_all();
    graphics.present();
}

// Drag state: the window being moved by its title bar (or resized by its
// grip), and where the pointer was at the last event so each motion event
// applies only its own delta.
i32 g_drag_win = 0;
i32 g_resize_win = 0;
i32 g_drag_last_x = 0;
i32 g_drag_last_y = 0;

// Press state: the node under the pointer when the left button went down.
// A click fires on release only if the pointer is still over that node, so
// dragging off a button cancels it.
i32 g_pressed_id = 0;
i32 g_hot_id = 0;

// Desktop context menu (right-click on the wallpaper), registered by main.
char *g_desktop_menu_items = (char*)0;
i32 g_desktop_menu_handler = 0;

export void set_desktop_menu(char *items, i32 handler) {
    g_desktop_menu_items = items;
    g_desktop_menu_handler = handler;
}

// Window context menu: the same three actions as the title-bar buttons.
void on_window_menu(i32 index) {
    i32 win = dom.menu_target();
    if (win == 0) { return; }
    if (index == 0) { dom.minimize_window(win); }
    if (index == 1) { dom.maximize_window(win); }
    if (index == 2) { g_hot_id = 0; dom.close_window(win); }
}

// Node kinds the compositor treats specially. dom's NODE_* are u16 exports,
// which cannot be passed around as values from another package.
i32 KIND_TEXT_INPUT = 15;
i32 KIND_TEXT_AREA = 20;
i32 KIND_LIST = 21;

void on_press(i32 ex, i32 ey) {
    // A click while a menu is open either picks an item or dismisses the
    // menu; either way it goes no further.
    if (dom.menu_id() != 0) {
        i32 mhit = dom.find_at(ex, ey);
        if (mhit == dom.menu_id()) {
            dom.menu_click(ex, ey);
        } else {
            dom.close_menu();
        }
        return;
    }

    i32 hit = dom.find_at(ex, ey);
    if (hit == 0) {
        dom.set_focus(0);
        return;
    }

    // Anything inside a window activates that window first.
    i32 win = dom.window_of(hit);
    if (win != 0) {
        dom.focus_window(win);
    }

    if (hit == dom.taskbar_id()) {
        dom.taskbar_click(ex, ey);
        return;
    }

    if (hit == win) {
        // The window itself: title-bar buttons, drag handle, resize grip,
        // or just focus.
        i32 button = dom.titlebar_button_hit(win, ex, ey);
        if (button == 1) {
            g_hot_id = 0;
            dom.close_window(win);
            return;
        }
        if (button == 2) { dom.minimize_window(win); return; }
        if (button == 3) { dom.maximize_window(win); return; }
        if (dom.resize_grip_hit(win, ex, ey) != 0) {
            g_resize_win = win;
            g_drag_last_x = ex;
            g_drag_last_y = ey;
            return;
        }
        if (dom.titlebar_hit(win, ex, ey) != 0) {
            g_drag_win = win;
            g_drag_last_x = ex;
            g_drag_last_y = ey;
        }
        return;
    }

    // A control. Text fields and lists take keyboard focus; lists also
    // select on press. Everything else is a press-and-release click target.
    i32 kind = dom.kind_of(hit);
    if (kind == KIND_TEXT_INPUT) {
        dom.set_focus(hit);
        return;
    }
    if (kind == KIND_TEXT_AREA) {
        dom.set_focus(hit);
        return;
    }
    if (kind == KIND_LIST) {
        dom.set_focus(hit);
        dom.list_click(hit, ex, ey);
        return;
    }
    dom.set_pressed(hit, 1);
    g_pressed_id = hit;
}

void on_right_press(i32 ex, i32 ey) {
    if (dom.menu_id() != 0) {
        dom.close_menu();
        return;
    }
    i32 hit = dom.find_at(ex, ey);
    if (hit == dom.taskbar_id()) { return; }
    i32 win = dom.window_of(hit);
    if (win != 0) {
        dom.focus_window(win);
        if (dom.is_maximized(win) != 0) {
            dom.open_menu(ex, ey, "Minimize\nRestore\nClose", on_window_menu, win);
        } else {
            dom.open_menu(ex, ey, "Minimize\nMaximize\nClose", on_window_menu, win);
        }
        return;
    }
    if (hit == 0) {
        if (g_desktop_menu_items != 0) {
            dom.open_menu(ex, ey, g_desktop_menu_items, g_desktop_menu_handler, 0);
        }
    }
}

void on_release(i32 ex, i32 ey) {
    if (g_drag_win != 0) {
        g_drag_win = 0;
        return;
    }
    if (g_resize_win != 0) {
        g_resize_win = 0;
        return;
    }
    if (g_pressed_id != 0) {
        // Un-press whatever this loop pressed, not whatever happens to be
        // under the pointer now; click only if it is the same node.
        dom.set_pressed(g_pressed_id, 0);
        i32 hit = dom.find_at(ex, ey);
        if (hit == g_pressed_id) {
            dom.dispatch_click(hit); // may change the node's text
        }
        g_pressed_id = 0;
    }
}

void on_motion(i32 ex, i32 ey) {
    i32 dx = ex - g_drag_last_x;
    i32 dy = ey - g_drag_last_y;
    if (g_drag_win != 0) {
        if (dx != 0) { dom.move_node(g_drag_win, dx, dy); }
        else if (dy != 0) { dom.move_node(g_drag_win, dx, dy); }
    }
    if (g_resize_win != 0) {
        i32 w = dom.node_w(g_resize_win) + dx;
        i32 h = dom.node_h(g_resize_win) + dy;
        dom.resize_window(g_resize_win, w, h);
    }
    g_drag_last_x = ex;
    g_drag_last_y = ey;
}

// Interactive loop, event-driven. The mouse and keyboard IRQ handlers drain
// the hardware FIFOs into software queues; each pass consumes every queued
// event and edge-detects the button per event, so a click whose press and
// release both happened since the last pass still dispatches. The live
// registers stay authoritative for the cursor position and hover state, so a
// dropped event can delay a repaint but never wedge a node in a pressed or
// hovered state.
export void run() {
    i32 prev_left = 0;
    i32 prev_right = 0;

    // paint_first_frame() already painted the desktop (called from main.mln
    // before interrupts were enabled, so that paint could not be preempted).

    while (1) {

        // Consume all queued mouse events. Clicks are dispatched at the
        // event's own coordinates: where the press happened, not where the
        // pointer is now.
        while (mouse.has_event() != 0) {
            i32 ex = mouse.event_x();
            i32 ey = mouse.event_y();
            i32 btn = mouse.event_btn();
            i32 wheel = mouse.event_wheel();
            mouse.pop_event();
            i32 eb = btn & 1;
            i32 er = btn & 2;

            if (eb != 0) {
                if (prev_left == 0) {
                    on_press(ex, ey);
                } else {
                    on_motion(ex, ey);
                }
            } else {
                if (prev_left != 0) {
                    on_release(ex, ey);
                }
            }
            prev_left = eb;

            if (er != 0) {
                if (prev_right == 0) { on_right_press(ex, ey); }
            }
            prev_right = er;

            if (wheel != 0) {
                dom.dispatch_wheel(dom.find_at(ex, ey), wheel);
            }
        }

        // Keyboard events go to whichever node holds focus.
        while (keyboard.has_event() != 0) {
            i32 t = keyboard.event_type();
            i32 c = keyboard.event_code();
            i32 m = keyboard.event_mods();
            keyboard.pop_event();
            dom.dispatch_key_event(t, c, m);
        }

        // Live state drives the cursor and hover. Moving the pointer is two
        // register writes and does not dirty the scene; only a change in what
        // is hovered does.
        i32 mx = mouse.x();
        i32 my = mouse.y();
        graphics.set_cursor(mx, my);

        i32 hit = dom.find_at(mx, my);
        if (hit != g_hot_id) {
            if (g_hot_id != 0) { dom.set_hovered(g_hot_id, 0); }
            if (hit != 0) { dom.set_hovered(hit, 1); }
            g_hot_id = hit;
        }
        if (dom.menu_id() != 0) { dom.menu_hover(mx, my); }

        // Timers (clock, animations) run on this task between events.
        dom.tick();

        // The setters above record what changed, so the damage region is the
        // authority on whether a repaint is needed.
        if (dom.has_damage() != 0) {
            present_frame();
        }

        scheduler.sleep(1); // yield the CPU to other tasks between passes
    }
}
