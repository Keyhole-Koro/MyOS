package compositor;

import dom from "dom.mln";
import graphics from "graphics.mln";
import mouse from "../../../MyKernel/src/io/mouse.mln";
import scheduler from "../../../MyKernel/src/kernel/scheduler.mln";

// Presents the DOM scene and turns mouse events into DOM interactions.
//
// The compositor knows no node ids. Every interaction starts from
// dom.find_at(x, y), so whatever tree the running apps built is what gets
// hovered, pressed and clicked; a node participates simply by being hit-
// testable, and it reacts to a click by having an on_click handler.

// Repaint whatever changed and flip the frame. render_scene repaints only the
// damaged region, which the dom setters record as nodes change; the pointer is
// not drawn here at all, since the display controller composites it at
// scan-out (graphics.set_cursor).
void present_frame() {
    dom.render_scene();
    graphics.present();
}

// Interactive loop, event-driven. The mouse IRQ handler drains the hardware
// event FIFO into mouse's software queue; each pass consumes every queued
// event and edge-detects the button per event, so a click whose press and
// release both happened since the last pass still dispatches (nothing shorter
// than a display frame is lost anymore). The live registers stay authoritative
// for the cursor position and hover state, so a dropped event can delay a
// repaint but never wedge a node in a pressed or hovered state.
export void run() {
    i32 prev_left = 0;
    i32 pressed_id = 0; // node currently held down, 0 if none
    i32 hot_id = 0;     // node currently hovered, 0 if none

    graphics.show_cursor(1);

    // The first frame has nothing to compare against, so paint everything once.
    dom.render_all();
    graphics.present();

    while (1) {

        // Consume all queued events. Clicks are dispatched at the event's own
        // coordinates: where the press happened, not where the pointer is now.
        while (mouse.has_event() != 0) {
            i32 ex = mouse.event_x();
            i32 ey = mouse.event_y();
            i32 eb = mouse.event_btn() & 1;
            mouse.pop_event();

            if (eb != 0) {
                if (prev_left == 0) {
                    // Press edge: whatever sits under the pointer takes it.
                    i32 hit = dom.find_at(ex, ey);
                    if (hit != 0) {
                        dom.set_pressed(hit, 1);
                        pressed_id = hit;
                        dom.dispatch_click(hit); // may change the node's text
                    }
                }
            } else {
                // Release: un-press whatever this loop pressed, not whatever
                // happens to be under the pointer now.
                if (pressed_id != 0) {
                    dom.set_pressed(pressed_id, 0);
                    pressed_id = 0;
                }
            }
            prev_left = eb;
        }

        // Live state drives the cursor and hover. Moving the pointer is two
        // register writes and does not dirty the scene; only a change in what
        // is hovered does.
        i32 mx = mouse.x();
        i32 my = mouse.y();
        graphics.set_cursor(mx, my);

        i32 hit = dom.find_at(mx, my);
        if (hit != hot_id) {
            if (hot_id != 0) { dom.set_hovered(hot_id, 0); }
            if (hit != 0) { dom.set_hovered(hit, 1); }
            hot_id = hit;
        }

        // The setters above record what changed, so the damage region is the
        // authority on whether a repaint is needed.
        if (dom.has_damage() != 0) {
            present_frame();
        }

        scheduler.sleep(1); // yield the CPU to other tasks between passes
    }
}
