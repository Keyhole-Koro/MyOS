package graphics;

import font from "font8x8.mln";
import str from "../../../../toolchain/MyStdLib/str.mln";

export i32 VRAM_BASE = 0x30000000;
export i32 DISPLAY_WIDTH = 1024;
export i32 DISPLAY_HEIGHT = 768;

i32 DMA2D_DEST_ADDR = 0x24000020;
i32 DMA2D_COLOR_ADDR = 0x24000024;
i32 DMA2D_WIDTH_ADDR = 0x24000028;
i32 DMA2D_HEIGHT_ADDR = 0x2400002C;
i32 DMA2D_STRIDE_ADDR = 0x24000030;
i32 DMA2D_CMD_ADDR = 0x24000034;
i32 DISPLAY_SWAP_ADDR = 0x24000038;
i32 CURSOR_X_ADDR = 0x24000060;
i32 CURSOR_Y_ADDR = 0x24000064;
i32 CURSOR_CTRL_ADDR = 0x24000068;

// Present the back buffer: copy everything drawn since the last present to the
// visible front buffer in one shot, so partially-drawn frames never appear.
// Call once per frame after drawing the whole scene.
export void present() {
    i32* swap = (i32*)DISPLAY_SWAP_ADDR;
    *swap = 1;
}

// Hardware cursor: the display controller composites the pointer sprite over
// the frame at scan-out. Moving it is two register writes, and it never lands
// in VRAM, so the scene underneath does not have to be redrawn to erase it.
export void set_cursor(i32 x, i32 y) {
    i32* cx = (i32*)CURSOR_X_ADDR;
    i32* cy = (i32*)CURSOR_Y_ADDR;
    *cx = x;
    *cy = y;
}

export void show_cursor(i32 on) {
    i32* ctrl = (i32*)CURSOR_CTRL_ADDR;
    *ctrl = on;
}

// Clip rectangle. All drawing is confined to it, so a partial repaint can draw
// whole nodes and have the parts outside the damaged region dropped. Defaults
// to the whole display; clear_clip() restores that.
i32 g_clip_x0 = 0;
i32 g_clip_y0 = 0;
i32 g_clip_x1 = 1024;
i32 g_clip_y1 = 768;

export void set_clip(i32 x, i32 y, i32 w, i32 h) {
    i32 x0 = x;
    i32 y0 = y;
    i32 x1 = x + w;
    i32 y1 = y + h;
    if (x0 < 0) { x0 = 0; }
    if (y0 < 0) { y0 = 0; }
    if (x1 > DISPLAY_WIDTH) { x1 = DISPLAY_WIDTH; }
    if (y1 > DISPLAY_HEIGHT) { y1 = DISPLAY_HEIGHT; }
    g_clip_x0 = x0;
    g_clip_y0 = y0;
    g_clip_x1 = x1;
    g_clip_y1 = y1;
}

export void clear_clip() {
    g_clip_x0 = 0;
    g_clip_y0 = 0;
    g_clip_x1 = DISPLAY_WIDTH;
    g_clip_y1 = DISPLAY_HEIGHT;
}

export i32 rgb(i32 r, i32 g, i32 b) {
    return r * 65536 + g * 256 + b;
}

// Write a single pixel, bounds-checked against the display.
export void put_pixel(i32 x, i32 y, i32 color) {
    if (x < g_clip_x0) { return; }
    if (y < g_clip_y0) { return; }
    if (x >= g_clip_x1) { return; }
    if (y >= g_clip_y1) { return; }
    i32 addr = VRAM_BASE + (y * DISPLAY_WIDTH + x) * 4;
    i32* ptr = (i32*)addr;
    *ptr = color;
}

export void fill_rect(i32 x, i32 y, i32 w, i32 h, i32 color) {
    if (x < DISPLAY_WIDTH) {
        if (y < DISPLAY_HEIGHT) {
            if (x < 0) {
                w = w + x;
                x = 0;
            }
            if (y < 0) {
                h = h + y;
                y = 0;
            }
            if (x + w > DISPLAY_WIDTH) { w = DISPLAY_WIDTH - x; }
            if (y + h > DISPLAY_HEIGHT) { h = DISPLAY_HEIGHT - y; }

            // Intersect with the clip rectangle so a partial repaint cannot
            // paint outside the damaged region.
            if (x < g_clip_x0) { w = w - (g_clip_x0 - x); x = g_clip_x0; }
            if (y < g_clip_y0) { h = h - (g_clip_y0 - y); y = g_clip_y0; }
            if (x + w > g_clip_x1) { w = g_clip_x1 - x; }
            if (y + h > g_clip_y1) { h = g_clip_y1 - y; }
            
            if (w > 0) {
                if (h > 0) {
                    i32* DMA2D_DEST = (i32*)DMA2D_DEST_ADDR;
                    i32* DMA2D_COLOR = (i32*)DMA2D_COLOR_ADDR;
                    i32* DMA2D_WIDTH = (i32*)DMA2D_WIDTH_ADDR;
                    i32* DMA2D_HEIGHT = (i32*)DMA2D_HEIGHT_ADDR;
                    i32* DMA2D_STRIDE = (i32*)DMA2D_STRIDE_ADDR;
                    i32* DMA2D_CMD = (i32*)DMA2D_CMD_ADDR;
                    
                    *DMA2D_DEST = VRAM_BASE + (y * DISPLAY_WIDTH + x) * 4;
                    *DMA2D_COLOR = color;
                    *DMA2D_WIDTH = w;
                    *DMA2D_HEIGHT = h;
                    *DMA2D_STRIDE = DISPLAY_WIDTH;
                    *DMA2D_CMD = 1; // triggers fill
                }
            }
        }
    }
}

export void draw_rect(i32 x, i32 y, i32 w, i32 h, i32 color) {
    fill_rect(x, y, w, 1, color);
    fill_rect(x, y + h - 1, w, 1, color);
    fill_rect(x, y, 1, h, color);
    fill_rect(x + w - 1, y, 1, h, color);
}

i32 iabs(i32 v) {
    if (v < 0) { return 0 - v; }
    return v;
}

// Draw a line from (x0, y0) to (x1, y1) using Bresenham's algorithm. Handles
// any slope, including horizontal/vertical and steep lines.
export void draw_line(i32 x0, i32 y0, i32 x1, i32 y1, i32 color) {
    i32 dx = iabs(x1 - x0);
    i32 dy = iabs(y1 - y0);
    i32 sx = 0 - 1;
    if (x0 < x1) { sx = 1; }
    i32 sy = 0 - 1;
    if (y0 < y1) { sy = 1; }
    i32 err = dx - dy;

    while (1) {
        put_pixel(x0, y0, color);
        if (x0 == x1) {
            if (y0 == y1) { return; }
        }
        i32 e2 = err * 2;
        if (e2 > (0 - dy)) {
            err = err - dy;
            x0 = x0 + sx;
        }
        if (e2 < dx) {
            err = err + dx;
            y0 = y0 + sy;
        }
    }
}

// Draw a circle outline of radius r centered at (cx, cy) using the midpoint
// circle algorithm (8-way symmetry).
export void draw_circle(i32 cx, i32 cy, i32 r, i32 color) {
    i32 x = r;
    i32 y = 0;
    i32 err = 1 - r;
    while (x >= y) {
        put_pixel(cx + x, cy + y, color);
        put_pixel(cx + y, cy + x, color);
        put_pixel(cx - y, cy + x, color);
        put_pixel(cx - x, cy + y, color);
        put_pixel(cx - x, cy - y, color);
        put_pixel(cx - y, cy - x, color);
        put_pixel(cx + y, cy - x, color);
        put_pixel(cx + x, cy - y, color);
        y = y + 1;
        if (err < 0) {
            err = err + 2 * y + 1;
        } else {
            x = x - 1;
            err = err + 2 * (y - x) + 1;
        }
    }
}

// Fill a solid disc of radius r centered at (cx, cy). Draws each scanline as a
// horizontal fill_rect (DMA2D-accelerated).
export void fill_circle(i32 cx, i32 cy, i32 r, i32 color) {
    i32 dy = 0 - r;
    while (dy <= r) {
        // Half-width of the chord at this row: sqrt(r*r - dy*dy), computed by
        // widening from 0 while w*w still fits (no sqrt/multiply-heavy loop).
        i32 rr = r * r - dy * dy;
        i32 w = 0;
        while ((w + 1) * (w + 1) <= rr) {
            w = w + 1;
        }
        fill_rect(cx - w, cy + dy, w * 2 + 1, 1, color);
        dy = dy + 1;
    }
}

// Draw a single 8x8 glyph at (x, y). Set pixels use `fg`; if `bg` differs from
// `fg` the cell background is filled with `bg` first (opaque text). Pass
// bg == fg for transparent rendering.
// Per-pixel glyph draw for the edge case where a character straddles the clip
// boundary. Slower than the direct-to-VRAM path, but only runs for the few
// glyphs on the edge of a damaged region.
void draw_char_clipped(i32 x, i32 y, i32 ch, i32 fg) {
    i32 row = 0;
    while (row < 8) {
        i32 bits = font.glyph_row(ch, row);
        i32 col = 0;
        while (col < 8) {
            i32 mask = 128 >> col;
            if ((bits & mask) != 0) {
                put_pixel(x + col, y + row, fg);
            }
            col = col + 1;
        }
        row = row + 1;
    }
}

export void draw_char(i32 x, i32 y, i32 ch, i32 fg, i32 bg) {
    if (bg != fg) {
        fill_rect(x, y, 8, 8, bg);
    }
    // Bounds-check the whole 8x8 glyph once, then write directly to VRAM
    // without per-pixel put_pixel calls (avoids 64 function calls + 256
    // bounds checks per character). Glyphs that are not fully inside the clip
    // rectangle fall back to the per-pixel path, which clips.
    i32 partial = 0;
    if (x < g_clip_x0) { partial = 1; }
    if (y < g_clip_y0) { partial = 1; }
    if (x + 8 > g_clip_x1) { partial = 1; }
    if (y + 8 > g_clip_y1) { partial = 1; }
    if (partial != 0) {
        draw_char_clipped(x, y, ch, fg);
        return;
    }

    i32 stride = DISPLAY_WIDTH * 4;
    i32 row_addr = VRAM_BASE + (y * DISPLAY_WIDTH + x) * 4;
    i32 row = 0;
    while (row < 8) {
        i32 bits = font.glyph_row(ch, row);
        i32 addr = row_addr;
        i32 col = 0;
        while (col < 8) {
            i32 mask = 128 >> col;
            if ((bits & mask) != 0) {
                i32* ptr = (i32*)addr;
                *ptr = fg;
            }
            addr = addr + 4;
            col = col + 1;
        }
        row_addr = row_addr + stride;
        row = row + 1;
    }
}

// Draw a NUL-terminated string starting at (x, y), advancing 8 px per glyph.
// Newline (0x0A) moves to the next line and back to the starting x.
export void draw_text(i32 x, i32 y, char* s, i32 fg, i32 bg) {
    i32 cx = x;
    i32 cy = y;
    i32 i = 0;
    i32 c = (i32)s[i] & 0xFF;
    while (c != 0) {
        if (c == 10) {
            cx = x;
            cy = cy + font.glyph_h();
        } else {
            draw_char(cx, cy, c, fg, bg);
            cx = cx + font.glyph_w();
        }
        i = i + 1;
        c = (i32)s[i] & 0xFF;
    }
}

// Draw a single glyph magnified by `scale` (each font pixel becomes a
// scale x scale block). scale == 1 matches draw_char.
export void draw_char_scaled(i32 x, i32 y, i32 ch, i32 fg, i32 bg, i32 scale) {
    if (scale < 1) { scale = 1; }
    if (bg != fg) {
        fill_rect(x, y, 8 * scale, 8 * scale, bg);
    }
    i32 row = 0;
    while (row < 8) {
        i32 bits = font.glyph_row(ch, row);
        i32 col = 0;
        while (col < 8) {
            i32 mask = 128 >> col;
            if ((bits & mask) != 0) {
                fill_rect(x + col * scale, y + row * scale, scale, scale, fg);
            }
            col = col + 1;
        }
        row = row + 1;
    }
}

// Draw a NUL-terminated string magnified by `scale`, advancing 8*scale px per
// glyph. Newline returns to the starting x and drops one scaled line.
export void draw_text_scaled(i32 x, i32 y, char* s, i32 fg, i32 bg, i32 scale) {
    if (scale < 1) { scale = 1; }
    i32 cx = x;
    i32 cy = y;
    i32 i = 0;
    i32 c = (i32)s[i] & 0xFF;
    while (c != 0) {
        if (c == 10) {
            cx = x;
            cy = cy + 8 * scale;
        } else {
            draw_char_scaled(cx, cy, c, fg, bg, scale);
            cx = cx + 8 * scale;
        }
        i = i + 1;
        c = (i32)s[i] & 0xFF;
    }
}

// Draw a signed 32-bit integer in base 10 at (x, y). Returns the x coordinate
// just past the last glyph so callers can chain draws.
export i32 draw_int(i32 x, i32 y, i32 value, i32 fg, i32 bg) {
    // str.itoa already does the sign, the zero case, and the digit-order
    // reversal (11 bytes covers "-2147483648" plus the terminator); this just
    // walks the resulting string and draws it, the same as draw_text.
    char digits[12];
    str.itoa(value, &digits[0]);

    i32 cx = x;
    i32 i = 0;
    i32 c = (i32)digits[0] & 0xFF;
    while (c != 0) {
        draw_char(cx, y, c, fg, bg);
        cx = cx + font.glyph_w();
        i = i + 1;
        c = (i32)digits[i] & 0xFF;
    }
    return cx;
}

// Copy a w x h block of 32-bit pixels from a source buffer (row-major, one i32
// per pixel) to the screen at (x, y). `src` points at the top-left pixel.
export void blit(i32 x, i32 y, i32 w, i32 h, ref i32 src) {
    i32 row = 0;
    while (row < h) {
        i32 col = 0;
        while (col < w) {
            put_pixel(x + col, y + row, src[row * w + col]);
            col = col + 1;
        }
        row = row + 1;
    }
}

// Like blit, but pixels equal to `key_color` are treated as transparent and
// left untouched, so non-rectangular sprites composite over the background.
export void blit_key(i32 x, i32 y, i32 w, i32 h, ref i32 src, i32 key_color) {
    i32 row = 0;
    while (row < h) {
        i32 col = 0;
        while (col < w) {
            i32 px = src[row * w + col];
            if (px != key_color) {
                put_pixel(x + col, y + row, px);
            }
            col = col + 1;
        }
        row = row + 1;
    }
}
