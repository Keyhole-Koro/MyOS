package graphics;

import display_config from "display_config.mln";
import ui_config from "config.mln";
import font from "font8x8.mln";
import font_sans from "font_sans.mln";
import str from "../../../../toolchain/MyStdLib/str.mln";

export i32 VRAM_BASE = 0x30000000;

// Imported MyLang functions link across packages reliably, so keep display
// geometry behind calls to the shared configuration rather than duplicating
// numeric globals in this package.
/**
 * Retrieves the screen width in pixels from hardware display config.
 * @return Screen width.
 */
export i32 display_width() {
    return display_config.width();
}

/**
 * Retrieves the screen height in pixels from hardware display config.
 * @return Screen height.
 */
export i32 display_height() {
    return display_config.height();
}

// 2D accelerator registers. Must match runtime/MyEmulator/src/constants.rs.
i32 DMA2D_DEST_ADDR = 0x24000020;
i32 DMA2D_COLOR_ADDR = 0x24000024;
i32 DMA2D_WIDTH_ADDR = 0x24000028;
i32 DMA2D_HEIGHT_ADDR = 0x2400002C;
i32 DMA2D_STRIDE_ADDR = 0x24000030;
i32 DMA2D_CMD_ADDR = 0x24000034;
i32 DISPLAY_SWAP_ADDR = 0x24000038;
i32 CURSOR_X_ADDR = 0x24000060;
i32 CURSOR_Y_ADDR = 0x24000064;
i32 CURSOR_CTRL_ADDR = 0x24000068;
i32 DMA2D_SRC_ADDR = 0x24000090;
i32 DMA2D_SRC_STRIDE_ADDR = 0x24000094;
i32 DMA2D_COLOR2_ADDR = 0x24000098;
i32 DMA2D_RADIUS_ADDR = 0x2400009C;
i32 DMA2D_SPREAD_ADDR = 0x240000B8;
i32 DMA2D_CLIP_X0_ADDR = 0x240000C0;
i32 DMA2D_CLIP_Y0_ADDR = 0x240000C4;
i32 DMA2D_CLIP_X1_ADDR = 0x240000C8;
i32 DMA2D_CLIP_Y1_ADDR = 0x240000CC;

i32 DMA2D_CMD_FILL = 1;
i32 DMA2D_CMD_BLEND_FILL = 2;
i32 DMA2D_CMD_COPY = 3;
i32 DMA2D_CMD_COPY_BLEND = 4;
i32 DMA2D_CMD_MASK_A8 = 5;
i32 DMA2D_CMD_GRADIENT_V = 6;
i32 DMA2D_CMD_GRADIENT_H = 7;
i32 DMA2D_CMD_ROUND_RECT = 8;
i32 DMA2D_CMD_ROUND_RECT_OUTLINE = 9;
i32 DMA2D_CMD_SHADOW = 10;

/**
 * Swaps back buffer to front buffer, presenting the rendered frame.
 */
export void present() {
    i32* swap = (i32*)DISPLAY_SWAP_ADDR;
    *swap = 1;
}

/**
 * Sets the hardware cursor position.
 * @param x Cursor screen X coordinate.
 * @param y Cursor screen Y coordinate.
 */
export void set_cursor(i32 x, i32 y) {
    i32* cx = (i32*)CURSOR_X_ADDR;
    i32* cy = (i32*)CURSOR_Y_ADDR;
    *cx = x;
    *cy = y;
}

/**
 * Shows or hides the hardware cursor sprite.
 * @param on 1 to show, 0 to hide.
 */
export void show_cursor(i32 on) {
    i32* ctrl = (i32*)CURSOR_CTRL_ADDR;
    *ctrl = on;
}

// ---------------------------------------------------------------------------
// Colours. Packed 0xAARRGGBB. rgb() leaves alpha at 0, which every opaque
// primitive ignores; the blend primitives read it, so build translucent
// colours with rgba() or with_alpha().
// ---------------------------------------------------------------------------

/**
 * Packs red, green, blue color channels into an RGB integer (alpha = 0).
 * @param r Red component (0-255).
 * @param g Green component (0-255).
 * @param b Blue component (0-255).
 * @return Packed RGB integer (0x00RRGGBB).
 */
export i32 rgb(i32 r, i32 g, i32 b) {
    return r * 65536 + g * 256 + b;
}

/**
 * Packs red, green, blue, and alpha channels into an RGBA integer.
 * @param r Red component (0-255).
 * @param g Green component (0-255).
 * @param b Blue component (0-255).
 * @param a Alpha component (0-255).
 * @return Packed ARGB integer (0xAARRGGBB).
 */
export i32 rgba(i32 r, i32 g, i32 b, i32 a) {
    return (a << 24) | rgb(r, g, b);
}

/**
 * Replaces the alpha channel of a packed color.
 * @param color Source color.
 * @param a New alpha value (0-255).
 * @return Color with updated alpha channel.
 */
export i32 with_alpha(i32 color, i32 a) {
    return (a << 24) | (color & 0xFFFFFF);
}

/**
 * Extracts the 8-bit alpha component from a packed ARGB color.
 * @param color Packed ARGB color.
 * @return Alpha component (0-255).
 */
export i32 alpha_of(i32 color) {
    return (color >> 24) & 0xFF;
}

/**
 * Extracts the red component from a packed color.
 * @param color Packed ARGB color value.
 * @return Red component in the range 0..255.
 */
export i32 red_of(i32 color) { return (color >> 16) & 0xFF; }
/**
 * Extracts the green component from a packed color.
 * @param color Packed ARGB color value.
 * @return Green component in the range 0..255.
 */
export i32 green_of(i32 color) { return (color >> 8) & 0xFF; }
/**
 * Extracts the blue component from a packed color.
 * @param color Packed ARGB color value.
 * @return Blue component in the range 0..255.
 */
export i32 blue_of(i32 color) { return color & 0xFF; }

/**
 * Computes a linear interpolation between two colors by factor `t`.
 * @param c0 First color (t=0).
 * @param c1 Second color (t=255).
 * @param t Blend weight in range 0..255.
 * @return Interpolated RGB color.
 */
export i32 mix(i32 c0, i32 c1, i32 t) {
    if (t <= 0) { return c0 & 0xFFFFFF; }
    if (t >= 255) { return c1 & 0xFFFFFF; }
    i32 r = (red_of(c0) * (255 - t) + red_of(c1) * t + 127) / 255;
    i32 g = (green_of(c0) * (255 - t) + green_of(c1) * t + 127) / 255;
    i32 b = (blue_of(c0) * (255 - t) + blue_of(c1) * t + 127) / 255;
    return rgb(r, g, b);
}

/**
 * Darkens a color toward black by the given amount.
 * @param color Source color.
 * @param amount Amount to darken (0-255).
 * @return Darkened color.
 */
export i32 darken(i32 color, i32 amount) {
    return mix(color, rgb(0, 0, 0), amount);
}

/**
 * Lightens a color toward white by the given amount.
 * @param color Source color.
 * @param amount Amount to lighten (0-255).
 * @return Lightened color.
 */
export i32 lighten(i32 color, i32 amount) {
    return mix(color, rgb(255, 255, 255), amount);
}

// ---------------------------------------------------------------------------
// Clip rectangle. All drawing is confined to it, so a partial repaint can draw
// whole nodes and have the parts outside the damaged region dropped, and a
// container can confine its children. Defaults to the whole display;
// clear_clip() restores that. push_clip() intersects with the current clip
// and pop_clip() restores the previous one, nesting up to CLIP_DEPTH deep.
// ---------------------------------------------------------------------------
i32 g_clip_x0 = 0;
i32 g_clip_y0 = 0;
i32 g_clip_x1 = 0;
i32 g_clip_y1 = 0;

i32 g_clip_stack_x0[16];
i32 g_clip_stack_y0[16];
i32 g_clip_stack_x1[16];
i32 g_clip_stack_y1[16];
i32 g_clip_sp = 0;

/**
 * Initializes the graphics clip stack and clears the clipping rectangle.
 */
export void init() {
    clear_clip();
    g_clip_sp = 0;
}

/**
 * Copies the software clipping rectangle into hardware DMA2D scissor registers.
 */
void sync_scissor() {
    i32* x0 = (i32*)DMA2D_CLIP_X0_ADDR;
    i32* y0 = (i32*)DMA2D_CLIP_Y0_ADDR;
    i32* x1 = (i32*)DMA2D_CLIP_X1_ADDR;
    i32* y1 = (i32*)DMA2D_CLIP_Y1_ADDR;
    *x0 = g_clip_x0;
    *y0 = g_clip_y0;
    *x1 = g_clip_x1;
    *y1 = g_clip_y1;
}

/**
 * Sets the active clipping rectangle to the given screen coordinates.
 * @param x Origin X coordinate.
 * @param y Origin Y coordinate.
 * @param w Width in pixels.
 * @param h Height in pixels.
 */
export void set_clip(i32 x, i32 y, i32 w, i32 h) {
    i32 width = display_config.width();
    i32 height = display_config.height();
    i32 x0 = x;
    i32 y0 = y;
    i32 x1 = x + w;
    i32 y1 = y + h;
    if (x0 < 0) { x0 = 0; }
    if (y0 < 0) { y0 = 0; }
    if (x1 > width) { x1 = width; }
    if (y1 > height) { y1 = height; }
    g_clip_x0 = x0;
    g_clip_y0 = y0;
    g_clip_x1 = x1;
    g_clip_y1 = y1;
    sync_scissor();
}

/**
 * Resets the active clipping rectangle to cover the entire screen.
 */
export void clear_clip() {
    g_clip_x0 = 0;
    g_clip_y0 = 0;
    g_clip_x1 = display_config.width();
    g_clip_y1 = display_config.height();
    sync_scissor();
}

/**
 * Intersects the active clip rectangle with (x, y, w, h) and pushes the previous clip onto the clip stack.
 * @param x Origin X coordinate.
 * @param y Origin Y coordinate.
 * @param w Width in pixels.
 * @param h Height in pixels.
 */
export void push_clip(i32 x, i32 y, i32 w, i32 h) {
    if (g_clip_sp < ui_config.CLIP_DEPTH) {
        g_clip_stack_x0[g_clip_sp] = g_clip_x0;
        g_clip_stack_y0[g_clip_sp] = g_clip_y0;
        g_clip_stack_x1[g_clip_sp] = g_clip_x1;
        g_clip_stack_y1[g_clip_sp] = g_clip_y1;
    }
    g_clip_sp++;
    i32 x1 = x + w;
    i32 y1 = y + h;
    if (x > g_clip_x0) { g_clip_x0 = x; }
    if (y > g_clip_y0) { g_clip_y0 = y; }
    if (x1 < g_clip_x1) { g_clip_x1 = x1; }
    if (y1 < g_clip_y1) { g_clip_y1 = y1; }
    sync_scissor();
}

/**
 * Pops and restores the previous clipping rectangle from the clip stack.
 */
export void pop_clip() {
    if (g_clip_sp <= 0) { return; }
    g_clip_sp--;
    i32 i = g_clip_sp;
    if (i >= ui_config.CLIP_DEPTH) { i = ui_config.CLIP_DEPTH - 1; }
    g_clip_x0 = g_clip_stack_x0[i];
    g_clip_y0 = g_clip_stack_y0[i];
    g_clip_x1 = g_clip_stack_x1[i];
    g_clip_y1 = g_clip_stack_y1[i];
    sync_scissor();
}

/**
 * Checks whether the active clipping rectangle is empty.
 * @return True if clip rectangle is empty, false otherwise.
 */
export bool clip_is_empty() {
    if (g_clip_x1 <= g_clip_x0) { return true; }
    if (g_clip_y1 <= g_clip_y0) { return true; }
    return false;
}

// Intersect (x, y, w, h) with the clip. The result lands in g_cl_* and the
// return value says whether anything is left. Every accelerator primitive
// goes through this so DMA2D never writes outside the clip.
i32 g_cl_x = 0;
i32 g_cl_y = 0;
i32 g_cl_w = 0;
i32 g_cl_h = 0;

/**
 * Intersects a target rectangle with the current clipping bounds, storing result in g_cl_*.
 * @param x Left coordinate of rectangle.
 * @param y Top coordinate of rectangle.
 * @param w Width of rectangle.
 * @param h Height of rectangle.
 * @return True if any portion is visible within clip, false if completely culled.
 */
bool clip_rect(i32 x, i32 y, i32 w, i32 h) {
    i32 x0 = x;
    i32 y0 = y;
    i32 x1 = x + w;
    i32 y1 = y + h;
    if (x0 < g_clip_x0) { x0 = g_clip_x0; }
    if (y0 < g_clip_y0) { y0 = g_clip_y0; }
    if (x1 > g_clip_x1) { x1 = g_clip_x1; }
    if (y1 > g_clip_y1) { y1 = g_clip_y1; }
    if (x1 <= x0) { return false; }
    if (y1 <= y0) { return false; }
    g_cl_x = x0;
    g_cl_y = y0;
    g_cl_w = x1 - x0;
    g_cl_h = y1 - y0;
    return true;
}

// ---------------------------------------------------------------------------
// DMA2D submission. dest is the already-clipped rectangle (g_cl_*).
// ---------------------------------------------------------------------------

/**
 * Configures the destination VRAM address, dimensions, and stride for DMA2D.
 * @param x Horizontal start pixel.
 * @param y Vertical start pixel.
 * @param w Width in pixels.
 * @param h Height in pixels.
 */
void dma_dest(i32 x, i32 y, i32 w, i32 h) {
    i32 width = display_config.width();
    i32* dest = (i32*)DMA2D_DEST_ADDR;
    i32* dw = (i32*)DMA2D_WIDTH_ADDR;
    i32* dh = (i32*)DMA2D_HEIGHT_ADDR;
    i32* ds = (i32*)DMA2D_STRIDE_ADDR;
    *dest = VRAM_BASE + (y * width + x) * 4;
    *dw = w;
    *dh = h;
    *ds = width;
}

/**
 * Clamps negative coordinates before configuring DMA2D destination for shapes.
 * @param x Horizontal start pixel.
 * @param y Vertical start pixel.
 * @param w Width in pixels.
 * @param h Height in pixels.
 */
void dma_dest_shape(i32 x, i32 y, i32 w, i32 h) {
    if (x < 0) { w = w + x; x = 0; }
    if (y < 0) { h = h + y; y = 0; }
    dma_dest(x, y, w, h);
}

/**
 * Sets the primary 32-bit ARGB color in the DMA2D color register.
 * @param color 32-bit ARGB color value.
 */
void dma_color(i32 color) {
    i32* c = (i32*)DMA2D_COLOR_ADDR;
    *c = color;
}

/**
 * Sets the secondary 32-bit ARGB color in the DMA2D color2 register.
 * @param color 32-bit ARGB color value.
 */
void dma_color2(i32 color) {
    i32* c = (i32*)DMA2D_COLOR2_ADDR;
    *c = color;
}

/**
 * Configures the source buffer address and stride in DMA2D registers.
 * @param addr Memory address of source buffer.
 * @param stride Row stride in bytes or pixels.
 */
void dma_src(i32 addr, i32 stride) {
    i32* s = (i32*)DMA2D_SRC_ADDR;
    i32* ss = (i32*)DMA2D_SRC_STRIDE_ADDR;
    *s = addr;
    *ss = stride;
}

/**
 * Sets corner radius and spread parameters in DMA2D shape registers.
 * @param radius Corner radius in pixels.
 * @param spread Blur spread in pixels.
 */
void dma_shape(i32 radius, i32 spread) {
    i32* r = (i32*)DMA2D_RADIUS_ADDR;
    i32* sp = (i32*)DMA2D_SPREAD_ADDR;
    *r = radius;
    *sp = spread;
}

/**
 * Writes command code to DMA2D command register to trigger hardware execution.
 * @param cmd DMA2D command code (e.g. DMA2D_CMD_SOLID_FILL).
 */
void dma_run(i32 cmd) {
    i32* c = (i32*)DMA2D_CMD_ADDR;
    *c = cmd;
}

/**
 * Tests whether a rectangle is completely outside the current clipping bounds.
 * @param x Left coordinate.
 * @param y Top coordinate.
 * @param w Width in pixels.
 * @param h Height in pixels.
 * @return True if completely outside clip, false if it touches or intersects.
 */
bool outside_clip(i32 x, i32 y, i32 w, i32 h) {
    if (x + w <= g_clip_x0) { return true; }
    if (y + h <= g_clip_y0) { return true; }
    if (x >= g_clip_x1) { return true; }
    if (y >= g_clip_y1) { return true; }
    return false;
}

// ---------------------------------------------------------------------------
// Pixels and rectangles.
// ---------------------------------------------------------------------------

/**
 * Writes a single pixel to the back buffer, clipped against the active clip rectangle.
 * @param x Screen X coordinate.
 * @param y Screen Y coordinate.
 * @param color 24-bit RGB or 32-bit ARGB pixel color.
 */
export void put_pixel(i32 x, i32 y, i32 color) {
    if (x < g_clip_x0) { return; }
    if (y < g_clip_y0) { return; }
    if (x >= g_clip_x1) { return; }
    if (y >= g_clip_y1) { return; }
    i32 addr = VRAM_BASE + (y * display_config.width() + x) * 4;
    i32* ptr = (i32*)addr;
    *ptr = color;
}

/**
 * Reads a pixel color back from the back buffer.
 * @param x Screen X coordinate.
 * @param y Screen Y coordinate.
 * @return 32-bit pixel color, or 0 if outside display bounds.
 */
export i32 get_pixel(i32 x, i32 y) {
    if (x < 0) { return 0; }
    if (y < 0) { return 0; }
    if (x >= display_config.width()) { return 0; }
    if (y >= display_config.height()) { return 0; }
    i32 addr = VRAM_BASE + (y * display_config.width() + x) * 4;
    i32* ptr = (i32*)addr;
    return *ptr;
}

/**
 * Blends a single translucent pixel into the back buffer.
 * @param x Screen X coordinate.
 * @param y Screen Y coordinate.
 * @param color ARGB color containing alpha component.
 */
export void blend_pixel(i32 x, i32 y, i32 color) {
    i32 a = alpha_of(color);
    if (a == 0) { return; }
    if (a >= 255) { put_pixel(x, y, color); return; }
    if (x < g_clip_x0) { return; }
    if (y < g_clip_y0) { return; }
    if (x >= g_clip_x1) { return; }
    if (y >= g_clip_y1) { return; }
    i32 addr = VRAM_BASE + (y * display_config.width() + x) * 4;
    i32* ptr = (i32*)addr;
    *ptr = mix(*ptr, color, a);
}

/**
 * Fills a solid rectangle using hardware DMA2D acceleration.
 * @param x Origin X coordinate.
 * @param y Origin Y coordinate.
 * @param w Width in pixels.
 * @param h Height in pixels.
 * @param color 24-bit RGB color.
 */
export void fill_rect(i32 x, i32 y, i32 w, i32 h, i32 color) {
    if (!clip_rect(x, y, w, h)) { return; }
    dma_dest(g_cl_x, g_cl_y, g_cl_w, g_cl_h);
    dma_color(color);
    dma_run(DMA2D_CMD_FILL);
}

/**
 * Fills a rectangle with an alpha-blended color using hardware DMA2D acceleration.
 * @param x Origin X coordinate.
 * @param y Origin Y coordinate.
 * @param w Width in pixels.
 * @param h Height in pixels.
 * @param color 32-bit ARGB color with alpha in the top byte.
 */
export void blend_rect(i32 x, i32 y, i32 w, i32 h, i32 color) {
    i32 a = alpha_of(color);
    if (a == 0) { return; }
    if (a >= 255) { fill_rect(x, y, w, h, color); return; }
    if (!clip_rect(x, y, w, h)) { return; }
    dma_dest(g_cl_x, g_cl_y, g_cl_w, g_cl_h);
    dma_color(color);
    dma_run(DMA2D_CMD_BLEND_FILL);
}

/**
 * Draws a vertical linear color gradient from c0 (top) to c1 (bottom).
 * @param x Origin X coordinate.
 * @param y Origin Y coordinate.
 * @param w Width in pixels.
 * @param h Height in pixels.
 * @param c0 Top color.
 * @param c1 Bottom color.
 */
export void fill_gradient_v(i32 x, i32 y, i32 w, i32 h, i32 c0, i32 c1) {
    if (h <= 0) { return; }
    if (w <= 0) { return; }
    if (outside_clip(x, y, w, h)) { return; }
    // The full rectangle goes to the device and the scissor trims it, so a
    // partial repaint reproduces exactly the rows a full paint produced
    // (re-deriving end colours for the visible part rounds differently and
    // leaves seams).
    dma_dest_shape(x, y, w, h);
    dma_color(c0);
    dma_color2(c1);
    dma_run(DMA2D_CMD_GRADIENT_V);
}

/**
 * Draws a horizontal linear color gradient from c0 (left) to c1 (right).
 * @param x Origin X coordinate.
 * @param y Origin Y coordinate.
 * @param w Width in pixels.
 * @param h Height in pixels.
 * @param c0 Left color.
 * @param c1 Right color.
 */
export void fill_gradient_h(i32 x, i32 y, i32 w, i32 h, i32 c0, i32 c1) {
    if (w <= 0) { return; }
    if (h <= 0) { return; }
    if (outside_clip(x, y, w, h)) { return; }
    dma_dest_shape(x, y, w, h);
    dma_color(c0);
    dma_color2(c1);
    dma_run(DMA2D_CMD_GRADIENT_H);
}

/**
 * Copies a rectangular region of the back buffer to another position using DMA2D.
 * @param sx Source X coordinate.
 * @param sy Source Y coordinate.
 * @param dx Destination X coordinate.
 * @param dy Destination Y coordinate.
 * @param w Region width in pixels.
 * @param h Height in pixels.
 */
export void copy_rect(i32 sx, i32 sy, i32 dx, i32 dy, i32 w, i32 h) {
    if (!clip_rect(dx, dy, w, h)) { return; }
    i32 width = display_config.width();
    i32 off_x = g_cl_x - dx;
    i32 off_y = g_cl_y - dy;
    dma_dest(g_cl_x, g_cl_y, g_cl_w, g_cl_h);
    dma_src(VRAM_BASE + ((sy + off_y) * width + sx + off_x) * 4, width);
    dma_run(DMA2D_CMD_COPY);
}

/**
 * Blends an 8-bit coverage mask onto the display with the given color using DMA2D.
 * @param src Address of row-major 8-bit mask buffer.
 * @param stride Row stride in bytes of the mask buffer.
 * @param x Destination X coordinate.
 * @param y Destination Y coordinate.
 * @param w Mask width in pixels.
 * @param h Mask height in pixels.
 * @param color 24-bit RGB tint color.
 */
export void mask_blit(i32 src, i32 stride, i32 x, i32 y, i32 w, i32 h, i32 color) {
    if (!clip_rect(x, y, w, h)) { return; }
    i32 off_x = g_cl_x - x;
    i32 off_y = g_cl_y - y;
    dma_dest(g_cl_x, g_cl_y, g_cl_w, g_cl_h);
    dma_src(src + off_y * stride + off_x, stride);
    dma_color(color);
    dma_run(DMA2D_CMD_MASK_A8);
}

/**
 * Copies an ARGB image from memory to the display with per-pixel alpha blending.
 * @param src Address of row-major 32-bit ARGB pixel buffer.
 * @param stride Row stride in pixels of source buffer.
 * @param x Destination X coordinate.
 * @param y Destination Y coordinate.
 * @param w Width in pixels.
 * @param h Height in pixels.
 */
export void blit_alpha(i32 src, i32 stride, i32 x, i32 y, i32 w, i32 h) {
    if (!clip_rect(x, y, w, h)) { return; }
    i32 off_x = g_cl_x - x;
    i32 off_y = g_cl_y - y;
    dma_dest(g_cl_x, g_cl_y, g_cl_w, g_cl_h);
    dma_src(src + (off_y * stride + off_x) * 4, stride);
    dma_run(DMA2D_CMD_COPY_BLEND);
}

/**
 * Draws the outline of a 1-pixel rectangle.
 * @param x Origin X coordinate.
 * @param y Origin Y coordinate.
 * @param w Width in pixels.
 * @param h Height in pixels.
 * @param color 24-bit RGB outline color.
 */
export void draw_rect(i32 x, i32 y, i32 w, i32 h, i32 color) {
    fill_rect(x, y, w, 1, color);
    fill_rect(x, y + h - 1, w, 1, color);
    fill_rect(x, y, 1, h, color);
    fill_rect(x + w - 1, y, 1, h, color);
}

/**
 * Draws a rectangle border whose thickness scales with UI scale.
 * @param x Origin X coordinate.
 * @param y Origin Y coordinate.
 * @param w Width in pixels.
 * @param h Height in pixels.
 * @param color 24-bit RGB outline color.
 * @param scale Border thickness scaling factor.
 */
export void draw_rect_scaled(i32 x, i32 y, i32 w, i32 h, i32 color, i32 scale) {
    if (scale < 1) { scale = 1; }
    fill_rect(x, y, w, scale, color);
    fill_rect(x, y + h - scale, w, scale, color);
    fill_rect(x, y, scale, h, color);
    fill_rect(x + w - scale, y, scale, h, color);
}

// ---------------------------------------------------------------------------
// Rounded rectangles and shadows.
//
// These are accelerator commands: the guest hands DMA2D the unclipped
// rectangle plus radius/thickness/blur, and the scissor (mirrored from the
// clip stack) trims the result. Shapes therefore cost a handful of register
// writes regardless of size, and their anti-aliased edges are computed by
// the device.
// ---------------------------------------------------------------------------

/**
 * Returns the absolute value of an integer.
 * @param v Input signed integer.
 * @return Absolute value.
 */
i32 iabs(i32 v) {
    if (v < 0) { return -v; }
    return v;
}

/**
 * Computes integer square root (floor).
 * @param n Non-negative integer.
 * @return Integer square root.
 */
export i32 isqrt(i32 n) {
    if (n <= 0) { return 0; }
    i32 res = 0;
    i32 bit = 1 << 30;
    while (bit > n) { bit = bit >> 2; }
    while (bit != 0) {
        if (n >= res + bit) {
            n = n - (res + bit);
            res = (res >> 1) + bit;
        } else {
            res = res >> 1;
        }
        bit = bit >> 2;
    }
    return res;
}

/**
 * Fills a rounded rectangle with anti-aliased corners using DMA2D acceleration.
 * @param x Origin X coordinate.
 * @param y Origin Y coordinate.
 * @param w Width in pixels.
 * @param h Height in pixels.
 * @param r Corner radius in pixels.
 * @param color 24-bit RGB or 32-bit ARGB fill color.
 */
export void fill_round_rect(i32 x, i32 y, i32 w, i32 h, i32 r, i32 color) {
    if (w <= 0) { return; }
    if (h <= 0) { return; }
    if (outside_clip(x, y, w, h)) { return; }
    i32 a = alpha_of(color);
    if (r <= 0) {
        if (a == 0) { fill_rect(x, y, w, h, color); }
        else { blend_rect(x, y, w, h, color); }
        return;
    }
    dma_dest_shape(x, y, w, h);
    dma_color(color);
    dma_shape(r, 0);
    dma_run(DMA2D_CMD_ROUND_RECT);
}

/**
 * Draws a rounded rectangle outline using DMA2D acceleration.
 * @param x Origin X coordinate.
 * @param y Origin Y coordinate.
 * @param w Width in pixels.
 * @param h Height in pixels.
 * @param r Corner radius in pixels.
 * @param t Outline thickness in pixels.
 * @param color Outline color.
 */
export void draw_round_rect(i32 x, i32 y, i32 w, i32 h, i32 r, i32 t, i32 color) {
    if (w <= 0) { return; }
    if (h <= 0) { return; }
    if (t < 1) { t = 1; }
    if (outside_clip(x, y, w, h)) { return; }
    dma_dest_shape(x, y, w, h);
    dma_color(color);
    dma_shape(r, t);
    dma_run(DMA2D_CMD_ROUND_RECT_OUTLINE);
}

/**
 * Draws a soft drop shadow behind a rounded rectangle using DMA2D acceleration.
 * @param x Origin X coordinate.
 * @param y Origin Y coordinate.
 * @param w Width in pixels.
 * @param h Height in pixels.
 * @param r Corner radius in pixels.
 * @param size Shadow blur/spread size in pixels.
 * @param offset_y Vertical shadow offset in pixels.
 * @param alpha Maximum shadow opacity (0-255).
 */
export void draw_shadow(i32 x, i32 y, i32 w, i32 h, i32 r, i32 size, i32 offset_y, i32 alpha) {
    if (size < 1) { return; }
    if (w <= 0) { return; }
    if (h <= 0) { return; }
    i32 sy = y + offset_y;
    if (outside_clip(x - size, sy - size, w + 2 * size, h + 2 * size)) { return; }
    dma_dest_shape(x, sy, w, h);
    dma_color(rgba(0, 0, 0, alpha));
    dma_shape(r, size);
    dma_run(DMA2D_CMD_SHADOW);
}

// ---------------------------------------------------------------------------
// Lines and circles (software, put_pixel based).
// ---------------------------------------------------------------------------

/**
 * Draws a line between two points using Bresenham's algorithm.
 * @param x0 Starting X coordinate.
 * @param y0 Starting Y coordinate.
 * @param x1 Ending X coordinate.
 * @param y1 Ending Y coordinate.
 * @param color Line color.
 */
export void draw_line(i32 x0, i32 y0, i32 x1, i32 y1, i32 color) {
    i32 dx = iabs(x1 - x0);
    i32 dy = iabs(y1 - y0);
    i32 sx = -1;
    if (x0 < x1) { sx = 1; }
    i32 sy = -1;
    if (y0 < y1) { sy = 1; }
    i32 err = dx - dy;

    while (1) {
        put_pixel(x0, y0, color);
        if (x0 == x1) {
            if (y0 == y1) { return; }
        }
        i32 e2 = err * 2;
        if (e2 > -dy) {
            err = err - dy;
            x0 = x0 + sx;
        }
        if (e2 < dx) {
            err = err + dx;
            y0 = y0 + sy;
        }
    }
}

/**
 * Draws a circle outline using the midpoint circle algorithm.
 * @param cx Center X coordinate.
 * @param cy Center Y coordinate.
 * @param r Circle radius.
 * @param color Circle outline color.
 */
export void draw_circle(i32 cx, i32 cy, i32 r, i32 color) {
    i32 x = r;
    i32 y = 0;
    i32 err = 1 - r;
    while (x >= y) {
        put_pixel(cx + x, cy + y, color);
        put_pixel(cx + y, cy + x, color);
        put_pixel(cx - y, cy + x, color);
        put_pixel(cx - x, cy + y, color);
        put_pixel(cx - x, cy - y, color);
        put_pixel(cx - y, cy - x, color);
        put_pixel(cx + y, cy - x, color);
        put_pixel(cx + x, cy - y, color);
        y++;
        if (err < 0) {
            err = err + 2 * y + 1;
        } else {
            x--;
            err = err + 2 * (y - x) + 1;
        }
    }
}

/**
 * Fills a solid disc using horizontal scanline fills.
 * @param cx Center X coordinate.
 * @param cy Center Y coordinate.
 * @param r Circle radius.
 * @param color Disc fill color.
 */
export void fill_circle(i32 cx, i32 cy, i32 r, i32 color) {
    i32 dy = -r;
    while (dy <= r) {
        // Half-width of the chord at this row: sqrt(r*r - dy*dy), computed by
        // widening from 0 while w*w still fits (no sqrt/multiply-heavy loop).
        i32 rr = r * r - dy * dy;
        i32 w = 0;
        while ((w + 1) * (w + 1) <= rr) {
            w++;
        }
        fill_rect(cx - w, cy + dy, w * 2 + 1, 1, color);
        dy++;
    }
}

/**
 * Fills an anti-aliased disc using hardware rounded rectangle acceleration.
 * @param cx Center X coordinate.
 * @param cy Center Y coordinate.
 * @param r Radius in pixels.
 * @param color Disc fill color.
 */
export void fill_disc(i32 cx, i32 cy, i32 r, i32 color) {
    fill_round_rect(cx - r, cy - r, 2 * r, 2 * r, r, color);
}

// ---------------------------------------------------------------------------
// Anti-aliased proportional text (font_sans). Positions are the top-left of
// the line box; the baseline sits ascent() below it. `bold` selects the
// heavier face, `scale` (1 or 2) the size matching the UI scale.
// ---------------------------------------------------------------------------

/**
 * Returns the line height in pixels for proportional font_sans.
 * @param bold Non-zero for bold typeface, 0 for regular.
 * @param scale Font scaling factor (1 or 2).
 * @return Line height in pixels.
 */
export i32 text_height(i32 bold, i32 scale) {
    i32 face = font_sans.face_for(bold, scale);
    return font_sans.line_height(face);
}

/**
 * Returns the font ascent in pixels from top of line box to baseline.
 * @param bold Non-zero for bold typeface, 0 for regular.
 * @param scale Font scaling factor (1 or 2).
 * @return Ascent in pixels.
 */
export i32 text_ascent(i32 bold, i32 scale) {
    i32 face = font_sans.face_for(bold, scale);
    return font_sans.ascent(face);
}

/**
 * Calculates the total width in pixels of a string rendered in font_sans.
 * @param s Pointer to null-terminated string.
 * @param bold Non-zero for bold typeface.
 * @param scale Scaling factor.
 * @return String advance width in pixels.
 */
export i32 text_width(char* s, i32 bold, i32 scale) {
    i32 face = font_sans.face_for(bold, scale);
    i32 w = 0;
    i32 i = 0;
    i32 c = (i32)s[i] & 0xFF;
    while (c != 0) {
        if (c != 10) {
            w = w + font_sans.advance(face, c);
        }
        i++;
        c = (i32)s[i] & 0xFF;
    }
    return w;
}

/**
 * Calculates the width in pixels of the first `n` characters of a string.
 * @param s Pointer to null-terminated string.
 * @param n Number of characters to measure.
 * @param bold Non-zero for bold typeface.
 * @param scale Scaling factor.
 * @return Width in pixels.
 */
export i32 text_width_n(char* s, i32 n, i32 bold, i32 scale) {
    i32 face = font_sans.face_for(bold, scale);
    i32 w = 0;
    i32 i = 0;
    i32 c = (i32)s[i] & 0xFF;
    while (c != 0) {
        if (i >= n) { return w; }
        if (c != 10) {
            w = w + font_sans.advance(face, c);
        }
        i++;
        c = (i32)s[i] & 0xFF;
    }
    return w;
}

/**
 * Renders a single anti-aliased font_sans glyph and returns its horizontal advance.
 * @param x Left position of line box.
 * @param y Top position of line box.
 * @param ch ASCII character code.
 * @param color Text color.
 * @param bold Non-zero for bold.
 * @param scale Scaling factor.
 * @return Horizontal advance in pixels.
 */
export i32 draw_glyph(i32 x, i32 y, i32 ch, i32 color, i32 bold, i32 scale) {
    i32 face = font_sans.face_for(bold, scale);
    i32 w = font_sans.width(face, ch);
    i32 h = font_sans.height(face, ch);
    if (w > 0) {
        if (h > 0) {
            i32 src = font_sans.data(face, ch);
            i32 gx = x + font_sans.bearing_x(face, ch);
            i32 gy = y + font_sans.bearing_y(face, ch);
            mask_blit(src, w, gx, gy, w, h, color);
        }
    }
    return font_sans.advance(face, ch);
}

/**
 * Draws a null-terminated string using anti-aliased proportional font_sans.
 * @param x Origin X coordinate.
 * @param y Origin Y coordinate.
 * @param s String to draw.
 * @param color Text color.
 * @param bold Non-zero for bold typeface.
 * @param scale Scaling factor.
 */
export void draw_label(i32 x, i32 y, char* s, i32 color, i32 bold, i32 scale) {
    i32 face = font_sans.face_for(bold, scale);
    i32 line_h = font_sans.line_height(face);
    i32 cx = x;
    i32 cy = y;
    i32 i = 0;
    i32 c = (i32)s[i] & 0xFF;
    while (c != 0) {
        if (c == 10) {
            cx = x;
            cy = cy + line_h;
        } else {
            // Skip glyphs entirely outside the clip without touching DMA2D.
            i32 adv = font_sans.advance(face, c);
            if (cx < g_clip_x1) {
                if (cx + adv + 4 > g_clip_x0) {
                    draw_glyph(cx, cy, c, color, bold, scale);
                }
            }
            cx = cx + adv;
        }
        i++;
        c = (i32)s[i] & 0xFF;
    }
}

/**
 * Draws a string horizontally centered within a given bounding width.
 * @param x Box left X coordinate.
 * @param y Box top Y coordinate.
 * @param w Bounding width in pixels.
 * @param s String to draw.
 * @param color Text color.
 * @param bold Non-zero for bold.
 * @param scale Scaling factor.
 */
export void draw_label_centered(i32 x, i32 y, i32 w, char* s, i32 color, i32 bold, i32 scale) {
    i32 tw = text_width(s, bold, scale);
    draw_label(x + (w - tw) / 2, y, s, color, bold, scale);
}

/**
 * Draws a string vertically centered within a given bounding height.
 * @param x Box left X coordinate.
 * @param y Box top Y coordinate.
 * @param h Bounding height in pixels.
 * @param s String to draw.
 * @param color Text color.
 * @param bold Non-zero for bold.
 * @param scale Scaling factor.
 */
export void draw_label_vcentered(i32 x, i32 y, i32 h, char* s, i32 color, i32 bold, i32 scale) {
    i32 th = text_height(bold, scale);
    draw_label(x, y + (h - th) / 2, s, color, bold, scale);
}

// ---------------------------------------------------------------------------
// Legacy 8x8 bitmap text. Still used by the serial-oriented debugging paths
// and as a fallback; UI code uses draw_label above.
// ---------------------------------------------------------------------------

/**
 * Draws a clipped 8x8 character pixel-by-pixel using put_pixel.
 * @param x Left pixel coordinate.
 * @param y Top pixel coordinate.
 * @param ch ASCII character code.
 * @param fg 32-bit ARGB foreground color.
 */
void draw_char_clipped(i32 x, i32 y, i32 ch, i32 fg) {
    i32 row = 0;
    while (row < 8) {
        i32 bits = font.glyph_row(ch, row);
        i32 col = 0;
        while (col < 8) {
            i32 mask = 128 >> col;
            if (bits & mask) {
                put_pixel(x + col, y + row, fg);
            }
            col++;
        }
        row++;
    }
}

/**
 * Draws a single 8x8 bitmap character glyph.
 * @param x Screen X coordinate.
 * @param y Screen Y coordinate.
 * @param ch ASCII character code.
 * @param fg Foreground color.
 * @param bg Background color (set equal to fg for transparent background).
 */
export void draw_char(i32 x, i32 y, i32 ch, i32 fg, i32 bg) {
    if (bg != fg) {
        fill_rect(x, y, 8, 8, bg);
    }
    // Bounds-check the whole 8x8 glyph once, then write directly to VRAM
    // without per-pixel put_pixel calls (avoids 64 function calls + 256
    // bounds checks per character). Glyphs that are not fully inside the clip
    // rectangle fall back to the per-pixel path, which clips.
    i32 partial = 0;
    if (x < g_clip_x0) { partial = 1; }
    if (y < g_clip_y0) { partial = 1; }
    if (x + 8 > g_clip_x1) { partial = 1; }
    if (y + 8 > g_clip_y1) { partial = 1; }
    if (partial) {
        draw_char_clipped(x, y, ch, fg);
        return;
    }

    i32 width = display_config.width();
    i32 stride = width * 4;
    i32 row_addr = VRAM_BASE + (y * width + x) * 4;
    i32 row = 0;
    while (row < 8) {
        i32 bits = font.glyph_row(ch, row);
        i32 addr = row_addr;
        i32 col = 0;
        while (col < 8) {
            i32 mask = 128 >> col;
            if (bits & mask) {
                i32* ptr = (i32*)addr;
                *ptr = fg;
            }
            addr = addr + 4;
            col++;
        }
        row_addr = row_addr + stride;
        row++;
    }
}

/**
 * Draws a null-terminated string using the legacy 8x8 bitmap font.
 * @param x Origin X coordinate.
 * @param y Origin Y coordinate.
 * @param s String to draw.
 * @param fg Foreground text color.
 * @param bg Background fill color (equal to fg for transparent).
 */
export void draw_text(i32 x, i32 y, char* s, i32 fg, i32 bg) {
    i32 cx = x;
    i32 cy = y;
    i32 i = 0;
    i32 c = (i32)s[i] & 0xFF;
    while (c != 0) {
        if (c == 10) {
            cx = x;
            cy = cy + font.glyph_h();
        } else {
            draw_char(cx, cy, c, fg, bg);
            cx = cx + font.glyph_w();
        }
        i++;
        c = (i32)s[i] & 0xFF;
    }
}

/**
 * Draws an 8x8 bitmap glyph magnified by integer `scale`.
 * @param x Screen X coordinate.
 * @param y Screen Y coordinate.
 * @param ch ASCII character code.
 * @param fg Foreground color.
 * @param bg Background color.
 * @param scale Integer scaling factor.
 */
export void draw_char_scaled(i32 x, i32 y, i32 ch, i32 fg, i32 bg, i32 scale) {
    if (scale < 1) { scale = 1; }
    if (bg != fg) {
        fill_rect(x, y, 8 * scale, 8 * scale, bg);
    }
    i32 row = 0;
    while (row < 8) {
        i32 bits = font.glyph_row(ch, row);
        i32 col = 0;
        while (col < 8) {
            i32 mask = 128 >> col;
            if (bits & mask) {
                fill_rect(x + col * scale, y + row * scale, scale, scale, fg);
            }
            col++;
        }
        row++;
    }
}

/**
 * Draws a string with the 8x8 font magnified by integer `scale`.
 * @param x Origin X coordinate.
 * @param y Origin Y coordinate.
 * @param s String to draw.
 * @param fg Foreground color.
 * @param bg Background color.
 * @param scale Scaling factor.
 */
export void draw_text_scaled(i32 x, i32 y, char* s, i32 fg, i32 bg, i32 scale) {
    if (scale < 1) { scale = 1; }
    i32 cx = x;
    i32 cy = y;
    i32 i = 0;
    i32 c = (i32)s[i] & 0xFF;
    while (c != 0) {
        if (c == 10) {
            cx = x;
            cy = cy + 8 * scale;
        } else {
            draw_char_scaled(cx, cy, c, fg, bg, scale);
            cx = cx + 8 * scale;
        }
        i++;
        c = (i32)s[i] & 0xFF;
    }
}

/**
 * Renders a 32-bit signed integer in base-10 decimal using 8x8 bitmap font.
 * @param x Screen X coordinate.
 * @param y Screen Y coordinate.
 * @param value Integer value to display.
 * @param fg Text color.
 * @param bg Background color.
 * @return X coordinate immediately following the rendered number.
 */
export i32 draw_int(i32 x, i32 y, i32 value, i32 fg, i32 bg) {
    // str.itoa already does the sign, the zero case, and the digit-order
    // reversal (11 bytes covers "-2147483648" plus the terminator); this just
    // walks the resulting string and draws it, the same as draw_text.
    char digits[12];
    str.itoa(value, &digits[0]);

    i32 cx = x;
    i32 i = 0;
    i32 c = (i32)digits[0] & 0xFF;
    while (c != 0) {
        draw_char(cx, y, c, fg, bg);
        cx = cx + font.glyph_w();
        i++;
        c = (i32)digits[i] & 0xFF;
    }
    return cx;
}

/**
 * Blits a block of raw 32-bit pixels directly from memory to the screen.
 * @param x Destination X coordinate.
 * @param y Destination Y coordinate.
 * @param w Width in pixels.
 * @param h Height in pixels.
 * @param src Reference to row-major pixel array.
 */
export void blit(i32 x, i32 y, i32 w, i32 h, ref i32 src) {
    i32 row = 0;
    while (row < h) {
        i32 col = 0;
        while (col < w) {
            put_pixel(x + col, y + row, src[row * w + col]);
            col++;
        }
        row++;
    }
}

/**
 * Blits a block of 32-bit pixels with transparency color keying.
 * @param x Destination X coordinate.
 * @param y Destination Y coordinate.
 * @param w Width in pixels.
 * @param h Height in pixels.
 * @param src Reference to row-major pixel array.
 * @param key_color Color value treated as transparent.
 */
export void blit_key(i32 x, i32 y, i32 w, i32 h, ref i32 src, i32 key_color) {
    i32 row = 0;
    while (row < h) {
        i32 col = 0;
        while (col < w) {
            i32 px = src[row * w + col];
            if (px != key_color) {
                put_pixel(x + col, y + row, px);
            }
            col++;
        }
        row++;
    }
}
