package ui_channel;

// The UI server's inbound side of the UI protocol
// (system/MyAppFramework/src/protocol.mln): requests arrive on one kernel
// channel (MyKernel ipc.mln) from every process, each carrying the channel
// its reply goes to; serve() answers them all from the compositor's pass.
// Requests reach the channel through the OS_CALL handler
// (proc/os_calls.mln), which has already copied everything the message
// names out of the process's memory -- the words here are kernel words.

import ipc from "../../../MyKernel/src/kernel/ipc.mln";
import { UiMsg } from "../../../MyAppFramework/src/protocol.mln";
import ui_server from "ui_server.mln";
import ui_events from "ui_events.mln";

i32 g_requests = 0;   // apps -> server

export void init() {
    if (g_requests == 0) { g_requests = ipc.create(); }
    ui_events.init();
}

// Queue a request: words 0..9 a UiMsg (op, owner, a0..a5, s0, s1), word 10
// the channel to answer on. False when the ring is full.
export bool submit(i32 *words) {
    return ipc.send(g_requests, words);
}

// Answer every queued request. Runs on the UI server's task. Returns how
// many were answered.
export i32 serve() {
    i32 served = 0;
    i32 w[16];
    while (ipc.recv(g_requests, &w[0])) {
        served++;
        UiMsg m;
        m.op = w[0];
        m.owner = w[1];
        m.a0 = w[2]; m.a1 = w[3]; m.a2 = w[4]; m.a3 = w[5]; m.a4 = w[6]; m.a5 = w[7];
        m.s0 = (char*)w[8];
        m.s1 = (char*)w[9];
        i32 r[16];
        r[0] = ui_server.handle(&m);
        ipc.send(w[10], &r[0]);
    }
    return served;
}
