package ui_events;

// The server's outbound side of the UI protocol: events for applications
// (system/MyAppFramework/src/protocol.mln, UiEvent), one kernel channel
// (MyKernel ipc.mln) per process. The DOM, the widgets and the shell push
// here -- all on the UI server's task -- whenever something happens to a
// node an app owns; the process takes them with UI_POLL (proc/os_calls.mln),
// which binds the channel here on the process's first UI call.
//
// An owner is a pid. An event for an owner with no channel is dropped.

import ipc from "../../../MyKernel/src/kernel/ipc.mln";
import { UiEventKind } from "../../../MyAppFramework/src/protocol.mln";

i32 OWNERS_MAX = 16;
i32 g_owner[16];     // pid, 0 = free
i32 g_channel[16];

export void init() { }

// Events for `owner` go to `channel`.
export void bind(i32 owner, i32 channel) {
    i32 free = -1;
    i32 i = 0;
    while (i < OWNERS_MAX) {
        if (g_owner[i] == owner) { g_channel[i] = channel; return; }
        if (g_owner[i] == 0 && free < 0) { free = i; }
        i++;
    }
    if (free < 0) { return; }
    g_owner[free] = owner;
    g_channel[free] = channel;
}

i32 channel_of(i32 owner) {
    i32 i = 0;
    while (i < OWNERS_MAX) {
        if (g_owner[i] == owner) { return g_channel[i]; }
        i++;
    }
    return 0;
}

i32 g_dropped = 0;   // events lost to a full channel (an app that stopped polling)
export i32 dropped() { return g_dropped; }

// Queue an event for `owner`. A timer tick whose previous tick the app has
// not taken yet is not queued again (one pending tick per timer: a slow
// app catches up, it does not fall behind). A full channel drops the event
// and counts it.
export void push(i32 owner, i32 id, i32 kind, i32 arg, i32 token, char *text) {
    i32 ch = channel_of(owner);
    if (ch == 0) { return; }
    if (kind == UiEventKind::TIMER) {
        if (ipc.has(ch, id, kind)) { return; }
    }
    i32 w[16];
    w[0] = owner;
    w[1] = id;
    w[2] = kind;
    w[3] = arg;
    w[4] = token;
    w[5] = (i32)text;
    if (!ipc.send(ch, &w[0])) { g_dropped++; }
}
