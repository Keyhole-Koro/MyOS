package dom;

import debug from "../../../MyKernel/src/debug/debug.mln";
import heap from "../../../MyKernel/src/mm/heap.mln";
import serial from "../../../MyKernel/src/io/serial.mln";
import graphics from "graphics.mln";
import { Option } from "../../../../toolchain/MyStdLib/option.mln";
import { halt_cpu } from "../../../MyKernel/src/arch/halt.masm";

export u16 NODE_ROOT      = 0;
export u16 NODE_SYSTEM    = 1;
export u16 NODE_PROCESS   = 2;
export u16 NODE_DEVICE    = 3;
export u16 NODE_DIRECTORY = 4;
export u16 NODE_FILE      = 5;
export u16 NODE_UI        = 6;
export u16 NODE_DESKTOP   = 7;
export u16 NODE_WINDOW    = 8;
export u16 NODE_BOX       = 9;
export u16 NODE_TEXT      = 10;
export u16 NODE_BUTTON    = 11;
export u16 NODE_TIMER     = 12;
export u16 NODE_COLUMN    = 13;

// Accessibility roles (ISSUE-024). Separate from `kind`: automation locators
// query by `role` (get_by_role("button")), while `kind` is the OS-structural
// node type. UI create helpers set both. These are sequential and would suit an
// enum, but stay `export u16` globals so other packages (main.mln) can read
// them as dom.ROLE_BUTTON -- enum members do not survive cross-package linking.
export u16 ROLE_NONE    = 0;
export u16 ROLE_ROOT    = 1;
export u16 ROLE_DESKTOP = 2;
export u16 ROLE_WINDOW  = 3;
export u16 ROLE_BUTTON  = 4;
export u16 ROLE_TEXT    = 5;

// State flags, stored as a bitmask in `Node.state`. MyLang has no bool, so
// these are combined/tested with i32 bit ops (state & STATE_HOVERED). Written
// as binary literals so the bit position is obvious. Kept as `export u16`
// globals (not an enum): enum members do not survive cross-package reference
// (they mangle to p_NAME and fail to link), whereas exported globals do.
export u16 STATE_VISIBLE = 0b00001;
export u16 STATE_ENABLED = 0b00010;
export u16 STATE_HOVERED = 0b00100;
export u16 STATE_PRESSED = 0b01000;
export u16 STATE_FOCUSED = 0b10000;
// A visible node is not necessarily interactive: layout/decorative containers
// must let a hit pass through to their interactive descendants. Buttons opt in
// by default; other nodes may opt in with set_hit_testable().
export u16 STATE_HIT_TESTABLE = 0b100000;

// Measured layout: u16=2B, char*/i32=4B, pointers 4B-aligned, no trailing
// padding. Offsets: id=0 kind=2 name=4 parent=8 first_child=10 next_sibling=12
// role=14 text=16 x=20 y=22 w=24 h=26 state=28 _pad=30 on_click=32,
// background_color=36 border_color=40 padding=44 gap=46 -> sizeof=48.
// The _pad keeps on_click (i32, a function pointer) on a 4B boundary; each char*
// (name at 4, text at 16) is likewise 4B-aligned. Allocated as 48.
// Public because it is the payload type of get_node(). Mutation still goes
// through the DOM setters by convention; callers use it primarily to inspect
// a successful Option result.
export typedef struct {
    u16 id;
    u16 kind;
    char *name;
    u16 parent;
    u16 first_child;
    u16 next_sibling;
    u16 role;        // ROLE_* ; 0 = none
    char *text;      // display text / accessible name ; 0 = none
    u16 x;           // bounds (non-negative; UI nodes only, else 0)
    u16 y;
    u16 w;
    u16 h;
    u16 state;       // STATE_* bitmask
    u16 _pad;        // alignment padding so on_click sits on a 4B boundary
    i32 on_click;    // click handler function pointer (i32) ; 0 = none
    i32 background_color; // NODE_BOX fill colour (0 is valid black)
    i32 border_color;     // NODE_BOX border colour (0 is valid black)
    u16 padding;          // NODE_COLUMN inset, in pixels
    u16 gap;              // NODE_COLUMN gap between children, in pixels
} Node;

// Damage rectangle: the union of every node area that changed since the last
// render, in display coordinates. render_scene repaints only this region, so a
// hover highlight or a label rewrite costs its own rectangle instead of the
// whole screen (measured: a full repaint is ~735k guest instructions).
//
// Empty is encoded as g_damage_x1 <= g_damage_x0, which is what reset leaves.
i32 g_damage_x0 = 0;
i32 g_damage_y0 = 0;
i32 g_damage_x1 = 0;
i32 g_damage_y1 = 0;

i32 g_next_node_id = 1; // 0 is invalid/null
i32 g_root_node_id = 0;
i32 g_desktop_node_id = 0; // set in init(); UI attaches under this

// Up to 256 nodes for now to keep memory small
// TODO: grow this table and Node.id to u32 when we need more than 256 nodes.
Node *g_node_table[256];

// DOM markup uses logical 1024x768 coordinates. Scale it uniformly to the
// physical display so its proportions remain intact on larger resolutions.
// A display smaller than the base size keeps scale 1, avoiding zero-size
// controls; responsive downscaling can be added when sub-pixel layout exists.
i32 BASE_DISPLAY_WIDTH = 1024;
i32 BASE_DISPLAY_HEIGHT = 768;

export i32 ui_scale() {
    i32 sx = graphics.display_width() / BASE_DISPLAY_WIDTH;
    i32 sy = graphics.display_height() / BASE_DISPLAY_HEIGHT;
    i32 scale = sx;
    if (sy < scale) { scale = sy; }
    if (scale < 1) { scale = 1; }
    return scale;
}

i32 scale_ui(i32 value) {
    return value * ui_scale();
}

// The sole NodeId -> Node* boundary. It remains internal because MyLang's
// cross-module signature ABI cannot expose an Option of a package-private
// struct. External callers use node_exists() or the scalar DOM operations.
Option<Node*> get_node(i32 id) {
    if (id <= 0) { return None; }
    if (id >= g_next_node_id) { return None; }

    Node *node = g_node_table[id];
    if (node == 0) { return None; } // deleted slot (when remove_node lands)
    return Some(node);
}

export i32 node_exists(i32 id) {
    return case get_node(id) of {
        Some(_) -> 1;
        None -> 0;
    };
}

export i32 create_node(i32 kind, char *name) {
    if (g_next_node_id >= 256) {
        debug.println("dom panic: out of node ids");
        halt_cpu();
    }

    Node *n = (Node *)heap.alloc(48); // sizeof(Node)=48
    i32 id = g_next_node_id;
    g_next_node_id = g_next_node_id + 1;

    n->id = (u16)id;
    n->kind = (u16)kind;
    n->name = name;
    n->parent = 0;
    n->first_child = 0;
    n->next_sibling = 0;

    // UI / automation props default to empty; UI create helpers fill them in.
    n->role = ROLE_NONE;
    n->text = (char*)0;
    n->x = 0;
    n->y = 0;
    n->w = 0;
    n->h = 0;
    n->state = 0;
    n->_pad = 0;
    n->on_click = 0;
    n->background_color = 0;
    n->border_color = 0;
    n->padding = 0;
    n->gap = 0;

    g_node_table[id] = n;
    return id;
}

// --- prop accessors ---

// Update bounds without triggering layout. Column layout calls this for each
// child; keeping that operation separate avoids a child update recursively
// relaying out its parent.
void (Node* n) set_bounds_raw(i32 id, i32 x, i32 y, i32 w, i32 h) {
    // Damage the old area as well as the new one, so vacating a region repaints
    // the background that was underneath.
    damage_node(id);
    damage_rect(x, y, w, h);
    n->x = (u16)x;
    n->y = (u16)y;
    n->w = (u16)w;
    n->h = (u16)h;
}

// Text has no explicit height, but a Column still needs to reserve one font
// line for it. Other zero-height children intentionally consume no vertical
// space, which keeps structural nodes inert in a layout.
i32 (Node* n) layout_height() {
    i32 h = n->h;
    if (h != 0) { return h; }
    i32 text = NODE_TEXT;
    if (n->kind == text) { return 8 * ui_scale(); }
    return 0;
}

// Lay out direct children top-to-bottom. Child widths and heights remain their
// own props; Column owns only their x/y positions. Nested Columns are relaid
// after their origin moves so their descendants follow along as well.
void (Node* column) relayout_column() {
    i32 column_kind = NODE_COLUMN;
    if (column->kind != column_kind) { return; }

    i32 child_x = column->x + column->padding;
    i32 cursor_y = column->y + column->padding;
    i32 gap = column->gap;
    i32 child_id = column->first_child;

    while (child_id != 0) {
        case get_node(child_id) of {
            Some(raw_child) -> ({
                Node *child = (Node*)raw_child;
                i32 child_h = child.layout_height();
                child.set_bounds_raw(child_id, child_x, cursor_y,
                               child->w, child->h);

                i32 child_kind = child->kind;
                if (child_kind == column_kind) {
                    child.relayout_column();
                }

                cursor_y = cursor_y + child_h + gap;
                child_id = child->next_sibling;
            });
            // A broken sibling link must terminate traversal, not become a
            // null dereference. Normal trees never take this arm.
            None -> ({ child_id = 0; });
        };
    }
}

export void set_bounds(i32 id, i32 x, i32 y, i32 w, i32 h) {
    case get_node(id) of {
        Some(raw_node) -> ({
            Node *n = (Node*)raw_node;
            n.set_bounds_raw(id, x, y, w, h);

            // Moving/resizing a Column moves its direct children. Changing a
            // child size inside a Column reflows the following siblings.
            n.relayout_column();
            case get_node(n->parent) of {
                Some(raw_parent) -> ({
                    Node *parent = (Node*)raw_parent;
                    parent.relayout_column();
                });
                None -> 0;
            };
        });
        None -> 0;
    };
}

i32 text_width(char *text) {
    i32 len = 0;
    if (text != 0) {
        while (text[len] != 0) { len = len + 1; }
    }
    return len * 8 * ui_scale();
}

export void set_text(i32 id, char *text) {
    case get_node(id) of {
        Some(raw_node) -> ({
            Node *n = (Node*)raw_node;
            damage_node(id);   // old string's extent
            n->text = text;
            // Text used to retain a 0x0 node box and infer its extent only
            // while invalidating. Keep its physical bounds instead: damage,
            // clipping, layout, and hit testing then all agree after UI scale
            // has been applied.
            n->w = (u16)text_width(text);
            n->h = (u16)(8 * ui_scale());
            damage_node(id);   // new string may be longer
        });
        None -> 0;
    };
}

export void set_role(i32 id, i32 role) {
    case get_node(id) of {
        Some(raw_node) -> ({
            Node *n = (Node*)raw_node;
            n->role = (u16)role;
        });
        None -> 0;
    };
}

// Colours are fixed per Box for now. They are raw graphics.rgb() values, so
// callers can use the same colour construction API as the renderer.
export void set_colors(i32 id, i32 background, i32 border) {
    case get_node(id) of {
        Some(raw_node) -> ({
            Node *n = (Node*)raw_node;
            damage_node(id);
            n->background_color = background;
            n->border_color = border;
        });
        None -> 0;
    };
}

// Set the inset and inter-child gap of a Column, then immediately recompute
// its children so changing these props is observable without rebuilding it.
export void set_column_layout(i32 id, i32 padding, i32 gap) {
    case get_node(id) of {
        Some(raw_node) -> ({
            Node *n = (Node*)raw_node;
            n->padding = (u16)padding;
            n->gap = (u16)gap;
            n.relayout_column();
        });
        None -> 0;
    };
}

// True if changing `flag` on this node changes how it looks. Only buttons draw
// differently when hovered or pressed (see draw_node), so flagging a window or
// a label as hovered must not damage its area -- the pointer crossing a window
// would otherwise repaint the whole window for no visible difference.
i32 (Node* n) state_is_visible(i32 flag) {
    i32 kind = n->kind;
    i32 kb = NODE_BUTTON;
    i32 hovered = STATE_HOVERED;
    i32 pressed = STATE_PRESSED;
    i32 hit_testable = STATE_HIT_TESTABLE;
    if (flag == hovered) {
        if (kind == kb) { return 1; }
        return 0;
    }
    if (flag == pressed) {
        if (kind == kb) { return 1; }
        return 0;
    }
    if (flag == hit_testable) { return 0; }
    return 1; // visibility and everything else always matter
}

// Set (on != 0) or clear (on == 0) one STATE_* bit.
export void set_state_flag(i32 id, i32 flag, i32 on) {
    case get_node(id) of {
        Some(raw_node) -> ({
            Node *n = (Node*)raw_node;
            i32 state = n->state;
            i32 next = state & (~flag);
            if (on != 0) { next = state | flag; }
            // Only damage when the bit actually changes: the compositor sets
            // hovered/pressed every pass, and repainting on a no-op change would
            // defeat the whole point.
            if (next != state) {
                n->state = (u16)next;
                if (n.state_is_visible(flag) != 0) {
                    damage_node(id);
                }
            }
        });
        None -> 0;
    };
}

// Return 1 if the given STATE_* bit is set, else 0.
export i32 get_state_flag(i32 id, i32 flag) {
    return case get_node(id) of {
        Some(raw_node) -> ({
            Node *n = (Node*)raw_node;
            case (n->state & flag) of { 0 -> 0; _ -> 1; };
        });
        None -> 0;
    };
}

// Named state setters. Other packages can't pass dom.STATE_* as an argument (an
// `export u16` global doesn't resolve as a cross-package symbol), so these expose
// the common flags by name. `on` is 0 to clear, non-zero to set.
export void set_hovered(i32 id, i32 on) {
    set_state_flag(id, STATE_HOVERED, on);
}

export void set_pressed(i32 id, i32 on) {
    set_state_flag(id, STATE_PRESSED, on);
}

export void set_visible(i32 id, i32 on) {
    set_state_flag(id, STATE_VISIBLE, on);
}

export void set_hit_testable(i32 id, i32 on) {
    set_state_flag(id, STATE_HIT_TESTABLE, on);
}

// Store a click handler (a function pointer, passed as i32) on a node. The
// handler is invoked by dispatch_click via an indirect call. 0 clears it.
export void set_on_click(i32 id, i32 handler) {
    case get_node(id) of {
        Some(raw_node) -> ({
            Node *n = (Node*)raw_node;
            n->on_click = handler;
            set_hit_testable(id, handler != 0);
        });
        None -> 0;
    };
}

// Return the click handler stored on a node, or 0 if none.
export i32 get_on_click(i32 id) {
    return case get_node(id) of {
        Some(raw_node) -> ({
            Node *n = (Node*)raw_node;
            n->on_click;
        });
        None -> 0;
    };
}

// Invoke a node's click handler, if any. The handler is called as handler(id)
// through an indirect call. Returns 1 if a handler ran, else 0.
export i32 dispatch_click(i32 id) {
    i32 handler = get_on_click(id);
    if (handler != 0) {
        handler(id);
        return 1;
    }
    return 0;
}

export void append_child(i32 parent_id, i32 child_id) {
    damage_node(child_id);
    case get_node(parent_id) of {
        Some(raw_parent) -> ({
            Node *parent = (Node*)raw_parent;
            case get_node(child_id) of {
            Some(raw_child) -> ({
                Node *child = (Node*)raw_child;
                child->parent = (u16)parent_id;
                child->next_sibling = 0;

                if (parent->first_child == 0) {
                    parent->first_child = (u16)child_id;
                } else {
                    i32 current_id = parent->first_child;
                    while (current_id != 0) {
                        case get_node(current_id) of {
                            Some(raw_current) -> ({
                                Node *curr = (Node*)raw_current;
                                if (curr->next_sibling == 0) {
                                    curr->next_sibling = (u16)child_id;
                                    current_id = 0;
                                } else {
                                    current_id = curr->next_sibling;
                                }
                            });
                            None -> ({ current_id = 0; });
                        };
                    }
                }

                // A Column controls the positions of its direct children. This
                // runs after linking so the new child participates immediately.
                parent.relayout_column();
            });
            None -> 0;
        };
        });
        None -> 0;
    };
}

// --- UI node create helpers ---
// Each sets kind + role + bounds + text + default state (visible/enabled) in one
// call, so callers (and the MyDOMTranspiler output) don't repeat the setup.

// Return the id of the fixed desktop node created by init(); UI attaches here.
export i32 desktop_id() {
    return g_desktop_node_id;
}

// Tree navigation. Return 0 when there is no such node. Used by the renderer,
// hit-test, and callers that need to reach a built subtree's children.
export i32 first_child(i32 id) {
    return case get_node(id) of {
        Some(raw_node) -> ({
            Node *n = (Node*)raw_node;
            n->first_child;
        });
        None -> 0;
    };
}

export i32 next_sibling(i32 id) {
    return case get_node(id) of {
        Some(raw_node) -> ({
            Node *n = (Node*)raw_node;
            n->next_sibling;
        });
        None -> 0;
    };
}

// Note: NODE_*/ROLE_*/STATE_* are `export u16` globals; pass them bare as
// function args. Casting them like (i32)STATE_VISIBLE makes semantic report
// `undefined identifier` (see docs/DOM_SPEC.md), so no casts here.
export i32 create_window(char *title, i32 x, i32 y, i32 w, i32 h) {
    i32 id = create_node(NODE_WINDOW, title);
    set_role(id, ROLE_WINDOW);
    set_bounds(id, scale_ui(x), scale_ui(y), scale_ui(w), scale_ui(h));
    set_text(id, title);
    set_state_flag(id, STATE_VISIBLE, 1);
    set_state_flag(id, STATE_ENABLED, 1);
    return id;
}

export i32 create_button(char *label, i32 x, i32 y, i32 w, i32 h) {
    i32 id = create_node(NODE_BUTTON, label);
    set_role(id, ROLE_BUTTON);
    set_bounds(id, scale_ui(x), scale_ui(y), scale_ui(w), scale_ui(h));
    set_text(id, label);
    set_state_flag(id, STATE_VISIBLE, 1);
    set_state_flag(id, STATE_ENABLED, 1);
    set_state_flag(id, STATE_HIT_TESTABLE, 1);
    return id;
}

export i32 create_text(char *text, i32 x, i32 y) {
    i32 id = create_node(NODE_TEXT, text);
    set_role(id, ROLE_TEXT);
    set_bounds(id, scale_ui(x), scale_ui(y), 0, 0);
    set_text(id, text);
    set_state_flag(id, STATE_VISIBLE, 1);
    return id;
}

// A Box is a visual grouping primitive. It has no accessibility role and is
// not hit-testable by default, so decoration never obscures a Button within it.
export i32 create_box(i32 x, i32 y, i32 w, i32 h,
                      i32 background, i32 border) {
    i32 id = create_node(NODE_BOX, "box");
    set_bounds(id, scale_ui(x), scale_ui(y), scale_ui(w), scale_ui(h));
    set_colors(id, background, border);
    set_state_flag(id, STATE_VISIBLE, 1);
    return id;
}

// A Column is a visible-to-the-renderer layout container: it draws nothing of
// its own, but visibility gates all descendants. When a child is appended its
// x/y are recomputed from this origin, padding, and the preceding child sizes.
export i32 create_column(i32 x, i32 y, i32 w, i32 h,
                         i32 padding, i32 gap) {
    i32 id = create_node(NODE_COLUMN, "column");
    set_bounds(id, scale_ui(x), scale_ui(y), scale_ui(w), scale_ui(h));
    set_column_layout(id, scale_ui(padding), scale_ui(gap));
    set_state_flag(id, STATE_VISIBLE, 1);
    return id;
}

// ---------------------------------------------------------------------------
// DOM syntax elements.
//
// `<Window title="A" x={0} y={0} w={1} h={1}/>` in a .dom.mln source lowers to
// a call to the function of the same name, with each property handed to the
// parameter of the same name, and children passed to append_child. The element
// vocabulary therefore lives here rather than in the compiler: adding an
// element means adding a function, and its parameters are its properties.
// ---------------------------------------------------------------------------

export i32 Window(char *title, i32 x, i32 y, i32 w, i32 h) {
    return create_window(title, x, y, w, h);
}

export i32 Button(char *text, i32 x, i32 y, i32 w, i32 h, i32 onClick) {
    i32 id = create_button(text, x, y, w, h);
    set_on_click(id, onClick);
    return id;
}

export i32 Text(char *text, i32 x, i32 y) {
    return create_text(text, x, y);
}

export i32 Box(i32 x, i32 y, i32 w, i32 h,
               i32 background, i32 border) {
    return create_box(x, y, w, h, background, border);
}

export i32 Column(i32 x, i32 y, i32 w, i32 h,
                  i32 padding, i32 gap) {
    return create_column(x, y, w, h, padding, gap);
}

void print_indent(i32 depth) {
    i32 i = 0;
    while (i < depth) {
        debug.print("  ");
        i = i + 1;
    }
}

// Print "[role=R x=.. y=.. w=.. h=.. vis en ht ho pr fo]" for nodes that carry
// UI props. Structural nodes (role=0, no bounds) print nothing extra.
void (Node* n) dump_props() {
    i32 role = n->role;
    i32 w = n->w;
    i32 h = n->h;
    i32 state = n->state;
    // Nothing interesting to show for plain structural nodes.
    if (role == 0) {
        if (w == 0) {
            if (h == 0) {
                if (state == 0) { return; }
            }
        }
    }
    debug.printf(" [role=%i x=%i y=%i w=%i h=%i",
                 role, n->x, n->y, w, h);
    if ((state & STATE_VISIBLE) != 0) { debug.print(" vis"); }
    if ((state & STATE_ENABLED) != 0) { debug.print(" en"); }
    if ((state & STATE_HOVERED) != 0) { debug.print(" ho"); }
    if ((state & STATE_PRESSED) != 0) { debug.print(" pr"); }
    if ((state & STATE_FOCUSED) != 0) { debug.print(" fo"); }
    if ((state & STATE_HIT_TESTABLE) != 0) { debug.print(" ht"); }
    debug.print("]");
}

void dump_node(i32 node_id, i32 depth) {
    case get_node(node_id) of {
        Some(raw_node) -> ({
            Node *n = (Node*)raw_node;
            print_indent(depth);
            debug.printf("Node(id=%i, kind=%i) ", n->id, n->kind);
            if (n->name != 0) {
                debug.print((char*)n->name);
            } else {
                debug.print("?");
            }
            n.dump_props();
            debug.println("");

            i32 child_id = n->first_child;
            while (child_id != 0) {
                dump_node(child_id, depth + 1);
                child_id = next_sibling(child_id);
            }
        });
        None -> 0;
    };
}

export void dump() {
    debug.println("--- Kernel Object Tree ---");
    dump_node(g_root_node_id, 0);
    debug.println("--------------------------");
}

// --- machine-readable snapshot (MYOS-004 UI automation) ---
// dump()/dump_node() above are for humans reading the serial log; this section
// mirrors them but emits one JSON object per node (JSON Lines), stable enough
// for a host-side client (qa/mydomtester) to parse into a locator tree.

// role is compared as a local i32 copy: comparing an i32 against a `u16`
// export global directly (role == ROLE_BUTTON) miscompiles to always-false,
// same pitfall noted on draw_node above.
char* role_name(i32 role) {
    i32 r_root = ROLE_ROOT;
    i32 r_desktop = ROLE_DESKTOP;
    i32 r_window = ROLE_WINDOW;
    i32 r_button = ROLE_BUTTON;
    i32 r_text = ROLE_TEXT;
    if (role == r_root) { return "root"; }
    if (role == r_desktop) { return "desktop"; }
    if (role == r_window) { return "window"; }
    if (role == r_button) { return "button"; }
    if (role == r_text) { return "text"; }
    return "none";
}

// Emit one char, escaping the handful of bytes that would break JSON string
// syntax. UI text in this codebase is plain ASCII labels, so this does not
// attempt full JSON/unicode escaping -- just enough to stay well-formed.
void putc_json_escaped(i32 c) {
    if (c == '"') { serial.putc('\\'); serial.putc('"'); return; }
    if (c == '\\') { serial.putc('\\'); serial.putc('\\'); return; }
    if (c == '\n') { serial.putc('\\'); serial.putc('n'); return; }
    serial.putc(c);
}

void print_json_string(char* s) {
    serial.putc('"');
    if (s) {
        i32 i = 0;
        while (s[i] != 0) {
            putc_json_escaped(s[i]);
            i = i + 1;
        }
    }
    serial.putc('"');
}

void print_json_bool(i32 v) {
    if (v != 0) {
        debug.print("true");
    } else {
        debug.print("false");
    }
}

void dump_node_json(i32 node_id) {
    case get_node(node_id) of {
        Some(raw_node) -> ({
            Node *n = (Node*)raw_node;
            i32 state = n->state;
            i32 visible = 0;
            if ((state & STATE_VISIBLE) != 0) { visible = 1; }
            i32 enabled = 0;
            if ((state & STATE_ENABLED) != 0) { enabled = 1; }
            i32 hovered = 0;
            if ((state & STATE_HOVERED) != 0) { hovered = 1; }
            i32 pressed = 0;
            if ((state & STATE_PRESSED) != 0) { pressed = 1; }
            i32 focused = 0;
            if ((state & STATE_FOCUSED) != 0) { focused = 1; }
            i32 hit_testable = 0;
            if ((state & STATE_HIT_TESTABLE) != 0) { hit_testable = 1; }

            debug.print("{\"id\":");
            debug.printf("%i", n->id);
            debug.print(",\"parent\":");
            debug.printf("%i", n->parent);
            debug.print(",\"kind\":");
            debug.printf("%i", n->kind);
            debug.print(",\"role\":");
            print_json_string(role_name(n->role));
            debug.print(",\"name\":");
            print_json_string((char*)n->name);
            debug.print(",\"text\":");
            print_json_string((char*)n->text);
            debug.print(",\"x\":");
            debug.printf("%i", n->x);
            debug.print(",\"y\":");
            debug.printf("%i", n->y);
            debug.print(",\"w\":");
            debug.printf("%i", n->w);
            debug.print(",\"h\":");
            debug.printf("%i", n->h);
            debug.print(",\"visible\":");
            print_json_bool(visible);
            debug.print(",\"enabled\":");
            print_json_bool(enabled);
            debug.print(",\"hovered\":");
            print_json_bool(hovered);
            debug.print(",\"pressed\":");
            print_json_bool(pressed);
            debug.print(",\"focused\":");
            print_json_bool(focused);
            debug.print(",\"hitTestable\":");
            print_json_bool(hit_testable);
            debug.println("}");

            i32 child_id = n->first_child;
            while (child_id != 0) {
                dump_node_json(child_id);
                child_id = next_sibling(child_id);
            }
        });
        None -> 0;
    };
}

// Print the whole tree as JSON Lines, bracketed by markers a host-side reader
// can scan for on the serial stream (mixed in with ordinary debug output).
export void dump_json() {
    debug.println("---DOM-SNAPSHOT-BEGIN---");
    dump_node_json(g_root_node_id);
    debug.println("---DOM-SNAPSHOT-END---");
}

// --- renderer ---
// Walk the UI subtree and paint each node with graphics.*. The renderer and a
// window manager are one for now: z-order is sibling order (later siblings on
// top), and hover/pressed looks come from the node's state bitmask. graphics.mln
// is untouched; this only reads node props and calls its draw primitives.

void (Node* n) draw_node() {
    i32 kind = n->kind;
    i32 x = n->x;
    i32 y = n->y;
    i32 w = n->w;
    i32 h = n->h;
    i32 state = n->state;
    i32 scale = ui_scale();

    i32 black = graphics.rgb(0, 0, 0);
    i32 white = graphics.rgb(255, 255, 255);

    // Copy the NODE_* u16 globals into i32 locals before comparing. Comparing an
    // i32 against a `u16` global directly (kind == NODE_WINDOW) miscompiles and is
    // always false, even when both hold the same value; the local coerces cleanly.
    i32 kw = NODE_WINDOW;
    i32 kbox = NODE_BOX;
    i32 kb = NODE_BUTTON;
    i32 kt = NODE_TEXT;
    i32 pressed = STATE_PRESSED;
    i32 hovered = STATE_HOVERED;

    if (kind == kbox) {
        graphics.fill_rect(x, y, w, h, n->background_color);
        graphics.draw_rect_scaled(x, y, w, h, n->border_color, scale);
    } else if (kind == kw) {
        graphics.fill_rect(x, y, w, h, white);
        graphics.draw_rect_scaled(x, y, w, h, graphics.rgb(136, 136, 136), scale);
        if (n->text != 0) {
            graphics.draw_text_scaled(x + 20 * scale, y + 8 * scale, (char*)n->text, black, white, scale);
        }
    } else if (kind == kb) {
        i32 face = graphics.rgb(204, 204, 204);
        if ((state & pressed) != 0) {
            face = graphics.rgb(150, 150, 150);
        } else if ((state & hovered) != 0) {
            face = graphics.rgb(180, 210, 255);
        }
        graphics.fill_rect(x, y, w, h, face);
        graphics.draw_rect_scaled(x, y, w, h, black, scale);
        if (n->text != 0) {
            graphics.draw_text_scaled(x + 12 * scale, y + 8 * scale, (char*)n->text, black, face, scale);
        }
    } else if (kind == kt) {
        if (n->text != 0) {
            graphics.draw_text_scaled(x, y, (char*)n->text, black, white, scale);
        }
    }
    // Structural nodes (root/system/process/...) draw nothing.
}

// Render node_id and its descendants. Skips invisible subtrees. Sibling order is
// paint order, so later children appear on top.
// True if a node's own area overlaps the damage region. Nodes that do not are
// skipped without drawing: the clip rectangle would discard their pixels
// anyway, but only after paying for the glyph and fill work that produced
// them, which is the cost partial repaint exists to avoid.
i32 (Node* n) node_in_damage() {
    if (g_damage_x1 <= g_damage_x0) { return 1; } // no region: draw everything

    i32 w = n->w;
    i32 h = n->h;
    if (w == 0) {
        i32 len = 0;
        if (n->text != 0) {
            char *t = (char*)n->text;
            while (t[len] != 0) { len = len + 1; }
        }
        w = len * 8 * ui_scale();
        h = 8 * ui_scale();
    }
    i32 x0 = n->x;
    i32 y0 = n->y;
    if (x0 + w <= g_damage_x0) { return 0; }
    if (y0 + h <= g_damage_y0) { return 0; }
    if (x0 >= g_damage_x1) { return 0; }
    if (y0 >= g_damage_y1) { return 0; }
    return 1;
}

export void render(i32 node_id) {
    case get_node(node_id) of {
        Some(raw_node) -> ({
            Node *n = (Node*)raw_node;
            if ((n->state & STATE_VISIBLE) == 0) { return; }

            // Children are visited regardless: a child can overlap the damage region
            // even when its parent does not.
            if (n.node_in_damage() != 0) {
                n.draw_node();
            }

            i32 child_id = n->first_child;
            while (child_id != 0) {
                render(child_id);
                child_id = next_sibling(child_id);
            }
        });
        None -> 0;
    };
}

// Repaint the whole UI: clear the desktop, render each top-level window under it,
// then flip the frame to the display. The desktop node is a structural container
// with no STATE_VISIBLE, so we render its children directly rather than gating on
// the desktop's own visibility. Geometry comes from graphics' functions, which
// use the shared display configuration read by the emulator at build time.
// Draw the scene into the back buffer WITHOUT flipping it to the display. Use
// this when the caller wants to overlay something (e.g. the mouse cursor) before
// presenting. Call present() yourself afterwards.
// Add a rectangle to the damage region. Clipped to the display, so callers can
// pass node bounds without worrying about off-screen nodes.
export void damage_rect(i32 x, i32 y, i32 w, i32 h) {
    i32 display_width = graphics.display_width();
    i32 display_height = graphics.display_height();
    i32 x0 = x;
    i32 y0 = y;
    i32 x1 = x + w;
    i32 y1 = y + h;

    if (x0 < 0) { x0 = 0; }
    if (y0 < 0) { y0 = 0; }
    if (x1 > display_width) { x1 = display_width; }
    if (y1 > display_height) { y1 = display_height; }
    if (x1 <= x0) { return; }
    if (y1 <= y0) { return; }

    if (g_damage_x1 <= g_damage_x0) {
        // Region was empty: this rectangle becomes it.
        g_damage_x0 = x0;
        g_damage_y0 = y0;
        g_damage_x1 = x1;
        g_damage_y1 = y1;
        return;
    }
    if (x0 < g_damage_x0) { g_damage_x0 = x0; }
    if (y0 < g_damage_y0) { g_damage_y0 = y0; }
    if (x1 > g_damage_x1) { g_damage_x1 = x1; }
    if (y1 > g_damage_y1) { g_damage_y1 = y1; }
}

// Mark a node's own area as needing repaint. Text nodes carry no width/height
// of their own, so they damage a line-height band wide enough for their string.
export void damage_node(i32 id) {
    case get_node(id) of {
        Some(raw_node) -> ({
            Node *n = (Node*)raw_node;
            i32 w = n->w;
            i32 h = n->h;
            if (w == 0) {
                // Text: 8x8 glyphs, so the band is 8 tall and 8 per character wide.
                i32 len = 0;
                if (n->text != 0) {
                    char *t = (char*)n->text;
                    while (t[len] != 0) { len = len + 1; }
                }
                w = len * 8 * ui_scale();
                h = 8 * ui_scale();
            }
            damage_rect(n->x, n->y, w, h);
        });
        None -> 0;
    };
}

export i32 has_damage() {
    if (g_damage_x1 > g_damage_x0) { return 1; }
    return 0;
}

export void clear_damage() {
    g_damage_x0 = 0;
    g_damage_y0 = 0;
    g_damage_x1 = 0;
    g_damage_y1 = 0;
}

// Repaint every node, ignoring the damage region. Used for the first frame and
// whenever a caller wants an unconditional repaint.
export void render_all() {
    graphics.fill_rect(0, 0, graphics.display_width(), graphics.display_height(), graphics.rgb(30, 30, 40));
    i32 child_id = first_child(g_desktop_node_id);
    while (child_id != 0) {
        render(child_id);
        child_id = next_sibling(child_id);
    }
    clear_damage();
}

// Repaint just the damaged region: clear it to the desktop colour, then redraw
// every node that overlaps it. Nodes outside the region are skipped entirely,
// which is where the saving comes from -- a hover highlight redraws one button,
// not all 786432 pixels. Falls back to a full repaint when nothing is marked,
// so a caller that never damages anything still gets a correct frame.
export void render_scene() {
    if (g_damage_x1 <= g_damage_x0) {
        render_all();
        return;
    }

    i32 dx = g_damage_x0;
    i32 dy = g_damage_y0;
    i32 dw = g_damage_x1 - g_damage_x0;
    i32 dh = g_damage_y1 - g_damage_y0;

    graphics.set_clip(dx, dy, dw, dh);
    graphics.fill_rect(dx, dy, dw, dh, graphics.rgb(30, 30, 40));

    i32 child_id = first_child(g_desktop_node_id);
    while (child_id != 0) {
        render(child_id);
        child_id = next_sibling(child_id);
    }

    graphics.clear_clip();
    clear_damage();
}

export void render_desktop() {
    render_scene();
    graphics.present();
}

// --- hit-test ---
// True if (px, py) is inside a node's bounds. Nodes with zero size never hit.
i32 (Node* n) node_contains(i32 px, i32 py) {
    i32 x = n->x;
    i32 y = n->y;
    i32 w = n->w;
    i32 h = n->h;
    if (w == 0) { return 0; }
    if (h == 0) { return 0; }
    if (px < x) { return 0; }
    if (py < y) { return 0; }
    if (px >= x + w) { return 0; }
    if (py >= y + h) { return 0; }
    return 1;
}

// Return the id of the topmost visible node in node_id's subtree whose bounds
// contain (px, py), or 0 if none. Later siblings are on top (paint order), so we
// scan children last-to-topmost by taking the deepest/last hit.
i32 hit_test(i32 node_id, i32 px, i32 py) {
    return case get_node(node_id) of {
        Some(raw_node) -> ({
            Node *n = (Node*)raw_node;
            if ((n->state & STATE_VISIBLE) == 0) { return 0; }

            i32 found = 0;
            if (n.node_contains(px, py) != 0) {
                if ((n->state & STATE_HIT_TESTABLE) != 0) {
                    found = node_id;
                }
            }

            // A child that also contains the point wins over the parent, and a later
            // child wins over an earlier one (it paints on top).
            i32 child_id = n->first_child;
            while (child_id != 0) {
                i32 child_hit = hit_test(child_id, px, py);
                if (child_hit != 0) {
                    found = child_hit;
                }
                child_id = next_sibling(child_id);
            }
            found;
        });
        None -> 0;
    };
}

// Return the topmost UI node under (x, y), searching the whole desktop. 0 if none.
export i32 find_at(i32 x, i32 y) {
    i32 child_id = first_child(g_desktop_node_id);
    i32 found = 0;
    while (child_id != 0) {
        i32 hit = hit_test(child_id, x, y);
        if (hit != 0) {
            found = hit;
        }
        child_id = next_sibling(child_id);
    }
    return found;
}

export void init() {
    graphics.init();
    i32 root = create_node(NODE_ROOT, "root");
    g_root_node_id = root;

    i32 sys = create_node(NODE_SYSTEM, "system");
    append_child(root, sys);

    i32 proc = create_node(NODE_PROCESS, "process");
    append_child(sys, proc);

    i32 dev = create_node(NODE_DEVICE, "device");
    append_child(sys, dev);

    i32 fs_node = create_node(NODE_DIRECTORY, "fs");
    append_child(dev, fs_node);

    i32 ui = create_node(NODE_UI, "ui");
    append_child(sys, ui);
    
    i32 desktop = create_node(NODE_DESKTOP, "desktop");
    append_child(ui, desktop);
    g_desktop_node_id = desktop;
}
