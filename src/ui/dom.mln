package dom;

import debug from "../../../MyKernel/src/debug/debug.mln";
import heap from "../../../MyKernel/src/mm/heap.mln";
import serial from "../../../MyKernel/src/io/serial.mln";
import scheduler from "../../../MyKernel/src/kernel/scheduler.mln";
import automation_io from "../io/automation_io.mln";
import graphics from "graphics.mln";
import theme from "theme.mln";
import { Option } from "../../../../toolchain/MyStdLib/option.mln";
import { halt_cpu } from "../../../MyKernel/src/arch/halt.masm";

// Kernel object tree + UI DOM. See docs/DOM_SPEC.md and MYOS-014.
//
// One tree holds both the OS object model (root/system/process/device/ui)
// and the UI: windows and their controls hang under ui/desktop. UI nodes
// carry bounds in *absolute display pixels*; the create_* helpers take
// logical 1024x768 coordinates, scale them, and append_child then offsets a
// child by its parent's content origin, so app code writes positions
// relative to the window it is building. Sibling order is paint order and
// z-order (later on top); bring_to_front re-links a window to the end.

// --- node kinds --------------------------------------------------------------
export u16 NODE_ROOT      = 0;
export u16 NODE_SYSTEM    = 1;
export u16 NODE_PROCESS   = 2;
export u16 NODE_DEVICE    = 3;
export u16 NODE_DIRECTORY = 4;
export u16 NODE_FILE      = 5;
export u16 NODE_UI        = 6;
export u16 NODE_DESKTOP   = 7;
export u16 NODE_WINDOW    = 8;
export u16 NODE_BOX       = 9;
export u16 NODE_TEXT      = 10;
export u16 NODE_BUTTON    = 11;
export u16 NODE_TIMER     = 12;
export u16 NODE_COLUMN    = 13;
export u16 NODE_ROW       = 14;
export u16 NODE_TEXT_INPUT = 15;
export u16 NODE_CHECKBOX  = 16;
export u16 NODE_SEPARATOR = 17;
export u16 NODE_PANEL     = 18;
export u16 NODE_TASKBAR   = 19;

// --- accessibility roles (MYOS-004 automation locators) ------------------------
export u16 ROLE_NONE      = 0;
export u16 ROLE_ROOT      = 1;
export u16 ROLE_DESKTOP   = 2;
export u16 ROLE_WINDOW    = 3;
export u16 ROLE_BUTTON    = 4;
export u16 ROLE_TEXT      = 5;
export u16 ROLE_TEXTBOX   = 6;
export u16 ROLE_CHECKBOX  = 7;
export u16 ROLE_TOOLBAR   = 8;
export u16 ROLE_SEPARATOR = 9;

// --- state bitmask -------------------------------------------------------------
export u16 STATE_VISIBLE      = 0b0000001;
export u16 STATE_ENABLED      = 0b0000010;
export u16 STATE_HOVERED      = 0b0000100;
export u16 STATE_PRESSED      = 0b0001000;
export u16 STATE_FOCUSED      = 0b0010000; // keyboard focus, or the active window
export u16 STATE_HIT_TESTABLE = 0b0100000; // find_at may return this node
export u16 STATE_CHECKED      = 0b1000000; // Checkbox

// --- style bits (Node.style) -----------------------------------------------------
export u16 STYLE_BOLD    = 1; // Text: heavier face
export u16 STYLE_PRIMARY = 2; // Button: accent-coloured call to action
export u16 STYLE_CENTER  = 4; // Text: centre within w when w > 0

// Node layout (offsets, bytes; measured u16=2B, pointers 4B-aligned, no tail
// padding): id=0 kind=2 name=4 parent=8 first_child=10 next_sibling=12 role=14
// text=16 x=20 y=22 w=24 h=26 state=28 style=30 on_click=32
// background_color=36 border_color=40 padding=44 gap=46 color=48 on_key=52
// on_change=56 cap=60 len=62 cursor=64 radius=66 on_tick=68 interval=72
// next_due=76 test_id=80 -> sizeof = 84. Allocated as 84.
//
// Public because it is the payload type of get_node(). Mutation still goes
// through the DOM setters by convention.
export typedef struct {
    u16 id;
    u16 kind;
    char *name;
    u16 parent;
    u16 first_child;
    u16 next_sibling;
    u16 role;        // ROLE_* ; 0 = none
    char *text;      // display text / accessible name ; 0 = none
    u16 x;           // bounds in display pixels (UI nodes only, else 0)
    u16 y;
    u16 w;
    u16 h;
    u16 state;       // STATE_* bitmask
    u16 style;       // STYLE_* bitmask
    i32 on_click;    // click handler(id) ; 0 = none
    i32 background_color; // NODE_BOX fill colour (0 is valid black)
    i32 border_color;     // NODE_BOX border colour
    u16 padding;          // NODE_COLUMN/ROW inset, in display pixels
    u16 gap;              // NODE_COLUMN/ROW gap between children, in display pixels
    i32 color;            // foreground/text colour ; 0 = theme default
    i32 on_key;           // key handler(id, code, mods) for DOWN events ; 0 = default
    i32 on_change;        // change handler(id): TextInput edits, Checkbox toggles
    u16 cap;              // TextInput: buffer capacity in bytes (incl. NUL)
    u16 len;              // TextInput: current text length
    u16 cursor;           // TextInput: caret position (0..len)
    u16 radius;           // Panel corner radius, display pixels
    i32 on_tick;          // Timer handler(id)
    i32 interval;         // Timer period in scheduler ticks
    i32 next_due;         // Timer: tick at which it next fires
    char *test_id;        // stable automation identity; 0 = none
} Node;

i32 NODE_SIZE = 84;

// Damage rectangles: the areas that changed since the last render, in
// display coordinates. render_scene repaints each one under a clip. Keeping
// several instead of one union matters because the taskbar spans the full
// width at the bottom: one rect for it plus one for a window near the top
// would otherwise union into nearly the whole screen. When the list is
// full, new areas merge into the first entry.
i32 DAMAGE_MAX = 8;
i32 g_damage_x0[8];
i32 g_damage_y0[8];
i32 g_damage_x1[8];
i32 g_damage_y1[8];
i32 g_damage_count = 0;

// The rect render_scene is currently repainting, so node_in_damage can test
// against just that one; g_painting_all short-circuits it for full paints.
i32 g_paint_x0 = 0;
i32 g_paint_y0 = 0;
i32 g_paint_x1 = 0;
i32 g_paint_y1 = 0;
i32 g_painting_all = 1;

i32 g_next_node_id = 1; // 0 is invalid/null
i32 g_revision = 0;     // increments on externally observable DOM mutation
i32 g_root_node_id = 0;
i32 g_desktop_node_id = 0; // set in init(); UI attaches under this
i32 g_taskbar_id = 0;      // the desktop's taskbar node, drawn above windows
i32 g_timers_node_id = 0;  // structural parent for Timer nodes

i32 g_active_window = 0;   // window with STATE_FOCUSED (front-most, gets keys)
i32 g_focus_id = 0;        // node with keyboard focus (a TextInput), or 0
i32 g_launcher = 0;        // handler() for the taskbar's launcher button

// Up to 256 nodes for now to keep memory small
// TODO: grow this table and Node.id to u32 when we need more than 256 nodes.
Node *g_node_table[256];

// Registered timers (ids), scanned by tick().
i32 TIMER_MAX = 16;
i32 g_timer_ids[16];
i32 g_timer_count = 0;

// Scratch rectangle for helpers that hand back a rect (no multiple returns).
i32 g_ext_x = 0;
i32 g_ext_y = 0;
i32 g_ext_w = 0;
i32 g_ext_h = 0;

// Formatted uptime clock for the taskbar.
char g_clock_buf[16];

void touch() { g_revision = g_revision + 1; }
export i32 revision() { return g_revision; }

// DOM markup uses logical 1024x768 coordinates. Scale it uniformly to the
// physical display so its proportions remain intact on larger resolutions.
// A display smaller than the base size keeps scale 1, avoiding zero-size
// controls; responsive downscaling can be added when sub-pixel layout exists.
i32 BASE_DISPLAY_WIDTH = 1024;
i32 BASE_DISPLAY_HEIGHT = 768;

export i32 ui_scale() {
    i32 sx = graphics.display_width() / BASE_DISPLAY_WIDTH;
    i32 sy = graphics.display_height() / BASE_DISPLAY_HEIGHT;
    i32 scale = sx;
    if (sy < scale) { scale = sy; }
    if (scale < 1) { scale = 1; }
    return scale;
}

i32 scale_ui(i32 value) {
    return value * ui_scale();
}

// Raw NodeId -> Node* boundary; 0 for an invalid or deleted id.
Node* node_ptr(i32 id) {
    if (id <= 0) { return (Node*)0; }
    if (id >= g_next_node_id) { return (Node*)0; }
    return g_node_table[id];
}

// The sole Option-returning boundary. It remains internal because MyLang's
// cross-module signature ABI cannot expose an Option of a package-private
// struct. External callers use node_exists() or the scalar DOM operations.
Option<Node*> get_node(i32 id) {
    Node *node = node_ptr(id);
    if (node == 0) { return None; }
    return Some(node);
}

export bool node_exists(i32 id) {
    return node_ptr(id) != 0;
}

export i32 create_node(i32 kind, char *name) {
    if (g_next_node_id >= 256) {
        debug.println("dom panic: out of node ids");
        halt_cpu();
    }

    Node *n = (Node *)heap.alloc(NODE_SIZE);
    i32 id = g_next_node_id;
    g_next_node_id = g_next_node_id + 1;

    n->id = (u16)id;
    n->kind = (u16)kind;
    n->name = name;
    n->parent = 0;
    n->first_child = 0;
    n->next_sibling = 0;

    n->role = ROLE_NONE;
    n->text = (char*)0;
    n->x = 0;
    n->y = 0;
    n->w = 0;
    n->h = 0;
    n->state = 0;
    n->style = 0;
    n->on_click = 0;
    n->background_color = 0;
    n->border_color = 0;
    n->padding = 0;
    n->gap = 0;
    n->color = 0;
    n->on_key = 0;
    n->on_change = 0;
    n->cap = 0;
    n->len = 0;
    n->cursor = 0;
    n->radius = 0;
    n->on_tick = 0;
    n->interval = 0;
    n->next_due = 0;
    n->test_id = (char*)0;

    g_node_table[id] = n;
    touch();
    return id;
}

// --- scalar queries -------------------------------------------------------------

export i32 kind_of(i32 id) {
    Node *n = node_ptr(id);
    if (n == 0) { return 0 - 1; }
    return n->kind;
}

export i32 parent_of(i32 id) {
    Node *n = node_ptr(id);
    if (n == 0) { return 0; }
    return n->parent;
}

export i32 node_x(i32 id) { Node *n = node_ptr(id); if (n == 0) { return 0; } return n->x; }
export i32 node_y(i32 id) { Node *n = node_ptr(id); if (n == 0) { return 0; } return n->y; }
export i32 node_w(i32 id) { Node *n = node_ptr(id); if (n == 0) { return 0; } return n->w; }
export i32 node_h(i32 id) { Node *n = node_ptr(id); if (n == 0) { return 0; } return n->h; }

export char* text_of(i32 id) {
    Node *n = node_ptr(id);
    if (n == 0) { return (char*)0; }
    return (char*)n->text;
}

// --- damage -------------------------------------------------------------------------

// True if [ax0,ax1)x[ay0,ay1) and [bx0,bx1)x[by0,by1) overlap or touch.
i32 rects_touch(i32 ax0, i32 ay0, i32 ax1, i32 ay1, i32 bx0, i32 by0, i32 bx1, i32 by1) {
    if (ax1 < bx0) { return 0; }
    if (bx1 < ax0) { return 0; }
    if (ay1 < by0) { return 0; }
    if (by1 < ay0) { return 0; }
    return 1;
}

void damage_union_into(i32 i, i32 x0, i32 y0, i32 x1, i32 y1) {
    if (x0 < g_damage_x0[i]) { g_damage_x0[i] = x0; }
    if (y0 < g_damage_y0[i]) { g_damage_y0[i] = y0; }
    if (x1 > g_damage_x1[i]) { g_damage_x1[i] = x1; }
    if (y1 > g_damage_y1[i]) { g_damage_y1[i] = y1; }
}

// Add a rectangle to the damage list. Clipped to the display, so callers can
// pass node bounds without worrying about off-screen nodes. A rectangle
// that overlaps an existing entry is merged into it; otherwise it gets its
// own entry while there is room.
export void damage_rect(i32 x, i32 y, i32 w, i32 h) {
    i32 display_width = graphics.display_width();
    i32 display_height = graphics.display_height();
    i32 x0 = x;
    i32 y0 = y;
    i32 x1 = x + w;
    i32 y1 = y + h;

    if (x0 < 0) { x0 = 0; }
    if (y0 < 0) { y0 = 0; }
    if (x1 > display_width) { x1 = display_width; }
    if (y1 > display_height) { y1 = display_height; }
    if (x1 <= x0) { return; }
    if (y1 <= y0) { return; }

    i32 i = 0;
    while (i < g_damage_count) {
        if (rects_touch(x0, y0, x1, y1, g_damage_x0[i], g_damage_y0[i], g_damage_x1[i], g_damage_y1[i]) != 0) {
            damage_union_into(i, x0, y0, x1, y1);
            return;
        }
        i = i + 1;
    }
    if (g_damage_count < DAMAGE_MAX) {
        g_damage_x0[g_damage_count] = x0;
        g_damage_y0[g_damage_count] = y0;
        g_damage_x1[g_damage_count] = x1;
        g_damage_y1[g_damage_count] = y1;
        g_damage_count = g_damage_count + 1;
        return;
    }
    damage_union_into(0, x0, y0, x1, y1);
}

// The area a node paints, which for a window includes its drop shadow. The
// result lands in g_ext_*.
void node_extent(Node *n) {
    i32 x = n->x;
    i32 y = n->y;
    i32 w = n->w;
    i32 h = n->h;
    i32 kw = NODE_WINDOW;
    if (n->kind == kw) {
        i32 s = ui_scale();
        i32 size = theme.shadow_size() * s;
        i32 off = theme.shadow_offset() * s;
        x = x - size;
        y = y - size;
        w = w + 2 * size;
        h = h + 2 * size + off;
    }
    g_ext_x = x;
    g_ext_y = y;
    g_ext_w = w;
    g_ext_h = h;
}

// Mark a node's own area as needing repaint.
export void damage_node(i32 id) {
    Node *n = node_ptr(id);
    if (n == 0) { return; }
    node_extent(n);
    damage_rect(g_ext_x, g_ext_y, g_ext_w, g_ext_h);
}

export i32 has_damage() {
    if (g_damage_count > 0) { return 1; }
    return 0;
}

export void clear_damage() {
    g_damage_count = 0;
}

// --- text metrics ---------------------------------------------------------------------

i32 text_bold(Node *n) {
    i32 st = n->style;
    i32 b = STYLE_BOLD;
    if ((st & b) != 0) { return 1; }
    return 0;
}

i32 text_width_of(Node *n) {
    if (n->text == 0) { return 0; }
    i32 bold = text_bold(n);
    i32 s = ui_scale();
    return graphics.text_width((char*)n->text, bold, s);
}

i32 text_height_of(Node *n) {
    i32 bold = text_bold(n);
    i32 s = ui_scale();
    return graphics.text_height(bold, s);
}

// --- layout ---------------------------------------------------------------------------------

// Move a subtree by (dx, dy) without damage bookkeeping (callers damage).
void offset_subtree(i32 id, i32 dx, i32 dy) {
    Node *n = node_ptr(id);
    if (n == 0) { return; }
    n->x = (u16)(n->x + dx);
    n->y = (u16)(n->y + dy);
    i32 child_id = n->first_child;
    while (child_id != 0) {
        offset_subtree(child_id, dx, dy);
        Node *c = node_ptr(child_id);
        if (c == 0) { child_id = 0; } else { child_id = c->next_sibling; }
    }
}

// Move a child (and its subtree) so its top-left is at (x, y).
void place_child(i32 child_id, i32 x, i32 y) {
    Node *child = node_ptr(child_id);
    if (child == 0) { return; }
    i32 dx = x - child->x;
    i32 dy = y - child->y;
    if (dx == 0) {
        if (dy == 0) { return; }
    }
    damage_node(child_id);
    offset_subtree(child_id, dx, dy);
    damage_node(child_id);
}

// Lay out direct children top-to-bottom. Child widths and heights remain their
// own props; Column owns only their x/y positions. Nested containers are
// relaid after their origin moves so their descendants follow along as well.
// A zero-height child consumes no vertical space, which keeps structural
// nodes inert in a layout (Text carries its measured height).
void relayout_container(Node *n);

void relayout_column(Node *column) {
    i32 child_x = column->x + column->padding;
    i32 cursor_y = column->y + column->padding;
    i32 gap = column->gap;
    i32 child_id = column->first_child;

    while (child_id != 0) {
        Node *child = node_ptr(child_id);
        if (child == 0) { child_id = 0; }
        else {
            i32 child_h = child->h;
            place_child(child_id, child_x, cursor_y);
            relayout_container(child);
            cursor_y = cursor_y + child_h + gap;
            child_id = child->next_sibling;
        }
    }
}

// Lay out direct children left-to-right, top-aligned.
void relayout_row(Node *row) {
    i32 cursor_x = row->x + row->padding;
    i32 child_y = row->y + row->padding;
    i32 gap = row->gap;
    i32 child_id = row->first_child;

    while (child_id != 0) {
        Node *child = node_ptr(child_id);
        if (child == 0) { child_id = 0; }
        else {
            i32 child_w = child->w;
            place_child(child_id, cursor_x, child_y);
            relayout_container(child);
            cursor_x = cursor_x + child_w + gap;
            child_id = child->next_sibling;
        }
    }
}

void relayout_container(Node *n) {
    i32 kc = NODE_COLUMN;
    i32 kr = NODE_ROW;
    i32 k = n->kind;
    if (k == kc) { relayout_column(n); }
    if (k == kr) { relayout_row(n); }
}

// --- prop accessors ---------------------------------------------------------------------

// Set absolute bounds. Moving/resizing a container moves its direct
// children; changing a child's size inside one reflows the following siblings.
export void set_bounds(i32 id, i32 x, i32 y, i32 w, i32 h) {
    Node *n = node_ptr(id);
    if (n == 0) { return; }
    // Damage the old area as well as the new one, so vacating a region repaints
    // the background that was underneath.
    damage_node(id);
    n->x = (u16)x;
    n->y = (u16)y;
    n->w = (u16)w;
    n->h = (u16)h;
    damage_node(id);
    relayout_container(n);
    Node *parent = node_ptr(n->parent);
    if (parent != 0) { relayout_container(parent); }
    touch();
}

// Translate a node and everything under it, keeping damage in sync. This is
// what dragging a window calls.
export void move_node(i32 id, i32 dx, i32 dy) {
    Node *n = node_ptr(id);
    if (n == 0) { return; }
    damage_node(id);
    offset_subtree(id, dx, dy);
    damage_node(id);
    touch();
}

export void set_text(i32 id, char *text) {
    Node *n = node_ptr(id);
    if (n == 0) { return; }
    damage_node(id);   // old string's extent
    n->text = text;
    // Text keeps physical bounds equal to its measured size so damage,
    // clipping, layout, and hit testing all agree. Windows and buttons also
    // have text, but their authored layout bounds must never be replaced by
    // caption size.
    i32 kt = NODE_TEXT;
    if (n->kind == kt) {
        n->w = (u16)text_width_of(n);
        n->h = (u16)text_height_of(n);
        Node *parent = node_ptr(n->parent);
        if (parent != 0) { relayout_container(parent); }
    }
    damage_node(id);   // new string may be longer
    touch();
}

export void set_role(i32 id, i32 role) {
    Node *n = node_ptr(id);
    if (n == 0) { return; }
    n->role = (u16)role;
    touch();
}

// Stable, non-user-facing identity for a locator. Do not derive this from
// visible text, because labels may be localized or change as state updates.
export void set_test_id(i32 id, char *test_id) {
    Node *n = node_ptr(id);
    if (n == 0) { return; }
    n->test_id = test_id;
    touch();
}

// Box colours: raw graphics.rgb() values, the same construction API as the
// renderer's.
export void set_colors(i32 id, i32 background, i32 border) {
    Node *n = node_ptr(id);
    if (n == 0) { return; }
    damage_node(id);
    n->background_color = background;
    n->border_color = border;
}

// Foreground/text colour. 0 restores the theme default.
export void set_color(i32 id, i32 color) {
    Node *n = node_ptr(id);
    if (n == 0) { return; }
    n->color = color;
    damage_node(id);
}

export void set_style(i32 id, i32 style) {
    Node *n = node_ptr(id);
    if (n == 0) { return; }
    n->style = (u16)style;
    i32 kt = NODE_TEXT;
    if (n->kind == kt) {
        n->w = (u16)text_width_of(n);
        n->h = (u16)text_height_of(n);
    }
    damage_node(id);
}

// Set the inset and inter-child gap of a Column/Row, then immediately
// recompute its children so changing these props is observable.
export void set_column_layout(i32 id, i32 padding, i32 gap) {
    Node *n = node_ptr(id);
    if (n == 0) { return; }
    n->padding = (u16)padding;
    n->gap = (u16)gap;
    relayout_container(n);
}

// True if changing `flag` on this node changes how it looks. Only controls
// draw differently when hovered or pressed, so flagging a label as hovered
// must not damage its area; windows repaint when focus changes (title bar).
i32 state_is_visible(Node *n, i32 flag) {
    i32 kind = n->kind;
    i32 kb = NODE_BUTTON;
    i32 kc = NODE_CHECKBOX;
    i32 ki = NODE_TEXT_INPUT;
    i32 kw = NODE_WINDOW;
    i32 hovered = STATE_HOVERED;
    i32 pressed = STATE_PRESSED;
    i32 focused = STATE_FOCUSED;
    i32 hit_testable = STATE_HIT_TESTABLE;
    if (flag == hovered) {
        if (kind == kb) { return 1; }
        if (kind == kc) { return 1; }
        if (kind == kw) { return 1; } // close button highlight
        return 0;
    }
    if (flag == pressed) {
        if (kind == kb) { return 1; }
        if (kind == kc) { return 1; }
        return 0;
    }
    if (flag == focused) {
        if (kind == ki) { return 1; }
        if (kind == kw) { return 1; }
        return 0;
    }
    if (flag == hit_testable) { return 0; }
    return 1; // visibility, checked and everything else always matter
}

// Set (on != 0) or clear (on == 0) one STATE_* bit.
export void set_state_flag(i32 id, i32 flag, i32 on) {
    Node *n = node_ptr(id);
    if (n == 0) { return; }
    i32 state = n->state;
    i32 next = state & (~flag);
    if (on != 0) { next = state | flag; }
    // Only damage when the bit actually changes: the compositor sets
    // hovered/pressed every pass, and repainting on a no-op change would
    // defeat the whole point.
    if (next != state) {
        n->state = (u16)next;
        if (state_is_visible(n, flag) != 0) {
            damage_node(id);
        }
        touch();
    }
}

// Return 1 if the given STATE_* bit is set, else 0.
export i32 get_state_flag(i32 id, i32 flag) {
    Node *n = node_ptr(id);
    if (n == 0) { return 0; }
    i32 state = n->state;
    if ((state & flag) != 0) { return 1; }
    return 0;
}

// Named state setters. Other packages can't pass dom.STATE_* as an argument (an
// `export u16` global doesn't resolve as a cross-package symbol), so these expose
// the common flags by name. `on` is 0 to clear, non-zero to set.
export void set_hovered(i32 id, i32 on) { set_state_flag(id, STATE_HOVERED, on); }
export void set_pressed(i32 id, i32 on) { set_state_flag(id, STATE_PRESSED, on); }
export void set_visible(i32 id, i32 on) { set_state_flag(id, STATE_VISIBLE, on); }
export void set_hit_testable(i32 id, i32 on) { set_state_flag(id, STATE_HIT_TESTABLE, on); }
export void set_checked(i32 id, i32 on) { set_state_flag(id, STATE_CHECKED, on); }
export i32 is_checked(i32 id) { return get_state_flag(id, STATE_CHECKED); }
export i32 is_visible(i32 id) { return get_state_flag(id, STATE_VISIBLE); }

// Store a click handler (a function pointer, passed as i32) on a node. The
// handler is invoked by dispatch_click via an indirect call. 0 clears it.
export void set_on_click(i32 id, i32 handler) {
    Node *n = node_ptr(id);
    if (n == 0) { return; }
    n->on_click = handler;
    set_hit_testable(id, handler != 0);
}

export i32 get_on_click(i32 id) {
    Node *n = node_ptr(id);
    if (n == 0) { return 0; }
    return n->on_click;
}

export void set_on_key(i32 id, i32 handler) {
    Node *n = node_ptr(id);
    if (n == 0) { return; }
    n->on_key = handler;
}

export void set_on_change(i32 id, i32 handler) {
    Node *n = node_ptr(id);
    if (n == 0) { return; }
    n->on_change = handler;
}

void fire_change(Node *n) {
    i32 handler = n->on_change;
    if (handler != 0) {
        i32 id = n->id;
        handler(id);
    }
}

// Invoke a node's click handler, if any. Checkboxes toggle first, so the
// handler observes the new state. Returns 1 if a handler ran, else 0.
export i32 dispatch_click(i32 id) {
    Node *n = node_ptr(id);
    if (n == 0) { return 0; }
    i32 kc = NODE_CHECKBOX;
    if (n->kind == kc) {
        i32 checked = STATE_CHECKED;
        i32 now = n->state & checked;
        set_state_flag(id, STATE_CHECKED, now == 0);
        fire_change(n);
    }
    i32 handler = n->on_click;
    if (handler != 0) {
        handler(id);
        return 1;
    }
    return 0;
}

// --- tree structure -----------------------------------------------------------------------

// Where a parent's children are positioned from: a window's content area
// starts below its title bar, everything else at its own origin. Result in
// g_ext_x / g_ext_y.
void content_origin(Node *parent) {
    g_ext_x = parent->x;
    g_ext_y = parent->y;
    i32 kw = NODE_WINDOW;
    if (parent->kind == kw) {
        g_ext_y = g_ext_y + theme.titlebar_h() * ui_scale();
    }
}

export void append_child(i32 parent_id, i32 child_id) {
    Node *parent = node_ptr(parent_id);
    Node *child = node_ptr(child_id);
    if (parent == 0) { return; }
    if (child == 0) { return; }

    child->parent = (u16)parent_id;
    child->next_sibling = 0;

    if (parent->first_child == 0) {
        parent->first_child = (u16)child_id;
    } else {
        i32 current_id = parent->first_child;
        while (current_id != 0) {
            Node *curr = node_ptr(current_id);
            if (curr == 0) { current_id = 0; }
            else if (curr->next_sibling == 0) {
                curr->next_sibling = (u16)child_id;
                current_id = 0;
            } else {
                current_id = curr->next_sibling;
            }
        }
    }

    // Authored coordinates are relative to the parent's content origin;
    // stored coordinates are absolute, so shift the whole subtree once.
    content_origin(parent);
    offset_subtree(child_id, g_ext_x, g_ext_y);
    damage_node(child_id);

    // A Column/Row controls the positions of its direct children. This runs
    // after linking so the new child participates immediately.
    relayout_container(parent);
    touch();
}

// Unlink a node from its parent's child list (no damage, no free).
void unlink(Node *n) {
    Node *parent = node_ptr(n->parent);
    if (parent == 0) { return; }
    i32 id = n->id;
    if (parent->first_child == id) {
        parent->first_child = n->next_sibling;
    } else {
        i32 cur = parent->first_child;
        while (cur != 0) {
            Node *c = node_ptr(cur);
            if (c == 0) { cur = 0; }
            else if (c->next_sibling == id) {
                c->next_sibling = n->next_sibling;
                cur = 0;
            } else {
                cur = c->next_sibling;
            }
        }
    }
    n->next_sibling = 0;
}

// Re-link a node as the last child of its parent: last is painted last, so
// this raises it above its siblings.
export void bring_to_front(i32 id) {
    Node *n = node_ptr(id);
    if (n == 0) { return; }
    Node *parent = node_ptr(n->parent);
    if (parent == 0) { return; }
    if (n->next_sibling == 0) { return; } // already last
    unlink(n);
    // Re-append without re-translating: coordinates are already absolute.
    i32 last_id = parent->first_child;
    if (last_id == 0) {
        parent->first_child = (u16)id;
    } else {
        Node *last = node_ptr(last_id);
        while (last->next_sibling != 0) {
            last = node_ptr(last->next_sibling);
        }
        last->next_sibling = (u16)id;
    }
    damage_node(id);
    touch();
}

void free_subtree(i32 id) {
    Node *n = node_ptr(id);
    if (n == 0) { return; }
    i32 child_id = n->first_child;
    while (child_id != 0) {
        Node *c = node_ptr(child_id);
        i32 next = 0;
        if (c != 0) { next = c->next_sibling; }
        free_subtree(child_id);
        child_id = next;
    }
    if (g_focus_id == id) { g_focus_id = 0; }
    if (g_active_window == id) { g_active_window = 0; }
    // Drop it from the timer list.
    i32 i = 0;
    while (i < g_timer_count) {
        if (g_timer_ids[i] == id) {
            g_timer_ids[i] = g_timer_ids[g_timer_count - 1];
            g_timer_count = g_timer_count - 1;
        } else {
            i = i + 1;
        }
    }
    i32 ki = NODE_TEXT_INPUT;
    if (n->kind == ki) {
        if (n->text != 0) { heap.free((i32)n->text); }
    }
    g_node_table[id] = (Node*)0;
    heap.free((i32)n);
}

// Delete a node and its subtree: unlink from the parent, invalidate the slot
// (ids are never reused), free the memory, and drop any focus it held.
export void remove_node(i32 id) {
    Node *n = node_ptr(id);
    if (n == 0) { return; }
    damage_node(id);
    unlink(n);
    free_subtree(id);
    touch();
}

// Return the id of the fixed desktop node created by init(); UI attaches here.
export i32 desktop_id() {
    return g_desktop_node_id;
}

export i32 taskbar_id() {
    return g_taskbar_id;
}

// Tree navigation. Return 0 when there is no such node.
export i32 first_child(i32 id) {
    Node *n = node_ptr(id);
    if (n == 0) { return 0; }
    return n->first_child;
}

export i32 next_sibling(i32 id) {
    Node *n = node_ptr(id);
    if (n == 0) { return 0; }
    return n->next_sibling;
}

// The window containing a node (or the node itself if it is a window); 0 if
// it is not inside one.
export i32 window_of(i32 id) {
    i32 kw = NODE_WINDOW;
    i32 cur = id;
    while (cur != 0) {
        Node *n = node_ptr(cur);
        if (n == 0) { return 0; }
        if (n->kind == kw) { return cur; }
        cur = n->parent;
    }
    return 0;
}

// --- focus / window management -----------------------------------------------------------

export i32 active_window() {
    return g_active_window;
}

export i32 focused_node() {
    return g_focus_id;
}

// Keyboard focus. Only one node holds it; 0 clears it.
export void set_focus(i32 id) {
    if (id == g_focus_id) { return; }
    if (g_focus_id != 0) { set_state_flag(g_focus_id, STATE_FOCUSED, 0); }
    g_focus_id = 0;
    Node *n = node_ptr(id);
    if (n == 0) { return; }
    g_focus_id = id;
    set_state_flag(id, STATE_FOCUSED, 1);
}

// Make a window the active one: it comes to the front, gets the focused
// title bar look, and keyboard focus leaves any control outside it.
export void focus_window(i32 win) {
    Node *n = node_ptr(win);
    if (n == 0) { return; }
    i32 kw = NODE_WINDOW;
    if (n->kind != kw) { return; }
    if (g_active_window != win) {
        if (g_active_window != 0) { set_state_flag(g_active_window, STATE_FOCUSED, 0); }
        g_active_window = win;
        set_state_flag(win, STATE_FOCUSED, 1);
        if (window_of(g_focus_id) != win) { set_focus(0); }
        damage_node(g_taskbar_id); // the active entry's highlight moved
    }
    bring_to_front(win);
}

// After a window goes away, activate the top-most remaining one.
void activate_topmost() {
    i32 kw = NODE_WINDOW;
    i32 top = 0;
    i32 child_id = first_child(g_desktop_node_id);
    while (child_id != 0) {
        Node *c = node_ptr(child_id);
        if (c == 0) { child_id = 0; }
        else {
            if (c->kind == kw) { top = child_id; }
            child_id = c->next_sibling;
        }
    }
    if (top != 0) { focus_window(top); }
    damage_node(g_taskbar_id);
}

export void close_window(i32 win) {
    remove_node(win);
    activate_topmost();
}

// Chrome geometry, in display pixels. The close button is a disc at the left
// of the title bar; the whole bar (minus the button) is the drag handle.
i32 close_button_cx(Node *w) {
    i32 s = ui_scale();
    return w->x + 16 * s;
}

i32 close_button_cy(Node *w) {
    i32 s = ui_scale();
    i32 tb = theme.titlebar_h() * s;
    return w->y + tb / 2;
}

i32 close_button_r() {
    return 7 * ui_scale();
}

// True if (px, py) is on the window's close button.
export i32 close_button_hit(i32 win, i32 px, i32 py) {
    Node *w = node_ptr(win);
    if (w == 0) { return 0; }
    i32 dx = px - close_button_cx(w);
    i32 dy = py - close_button_cy(w);
    i32 r = close_button_r() + 3 * ui_scale(); // a little slack
    if (dx * dx + dy * dy <= r * r) { return 1; }
    return 0;
}

// True if (px, py) is in the window's title bar (excluding the close button).
export i32 titlebar_hit(i32 win, i32 px, i32 py) {
    Node *w = node_ptr(win);
    if (w == 0) { return 0; }
    if (close_button_hit(win, px, py) != 0) { return 0; }
    i32 tb = theme.titlebar_h() * ui_scale();
    if (px < w->x) { return 0; }
    if (px >= w->x + w->w) { return 0; }
    if (py < w->y) { return 0; }
    if (py >= w->y + tb) { return 0; }
    return 1;
}

// --- keyboard --------------------------------------------------------------------------------

i32 KEY_BACKSPACE = 8;
i32 KEY_ENTER = 13;
i32 KEY_DELETE = 127;
i32 KEY_LEFT = 0x101;
i32 KEY_RIGHT = 0x102;
i32 KEY_HOME = 0x105;
i32 KEY_END = 0x106;
i32 EVT_DOWN = 1;
i32 EVT_CHAR = 3;

void input_insert(Node *n, i32 c) {
    i32 len = n->len;
    i32 cap = n->cap;
    if (len + 1 >= cap) { return; }
    char *buf = (char*)n->text;
    i32 cur = n->cursor;
    i32 i = len;
    while (i > cur) {
        buf[i] = buf[i - 1];
        i = i - 1;
    }
    buf[cur] = (char)c;
    buf[len + 1] = (char)0;
    n->len = (u16)(len + 1);
    n->cursor = (u16)(cur + 1);
}

void input_delete_at(Node *n, i32 at) {
    i32 len = n->len;
    if (at < 0) { return; }
    if (at >= len) { return; }
    char *buf = (char*)n->text;
    i32 i = at;
    while (i < len - 1) {
        buf[i] = buf[i + 1];
        i = i + 1;
    }
    buf[len - 1] = (char)0;
    n->len = (u16)(len - 1);
}

// Default editing behaviour of a TextInput. Returns 1 if the text changed,
// 2 if only the caret moved, 0 if nothing happened.
i32 input_handle(Node *n, i32 type, i32 code) {
    i32 cur = n->cursor;
    i32 len = n->len;
    if (type == EVT_CHAR) {
        if (code >= 0x20) {
            if (code <= 0x7E) {
                input_insert(n, code);
                return 1;
            }
        }
        return 0;
    }
    if (type != EVT_DOWN) { return 0; }
    if (code == KEY_BACKSPACE) {
        if (cur > 0) {
            input_delete_at(n, cur - 1);
            n->cursor = (u16)(cur - 1);
            return 1;
        }
        return 0;
    }
    if (code == KEY_DELETE) {
        if (cur < len) { input_delete_at(n, cur); return 1; }
        return 0;
    }
    if (code == KEY_LEFT) {
        if (cur > 0) { n->cursor = (u16)(cur - 1); }
        return 2;
    }
    if (code == KEY_RIGHT) {
        if (cur < len) { n->cursor = (u16)(cur + 1); }
        return 2;
    }
    if (code == KEY_HOME) { n->cursor = 0; return 2; }
    if (code == KEY_END) { n->cursor = (u16)len; return 2; }
    return 0;
}

// Route one keyboard event (type = keyboard.EVT_*, code = key code or
// character) to the focused node. A node's on_key handler, if set, sees DOWN
// events first and can claim them by returning non-zero; otherwise text
// inputs get their default editing behaviour.
export void dispatch_key_event(i32 type, i32 code, i32 mods) {
    Node *n = node_ptr(g_focus_id);
    if (n == 0) { return; }
    i32 id = g_focus_id;
    if (type == EVT_DOWN) {
        i32 handler = n->on_key;
        if (handler != 0) {
            i32 claimed = handler(id, code, mods);
            if (claimed != 0) { return; }
        }
    }
    i32 ki = NODE_TEXT_INPUT;
    if (n->kind == ki) {
        i32 r = input_handle(n, type, code);
        if (r != 0) { damage_node(id); }
        if (r == 1) { fire_change(n); }
    }
}

// Replace a TextInput's contents (truncated to its capacity).
export void set_input_text(i32 id, char *s) {
    Node *n = node_ptr(id);
    if (n == 0) { return; }
    i32 ki = NODE_TEXT_INPUT;
    if (n->kind != ki) { return; }
    char *buf = (char*)n->text;
    i32 cap = n->cap;
    i32 i = 0;
    while (s[i] != 0) {
        if (i + 1 >= cap) { break; }
        buf[i] = s[i];
        i = i + 1;
    }
    buf[i] = (char)0;
    n->len = (u16)i;
    n->cursor = (u16)i;
    damage_node(id);
}

// --- timers --------------------------------------------------------------------------------------

// Fire every registered timer whose period has elapsed. The compositor calls
// this once per pass; handlers run on the compositor task.
export void tick() {
    i32 now = scheduler.ticks();
    i32 i = 0;
    while (i < g_timer_count) {
        i32 id = g_timer_ids[i];
        Node *t = node_ptr(id);
        if (t != 0) {
            if (now >= t->next_due) {
                t->next_due = now + t->interval;
                i32 handler = t->on_tick;
                if (handler != 0) { handler(id); }
            }
        }
        i = i + 1;
    }
}

export i32 create_timer(i32 interval, i32 handler) {
    i32 id = create_node(NODE_TIMER, "timer");
    Node *t = node_ptr(id);
    t->interval = interval;
    t->on_tick = handler;
    t->next_due = scheduler.ticks() + interval;
    if (g_timer_count < TIMER_MAX) {
        g_timer_ids[g_timer_count] = id;
        g_timer_count = g_timer_count + 1;
    }
    return id;
}

// --- UI node create helpers ------------------------------------------------------------------
// Each sets kind + role + bounds + text + default state (visible/enabled) in one
// call. Coordinates are logical (1024x768) and relative to the parent the node
// is later appended to.

// Note: NODE_*/ROLE_*/STATE_* are `export u16` globals; pass them bare as
// function args. Casting them like (i32)STATE_VISIBLE makes semantic report
// `undefined identifier` (see docs/DOM_SPEC.md), so no casts here.
export i32 create_window(char *title, i32 x, i32 y, i32 w, i32 h) {
    i32 id = create_node(NODE_WINDOW, title);
    set_role(id, ROLE_WINDOW);
    set_bounds(id, scale_ui(x), scale_ui(y), scale_ui(w), scale_ui(h));
    set_text(id, title);
    set_state_flag(id, STATE_VISIBLE, 1);
    set_state_flag(id, STATE_ENABLED, 1);
    set_state_flag(id, STATE_HIT_TESTABLE, 1); // body clicks focus the window
    return id;
}

export i32 create_button(char *label, i32 x, i32 y, i32 w, i32 h) {
    i32 id = create_node(NODE_BUTTON, label);
    set_role(id, ROLE_BUTTON);
    set_bounds(id, scale_ui(x), scale_ui(y), scale_ui(w), scale_ui(h));
    set_text(id, label);
    set_state_flag(id, STATE_VISIBLE, 1);
    set_state_flag(id, STATE_ENABLED, 1);
    set_state_flag(id, STATE_HIT_TESTABLE, 1);
    return id;
}

export i32 create_text(char *text, i32 x, i32 y) {
    i32 id = create_node(NODE_TEXT, text);
    set_role(id, ROLE_TEXT);
    set_bounds(id, scale_ui(x), scale_ui(y), 0, 0);
    set_text(id, text);
    set_state_flag(id, STATE_VISIBLE, 1);
    return id;
}

// A Box is a visual grouping primitive. It has no accessibility role and is
// not hit-testable by default, so decoration never obscures a Button within it.
export i32 create_box(i32 x, i32 y, i32 w, i32 h,
                      i32 background, i32 border) {
    i32 id = create_node(NODE_BOX, "box");
    set_bounds(id, scale_ui(x), scale_ui(y), scale_ui(w), scale_ui(h));
    set_colors(id, background, border);
    set_state_flag(id, STATE_VISIBLE, 1);
    return id;
}

// A Panel is a themed rounded card; its children are clipped to it.
export i32 create_panel(i32 x, i32 y, i32 w, i32 h, i32 radius) {
    i32 id = create_node(NODE_PANEL, "panel");
    set_bounds(id, scale_ui(x), scale_ui(y), scale_ui(w), scale_ui(h));
    Node *n = node_ptr(id);
    n->radius = (u16)scale_ui(radius);
    set_state_flag(id, STATE_VISIBLE, 1);
    return id;
}

// A Column is a visible-to-the-renderer layout container: it draws nothing of
// its own, but visibility gates all descendants. When a child is appended its
// x/y are recomputed from this origin, padding, and the preceding child sizes.
export i32 create_column(i32 x, i32 y, i32 w, i32 h,
                         i32 padding, i32 gap) {
    i32 id = create_node(NODE_COLUMN, "column");
    set_bounds(id, scale_ui(x), scale_ui(y), scale_ui(w), scale_ui(h));
    set_column_layout(id, scale_ui(padding), scale_ui(gap));
    set_state_flag(id, STATE_VISIBLE, 1);
    return id;
}

export i32 create_row(i32 x, i32 y, i32 w, i32 h,
                      i32 padding, i32 gap) {
    i32 id = create_node(NODE_ROW, "row");
    set_bounds(id, scale_ui(x), scale_ui(y), scale_ui(w), scale_ui(h));
    set_column_layout(id, scale_ui(padding), scale_ui(gap));
    set_state_flag(id, STATE_VISIBLE, 1);
    return id;
}

// A single-line text field. `placeholder` shows while empty; the node owns a
// heap buffer of `capacity` bytes (including the terminator).
export i32 create_text_input(char *placeholder, i32 x, i32 y, i32 w, i32 h, i32 capacity) {
    if (capacity < 2) { capacity = 2; }
    i32 id = create_node(NODE_TEXT_INPUT, placeholder);
    set_role(id, ROLE_TEXTBOX);
    set_bounds(id, scale_ui(x), scale_ui(y), scale_ui(w), scale_ui(h));
    Node *n = node_ptr(id);
    char *buf = (char*)heap.alloc(capacity);
    buf[0] = (char)0;
    n->text = buf;
    n->cap = (u16)capacity;
    n->len = 0;
    n->cursor = 0;
    set_state_flag(id, STATE_VISIBLE, 1);
    set_state_flag(id, STATE_ENABLED, 1);
    set_state_flag(id, STATE_HIT_TESTABLE, 1);
    return id;
}

export i32 create_checkbox(char *label, i32 x, i32 y, i32 checked) {
    i32 id = create_node(NODE_CHECKBOX, label);
    set_role(id, ROLE_CHECKBOX);
    i32 s = ui_scale();
    i32 box = theme.checkbox_size() * s;
    i32 tw = graphics.text_width(label, 0, s);
    i32 th = graphics.text_height(0, s);
    i32 h = box;
    if (th > h) { h = th; }
    set_bounds(id, scale_ui(x), scale_ui(y), box + 8 * s + tw, h);
    set_text(id, label);
    set_state_flag(id, STATE_VISIBLE, 1);
    set_state_flag(id, STATE_ENABLED, 1);
    set_state_flag(id, STATE_HIT_TESTABLE, 1);
    set_state_flag(id, STATE_CHECKED, checked);
    return id;
}

export i32 create_separator(i32 x, i32 y, i32 w) {
    i32 id = create_node(NODE_SEPARATOR, "separator");
    set_role(id, ROLE_SEPARATOR);
    set_bounds(id, scale_ui(x), scale_ui(y), scale_ui(w), ui_scale());
    set_state_flag(id, STATE_VISIBLE, 1);
    return id;
}

// ---------------------------------------------------------------------------
// DOM syntax elements.
//
// `<Window title="A" x={0} y={0} w={1} h={1}/>` in a .dom.mln source lowers to
// a call to the function of the same name, with each property handed to the
// parameter of the same name, and children passed to append_child. The element
// vocabulary therefore lives here rather than in the compiler: adding an
// element means adding a function, and its parameters are its properties.
// ---------------------------------------------------------------------------

export i32 Window(char *title, i32 x, i32 y, i32 w, i32 h) {
    return create_window(title, x, y, w, h);
}

export i32 Button(char *text, i32 x, i32 y, i32 w, i32 h, i32 onClick) {
    i32 id = create_button(text, x, y, w, h);
    set_on_click(id, onClick);
    return id;
}

// Accent-coloured call to action.
export i32 PrimaryButton(char *text, i32 x, i32 y, i32 w, i32 h, i32 onClick) {
    i32 id = create_button(text, x, y, w, h);
    set_on_click(id, onClick);
    set_style(id, STYLE_PRIMARY);
    return id;
}

export i32 Text(char *text, i32 x, i32 y) {
    return create_text(text, x, y);
}

// Text with an explicit colour (graphics.rgb(); 0 = theme default) and weight.
export i32 Label(char *text, i32 x, i32 y, i32 color, i32 bold) {
    i32 id = create_text(text, x, y);
    if (bold != 0) { set_style(id, STYLE_BOLD); }
    set_color(id, color);
    return id;
}

export i32 Box(i32 x, i32 y, i32 w, i32 h,
               i32 background, i32 border) {
    return create_box(x, y, w, h, background, border);
}

export i32 Panel(i32 x, i32 y, i32 w, i32 h, i32 radius) {
    return create_panel(x, y, w, h, radius);
}

export i32 Column(i32 x, i32 y, i32 w, i32 h,
                  i32 padding, i32 gap) {
    return create_column(x, y, w, h, padding, gap);
}

export i32 Row(i32 x, i32 y, i32 w, i32 h,
               i32 padding, i32 gap) {
    return create_row(x, y, w, h, padding, gap);
}

export i32 TextInput(char *placeholder, i32 x, i32 y, i32 w, i32 h, i32 capacity, i32 onChange) {
    i32 id = create_text_input(placeholder, x, y, w, h, capacity);
    set_on_change(id, onChange);
    return id;
}

export i32 Checkbox(char *text, i32 x, i32 y, i32 checked, i32 onClick) {
    i32 id = create_checkbox(text, x, y, checked);
    set_on_click(id, onClick);
    return id;
}

export i32 Separator(i32 x, i32 y, i32 w) {
    return create_separator(x, y, w);
}

export i32 Timer(i32 interval, i32 onTick) {
    return create_timer(interval, onTick);
}

// --- human-readable dump ---------------------------------------------------------------------

void print_indent(i32 depth) {
    i32 i = 0;
    while (i < depth) {
        debug.print("  ");
        i = i + 1;
    }
}

// Print "[role=R x=.. y=.. w=.. h=.. vis en ho pr fo ht ck]" for nodes that
// carry UI props. Structural nodes (role=0, no bounds) print nothing extra.
void dump_props(Node *n) {
    i32 role = n->role;
    i32 w = n->w;
    i32 h = n->h;
    i32 state = n->state;
    if (role == 0) {
        if (w == 0) {
            if (h == 0) {
                if (state == 0) { return; }
            }
        }
    }
    debug.printf(" [role=%i x=%i y=%i w=%i h=%i",
                 role, n->x, n->y, w, h);
    if ((state & STATE_VISIBLE) != 0) { debug.print(" vis"); }
    if ((state & STATE_ENABLED) != 0) { debug.print(" en"); }
    if ((state & STATE_HOVERED) != 0) { debug.print(" ho"); }
    if ((state & STATE_PRESSED) != 0) { debug.print(" pr"); }
    if ((state & STATE_FOCUSED) != 0) { debug.print(" fo"); }
    if ((state & STATE_HIT_TESTABLE) != 0) { debug.print(" ht"); }
    if ((state & STATE_CHECKED) != 0) { debug.print(" ck"); }
    debug.print("]");
}

void dump_node(i32 node_id, i32 depth) {
    Node *n = node_ptr(node_id);
    if (n == 0) { return; }
    print_indent(depth);
    debug.printf("Node(id=%i, kind=%i) ", n->id, n->kind);
    if (n->name != 0) {
        debug.print((char*)n->name);
    } else {
        debug.print("?");
    }
    dump_props(n);
    debug.println("");

    i32 child_id = n->first_child;
    while (child_id != 0) {
        dump_node(child_id, depth + 1);
        child_id = next_sibling(child_id);
    }
}

export void dump() {
    debug.println("--- Kernel Object Tree ---");
    dump_node(g_root_node_id, 0);
    debug.println("--------------------------");
}

// --- machine-readable snapshot (MYOS-004 UI automation) --------------------------------------
// Mirrors dump() but emits one JSON object per node (JSON Lines), stable
// enough for a host-side client (qa/mydomtester) to parse into a locator tree.

// role is compared as a local i32 copy: comparing an i32 against a `u16`
// export global directly (role == ROLE_BUTTON) miscompiles to always-false.
char* role_name(i32 role) {
    i32 r_root = ROLE_ROOT;
    i32 r_desktop = ROLE_DESKTOP;
    i32 r_window = ROLE_WINDOW;
    i32 r_button = ROLE_BUTTON;
    i32 r_text = ROLE_TEXT;
    i32 r_textbox = ROLE_TEXTBOX;
    i32 r_checkbox = ROLE_CHECKBOX;
    i32 r_toolbar = ROLE_TOOLBAR;
    i32 r_separator = ROLE_SEPARATOR;
    if (role == r_root) { return "root"; }
    if (role == r_desktop) { return "desktop"; }
    if (role == r_window) { return "window"; }
    if (role == r_button) { return "button"; }
    if (role == r_text) { return "text"; }
    if (role == r_textbox) { return "textbox"; }
    if (role == r_checkbox) { return "checkbox"; }
    if (role == r_toolbar) { return "toolbar"; }
    if (role == r_separator) { return "separator"; }
    return "none";
}

// Emit one char, escaping the handful of bytes that would break JSON string
// syntax. UI text in this codebase is plain ASCII labels, so this does not
// attempt full JSON/unicode escaping -- just enough to stay well-formed.
void putc_json_escaped(i32 c) {
    if (c == '"') { serial.putc('\\'); serial.putc('"'); return; }
    if (c == '\\') { serial.putc('\\'); serial.putc('\\'); return; }
    if (c == '\n') { serial.putc('\\'); serial.putc('n'); return; }
    serial.putc(c);
}

void print_json_string(char* s) {
    serial.putc('"');
    if (s) {
        i32 i = 0;
        while (s[i] != 0) {
            putc_json_escaped(s[i]);
            i = i + 1;
        }
    }
    serial.putc('"');
}

void print_json_bool(i32 v) {
    if (v != 0) {
        debug.print("true");
    } else {
        debug.print("false");
    }
}

void print_json_flag(char* key, i32 state, i32 flag) {
    debug.print(",\"");
    debug.print(key);
    debug.print("\":");
    i32 on = 0;
    if ((state & flag) != 0) { on = 1; }
    print_json_bool(on);
}

void dump_node_json(i32 node_id) {
    Node *n = node_ptr(node_id);
    if (n == 0) { return; }
    i32 state = n->state;

    debug.print("{\"id\":");
    debug.printf("%i", n->id);
    debug.print(",\"parent\":");
    debug.printf("%i", n->parent);
    debug.print(",\"kind\":");
    debug.printf("%i", n->kind);
    debug.print(",\"role\":");
    print_json_string(role_name(n->role));
    debug.print(",\"name\":");
    print_json_string((char*)n->name);
    debug.print(",\"text\":");
    print_json_string((char*)n->text);
    debug.print(",\"x\":");
    debug.printf("%i", n->x);
    debug.print(",\"y\":");
    debug.printf("%i", n->y);
    debug.print(",\"w\":");
    debug.printf("%i", n->w);
    debug.print(",\"h\":");
    debug.printf("%i", n->h);
    print_json_flag("visible", state, STATE_VISIBLE);
    print_json_flag("enabled", state, STATE_ENABLED);
    print_json_flag("hovered", state, STATE_HOVERED);
    print_json_flag("pressed", state, STATE_PRESSED);
    print_json_flag("focused", state, STATE_FOCUSED);
    print_json_flag("hitTestable", state, STATE_HIT_TESTABLE);
    print_json_flag("checked", state, STATE_CHECKED);
    debug.println("}");

    i32 child_id = n->first_child;
    while (child_id != 0) {
        dump_node_json(child_id);
        child_id = next_sibling(child_id);
    }
}

// Print the whole tree as JSON Lines, bracketed by markers a host-side reader
// can scan for on the serial stream (mixed in with ordinary debug output).
export void dump_json() {
    debug.println("---DOM-SNAPSHOT-BEGIN---");
    dump_node_json(g_root_node_id);
    debug.println("---DOM-SNAPSHOT-END---");
}

// --- automation bridge snapshot ---------------------------------------------------------------
// Unlike dump_json(), this never touches serial. The host reads the dedicated
// automation MMIO TX FIFO, so a shell prompt or another task's log line cannot
// corrupt the protocol response.

i32 g_automation_first = 1;

void automation_raw(char *s) {
    if (s == 0) { return; }
    while (*s != 0) {
        automation_io.putc(*s);
        s = s + 1;
    }
}

void automation_i32(i32 value) {
    if (value == 0) { automation_io.putc('0'); return; }
    if (value < 0) { automation_io.putc('-'); value = 0 - value; }
    char digits[12];
    i32 n = 0;
    while (value > 0) {
        digits[n] = (char)('0' + value % 10);
        value = value / 10;
        n = n + 1;
    }
    n = n - 1;
    while (n >= 0) {
        automation_io.putc(digits[n]);
        n = n - 1;
    }
}

void automation_json_string(char *s) {
    automation_io.putc('"');
    if (s != 0) {
        while (*s != 0) {
            i32 c = *s;
            if (c == '"') { automation_io.putc('\\'); automation_io.putc('"'); }
            else if (c == '\\') { automation_io.putc('\\'); automation_io.putc('\\'); }
            else if (c == '\n') { automation_io.putc('\\'); automation_io.putc('n'); }
            else { automation_io.putc(c); }
            s = s + 1;
        }
    }
    automation_io.putc('"');
}

void automation_bool(i32 value) {
    if (value != 0) { automation_raw("true"); }
    else { automation_raw("false"); }
}

void automation_state(Node *n, i32 flag) {
    automation_bool(n->state & flag);
}

void automation_node(i32 node_id) {
    Node *n = node_ptr(node_id);
    if (n == 0) { return; }
    if (g_automation_first == 0) { automation_io.putc(','); }
    g_automation_first = 0;

    automation_raw("{\"id\":"); automation_i32(n->id);
    automation_raw(",\"parent\":"); automation_i32(n->parent);
    automation_raw(",\"role\":"); automation_json_string(role_name(n->role));
    automation_raw(",\"name\":"); automation_json_string((char*)n->name);
    automation_raw(",\"text\":"); automation_json_string((char*)n->text);
    automation_raw(",\"testId\":"); automation_json_string((char*)n->test_id);
    automation_raw(",\"value\":");
    i32 textbox = ROLE_TEXTBOX;
    if (n->role == textbox) { automation_json_string((char*)n->text); }
    else { automation_json_string(""); }
    automation_raw(",\"bounds\":{\"x\":"); automation_i32(n->x);
    automation_raw(",\"y\":"); automation_i32(n->y);
    automation_raw(",\"width\":"); automation_i32(n->w);
    automation_raw(",\"height\":"); automation_i32(n->h);
    automation_raw("},\"visible\":"); automation_state(n, STATE_VISIBLE);
    automation_raw(",\"enabled\":"); automation_state(n, STATE_ENABLED);
    automation_raw(",\"focused\":"); automation_state(n, STATE_FOCUSED);
    automation_raw(",\"checked\":"); automation_state(n, STATE_CHECKED);
    automation_raw(",\"hitTestable\":"); automation_state(n, STATE_HIT_TESTABLE);
    automation_io.putc('}');

    i32 child = n->first_child;
    while (child != 0) {
        automation_node(child);
        child = next_sibling(child);
    }
}

export void write_automation_snapshot() {
    g_automation_first = 1;
    automation_raw("{\"revision\":"); automation_i32(g_revision);
    automation_raw(",\"nodes\":[");
    automation_node(g_root_node_id);
    automation_raw("]}");
}

// --- renderer ---------------------------------------------------------------------------------
// Walk the UI subtree and paint each node with graphics.*. The renderer and
// the window manager are one: z-order is sibling order (later siblings on
// top), and hover/pressed/focus looks come from the node's state bitmask.
// Colours and metrics come from theme.mln.
//
// Theme values are fetched into locals before use because a cross-package
// call nested inside another package's argument list does not resolve.

i32 node_fg(Node *n, i32 fallback) {
    i32 c = n->color;
    if (c != 0) { return c; }
    return fallback;
}

void draw_window(Node *n) {
    i32 s = ui_scale();
    i32 x = n->x;
    i32 y = n->y;
    i32 w = n->w;
    i32 h = n->h;
    i32 state = n->state;
    i32 focused_bit = STATE_FOCUSED;
    i32 hovered_bit = STATE_HOVERED;
    i32 active = state & focused_bit;
    i32 hovered = state & hovered_bit;

    i32 r = theme.window_radius() * s;
    i32 tb = theme.titlebar_h() * s;

    // Shadow first, then the body over it.
    i32 shadow = theme.shadow_size() * s;
    i32 shadow_off = theme.shadow_offset() * s;
    i32 shadow_a = theme.shadow_alpha();
    if (active == 0) { shadow_a = theme.shadow_alpha_inactive(); }
    graphics.draw_shadow(x, y, w, h, r, shadow, shadow_off, shadow_a);

    i32 bg = theme.window_bg();
    graphics.fill_round_rect(x, y, w, h, r, bg);

    // Title bar: rounded on top, squared off where it meets the content.
    i32 tb_top = theme.titlebar_top();
    i32 tb_bottom = theme.titlebar_bottom();
    if (active == 0) {
        tb_top = theme.titlebar_inactive();
        tb_bottom = tb_top;
    }
    graphics.push_clip(x, y, w, tb);
    graphics.fill_round_rect(x, y, w, tb + r, r, tb_top);
    graphics.fill_gradient_v(x + r, y, w - 2 * r, tb, tb_top, tb_bottom);
    graphics.fill_gradient_v(x, y + r, r, tb - r, tb_top, tb_bottom);
    graphics.fill_gradient_v(x + w - r, y + r, r, tb - r, tb_top, tb_bottom);
    graphics.pop_clip();
    i32 divider = theme.titlebar_divider();
    graphics.blend_rect(x, y + tb - s, w, s, divider);

    // Close button: a disc at the left of the bar.
    i32 cx = close_button_cx(n);
    i32 cy = close_button_cy(n);
    i32 cr = close_button_r();
    i32 close = theme.close_button();
    if (active == 0) { close = theme.close_button_inactive(); }
    if (hovered != 0) { close = theme.close_button_hover(); }
    graphics.fill_disc(cx, cy, cr, close);
    i32 ring = theme.close_button_ring();
    graphics.draw_round_rect(cx - cr, cy - cr, 2 * cr, 2 * cr, cr, s, ring);
    if (hovered != 0) {
        // An x glyph appears on hover.
        i32 g = theme.close_glyph();
        i32 k = cr / 2;
        graphics.draw_line(cx - k, cy - k, cx + k, cy + k, g);
        graphics.draw_line(cx + k, cy - k, cx - k, cy + k, g);
        graphics.draw_line(cx - k + 1, cy - k, cx + k + 1, cy + k, g);
        graphics.draw_line(cx + k + 1, cy - k, cx - k + 1, cy + k, g);
    }

    // Title, centred, kept clear of the close button.
    if (n->text != 0) {
        i32 title_color = theme.text_primary();
        if (active == 0) { title_color = theme.text_secondary(); }
        i32 th = graphics.text_height(1, s);
        i32 inset = 2 * (cx - x);
        graphics.push_clip(x + inset, y, w - 2 * inset, tb);
        graphics.draw_label_centered(x, y + (tb - th) / 2, w, (char*)n->text, title_color, 1, s);
        graphics.pop_clip();
    }

    // Border last so it sits over the title bar edge.
    i32 border = theme.window_border();
    if (active == 0) { border = theme.window_border_inactive(); }
    graphics.draw_round_rect(x, y, w, h, r, s, border);
}

void draw_button(Node *n) {
    i32 s = ui_scale();
    i32 x = n->x;
    i32 y = n->y;
    i32 w = n->w;
    i32 h = n->h;
    i32 state = n->state;
    i32 pressed_bit = STATE_PRESSED;
    i32 hovered_bit = STATE_HOVERED;
    i32 primary_bit = STYLE_PRIMARY;
    i32 style = n->style;
    i32 r = theme.button_radius() * s;

    i32 face = theme.button_face();
    i32 label = theme.text_primary();
    i32 border = theme.button_border();
    if ((style & primary_bit) != 0) {
        face = theme.accent();
        label = theme.on_accent();
        border = theme.accent_pressed();
        if ((state & pressed_bit) != 0) { face = theme.accent_pressed(); }
        else if ((state & hovered_bit) != 0) { face = theme.accent_hover(); }
    } else {
        if ((state & pressed_bit) != 0) { face = theme.button_face_pressed(); }
        else if ((state & hovered_bit) != 0) { face = theme.button_face_hover(); }
    }
    label = node_fg(n, label);

    graphics.fill_round_rect(x, y, w, h, r, face);
    graphics.draw_round_rect(x, y, w, h, r, s, border);
    if (n->text != 0) {
        i32 th = graphics.text_height(0, s);
        graphics.push_clip(x, y, w, h);
        graphics.draw_label_centered(x, y + (h - th) / 2, w, (char*)n->text, label, 0, s);
        graphics.pop_clip();
    }
}

void draw_text_node(Node *n) {
    if (n->text == 0) { return; }
    i32 s = ui_scale();
    i32 color = theme.text_primary();
    color = node_fg(n, color);
    i32 bold = text_bold(n);
    i32 center_bit = STYLE_CENTER;
    i32 style = n->style;
    if ((style & center_bit) != 0) {
        graphics.draw_label_centered(n->x, n->y, n->w, (char*)n->text, color, bold, s);
    } else {
        graphics.draw_label(n->x, n->y, (char*)n->text, color, bold, s);
    }
}

void draw_text_input(Node *n) {
    i32 s = ui_scale();
    i32 x = n->x;
    i32 y = n->y;
    i32 w = n->w;
    i32 h = n->h;
    i32 state = n->state;
    i32 focused_bit = STATE_FOCUSED;
    i32 focused = state & focused_bit;
    i32 r = theme.input_radius() * s;
    i32 pad = theme.input_padding_x() * s;

    i32 bg = theme.input_bg();
    graphics.fill_round_rect(x, y, w, h, r, bg);
    i32 border = theme.input_border();
    i32 bw = s;
    if (focused != 0) {
        border = theme.input_border_focus();
        bw = 2 * s;
    }
    graphics.draw_round_rect(x, y, w, h, r, bw, border);

    i32 th = graphics.text_height(0, s);
    i32 ty = y + (h - th) / 2;
    graphics.push_clip(x + pad / 2, y, w - pad, h);
    if (n->len == 0) {
        if (n->name != 0) {
            i32 ph = theme.input_placeholder();
            graphics.draw_label(x + pad, ty, (char*)n->name, ph, 0, s);
        }
    } else {
        i32 fg = theme.text_primary();
        fg = node_fg(n, fg);
        graphics.draw_label(x + pad, ty, (char*)n->text, fg, 0, s);
    }
    if (focused != 0) {
        i32 cur = n->cursor;
        i32 caret_x = x + pad + graphics.text_width_n((char*)n->text, cur, 0, s);
        i32 caret = theme.caret();
        graphics.fill_rect(caret_x, ty + s, s, th - 2 * s, caret);
    }
    graphics.pop_clip();
}

void draw_checkbox(Node *n) {
    i32 s = ui_scale();
    i32 x = n->x;
    i32 y = n->y;
    i32 h = n->h;
    i32 state = n->state;
    i32 checked_bit = STATE_CHECKED;
    i32 hovered_bit = STATE_HOVERED;
    i32 pressed_bit = STATE_PRESSED;
    i32 checked = state & checked_bit;
    i32 box = theme.checkbox_size() * s;
    i32 r = theme.checkbox_radius() * s;
    i32 by = y + (h - box) / 2;

    i32 face = theme.checkbox_bg();
    i32 border = theme.checkbox_border();
    if (checked != 0) {
        face = theme.accent();
        border = theme.accent_pressed();
        if ((state & pressed_bit) != 0) { face = theme.accent_pressed(); }
        else if ((state & hovered_bit) != 0) { face = theme.accent_hover(); }
    } else {
        if ((state & pressed_bit) != 0) { face = theme.button_face_pressed(); }
        else if ((state & hovered_bit) != 0) { face = theme.button_face_hover(); }
    }
    graphics.fill_round_rect(x, by, box, box, r, face);
    graphics.draw_round_rect(x, by, box, box, r, s, border);
    if (checked != 0) {
        // Check mark: two strokes, drawn s+1 times side by side for weight.
        i32 white = theme.on_accent();
        i32 x0 = x + box * 25 / 100;
        i32 y0 = by + box * 52 / 100;
        i32 x1 = x + box * 43 / 100;
        i32 y1 = by + box * 70 / 100;
        i32 x2 = x + box * 76 / 100;
        i32 y2 = by + box * 30 / 100;
        i32 k = 0;
        while (k < s + 1) {
            graphics.draw_line(x0, y0 + k, x1, y1 + k, white);
            graphics.draw_line(x1, y1 + k, x2, y2 + k, white);
            k = k + 1;
        }
    }
    if (n->text != 0) {
        i32 fg = theme.text_primary();
        fg = node_fg(n, fg);
        i32 th = graphics.text_height(0, s);
        graphics.draw_label(x + box + 8 * s, y + (h - th) / 2, (char*)n->text, fg, 0, s);
    }
}

void draw_panel(Node *n) {
    i32 s = ui_scale();
    i32 bg = theme.panel_bg();
    i32 border = theme.panel_border();
    i32 r = n->radius;
    graphics.fill_round_rect(n->x, n->y, n->w, n->h, r, bg);
    graphics.draw_round_rect(n->x, n->y, n->w, n->h, r, s, border);
}

// --- taskbar ---
// The bar lists every window on the desktop (click to activate), with a
// launcher button at the left and an uptime clock at the right. Entries are
// laid out arithmetically at draw and hit time rather than as child nodes,
// so the bar never has to be rebuilt when windows come and go.

// The desktop window with the smallest id greater than `after` (0 = first);
// 0 when there is none. Walks the desktop's children, so a closed window
// drops out and ids keep creation order.
i32 next_window_after(i32 after) {
    i32 kw = NODE_WINDOW;
    i32 best = 0;
    i32 child_id = first_child(g_desktop_node_id);
    while (child_id != 0) {
        Node *c = node_ptr(child_id);
        if (c == 0) { child_id = 0; }
        else {
            if (c->kind == kw) {
                if (child_id > after) {
                    if (best == 0) { best = child_id; }
                    else if (child_id < best) { best = child_id; }
                }
            }
            child_id = c->next_sibling;
        }
    }
    return best;
}

i32 taskbar_entry_x(i32 index) {
    i32 s = ui_scale();
    i32 launcher = theme.taskbar_launcher_w() * s;
    i32 ew = theme.taskbar_entry_w() * s;
    return 8 * s + launcher + 8 * s + index * (ew + 6 * s);
}

void format_clock() {
    // Uptime from the 1 ms scheduler tick: HH:MM:SS.
    i32 secs = scheduler.ticks() / 1000;
    i32 hh = (secs / 3600) % 100;
    i32 mm = (secs / 60) % 60;
    i32 ss = secs % 60;
    g_clock_buf[0] = (char)('0' + hh / 10);
    g_clock_buf[1] = (char)('0' + hh % 10);
    g_clock_buf[2] = ':';
    g_clock_buf[3] = (char)('0' + mm / 10);
    g_clock_buf[4] = (char)('0' + mm % 10);
    g_clock_buf[5] = ':';
    g_clock_buf[6] = (char)('0' + ss / 10);
    g_clock_buf[7] = (char)('0' + ss % 10);
    g_clock_buf[8] = (char)0;
}

void draw_taskbar(Node *n) {
    i32 s = ui_scale();
    i32 x = n->x;
    i32 y = n->y;
    i32 w = n->w;
    i32 h = n->h;

    i32 bg = theme.taskbar_bg();
    graphics.blend_rect(x, y, w, h, bg);
    i32 edge = theme.taskbar_edge();
    graphics.blend_rect(x, y, w, s, edge);

    // Launcher: accent dot + "MyOS".
    i32 accent = theme.accent();
    i32 on_dark = theme.text_on_dark();
    i32 lx = x + 8 * s;
    i32 lw = theme.taskbar_launcher_w() * s;
    i32 er = theme.taskbar_entry_radius() * s;
    i32 entry_bg = theme.taskbar_entry();
    graphics.fill_round_rect(lx, y + 6 * s, lw, h - 12 * s, er, entry_bg);
    graphics.fill_disc(lx + 16 * s, y + h / 2, 6 * s, accent);
    i32 th_b = graphics.text_height(1, s);
    graphics.draw_label(lx + 30 * s, y + (h - th_b) / 2, "MyOS", on_dark, 1, s);

    // One entry per window, in creation order (ids ascend), so raising a
    // window does not shuffle the bar.
    i32 ew = theme.taskbar_entry_w() * s;
    i32 active_bg = theme.taskbar_entry_active();
    i32 dim = theme.text_on_dark_dim();
    i32 th = graphics.text_height(0, s);
    i32 index = 0;
    i32 win = next_window_after(0);
    while (win != 0) {
        Node *c = node_ptr(win);
        i32 ex = x + taskbar_entry_x(index);
        i32 ebg = entry_bg;
        i32 fg = dim;
        if (win == g_active_window) { ebg = active_bg; fg = on_dark; }
        graphics.fill_round_rect(ex, y + 6 * s, ew, h - 12 * s, er, ebg);
        if (win == g_active_window) {
            graphics.fill_round_rect(ex + 10 * s, y + h - 9 * s, ew - 20 * s, 2 * s, s, accent);
        }
        if (c->text != 0) {
            graphics.push_clip(ex + 10 * s, y, ew - 20 * s, h);
            graphics.draw_label(ex + 12 * s, y + (h - th) / 2, (char*)c->text, fg, 0, s);
            graphics.pop_clip();
        }
        index = index + 1;
        win = next_window_after(win);
    }

    // Clock at the right.
    format_clock();
    i32 cw = graphics.text_width(&g_clock_buf[0], 0, s);
    graphics.draw_label(x + w - cw - 16 * s, y + (h - th) / 2, &g_clock_buf[0], on_dark, 0, s);
}

// The window whose taskbar entry is at (px, py), or 0; -1 for the launcher.
i32 taskbar_target_at(i32 px, i32 py) {
    Node *n = node_ptr(g_taskbar_id);
    if (n == 0) { return 0; }
    i32 s = ui_scale();
    i32 x = n->x;
    i32 lx = x + 8 * s;
    i32 lw = theme.taskbar_launcher_w() * s;
    if (px >= lx) {
        if (px < lx + lw) { return 0 - 1; }
    }
    i32 ew = theme.taskbar_entry_w() * s;
    i32 index = 0;
    i32 win = next_window_after(0);
    while (win != 0) {
        i32 ex = x + taskbar_entry_x(index);
        if (px >= ex) {
            if (px < ex + ew) { return win; }
        }
        index = index + 1;
        win = next_window_after(win);
    }
    return 0;
}

// Handle a click on the taskbar: activate the window whose entry was hit, or
// run the launcher handler.
export void taskbar_click(i32 px, i32 py) {
    i32 target = taskbar_target_at(px, py);
    if (target > 0) {
        focus_window(target);
        return;
    }
    if (target < 0) {
        i32 handler = g_launcher;
        if (handler != 0) { handler(); }
    }
}

export void set_launcher(i32 handler) {
    g_launcher = handler;
}

// Redraw the clock (called by a timer once a second).
export void refresh_taskbar() {
    damage_node(g_taskbar_id);
}

void draw_node(Node *n) {
    i32 kind = n->kind;
    i32 x = n->x;
    i32 y = n->y;
    i32 w = n->w;
    i32 h = n->h;
    i32 scale = ui_scale();

    // Copy the NODE_* u16 globals into i32 locals before comparing. Comparing an
    // i32 against a `u16` global directly (kind == NODE_WINDOW) miscompiles and is
    // always false, even when both hold the same value; the local coerces cleanly.
    i32 kw = NODE_WINDOW;
    i32 kbox = NODE_BOX;
    i32 kb = NODE_BUTTON;
    i32 kt = NODE_TEXT;
    i32 ki = NODE_TEXT_INPUT;
    i32 kc = NODE_CHECKBOX;
    i32 ks = NODE_SEPARATOR;
    i32 kp = NODE_PANEL;
    i32 ktb = NODE_TASKBAR;

    if (kind == kbox) {
        graphics.fill_rect(x, y, w, h, n->background_color);
        graphics.draw_rect_scaled(x, y, w, h, n->border_color, scale);
    } else if (kind == kw) {
        draw_window(n);
    } else if (kind == kb) {
        draw_button(n);
    } else if (kind == kt) {
        draw_text_node(n);
    } else if (kind == ki) {
        draw_text_input(n);
    } else if (kind == kc) {
        draw_checkbox(n);
    } else if (kind == ks) {
        i32 sep = theme.separator();
        graphics.blend_rect(x, y, w, h, sep);
    } else if (kind == kp) {
        draw_panel(n);
    } else if (kind == ktb) {
        draw_taskbar(n);
    }
    // Structural nodes (root/system/process/...) draw nothing.
}

// True if a node's painted area overlaps the damage region. Nodes that do not
// are skipped without drawing: the clip rectangle would discard their pixels
// anyway, but only after paying for the fill work that produced them.
i32 node_in_damage(Node *n) {
    if (g_painting_all != 0) { return 1; } // full repaint: draw everything
    node_extent(n);
    if (g_ext_x + g_ext_w <= g_paint_x0) { return 0; }
    if (g_ext_y + g_ext_h <= g_paint_y0) { return 0; }
    if (g_ext_x >= g_paint_x1) { return 0; }
    if (g_ext_y >= g_paint_y1) { return 0; }
    return 1;
}

// Containers that confine their children's pixels to their own bounds.
i32 clips_children(Node *n) {
    i32 kw = NODE_WINDOW;
    i32 kp = NODE_PANEL;
    i32 k = n->kind;
    if (k == kw) { return 1; }
    if (k == kp) { return 1; }
    return 0;
}

// Render node_id and its descendants. Skips invisible subtrees. Sibling order
// is paint order, so later children appear on top.
export void render(i32 node_id) {
    Node *n = node_ptr(node_id);
    if (n == 0) { return; }
    if ((n->state & STATE_VISIBLE) == 0) { return; }

    i32 in_damage = node_in_damage(n);
    if (in_damage != 0) {
        draw_node(n);
    }

    // Children are visited regardless: a child can overlap the damage region
    // even when its parent does not -- unless the parent clips them, in
    // which case an off-damage parent means off-damage children.
    i32 clip = clips_children(n);
    if (clip != 0) {
        if (in_damage == 0) { return; }
        graphics.push_clip(n->x, n->y, n->w, n->h);
    }
    i32 child_id = n->first_child;
    while (child_id != 0) {
        render(child_id);
        child_id = next_sibling(child_id);
    }
    if (clip != 0) { graphics.pop_clip(); }
}

// Paint the desktop: wallpaper, every window in z-order, then the taskbar on
// top. Honours the current clip, so render_scene can call it for a region.
void paint_desktop() {
    i32 top = theme.desktop_top();
    i32 bottom = theme.desktop_bottom();
    i32 dw = graphics.display_width();
    i32 dh = graphics.display_height();
    graphics.fill_gradient_v(0, 0, dw, dh, top, bottom);

    i32 child_id = first_child(g_desktop_node_id);
    while (child_id != 0) {
        if (child_id != g_taskbar_id) { render(child_id); }
        child_id = next_sibling(child_id);
    }
    if (g_taskbar_id != 0) { render(g_taskbar_id); }
}

// Repaint every node, ignoring the damage region. Used for the first frame and
// whenever a caller wants an unconditional repaint.
export void render_all() {
    clear_damage();
    g_painting_all = 1;
    graphics.clear_clip();
    paint_desktop();
    clear_damage();
}

// Repaint just the damaged region: everything that overlaps it is redrawn
// under a clip, nodes outside it are skipped entirely -- a hover highlight
// redraws one button, not the whole screen. Falls back to a full repaint when
// nothing is marked, so a caller that never damages anything still gets a
// correct frame.
export void render_scene() {
    if (g_damage_count == 0) {
        render_all();
        return;
    }

    // Paint each damaged rectangle under its own clip. The count is
    // snapshotted so anything damaged while painting waits for the next
    // frame rather than extending this loop.
    i32 count = g_damage_count;
    i32 i = 0;
    while (i < count) {
        g_paint_x0 = g_damage_x0[i];
        g_paint_y0 = g_damage_y0[i];
        g_paint_x1 = g_damage_x1[i];
        g_paint_y1 = g_damage_y1[i];
        g_painting_all = 0;
        graphics.set_clip(g_paint_x0, g_paint_y0, g_paint_x1 - g_paint_x0, g_paint_y1 - g_paint_y0);
        paint_desktop();
        i = i + 1;
    }
    g_painting_all = 1;
    graphics.clear_clip();
    clear_damage();
}

export void render_desktop() {
    render_scene();
    graphics.present();
}

// --- hit-test --------------------------------------------------------------------------------------

// True if (px, py) is inside a node's bounds. Nodes with zero size never hit.
i32 node_contains(Node *n, i32 px, i32 py) {
    i32 x = n->x;
    i32 y = n->y;
    i32 w = n->w;
    i32 h = n->h;
    if (w == 0) { return 0; }
    if (h == 0) { return 0; }
    if (px < x) { return 0; }
    if (py < y) { return 0; }
    if (px >= x + w) { return 0; }
    if (py >= y + h) { return 0; }
    return 1;
}

// Return the id of the topmost visible node in node_id's subtree whose bounds
// contain (px, py), or 0 if none. Later siblings are on top (paint order), so
// the last hit among the children wins over earlier ones and over the parent.
i32 hit_test(i32 node_id, i32 px, i32 py) {
    Node *n = node_ptr(node_id);
    if (n == 0) { return 0; }
    if ((n->state & STATE_VISIBLE) == 0) { return 0; }

    i32 inside = node_contains(n, px, py);
    i32 found = 0;
    if (inside != 0) {
        if ((n->state & STATE_HIT_TESTABLE) != 0) {
            found = node_id;
        }
    }

    // Children of a clipping container cannot be hit outside it.
    if (inside == 0) {
        if (clips_children(n) != 0) { return 0; }
    }

    i32 child_id = n->first_child;
    while (child_id != 0) {
        i32 child_hit = hit_test(child_id, px, py);
        if (child_hit != 0) {
            found = child_hit;
        }
        child_id = next_sibling(child_id);
    }
    return found;
}

// Return the topmost UI node under (x, y), searching the whole desktop. 0 if
// none. The taskbar is always on top.
export i32 find_at(i32 x, i32 y) {
    if (g_taskbar_id != 0) {
        i32 tb = hit_test(g_taskbar_id, x, y);
        if (tb != 0) { return tb; }
    }
    i32 child_id = first_child(g_desktop_node_id);
    i32 found = 0;
    while (child_id != 0) {
        if (child_id != g_taskbar_id) {
            i32 hit = hit_test(child_id, x, y);
            if (hit != 0) {
                found = hit;
            }
        }
        child_id = next_sibling(child_id);
    }
    return found;
}

// --- init ------------------------------------------------------------------------------------------

export void init() {
    graphics.init();
    i32 root = create_node(NODE_ROOT, "root");
    g_root_node_id = root;
    set_role(root, ROLE_ROOT);

    i32 sys = create_node(NODE_SYSTEM, "system");
    append_child(root, sys);

    i32 proc = create_node(NODE_PROCESS, "process");
    append_child(sys, proc);

    i32 dev = create_node(NODE_DEVICE, "device");
    append_child(sys, dev);

    i32 fs_node = create_node(NODE_DIRECTORY, "fs");
    append_child(dev, fs_node);

    i32 ui = create_node(NODE_UI, "ui");
    append_child(sys, ui);

    i32 desktop = create_node(NODE_DESKTOP, "desktop");
    append_child(ui, desktop);
    g_desktop_node_id = desktop;
    set_role(desktop, ROLE_DESKTOP);

    i32 timers = create_node(NODE_UI, "timers");
    append_child(ui, timers);
    g_timers_node_id = timers;
    g_timer_count = 0;

    g_active_window = 0;
    g_focus_id = 0;
    g_taskbar_id = 0;
}

// Add the taskbar to the desktop. Separate from init() so tests that only
// need a bare tree keep the layout they expect.
export i32 create_taskbar() {
    if (g_taskbar_id != 0) { return g_taskbar_id; }
    i32 s = ui_scale();
    i32 h = theme.taskbar_h() * s;
    i32 dw = graphics.display_width();
    i32 dh = graphics.display_height();
    i32 id = create_node(NODE_TASKBAR, "taskbar");
    set_role(id, ROLE_TOOLBAR);
    set_text(id, "taskbar");
    set_bounds(id, 0, dh - h, dw, h);
    set_state_flag(id, STATE_VISIBLE, 1);
    set_state_flag(id, STATE_HIT_TESTABLE, 1);
    append_child(g_desktop_node_id, id);
    g_taskbar_id = id;
    return id;
}

// Height of the taskbar in display pixels (0 if none), so callers can keep
// windows above it.
export i32 taskbar_height() {
    Node *n = node_ptr(g_taskbar_id);
    if (n == 0) { return 0; }
    return n->h;
}
