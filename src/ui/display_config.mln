// Geometry is supplied by the display device. Board defaults are configured
// in runtime/MyEmulator/config/hardware.conf; no emulator dependency on MyOS.
package display_config;

import mem from "../../../MyKernel/src/mm/mem.mln";

export i32 width() {
    return mem.read_word(0x240000D0);
}

export i32 height() {
    return mem.read_word(0x240000D4);
}
