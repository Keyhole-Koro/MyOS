package ui_event;

import { NodeId } from "@contracts/ui/widget.contract.mln";
import { Pid } from "@contracts/process/control.contract.mln";

// UI-domain events. The UI knows that an owned node was clicked or changed,
// but does not know how an application process receives that notification.
// The outer IPC endpoint installs the sink during boot.

/** Event kinds emitted by UI-owned nodes before OS wire-protocol translation. */
export enum UiEventKind {
    NONE,
    CLICK,
    CHANGE,
    ACTIVATE,
    TIMER,
}

void no_sink(Pid owner, NodeId id, i32 kind, i32 arg) { }

fn(Pid owner, NodeId id, i32 kind, i32 arg) -> void g_sink = no_sink;

/**
 * Installs the callback that receives events produced by UI nodes.
 * @param sink Callback with signature (owner, node_id, kind, argument).
 */
export void set_sink(fn(Pid owner, NodeId id, i32 kind, i32 arg) -> void sink) { g_sink = sink; }

/**
 * Sends a UI event to the currently installed event callback.
 * @param owner Process ID that owns the target node.
 * @param id DOM node ID that produced the event.
 * @param kind UiEventKind value describing the event.
 * @param arg Event-specific integer payload.
 */
export void emit(Pid owner, NodeId id, i32 kind, i32 arg) {
    g_sink(owner, id, kind, arg);
}
