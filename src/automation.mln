package automation;

import automation_io from "io/automation_io.mln";
import dom from "ui/dom.mln";
import scheduler from "../../MyKernel/src/kernel/scheduler.mln";

i32 CMD_DOM_SNAPSHOT = 1;

// Input and screenshots remain emulator operations. The guest only owns DOM
// inspection, which keeps the normal compositor path in every UI test.
export void run() {
    while (1) {
        if (automation_io.has_request() != 0) {
            i32 command = automation_io.read_request();
            if (command == CMD_DOM_SNAPSHOT) { dom.write_automation_snapshot(); }
            else { automation_io.putc('{'); automation_io.putc('}'); }
            automation_io.done();
        }
        scheduler.sleep(1);
    }
}
