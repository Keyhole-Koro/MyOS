package counter;

import elements from "../../../MyAppFramework/src/elements.mln";
import ui from "../../../MyAppFramework/src/ui.mln";
import { app } from "../../../MyAppFramework/src/annotations.mln";

// Click counter demo app, and the smallest example of the app framework.
//
// `@app` on view() makes Counter an application: the build lists it in the
// launcher, and each launch allocates one zeroed Counter, runs view() to
// build its window and routes that window's events to the methods named in
// the markup. Fields are the instance's state -- no globals, so every
// launch is independent -- and `ref=` stores node ids into them so handlers
// never walk the tree.
//
// The methods take `ref mut Counter`: the framework calls them with the
// instance's address, and a reference is that address underneath. `Counter *c`
// with `c->` would be the same thing spelled as a raw pointer.
//
// Coordinates are logical (1024x768) and relative to the parent element; a
// Window's children start below its title bar. Column and Row position their
// own children, so those need only sizes.

/**
 * Per-window state for the click-counter application.
 * @property clicks Current accumulated click count.
 * @property step Amount added by each click, selected by the checkbox.
 * @property label DOM node ID of the text label displaying the count.
 */
struct Counter {
    i32 clicks;
    i32 step;
    i32 label;
};

@app
/** Builds the counter window and initializes its per-instance increment step.
 * @return DOM node ID of the newly created window.
 */
i32 (ref mut Counter c) view() {
    c.step = 1;
    i32 muted = ui.rgb(0x6B, 0x72, 0x80);
    return <Window title="Counter" x={96} y={72} w={400} h={272}>
        <Panel x={20} y={20} w={360} h={140} radius={10}>
            <Column x={20} y={16} w={320} h={110} gap={10}>
                <Label text="A window, a panel, two buttons." color={muted} />
                <Label ref={c.label} text="clicks: 0" bold={1} testId="counter" />
                <Row w={320} h={36} gap={10}>
                    <PrimaryButton text="Click me" w={120} h={36} onClick={c.click} />
                    <Button text="Reset" w={90} h={36} onClick={c.reset} />
                </Row>
            </Column>
        </Panel>
        <Checkbox text="Count by two" x={24} y={180} onClick={c.step_changed} />
    </Window>;
}

/** Refreshes the count label from the current counter state. */
void (ref mut Counter c) refresh() {
    ui.set_text_fmt(c.label, "clicks: %d", c.clicks, 0);
}

/**
 * Adds the configured step and refreshes the count label.
 * @param id DOM node ID supplied by the click event.
 */
void (ref mut Counter c) click(i32 id) {
    c.clicks = c.clicks + c.step;
    c.refresh();
}

/**
 * Resets the count to zero and refreshes the display.
 * @param id DOM node ID supplied by the reset-button event.
 */
void (ref mut Counter c) reset(i32 id) {
    c.clicks = 0;
    c.refresh();
}

// Checkbox: the toggle happens before the handler runs, so reading the
// node gives the new state.
/**
 * Selects an increment step of one or two from the checkbox state.
 * @param id Checkbox DOM node ID whose checked state has just changed.
 */
void (ref mut Counter c) step_changed(i32 id) {
    c.step = 1;
    if (ui.is_checked(id)) { c.step = 2; }
}
