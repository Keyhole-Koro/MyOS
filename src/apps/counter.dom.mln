package counter;

import app from "@app/app.mln";
import { App, View } from "@app/app.mln";
import elements from "@app/elements.mln";
import ui from "@app/ui.mln";
import { app } from "@app/annotations.mln";

// Click counter demo app, and the smallest example of the app framework.
//
// The fields are the state. `view` says what the state looks like: after each
// event the framework reads it again and changes what differs, so a handler
// only changes the state.
//
// Coordinates are logical (1024x768) and relative to the parent element; a
// Window's children start below its title bar. Column and Row position their
// own children, so those need only sizes.

/**
 * The click counter's state.
 * @property clicks Current accumulated click count.
 * @property step Amount added by each click, selected by the checkbox.
 */
@app
struct Counter {
    i32 clicks;
    i32 step;
};

impl App for Counter {
    Self start() { return Counter { step: 1 }; }

    View (Self c) view() {
        return <Window title="Counter" w={400} h={272}>
            <Panel x={20} y={20} w={360} h={140} radius={10}>
                <Column x={20} y={16} w={320} h={110} gap={10}>
                    <Label text="A window, a panel, two buttons." color={ui.TEXT_SECONDARY} />
                    <Label text={"clicks: %d", c.clicks} bold={1} testId="counter" />
                    <Row w={320} h={36} gap={10}>
                        <PrimaryButton text="Click me" w={120} h={36} onClick={c.click} />
                        <Button text="Reset" w={90} h={36} onClick={c.reset} />
                    </Row>
                </Column>
            </Panel>
            <Checkbox text="Count by two" x={24} y={180} checked={c.step == 2} onChange={c.set_double} />
        </Window>;
    }
}

/** Adds the configured step. */
void (borrow Counter c) click() {
    c.clicks = c.clicks + c.step;
}

/** Resets the count to zero. */
void (borrow Counter c) reset() {
    c.clicks = 0;
}

/**
 * Selects an increment step of one or two.
 * @param on Whether the checkbox is now checked.
 */
void (borrow Counter c) set_double(bool on) {
    c.step = on ? 2 : 1;
}

i32 main() { return app.run<Counter>(); }
