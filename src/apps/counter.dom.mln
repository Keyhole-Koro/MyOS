package counter;

import dom from "../ui/dom.mln";
import str from "../../../MyKernel/src/lib/str.mln";

// Click counter demo app.
//
// The window is described declaratively: each element calls the dom function of
// the same name, every property is handed to the parameter of the same name,
// and children become dom.append_child. mount() builds that tree, attaches it
// to the desktop, and keeps the label id so the handler can rewrite its text.
//
// Interaction is not this app's concern. The compositor hit-tests the pointer
// and calls whatever handler the hit node carries, so all this app does to
// become clickable is pass on_click as the Button's onClick property.

i32 g_clicks = 0;
i32 g_label_id = 0;

char g_click_buf[32];

// Bumps the counter and rewrites the label text; the next render picks up the
// new text from the node. dom.dispatch_click invokes this indirectly with the
// button id.
void on_click(i32 id) {
    g_clicks = g_clicks + 1;

    g_click_buf[0] = 99; g_click_buf[1] = 108; g_click_buf[2] = 105;
    g_click_buf[3] = 99; g_click_buf[4] = 107; g_click_buf[5] = 115;
    g_click_buf[6] = 58; g_click_buf[7] = 32;

    str.itoa(g_clicks, &g_click_buf[8]);
    dom.set_text(g_label_id, &g_click_buf[0]);
}

i32 build_ui() {
    return <Window title="MyKernel Window" x={100} y={100} w={600} h={400}>
        <Button text="CLICK ME" x={120} y={130} w={150} h={60} onClick={on_click} />
        <Text text="clicks: 0" x={320} y={150} />
    </Window>;
}

// Build the window, mount it on the desktop and remember the label. Returns the
// window node id. The button is the window's first child; the label follows it.
export i32 mount() {
    i32 win = build_ui();
    dom.append_child(dom.desktop_id(), win);

    i32 btn = dom.first_child(win);
    g_label_id = dom.next_sibling(btn);

    return win;
}
