package notes;

import elements from "../../../MyAppFramework/src/elements.mln";
import ui from "../../../MyAppFramework/src/ui.mln";
import { app } from "../../../MyAppFramework/src/annotations.mln";

// "Notes": a small form that exercises keyboard input. Two text fields, a
// checkbox and a separator, plus a label that echoes what was typed. Every
// launch is its own Notes instance, so the fields and the echo label are
// per-window state on the struct; each new window cascades down and right
// of the previous one.

i32 opened_count = 0; // desktop placement sequence shared by Notes windows

/**
 * Per-window state for the Notes form.
 * @property title DOM node ID of the title text input.
 * @property body DOM node ID of the body text input.
 * @property echo DOM node ID of the label that mirrors typed text.
 * @property typed Scratch buffer used to copy text from the changed input.
 */
struct Notes {
    i32 title;
    i32 body;
    i32 echo;
    char typed[128];
};

@app
/** Builds a Notes window with per-instance title and body fields.
 * @return DOM node ID of the new Notes window.
 */
i32 (Notes *n) view() {
    i32 offset = 28 * opened_count;
    opened_count++;
    i32 muted = ui.rgb(0x6B, 0x72, 0x80);
    return <Window title="Notes" x={540 + offset} y={96 + offset} w={380} h={330}>
        <Column x={24} y={20} w={332} h={270} gap={12}>
            <Label text="Click a field and type. Tab moves between fields." color={muted} />
            <TextInput ref={n->title} placeholder="Title" w={332} h={34} capacity={64} onChange={n->changed} />
            <TextInput ref={n->body} placeholder="Write something..." w={332} h={34} capacity={64} onChange={n->changed} />
            <Separator w={332} />
            <Checkbox text="Mark as done" checked={1} />
            <Row w={332} h={34} gap={10}>
                <Button text="Clear" w={90} h={34} onClick={n->clear} />
            </Row>
            <Label ref={n->echo} text="You typed: " />
        </Column>
    </Window>;
}

/**
 * Copies a changed input's text and mirrors it in the echo label.
 * @param id DOM node ID of the input that changed.
 */
void (Notes *n) changed(i32 id) {
    ui.text_copy(id, &n->typed[0], 128);
    ui.set_text_fmt(n->echo, "You typed: %s", (i32)(&n->typed[0]), 0);
}

/**
 * Clears the title and body fields and refreshes the echo label.
 * @param id DOM node ID supplied by the clear-button event.
 */
void (Notes *n) clear(i32 id) {
    ui.input_set(n->title, "");
    ui.input_set(n->body, "");
    n->changed(n->title);
}
