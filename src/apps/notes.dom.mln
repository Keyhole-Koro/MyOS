package notes;

import app from "@app/app.mln";
import { App, View } from "@app/app.mln";
import elements from "@app/elements.mln";
import ui from "@app/ui.mln";
import { TextField } from "@app/ui.mln";
import { app } from "@app/annotations.mln";
import { Text } from "@std/text/text.mln";

// "Notes": a small form that exercises keyboard input. Two text fields, a
// checkbox and a separator, plus a label that echoes what was typed. What is
// being typed stays in the fields; the echo is state.

/**
 * The Notes form's state.
 * @property title The title field.
 * @property body The body field.
 * @property typed Text of the field that last changed.
 */
@app
struct Notes {
    TextField title;
    TextField body;
    Text<128> typed;
};

impl App for Notes {
    Self start() { return Notes { title: ui.field(), body: ui.field() }; }

    View (Self n) view() {
        return <Window title="Notes" w={380} h={330}>
            <Column x={24} y={20} w={332} h={270} gap={12}>
                <Label text="Click a field and type. Tab moves between fields." color={ui.TEXT_SECONDARY} />
                <TextInput field={n.title} placeholder="Title" w={332} h={34} capacity={64} onChange={n.changed} />
                <TextInput field={n.body} placeholder="Write something..." w={332} h={34} capacity={64} onChange={n.changed} />
                <Separator w={332} />
                <Checkbox text="Mark as done" checked={true} />
                <Row w={332} h={34} gap={10}>
                    <Button text="Clear" w={90} h={34} onClick={n.clear} />
                </Row>
                <Label text={"You typed: %s", n.typed} />
            </Column>
        </Window>;
    }
}

/**
 * Keeps the text of the field that changed.
 * @param text The field's new text.
 */
void (borrow Notes n) changed(str text) {
    n.typed.clear();
    n.typed.append(text);
}

/** Clears both fields and the echo. */
void (borrow Notes n) clear() {
    n.title.clear();
    n.body.clear();
    n.typed.clear();
}

i32 main() { return app.run<Notes>(); }
