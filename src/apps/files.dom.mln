package files;

import app from "@app/app.mln";
import { App, View } from "@app/app.mln";
import elements from "@app/elements.mln";
import ui from "@app/ui.mln";
import { app } from "@app/annotations.mln";
import fs from "@std/hosted/fs.mln";
import { DirEntry } from "@std/hosted/fs.mln";
import str from "@std/text/str.mln";
import { Text } from "@std/text/text.mln";
import { Result } from "@std/core/result.mln";
import { FsError } from "@contracts/io/fs.contract.mln";
import { Option } from "@std/core/option.mln";

// File manager: lists the MFS disk, opens a file in the editor (activate a
// row, or the Open button), deletes after a confirmation dialog, and creates
// new files through the editor. It does not know the editor: ui.open(path)
// goes to whichever app declares `opens`.
//
// The list and the dialog are values: `rows` and `selected` are what the list
// shows, `asking` whether the dialog is up.

/**
 * The file manager's state.
 * @property rows Newline-separated display rows of the directory shown.
 * @property selected The selected row, if any.
 * @property name Name of the selected entry.
 * @property dir Current directory path; an empty string denotes the root.
 * @property path Scratch buffer used to assemble child paths.
 * @property status What the status line says.
 * @property asking Whether the delete confirmation is up.
 */
@app(single)
struct Files {
    Text<1024> rows;
    Option<i32> selected;
    Text<16> name;
    Text<64> dir;
    Text<80> path;
    Text<96> status;
    bool asking;
};

impl App for Files {
    Self start() {
        Files f = Files {};
        f.reload();
        return f;
    }

    View (Self f) view() {
        return <Window title="Files" w={440} h={400}>
            <List name="files" items={f.rows} selected={f.selected} x={12} y={12} w={416} h={270} capacity={1024}
                  focus={true} onChange={f.select} onActivate={f.open_selected} testId="file-list" />
            <Row x={12} y={294} w={416} h={34} gap={8}>
                <PrimaryButton text="Open" w={90} h={34} onClick={f.open_selected} />
                <Button text="New" w={80} h={34} onClick={f.create} />
                <Button text="Delete" w={90} h={34} onClick={f.ask} />
                <Button text="Refresh" w={96} h={34} onClick={f.reload} />
            </Row>
            <Label text={f.status} x={12} y={340} color={ui.TEXT_SECONDARY} testId="files-status" />
            <Dialog when={f.asking} title="Delete file?" text={"Delete \"%s\" permanently?", f.name}
                    confirm="Delete" onConfirm={f.delete} onCancel={f.cancel} />
        </Window>;
    }
}

// `name` inside the directory shown, as a path.
/**
 * Builds a path under the currently displayed directory.
 * @param name Child entry name.
 * @return View of the instance's reusable path buffer.
 */
str (borrow Files f) path_of(str name) {
    f.path.clear();
    if (!f.dir.is_empty()) {
        f.path.append(f.dir.as_str());
        f.path.append("/");
    }
    f.path.append(name);
    return f.path.as_str();
}

/**
 * Says a failure on the status line, as `what: <message>`.
 * @param what What failed.
 * @param message Why, typically an error's `describe()`.
 */
void (borrow Files f) failed(str what, str message) {
    f.status.clear();
    f.status.append(what);
    f.status.append(": ");
    f.status.append(message);
}

/**
 * Replaces the status line.
 * @param text The new status.
 */
void (borrow Files f) say(str text) {
    f.status.clear();
    f.status.append(text);
}

/**
 * Says how many entries the directory shown has.
 * @param count Number of entries.
 */
void (borrow Files f) say_count(i32 count) {
    f.status.clear();
    Text<12> number = count.to_string();
    if (f.dir.is_empty()) {
        f.status.append(number.as_str());
        f.status.append(" entries on disk");
        return;
    }
    f.status.append("/");
    f.status.append(f.dir.as_str());
    f.status.append(": ");
    f.status.append(number.as_str());
    f.status.append(" entries");
}

// Rebuild the rows from the directory shown: ".." first unless at the root,
// then one row per entry -- "name/" for a directory, "name  (N bytes)" for a
// file.
/** Reads the current directory into the state. */
void (borrow Files f) reload() {
    f.rows.clear();
    f.selected = None;
    i32 start = 0;
    i32 count = 0;
    if (!f.dir.is_empty()) {
        f.rows.append("..");
        count++;
    }
    while (1) {
        // None ends enumeration; Err reports a disk failure.
        DirEntry entry = case fs.next_entry(f.dir.as_str(), start) of {
            Ok(v) -> case v of { Some(found) -> found; None -> ({ break; }); };
            Err(e) -> ({ f.failed("cannot list", e.describe()); return; });
        };
        i32 idx = entry.index;
        if (count > 0) { f.rows.append("\n"); }
        f.rows.append(entry.name.as_str());
        bool is_directory = case fs.is_dir(idx) of {
            Ok(value) -> value;
            Err(e) -> ({ f.failed("cannot list", e.describe()); return; });
        };
        if (is_directory) {
            f.rows.append("/");
        } else {
            i32 size = case fs.entry_size(idx) of {
                Ok(value) -> value;
                Err(e) -> ({ f.failed("cannot list", e.describe()); return; });
            };
            f.rows.append("   (");
            Text<12> size_text = size.to_string();
            f.rows.append(size_text.as_str());
            f.rows.append(" bytes)");
        }
        count++;
        start = idx + 1;
    }
    f.say_count(f.dir.is_empty() ? count : count - 1);
}

/**
 * The text of a row.
 * @param row Zero-based row number.
 * @return View of the row, empty past the end.
 */
str (Files f) row_text(i32 row) {
    str rows = f.rows.as_str();
    i32 start = 0;
    i32 line = 0;
    while (line < row) {
        while (start < rows.length && rows.byte(start) != '\n') { start++; }
        start++;
        line++;
    }
    i32 end = start;
    while (end < rows.length && rows.byte(end) != '\n') { end++; }
    return case rows.slice(start, end) of { Some(view) -> view; None -> ""; };
}

// Whether a row is a directory ("name/" or "..").
/**
 * Tests whether a row represents a directory or the parent entry.
 * @param row Zero-based row number.
 * @return True for a directory or parent row.
 */
bool (Files f) row_is_dir(i32 row) {
    str item = f.row_text(row);
    if (item == "..") { return true; }
    return !item.is_empty() && item.byte(item.length - 1) == '/';
}

// Enter the selected directory (".." goes up), and show it.
/**
 * Changes the displayed directory and reads its contents.
 * @param name Directory name to enter, or ".." to move to the parent.
 */
void (borrow Files f) enter(str name) {
    if (name == "..") {
        i32 n = f.dir.len();
        while (n > 0 && f.dir.data[n - 1] != '/') { n--; }
        if (n > 0) { n--; }
        f.dir.truncate(n);
    } else {
        if (!f.dir.is_empty()) { f.dir.append("/"); }
        f.dir.append(name);
    }
    f.reload();
}

/**
 * Keeps the selected row, and the name in it: the part before the size.
 * @param row The row the user selected.
 */
void (borrow Files f) select(i32 row) {
    f.selected = Some(row);
    str item = f.row_text(row);
    f.name.clear();
    i32 i = 0;
    while (i < item.length && i < fs.NAME_MAX - 1) {
        i32 c = item.byte(i);
        if (c == ' ' || c == '/') { break; }
        f.name.push((u8)c);
        i++;
    }
    f.status.clear();
    f.status.append("selected ");
    f.status.append(f.name.as_str());
}

/** Enters the selected directory or opens the selected file. */
void (borrow Files f) open_selected() {
    i32 row = case f.selected of {
        Some(value) -> value;
        None -> ({ f.say("select a file first"); return; });
    };
    Text<16> name = f.name;
    if (f.row_is_dir(row)) { f.enter(name.as_str()); return; }
    ui.open(f.path_of(name.as_str()));
}

/** Opens the editor on the default new-file path. */
void (borrow Files f) create() {
    ui.open(f.path_of("untitled.txt"));
}

// --- delete confirmation dialog ---

/** Asks to confirm deleting the selected entry. */
void (borrow Files f) ask() {
    if (f.selected.is_none()) { f.say("select a file first"); return; }
    f.asking = true;
}

/** Dismisses the delete confirmation without changing the filesystem. */
void (borrow Files f) cancel() {
    f.asking = false;
}

/** Removes the selected file after confirmation and reads the list again. */
void (borrow Files f) delete() {
    f.asking = false;
    Text<16> name = f.name;
    case fs.remove(f.path_of(name.as_str())) of {
        Ok(_) -> ({ f.reload(); f.say("deleted"); });
        Err(e) -> ({ f.failed("delete failed", e.describe()); });
    };
}

i32 main() { return app.run<Files>(); }
