package files;

import elements from "@app/elements.mln";
import ui from "@app/ui.mln";
import { app } from "@app/annotations.mln";
import fs from "@std/hosted/fs.mln";
import { DirEntry } from "@std/hosted/fs.mln";
import str from "@std/text/str.mln";
import { list_item } from "@app/ui_text.mln";
import { Text } from "@std/text/text.mln";
import { Result } from "@std/core/result.mln";
import { FsError } from "@contracts/io/fs.contract.mln";
import { NodeId, UiError } from "@contracts/ui/widget.contract.mln";
import { Option } from "@std/core/option.mln";

// File manager: lists the MFS disk, opens a file in the editor (activate a
// row, or the Open button), deletes after a confirmation dialog, and creates
// new files through the editor. It does not know the editor: ui.open(path)
// goes to whichever app declares @open.
//
// The confirmation dialog is a second window the instance builds on demand.
// Nodes created from a handler belong to the instance that ran it, so if the
// user closes Files while the dialog is up, the dialog goes with it.

/**
 * Per-window file-manager state, including its list and transient dialog buffers.
 * @property list DOM node ID of the directory-entry list.
 * @property status DOM node ID of the status label.
 * @property dialog DOM node ID of the active confirmation dialog, if one is open.
 * @property items Newline-separated display rows backing the list widget.
 * @property selected Name of the currently selected entry.
 * @property question Text shown in the delete-confirmation dialog.
 * @property dir Current directory path; an empty string denotes the root.
 * @property path Scratch buffer used to assemble child paths.
 */
struct Files {
    NodeId list;
    NodeId status;
    Option<NodeId> dialog; // open confirmation window
    Text<1024> items;   // "\n"-joined list rows
    Text<16> selected;  // name of the selected row
    Text<64> question;  // dialog text
    Text<64> dir;       // the directory shown ("" = root)
    Text<80> path;      // dir + "/" + a name
};

@app(single)
/**
 * Builds the file-manager window, loads the root directory, and focuses its list.
 * @return DOM node ID of the file-manager window.
 */
NodeId (borrow Files f) view() {
    f.dialog = None; // the instance starts as zero bytes, which read as Some(0)
    NodeId win = <Window title="Files" x={60} y={60} w={440} h={400}>
        <List ref={f.list} name="files" x={12} y={12} w={416} h={270} capacity={1024}
              onChange={f.select} onActivate={f.open} testId="file-list" />
        <Row x={12} y={294} w={416} h={34} gap={8}>
            <PrimaryButton text="Open" w={90} h={34} onClick={f.open} />
            <Button text="New" w={80} h={34} onClick={f.create} />
            <Button text="Delete" w={90} h={34} onClick={f.delete} />
            <Button text="Refresh" w={96} h={34} onClick={f.refresh} />
        </Row>
        <Label ref={f.status} text="" x={12} y={340} color={ui.TEXT_SECONDARY} testId="files-status" />
    </Window>;
    f.refresh();
    ui.focus(f.list);
    return win;
}

// `name` inside the directory shown, as a path.
/**
 * Builds a path under the currently displayed directory.
 * @param name Child entry name.
 * @return View of the instance's reusable path buffer.
 */
str (borrow Files f) path_of(str name) {
    f.path.clear();
    if (!f.dir.is_empty()) {
        f.path.append(f.dir.as_str());
        f.path.append("/");
    }
    f.path.append(name);
    return f.path.as_str();
}

// Rebuild the list from the directory shown: ".." first unless at the
// root, then one row per entry -- "name/" for a directory, "name  (N
// bytes)" for a file.
/** Refreshes the list widget and status label from the current directory. */
void (borrow Files f) refresh() {
    f.items.clear();
    i32 start = 0;
    i32 count = 0;
    if (!f.dir.is_empty()) {
        f.items.append("..");
        count++;
    }
    while (1) {
        // None ends enumeration; Err reports a disk failure.
        DirEntry entry = case fs.next_entry(f.dir.as_str(), start) of {
            Ok(v) -> case v of { Some(found) -> found; None -> ({ break; }); };
            Err(e) -> ({ ui.set_error(f.status, "cannot list", e.describe()); return; });
        };
        i32 idx = entry.index;
        if (count > 0) { f.items.append("\n"); }
        f.items.append(entry.name.as_str());
        bool is_directory = case fs.is_dir(idx) of {
            Ok(value) -> value;
            Err(e) -> ({ ui.set_error(f.status, "cannot list", e.describe()); return; });
        };
        if (is_directory) {
            f.items.append("/");
        } else {
            i32 size = case fs.entry_size(idx) of {
                Ok(value) -> value;
                Err(e) -> ({ ui.set_error(f.status, "cannot list", e.describe()); return; });
            };
            f.items.append("   (");
            Text<12> size_text = size.to_string();
            f.items.append(size_text.as_str());
            f.items.append(" bytes)");
        }
        count++;
        start = idx + 1;
    }
    ui.list_set_items(f.list, f.items.as_str());
    if (!f.dir.is_empty()) {
        str shown = f.dir.as_str();
        ui.set_text_fmt(f.status, "/%s: %d entries", shown, count - 1);
    } else {
        ui.set_text_fmt(f.status, "%d entries on disk", "", count);
    }
    f.selected.clear();
}

// Whether the selected row is a directory ("name/" or "..").
/**
 * Tests whether the selected row represents a directory or the parent entry.
 * @return Ok(true) for a directory or parent row, Ok(false) for a file or no selection,
 *         or Err when the list query fails.
 */
Result<bool, UiError> (borrow Files f) selected_is_dir() {
    Option<i32> selected = ui.list_selected(f.list)?;
    i32 row = case selected of {
        Some(n) -> n;
        None -> ({ return Ok(false); });
    };
    Text<48> item = Text<48> {};
    item.clear();
    list_item<48>(f.list, row, &item)?;
    if (item.len() == 2 && item.data[0] == '.' && item.data[1] == '.') { return Ok(true); }
    if (!item.is_empty() && item.data[item.len() - 1] == '/') { return Ok(true); }
    return Ok(false);
}

// Enter the selected directory (".." goes up), and show it.
/**
 * Changes the displayed directory and refreshes its contents.
 * @param name Directory name to enter, or ".." to move to the parent.
 */
void (borrow Files f) enter(str name) {
    if (name == "..") {
        i32 n = f.dir.len();
        while (n > 0 && f.dir.data[n - 1] != '/') { n--; }
        if (n > 0) { n--; }
        f.dir.truncate(n);
    } else {
        if (!f.dir.is_empty()) { f.dir.append("/"); }
        f.dir.append(name);
    }
    f.refresh();
}

// Copy the selected row's file name (the part before the size) into
// f.selected. False when no row is selected.
/**
 * Copies the selected entry's name out of its display row.
 * @return True when f.selected now holds a name, false if no row is selected.
 */
bool (borrow Files f) load_selected() {
    i32 row = case ui.list_selected(f.list) of {
        Ok(Some(n)) -> n;
        Ok(None) -> ({ return false; });
        Err(_) -> ({ return false; });
    };
    Text<48> item = Text<48> {};
    item.clear();
    case list_item<48>(f.list, row, &item) of {
        Ok(_) -> _;
        Err(_) -> ({ return false; });
    };
    f.selected.clear();
    i32 i = 0;
    while (i < item.len()) {
        if (item.data[i] == ' ') { break; }
        if (item.data[i] == '/') { break; }
        f.selected.push((u8)item.data[i]);
        i++;
        if (i >= fs.NAME_MAX - 1) { break; }
    }
    return true;
}

/**
 * Updates the status label when the selected row changes.
 * @param id DOM node ID supplied by the list change event.
 */
void (borrow Files f) select(NodeId id) {
    if (!f.load_selected()) { return; }
    str shown = f.selected.as_str();
    ui.set_text_fmt(f.status, "selected %s", shown, 0);
}

/**
 * Enters the selected directory or routes the selected file to an @open application.
 * @param id DOM node ID supplied by the open/activate event.
 */
void (borrow Files f) open(NodeId id) {
    if (!f.load_selected()) { ui.set_text(f.status, "select a file first"); return; }
    Text<16> name = f.selected;
    bool directory = case f.selected_is_dir() of {
        Ok(value) -> value;
        Err(_) -> ({ ui.set_text(f.status, "could not read selected item"); return; });
    };
    if (directory) { f.enter(name.as_str()); return; }
    ui.open(f.path_of(name.as_str()));
}

/**
 * Opens the editor on the default new-file path.
 * @param id DOM node ID supplied by the New-button event (unused).
 */
void (borrow Files f) create(NodeId id) {
    ui.open(f.path_of("untitled.txt"));
}

// --- delete confirmation dialog ---

/** Closes the active confirmation dialog, if one exists. */
void (borrow Files f) close_dialog() {
    case f.dialog of {
        Some(dialog) -> ({ ui.close(dialog); f.dialog = None; });
        None -> _;
    };
}

/**
 * Removes the selected file after confirmation and refreshes the list.
 * @param id DOM node ID supplied by the confirmation button (unused).
 */
void (borrow Files f) confirm_delete(NodeId id) {
    f.close_dialog();
    if (!f.load_selected()) { return; }
    Text<16> name = f.selected;
    case fs.remove(f.path_of(name.as_str())) of {
        Ok(_) -> ({ f.refresh(); ui.set_text(f.status, "deleted"); });
        Err(e) -> ({ ui.set_error(f.status, "delete failed", e.describe()); });
    };
}

/**
 * Dismisses the delete confirmation without changing the filesystem.
 * @param id DOM node ID supplied by the cancel button (unused).
 */
void (borrow Files f) cancel_delete(NodeId id) {
    f.close_dialog();
}

/**
 * Opens a confirmation dialog for deleting the selected entry.
 * @param id DOM node ID supplied by the Delete-button event (unused).
 */
void (borrow Files f) delete(NodeId id) {
    if (!f.load_selected()) { ui.set_text(f.status, "select a file first"); return; }
    f.close_dialog();
    f.question.clear();
    f.question.append("Delete \"");
    f.question.append(f.selected.as_str());
    f.question.append("\" permanently?");
    Option<NodeId> enclosing = case ui.window_of(f.list) of {
        Ok(value) -> value;
        Err(_) -> ({ ui.set_text(f.status, "window lookup failed"); return; });
    };
    NodeId win = case enclosing of {
        Some(value) -> value;
        None -> ({ ui.set_text(f.status, "window not found"); return; });
    };
    i32 wx = case ui.window_x(win) of { Ok(value) -> value + 60; Err(_) -> ({ return; }); };
    i32 wy = case ui.window_y(win) of { Ok(value) -> value + 90; Err(_) -> ({ return; }); };
    str question = f.question.as_str();
    NodeId dialog = <Window title="Delete file?" x={wx} y={wy} w={340} h={140}>
        <Label text={question} x={20} y={16} />
        <Row x={20} y={60} w={300} h={34} gap={10}>
            <PrimaryButton text="Delete" w={110} h={34} onClick={f.confirm_delete} />
            <Button text="Cancel" w={110} h={34} onClick={f.cancel_delete} />
        </Row>
    </Window>;
    f.dialog = Some(dialog);
    ui.show(dialog);
}
