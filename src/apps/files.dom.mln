package files;

import elements from "../../../MyAppFramework/src/elements.mln";
import ui from "../../../MyAppFramework/src/ui.mln";
import { app } from "../../../MyAppFramework/src/annotations.mln";
import fs from "@std/hosted/fs.mln";
import str from "@std/text/str.mln";
import { InlineString } from "@std/text/inline_string.mln";
import { InlineCString } from "@std/text/inline_c_string.mln";
import { Result } from "@std/core/result.mln";
import { FsError } from "../../../../contracts/io/fs.contract.mln";
import { UiError } from "../../../../contracts/ui/widget.contract.mln";
import { Option } from "@std/core/option.mln";

// File manager: lists the MFS disk, opens a file in the editor (activate a
// row, or the Open button), deletes after a confirmation dialog, and creates
// new files through the editor. It does not know the editor: ui.open(path)
// goes to whichever app declares @open.
//
// The confirmation dialog is a second window the instance builds on demand.
// Nodes created from a handler belong to the instance that ran it, so if the
// user closes Files while the dialog is up, the dialog goes with it.

/**
 * Per-window file-manager state, including its list and transient dialog buffers.
 * @property list DOM node ID of the directory-entry list.
 * @property status DOM node ID of the status label.
 * @property dialog DOM node ID of the active confirmation dialog, or zero.
 * @property items Newline-separated display rows backing the list widget.
 * @property selected Name of the currently selected entry.
 * @property question Text shown in the delete-confirmation dialog.
 * @property dir Current directory path; an empty string denotes the root.
 * @property path Scratch buffer used to assemble child paths.
 */
struct Files {
    i32 list;
    i32 status;
    i32 dialog;          // open confirmation window, or 0
    InlineCString<1024> items;   // "\n"-joined list rows
    InlineCString<16> selected;  // name of the selected row
    InlineCString<64> question;  // dialog text
    InlineCString<64> dir;       // the directory shown ("" = root)
    InlineCString<80> path;      // dir + "/" + a name
};

@app(single)
/**
 * Builds the file-manager window, loads the root directory, and focuses its list.
 * @return DOM node ID of the file-manager window.
 */
i32 (Files *f) view() {
    i32 muted = ui.rgb(0x6B, 0x72, 0x80);
    i32 win = <Window title="Files" x={60} y={60} w={440} h={400}>
        <List ref={f->list} name="files" x={12} y={12} w={416} h={270} capacity={1024}
              onChange={f->select} onActivate={f->open} testId="file-list" />
        <Row x={12} y={294} w={416} h={34} gap={8}>
            <PrimaryButton text="Open" w={90} h={34} onClick={f->open} />
            <Button text="New" w={80} h={34} onClick={f->create} />
            <Button text="Delete" w={90} h={34} onClick={f->delete} />
            <Button text="Refresh" w={96} h={34} onClick={f->refresh} />
        </Row>
        <Label ref={f->status} text="" x={12} y={340} color={muted} testId="files-status" />
    </Window>;
    f->refresh(0);
    ui.focus(f->list);
    return win;
}

// `name` inside the directory shown, as a path.
/**
 * Builds a path under the currently displayed directory.
 * @param name NUL-terminated child entry name.
 * @return Pointer to the instance's reusable path buffer.
 */
char* (Files *f) path_of(char *name) {
    f->path.clear();
    if (!f->dir.is_empty()) {
        f->path.append(f->dir.as_str());
        f->path.append("/");
    }
    f->path.append(str.from_c(name));
    return f->path.as_ptr();
}

// Rebuild the list from the directory shown: ".." first unless at the
// root, then one row per entry -- "name/" for a directory, "name  (N
// bytes)" for a file.
/**
 * Refreshes the list widget and status label from the current directory.
 * @param id DOM event argument (unused).
 */
void (Files *f) refresh(i32 id) {
    InlineCString<16> name = InlineCString<16> {};
    f->items.clear();
    i32 start = 0;
    i32 count = 0;
    if (!f->dir.is_empty()) {
        f->items.append("..");
        count++;
    }
    while (1) {
        // None ends enumeration; Err reports a disk failure.
        name.clear();
        Result<Option<i32>, FsError> res = fs.dir_next_at(f->dir.as_ptr(), start, name.as_ptr(), name.data.length);
        i32 idx = case res of {
            Ok(v) -> case v of { Some(n) -> n; None -> ({ break; }); };
            Err(_) -> ({ ui.set_text(f->status, "disk error"); return; });
        };
        name.sync_from_ptr();
        if (count > 0) { f->items.append("\n"); }
        f->items.append(name.as_str());
        Result<bool, FsError> directory = fs.is_dir(idx);
        bool is_directory = case directory of {
            Ok(value) -> value;
            Err(_) -> ({ ui.set_text(f->status, "disk error"); return; });
        };
        if (is_directory) {
            f->items.append("/");
        } else {
            Result<i32, FsError> size_result = fs.entry_size(idx);
            i32 size = case size_result of {
                Ok(value) -> value;
                Err(_) -> ({ ui.set_text(f->status, "disk error"); return; });
            };
            f->items.append("   (");
            InlineString<12> size_text = size.to_string();
            f->items.append(size_text.as_str());
            f->items.append(" bytes)");
        }
        count++;
        start = idx + 1;
    }
    ui.list_set_items(f->list, f->items.as_ptr());
    if (!f->dir.is_empty()) {
        ui.set_text_fmt(f->status, "/%s: %d entries", (i32)(f->dir.as_ptr()), count - 1);
    } else {
        ui.set_text_fmt(f->status, "%d entries on disk", count, 0);
    }
    f->selected.clear();
}

// Whether the selected row is a directory ("name/" or "..").
/**
 * Tests whether the selected row represents a directory or the parent entry.
 * @return 1 for a directory or parent row; 0 for a file or unavailable selection.
 */
i32 (Files *f) selected_is_dir() {
    Result<Option<i32>, UiError> selected = ui.list_selected(f->list);
    i32 row = case selected of {
        Ok(v) -> case v of {
            Some(n) -> n;
            None -> ({ return 0; });
        };
        Err(_) -> ({ return 0; });
    };
    InlineCString<48> item = InlineCString<48> {};
    item.clear();
    Result<i32, UiError> copied = ui.list_item(f->list, row, item.as_ptr(), item.data.length);
    case copied of {
        Ok(_) -> _;
        Err(_) -> ({ return 0; });
    };
    item.sync_from_ptr();
    if (item.len() == 2 && item.data[0] == '.' && item.data[1] == '.') { return 1; }
    if (!item.is_empty() && item.data[item.len() - 1] == '/') { return 1; }
    return 0;
}

// Enter the selected directory (".." goes up), and show it.
/**
 * Changes the displayed directory and refreshes its contents.
 * @param name Directory name to enter, or ".." to move to the parent.
 */
void (Files *f) enter(char *name) {
    if (name[0] == '.' && name[1] == '.' && name[2] == 0) {
        i32 n = f->dir.len();
        while (n > 0 && f->dir.data[n - 1] != '/') { n--; }
        if (n > 0) { n--; }
        f->dir.truncate(n);
    } else {
        if (!f->dir.is_empty()) { f->dir.append("/"); }
        f->dir.append(str.from_c(name));
    }
    f->refresh(0);
}

// The selected row's file name (the part before the size), or 0.
/**
 * Copies the selected entry's name out of its display row.
 * @return Pointer to the instance's selected-name buffer, or null if no row is selected.
 */
char* (Files *f) selected_name() {
    Result<Option<i32>, UiError> selected = ui.list_selected(f->list);
    i32 row = case selected of {
        Ok(v) -> case v of {
            Some(n) -> n;
            None -> ({ return (char*)0; });
        };
        Err(_) -> ({ return (char*)0; });
    };
    InlineCString<48> item = InlineCString<48> {};
    item.clear();
    Result<i32, UiError> copied = ui.list_item(f->list, row, item.as_ptr(), item.data.length);
    case copied of {
        Ok(_) -> _;
        Err(_) -> ({ return (char*)0; });
    };
    item.sync_from_ptr();
    f->selected.clear();
    i32 i = 0;
    while (i < item.len()) {
        if (item.data[i] == ' ') { break; }
        if (item.data[i] == '/') { break; }
        f->selected.push((u8)item.data[i]);
        i++;
        if (i >= fs.NAME_MAX - 1) { break; }
    }
    return f->selected.as_ptr();
}

/**
 * Updates the status label when the selected row changes.
 * @param id DOM node ID supplied by the list change event.
 */
void (Files *f) select(i32 id) {
    char *name = f->selected_name();
    if (name == 0) { return; }
    ui.set_text_fmt(f->status, "selected %s", (i32)name, 0);
}

/**
 * Enters the selected directory or routes the selected file to an @open application.
 * @param id DOM node ID supplied by the open/activate event.
 */
void (Files *f) open(i32 id) {
    char *name = f->selected_name();
    if (name == 0) { ui.set_text(f->status, "select a file first"); return; }
    if (f->selected_is_dir()) { f->enter(name); return; }
    ui.open(f->path_of(name));
}

/**
 * Opens the editor on the default new-file path.
 * @param id DOM node ID supplied by the New-button event (unused).
 */
void (Files *f) create(i32 id) {
    ui.open(f->path_of("untitled.txt"));
}

// --- delete confirmation dialog ---

/** Closes the active confirmation dialog, if one exists. */
void (Files *f) close_dialog() {
    if (f->dialog != 0) {
        ui.close(f->dialog);
        f->dialog = 0;
    }
}

/**
 * Removes the selected file after confirmation and refreshes the list.
 * @param id DOM node ID supplied by the confirmation button (unused).
 */
void (Files *f) confirm_delete(i32 id) {
    f->close_dialog();
    char *name = f->selected_name();
    if (name == 0) { return; }
    Result<_, FsError> removed = fs.remove(f->path_of(name));
    case removed of {
        Ok(_) -> ({ f->refresh(0); ui.set_text(f->status, "deleted"); });
        Err(_) -> ({ ui.set_text(f->status, "delete failed"); });
    };
}

/**
 * Dismisses the delete confirmation without changing the filesystem.
 * @param id DOM node ID supplied by the cancel button (unused).
 */
void (Files *f) cancel_delete(i32 id) {
    f->close_dialog();
}

/**
 * Opens a confirmation dialog for deleting the selected entry.
 * @param id DOM node ID supplied by the Delete-button event (unused).
 */
void (Files *f) delete(i32 id) {
    char *name = f->selected_name();
    if (name == 0) { ui.set_text(f->status, "select a file first"); return; }
    f->close_dialog();
    f->question.clear();
    f->question.append("Delete \"");
    f->question.append(str.from_c(name));
    f->question.append("\" permanently?");
    Option<i32> enclosing = case ui.window_of(f->list) of {
        Ok(value) -> value;
        Err(_) -> ({ ui.set_text(f->status, "window lookup failed"); return; });
    };
    i32 win = case enclosing of {
        Some(value) -> value;
        None -> ({ ui.set_text(f->status, "window not found"); return; });
    };
    i32 wx = case ui.window_x(win) of { Ok(value) -> value + 60; Err(_) -> ({ return; }); };
    i32 wy = case ui.window_y(win) of { Ok(value) -> value + 90; Err(_) -> ({ return; }); };
    f->dialog = <Window title="Delete file?" x={wx} y={wy} w={340} h={140}>
        <Label text={f->question.as_ptr()} x={20} y={16} />
        <Row x={20} y={60} w={300} h={34} gap={10}>
            <PrimaryButton text="Delete" w={110} h={34} onClick={f->confirm_delete} />
            <Button text="Cancel" w={110} h={34} onClick={f->cancel_delete} />
        </Row>
    </Window>;
    ui.show(f->dialog);
}
