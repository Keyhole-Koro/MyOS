package files;

import dom_widgets from "../ui/dom/dom_widgets.mln";
import dom from "../ui/dom/dom.mln";
import dom_elements from "../ui/dom/dom_elements.mln";
import graphics from "../ui/graphics.mln";
import fs from "../fs/fs.mln";
import fs_config from "../fs/fs_config.mln";
import editor from "editor.dom.mln";
import strbuf from "../../../../toolchain/MyStdLib/text/strbuf.mln";
import { Result } from "../../../../toolchain/MyStdLib/result.mln";
import { FsError } from "../fs/fs.mln";
import { Option } from "../../../../toolchain/MyStdLib/option.mln";

// File manager: lists the MFS disk, opens a file in the editor (activate a
// row, or the Open button), deletes after a confirmation dialog, and creates
// new files through the editor.

i32 g_win = 0;
i32 g_list = 0;
i32 g_status = 0;
i32 g_dialog = 0;
char g_items[1024];
char g_selected[16];
char g_status_buf[64];

/**
 * Updates the file manager status label with the provided message.
 * @param s Status text to display.
 */
void files_status(char *s) { dom.set_text(g_status, s); }

/**
 * Scans the filesystem and refreshes the file manager list with directory entries and file counts.
 */
export void refresh() {
    char name[16];
    i32 k = strbuf.reset(&g_items[0]);
    i32 start = 0;
    i32 count = 0;
    while (1) {
        i32 idx = 0;
        i32 has_more = case fs.dir_next(start, &name[0], 16) of {
            Ok(opt) -> case opt of {
                Some(v) -> ({ idx = v; 1; });
                None -> 0;
            };
            Err(e) -> ({ files_status("disk error"); 0; });
        };
        if (has_more == 0) { break; }
        if (count > 0) { k = strbuf.append(&g_items[0], 1024, k, "\n"); }
        k = strbuf.append(&g_items[0], 1024, k, &name[0]);
        k = strbuf.append(&g_items[0], 1024, k, "   (");
        k = strbuf.append_i32(&g_items[0], 1024, k, fs.entry_size(idx));
        k = strbuf.append(&g_items[0], 1024, k, " bytes)");
        count++;
        start = idx + 1;
    }
    dom_widgets.list_set_items(g_list, &g_items[0]);
    i32 s = strbuf.reset(&g_status_buf[0]);
    s = strbuf.append_i32(&g_status_buf[0], 64, s, count);
    s = strbuf.append(&g_status_buf[0], 64, s, " file(s) on disk");
    files_status(&g_status_buf[0]);
    strbuf.reset(&g_selected[0]);
}

/**
 * Extracts and returns the filename from the currently selected list row.
 * @return Pointer to extracted filename buffer, or null pointer if nothing is selected.
 */
char* selected_name() {
    Option<i32> ls = dom_widgets.list_selected(g_list);
    i32 row = case ls of { Some(v) -> v; None -> ({ return (char*)0; }); };
    char item[48];
    case dom_widgets.list_item(g_list, row, &item[0], 48) of {
        Some(_) -> _;
        None -> ({ return (char*)0; });
    };
    i32 i = 0;
    while (item[i] != 0) {
        if (item[i] == ' ') { break; }
        g_selected[i] = item[i];
        i++;
        if (i >= fs_config.NAME_MAX - 1) { break; }
    }
    g_selected[i] = (char)0;
    return &g_selected[0];
}

/**
 * Selection change callback for the file list: displays the selected filename in the status label.
 * @param id List node ID.
 */
void on_select(i32 id) {
    char *name = selected_name();
    if (name == 0) { return; }
    i32 k = strbuf.reset(&g_status_buf[0]);
    k = strbuf.append(&g_status_buf[0], 64, k, "selected ");
    k = strbuf.append(&g_status_buf[0], 64, k, name);
    files_status(&g_status_buf[0]);
}

/**
 * Click handler for the 'Open' button or row double-click: opens the selected file in the editor.
 * @param id Button or List node ID.
 */
void on_open(i32 id) {
    char *name = selected_name();
    if (name == 0) { files_status("select a file first"); return; }
    editor.forget_if_closed();
    editor.open(name);
}

/**
 * Click handler for the 'New' button: opens a new untitled file in the editor.
 * @param id Button node ID.
 */
void on_new(i32 id) {
    editor.forget_if_closed();
    editor.open("untitled.txt");
}

/**
 * Click handler for the 'Refresh' button: re-reads the filesystem directory.
 * @param id Button node ID.
 */
void on_refresh(i32 id) { refresh(); }

// --- delete confirmation dialog ---

/**
 * Closes and destroys the delete confirmation dialog window if one is currently open.
 */
void close_dialog() {
    if (g_dialog != 0) {
        dom_widgets.close_window(g_dialog);
        g_dialog = 0;
    }
}

/**
 * Click handler for the dialog 'Delete' button: deletes the chosen file and refreshes the list.
 * @param id Button node ID.
 */
void on_confirm_delete(i32 id) {
    close_dialog();
    char *name = selected_name();
    if (name == 0) { return; }
    Result<_, FsError> removed = fs.remove(name);
    case removed of { Ok(_) -> _; Err(_) -> _; };
    refresh();
    files_status("deleted");
}

/**
 * Click handler for the dialog 'Cancel' button: closes the confirmation dialog without deleting.
 * @param id Button node ID.
 */
void on_cancel_delete(i32 id) {
    close_dialog();
}

char g_question[64];

/**
 * Constructs the DOM subtree for the modal delete confirmation dialog window.
 * @param x Horizontal window position in logical pixels.
 * @param y Vertical window position in logical pixels.
 * @return Dialog Window node ID.
 */
i32 build_dialog(i32 x, i32 y) {
    return <Window title="Delete file?" x={x} y={y} w={340} h={140}>
        <Label text="" x={20} y={16} color={0} bold={0} />
        <Row x={20} y={60} w={300} h={34} padding={0} gap={10}>
            <PrimaryButton text="Delete" x={0} y={0} w={110} h={34} onClick={on_confirm_delete} />
            <Button text="Cancel" x={0} y={0} w={110} h={34} onClick={on_cancel_delete} />
        </Row>
    </Window>;
}

/**
 * Click handler for the 'Delete' button: prompts user with a confirmation dialog to delete the selected file.
 * @param id Button node ID.
 */
void on_delete(i32 id) {
    char *name = selected_name();
    if (name == 0) { files_status("select a file first"); return; }
    close_dialog();
    i32 k = strbuf.reset(&g_question[0]);
    k = strbuf.append(&g_question[0], 64, k, "Delete \"");
    k = strbuf.append(&g_question[0], 64, k, name);
    k = strbuf.append(&g_question[0], 64, k, "\" permanently?");
    i32 s = dom.ui_scale();
    i32 wx = dom.node_x(g_win) / s + 60;
    i32 wy = dom.node_y(g_win) / s + 90;
    g_dialog = build_dialog(wx, wy);
    dom.append_child(dom.desktop_id(), g_dialog);
    dom.set_text(dom.first_child(g_dialog), &g_question[0]);
    dom_widgets.focus_window(g_dialog);
}

/**
 * No-op callback for file manager UI elements.
 * @param id Node ID.
 */
void files_noop(i32 id) { }

/**
 * Constructs the declarative DOM subtree for the main Files application window.
 * @return Root Window node ID.
 */
i32 build_ui() {
    i32 muted = graphics.rgb(0x6B, 0x72, 0x80);
    return <Window title="Files" x={60} y={60} w={440} h={400}>
        <List name="files" x={12} y={12} w={416} h={270} capacity={1024} onChange={on_select} onActivate={on_open} />
        <Row x={12} y={294} w={416} h={34} padding={0} gap={8}>
            <PrimaryButton text="Open" x={0} y={0} w={90} h={34} onClick={on_open} />
            <Button text="New" x={0} y={0} w={80} h={34} onClick={on_new} />
            <Button text="Delete" x={0} y={0} w={90} h={34} onClick={on_delete} />
            <Button text="Refresh" x={0} y={0} w={96} h={34} onClick={on_refresh} />
        </Row>
        <Label text="" x={12} y={340} color={muted} bold={0} />
    </Window>;
}

/**
 * Mounts or focuses the singleton Files application window on the desktop.
 * @return Window node ID.
 */
export i32 mount() {
    if (g_win != 0) {
        if (dom.node_exists(g_win) == 0) { g_win = 0; }
    }
    if (g_win == 0) {
        g_win = build_ui();
        dom.append_child(dom.desktop_id(), g_win);
        g_list = dom.first_child(g_win);
        i32 row = dom.next_sibling(g_list);
        g_status = dom.next_sibling(row);
        dom.set_test_id(g_list, "file-list");
        dom.set_test_id(g_status, "files-status");
    }
    refresh();
    dom_widgets.focus_window(g_win);
    dom_widgets.set_focus(g_list);
    return g_win;
}
