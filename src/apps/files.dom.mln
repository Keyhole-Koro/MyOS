package files;

import dom_elements from "../ui/dom/dom_elements.mln";
import ui from "../app/ui.mln";
import fs from "../fs/fs.mln";
import strbuf from "../../../../toolchain/MyStdLib/text/strbuf.mln";
import { Result } from "../../../../toolchain/MyStdLib/result.mln";
import { FsError } from "../fs/fs.mln";
import { Option } from "../../../../toolchain/MyStdLib/option.mln";

// File manager: lists the MFS disk, opens a file in the editor (activate a
// row, or the Open button), deletes after a confirmation dialog, and creates
// new files through the editor. It does not know the editor: ui.open(path)
// goes to whichever app declares @open.
//
// The confirmation dialog is a second window the instance builds on demand.
// Nodes created from a handler belong to the instance that ran it, so if the
// user closes Files while the dialog is up, the dialog goes with it.

@app(single)
struct Files {
    i32 list;
    i32 status;
    i32 dialog;          // open confirmation window, or 0
};

// Text buffers the widgets point at. Module-level rather than fields because
// the app is single-instance and an array field cannot be indexed through
// a pointer yet (`f->items[0]` does not parse).
char g_items[1024];    // "\n"-joined list rows
char g_selected[16];   // name of the selected row
char g_question[64];   // dialog text

i32 (Files *f) view() {
    i32 muted = ui.rgb(0x6B, 0x72, 0x80);
    i32 win = <Window title="Files" x={60} y={60} w={440} h={400}>
        <List ref={f->list} name="files" x={12} y={12} w={416} h={270} capacity={1024}
              onChange={f->select} onActivate={f->open} testId="file-list" />
        <Row x={12} y={294} w={416} h={34} gap={8}>
            <PrimaryButton text="Open" w={90} h={34} onClick={f->open} />
            <Button text="New" w={80} h={34} onClick={f->create} />
            <Button text="Delete" w={90} h={34} onClick={f->delete} />
            <Button text="Refresh" w={96} h={34} onClick={f->refresh} />
        </Row>
        <Label ref={f->status} text="" x={12} y={340} color={muted} testId="files-status" />
    </Window>;
    f->refresh(0);
    ui.focus(f->list);
    return win;
}

// Rebuild the list from the disk: one "name  (N bytes)" row per file.
void (Files *f) refresh(i32 id) {
    char name[16];
    i32 k = strbuf.reset(&g_items[0]);
    i32 start = 0;
    i32 count = 0;
    while (1) {
        // Decode the nested Result<Option> with statement-level cases: a
        // struct-valued case arm (`Ok(v) -> v` into an Option local) is not
        // copied correctly yet, while `case v of` on the bound field is.
        Result<Option<i32>, FsError> res = fs.dir_next(start, &name[0], 16);
        i32 idx = -1;
        case res of {
            Ok(v) -> ({ idx = case v of { Some(n) -> n; None -> -1; }; });
            Err(e) -> ({ ui.set_text(f->status, "disk error"); return; });
        };
        if (idx < 0) { break; }
        if (count > 0) { k = strbuf.append(&g_items[0], 1024, k, "\n"); }
        k = strbuf.append(&g_items[0], 1024, k, &name[0]);
        k = strbuf.append(&g_items[0], 1024, k, "   (");
        k = strbuf.append_i32(&g_items[0], 1024, k, fs.entry_size(idx));
        k = strbuf.append(&g_items[0], 1024, k, " bytes)");
        count++;
        start = idx + 1;
    }
    ui.list_set_items(f->list, &g_items[0]);
    ui.set_text_fmt(f->status, "%d file(s) on disk", count, 0);
    strbuf.reset(&g_selected[0]);
}

// The selected row's file name (the part before the size), or 0.
char* (Files *f) selected_name() {
    i32 row = ui.list_selected(f->list);
    if (row < 0) { return (char*)0; }
    char item[48];
    ui.list_item(f->list, row, &item[0], 48);
    i32 i = 0;
    while (item[i] != 0) {
        if (item[i] == ' ') { break; }
        g_selected[i] = item[i];
        i++;
        if (i >= fs.NAME_MAX - 1) { break; }
    }
    g_selected[i] = (char)0;
    return &g_selected[0];
}

void (Files *f) select(i32 id) {
    char *name = f->selected_name();
    if (name == 0) { return; }
    ui.set_text_fmt(f->status, "selected %s", (i32)name, 0);
}

void (Files *f) open(i32 id) {
    char *name = f->selected_name();
    if (name == 0) { ui.set_text(f->status, "select a file first"); return; }
    ui.open(name);
}

void (Files *f) create(i32 id) {
    ui.open("untitled.txt");
}

// --- delete confirmation dialog ---

void (Files *f) close_dialog() {
    if (f->dialog != 0) {
        ui.close(f->dialog);
        f->dialog = 0;
    }
}

void (Files *f) confirm_delete(i32 id) {
    f->close_dialog();
    char *name = f->selected_name();
    if (name == 0) { return; }
    Result<_, FsError> removed = fs.remove(name);
    case removed of { Ok(_) -> _; Err(_) -> _; };
    f->refresh(0);
    ui.set_text(f->status, "deleted");
}

void (Files *f) cancel_delete(i32 id) {
    f->close_dialog();
}

void (Files *f) delete(i32 id) {
    char *name = f->selected_name();
    if (name == 0) { ui.set_text(f->status, "select a file first"); return; }
    f->close_dialog();
    i32 k = strbuf.reset(&g_question[0]);
    k = strbuf.append(&g_question[0], 64, k, "Delete \"");
    k = strbuf.append(&g_question[0], 64, k, name);
    k = strbuf.append(&g_question[0], 64, k, "\" permanently?");
    i32 win = ui.window_of(f->list);
    i32 wx = ui.window_x(win) + 60;
    i32 wy = ui.window_y(win) + 90;
    f->dialog = <Window title="Delete file?" x={wx} y={wy} w={340} h={140}>
        <Label text={&g_question[0]} x={20} y={16} />
        <Row x={20} y={60} w={300} h={34} gap={10}>
            <PrimaryButton text="Delete" w={110} h={34} onClick={f->confirm_delete} />
            <Button text="Cancel" w={110} h={34} onClick={f->cancel_delete} />
        </Row>
    </Window>;
    ui.show(f->dialog);
}
