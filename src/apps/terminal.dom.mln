package terminal;

import dom_widgets from "../ui/dom/dom_widgets.mln";
import dom from "../ui/dom/dom.mln";
import dom_elements from "../ui/dom/dom_elements.mln";
import console from "../proc/console.mln";
import fs from "../fs/fs.mln";
import heap from "../../../MyKernel/src/mm/heap.mln";
import irq from "../../../MyKernel/src/arch/irq.mln";
import str from "../../../../toolchain/MyStdLib/str.mln";
import strbuf from "../../../../toolchain/MyStdLib/text/strbuf.mln";
import { Result } from "../../../../toolchain/MyStdLib/result.mln";
import { FsError } from "../fs/fs.mln";
import { Option } from "../../../../toolchain/MyStdLib/option.mln";

// Terminal: a read-only TextArea for output and a command line. Lines typed
// while a user process is attached go to its stdin; otherwise they are
// built-in commands (help, ls, cat, clear, run). `run hello` (or just
// `hello`) loads the executable from the disk image and starts it as a
// separate process whose stdout lands in this window (see proc/console.mln).
// A timer polls the process and prints its exit code.

i32 INSTANCES = 4;
i32 g_out[4];      // output TextArea per instance
i32 g_in[4];       // command TextInput per instance
i32 g_win[4];
i32 g_pid[4];      // attached process, 0 = none
i32 g_count = 0;
i32 g_timer = 0;

/**
 * Looks up the terminal instance slot index corresponding to an input field node ID.
 * @param input_id TextInput node ID.
 * @return Option containing the slot index, or None.
 */
Option<i32> slot_of_input(i32 input_id) {
    i32 i = 0;
    while (i < g_count) {
        if (g_in[i] == input_id) { return Some(i); }
        i++;
    }
    return None;
}

/**
 * Looks up the terminal instance slot index corresponding to a window node ID.
 * @param win Window node ID.
 * @return Option containing the slot index, or None.
 */
Option<i32> slot_of_window(i32 win) {
    i32 i = 0;
    while (i < g_count) {
        if (g_win[i] == win) { return Some(i); }
        i++;
    }
    return None;
}

/**
 * Appends text to the terminal output area while temporarily disabling interrupts.
 * @param slot Terminal instance slot index.
 * @param s String to append.
 */
void say(i32 slot, char *s) {
    irq.disable();
    dom_widgets.append_text(g_out[slot], s);
    irq.enable();
}

/**
 * Appends a string followed by a newline to the terminal output area.
 * @param slot Terminal instance slot index.
 * @param s String to append.
 */
void say_line(i32 slot, char *s) {
    dom_widgets.append_text(g_out[slot], s);
    dom_widgets.append_text(g_out[slot], "\n");
}

char g_line_buf[96];

/**
 * Executes the built-in 'ls' command, listing files and sizes on disk.
 * @param slot Terminal instance slot index.
 */
void cmd_ls(i32 slot) {
    char name[16];
    i32 n = 0;
    i32 start = 0;
    while (1) {
        i32 idx = 0;
        i32 has_more = case fs.dir_next(start, &name[0], 16) of {
            Ok(opt) -> case opt of {
                Some(v) -> ({ idx = v; 1; });
                None -> 0;
            };
            Err(e) -> ({ say_line(slot, "ls: filesystem error"); 0; });
        };
        if (has_more == 0) { break; }
        i32 size = fs.entry_size(idx);
        i32 k = strbuf.reset(&g_line_buf[0]);
        k = strbuf.append(&g_line_buf[0], 96, k, "  ");
        k = strbuf.append(&g_line_buf[0], 96, k, &name[0]);
        k = strbuf.append(&g_line_buf[0], 96, k, "  ");
        k = strbuf.append_i32(&g_line_buf[0], 96, k, size);
        k = strbuf.append(&g_line_buf[0], 96, k, " bytes\n");
        say(slot, &g_line_buf[0]);
        n = n + 1;
        start = idx + 1;
    }
    if (n == 0) { say_line(slot, "  (no files)"); }
}

/**
 * Executes the built-in 'cat' command, printing file contents to the output area.
 * @param slot Terminal instance slot index.
 * @param path File path to display.
 */
void cmd_cat(i32 slot, char *path) {
    i32 fd = case fs.open(path) of {
        Ok(v) -> v;
        Err(e) -> ({ say_line(slot, "cat: no such file"); return; });
    };
    char chunk[64];
    while (1) {
        i32 got = case fs.read(fd, (i32)(&chunk[0]), 63) of {
            Ok(v) -> v;
            Err(e) -> 0;
        };
        if (got <= 0) { break; }
        chunk[got] = (char)0;
        say(slot, &chunk[0]);
    }
    fs.close(fd);
    say(slot, "\n");
}

/**
 * Spawns an executable file from disk and binds its I/O to the terminal slot.
 * @param slot Terminal instance slot index.
 * @param path Executable file path to run.
 */
void cmd_run(i32 slot, char *path) {
    if (g_pid[slot] != 0) {
        say_line(slot, "a process is still running here");
        return;
    }
    i32 pid = console.spawn_file(path);
    if (pid <= 0) {
        say_line(slot, "run: cannot start that (no such file, or not an executable)");
        return;
    }
    console.bind(pid, g_out[slot]);
    g_pid[slot] = pid;
    i32 k = strbuf.reset(&g_line_buf[0]);
    k = strbuf.append(&g_line_buf[0], 96, k, "[pid ");
    k = strbuf.append_i32(&g_line_buf[0], 96, k, pid);
    k = strbuf.append(&g_line_buf[0], 96, k, "] ");
    k = strbuf.append(&g_line_buf[0], 96, k, path);
    k = strbuf.append(&g_line_buf[0], 96, k, "\n");
    say(slot, &g_line_buf[0]);
}

/**
 * Splits a command string at the first space character in place and returns the argument.
 * @param line Command string buffer.
 * @return Pointer to argument substring, or pointer to trailing null.
 */
char* split_arg(char *line) {
    i32 i = 0;
    while (line[i] != 0) {
        if (line[i] == ' ') {
            line[i] = (char)0;
            i++;
            while (line[i] == ' ') { i++; }
            return &line[i];
        }
        i++;
    }
    return &line[i];
}

char g_cmd[96];

/**
 * Dispatches a line of command input to the running child process or built-in commands.
 * @param slot Terminal instance slot index.
 * @param line Command line text.
 */
void run_line(i32 slot, char *line) {
    // Echo the command line into the transcript.
    say(slot, "$ ");
    say_line(slot, line);

    if (g_pid[slot] != 0) {
        console.feed_line(g_pid[slot], line);
        return;
    }
    // Work on a copy: split_arg edits in place.
    i32 k = strbuf.reset(&g_cmd[0]);
    k = strbuf.append(&g_cmd[0], 96, k, line);
    char *arg = split_arg(&g_cmd[0]);
    char *cmd = &g_cmd[0];
    if (cmd[0] == 0) { return; }
    if (str.eq(cmd, "help") != 0) {
        say_line(slot, "help          this text");
        say_line(slot, "ls            list files on the disk");
        say_line(slot, "cat <file>    print a file");
        say_line(slot, "run <file>    start a user program (or just type its name)");
        say_line(slot, "clear         clear the screen");
        return;
    }
    if (str.eq(cmd, "ls") != 0) { cmd_ls(slot); return; }
    if (str.eq(cmd, "clear") != 0) { dom_widgets.clear_text_area(g_out[slot]); return; }
    if (str.eq(cmd, "cat") != 0) { cmd_cat(slot, arg); return; }
    if (str.eq(cmd, "run") != 0) { cmd_run(slot, arg); return; }
    cmd_run(slot, cmd);
}

/**
 * Key event handler for the command line input: executes command on Enter key (code 13).
 * @param id TextInput node ID.
 * @param code Key character or scan code.
 * @param mods Keyboard modifier flags.
 * @return 1 if handled, 0 otherwise.
 */
i32 on_key(i32 id, i32 code, i32 mods) {
    if (code != 13) { return 0; }
    i32 slot = case slot_of_input(id) of {
        Some(v) -> v;
        None -> ({ return 0; });
    };
    char *text = dom.text_of(id);
    i32 k = strbuf.reset(&g_line_buf[0]);
    k = strbuf.append(&g_line_buf[0], 96, k, text);
    dom_widgets.set_input_text(id, "");
    run_line(slot, &g_line_buf[0]);
    return 1;
}

/**
 * Click handler for the 'Run' button: submits the current command line input.
 * @param id Button node ID.
 */
void on_run_button(i32 id) {
    i32 win = dom.window_of(id);
    i32 slot = case slot_of_window(win) of { Some(v) -> v; None -> ({ return; }); };
    on_key(g_in[slot], 13, 0);
    dom_widgets.set_focus(g_in[slot]);
}

/**
 * No-op event handler for terminal UI elements.
 * @param id Node ID.
 */
void terminal_noop(i32 id) { }

/**
 * Periodic timer callback that polls child processes and reaps terminated ones.
 * @param id Timer node ID.
 */
void on_poll(i32 id) {
    i32 i = 0;
    while (i < g_count) {
        i32 pid = g_pid[i];
        if (pid != 0) {
            if (console.has_exited(pid) != 0) {
                i32 code = console.reap(pid);
                g_pid[i] = 0;
                i32 k = strbuf.reset(&g_line_buf[0]);
                k = strbuf.append(&g_line_buf[0], 96, k, "[pid ");
                k = strbuf.append_i32(&g_line_buf[0], 96, k, pid);
                k = strbuf.append(&g_line_buf[0], 96, k, " exited with ");
                k = strbuf.append_i32(&g_line_buf[0], 96, k, code);
                k = strbuf.append(&g_line_buf[0], 96, k, "]\n");
                say(i, &g_line_buf[0]);
            }
        }
        i++;
    }
}

/**
 * Constructs the declarative DOM subtree for a Terminal window instance.
 * @param x Horizontal window position in logical pixels.
 * @param y Vertical window position in logical pixels.
 * @return Root Window node ID.
 */
i32 build_ui(i32 x, i32 y) {
    return <Window title="Terminal" x={x} y={y} w={560} h={400}>
        <TextArea name="output" x={12} y={12} w={536} h={296} capacity={6144} readonly={1} onChange={terminal_noop} />
        <Row x={12} y={320} w={536} h={34} padding={0} gap={8}>
            <TextInput placeholder="type a command, e.g. help" x={0} y={0} w={440} h={34} capacity={96} onChange={terminal_noop} />
            <PrimaryButton text="Run" x={0} y={0} w={88} h={34} onClick={on_run_button} />
        </Row>
    </Window>;
}

/**
 * Mounts a new cascaded Terminal window instance to the desktop.
 * @return Window node ID, or 0 if instance table is full.
 */
export i32 mount() {
    if (g_count >= INSTANCES) { return 0; }
    i32 off = 24 * g_count;
    i32 win = build_ui(220 + off, 40 + off);
    dom.append_child(dom.desktop_id(), win);

    i32 out = dom.first_child(win);
    i32 row = dom.next_sibling(out);
    i32 input = dom.first_child(row);
    dom.set_on_key(input, on_key);
    dom.set_test_id(out, "terminal-output");
    dom.set_test_id(input, "terminal-input");

    i32 slot = g_count;
    g_out[slot] = out;
    g_in[slot] = input;
    g_win[slot] = win;
    g_pid[slot] = 0;
    g_count = g_count + 1;

    if (g_timer == 0) { g_timer = dom_widgets.create_timer(100, on_poll); }

    say_line(slot, "MyOS terminal. Type help, ls, or the name of a program (hello, echo, count).");
    dom_widgets.set_focus(input);
    return win;
}
