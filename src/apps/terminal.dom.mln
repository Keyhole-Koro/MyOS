package terminal;

import app from "@app/app.mln";
import { App, View } from "@app/app.mln";
import elements from "@app/elements.mln";
import ui from "@app/ui.mln";
import { Screen } from "@app/ui.mln";
import { app, timer } from "@app/annotations.mln";
import terminal from "@app/terminal.mln";
import process from "@std/hosted/process.mln";
import { Option } from "@std/core/option.mln";
import { Result } from "@std/core/result.mln";
import { SpawnError } from "@contracts/process/spawn.contract.mln";
import { Pid, ProcessControlError, ProcessExitStatus } from "@contracts/process/control.contract.mln";

// Terminal: a screen with /bin/sh on it. The shell reads the lines typed on
// the screen and starts the programs they name, which write to the same
// screen (user/apps/sh.mln). The window only starts the shell, and goes when
// the shell ends.

/**
 * The state of a terminal.
 * @property screen What the shell runs on.
 * @property shell The shell, while it runs.
 */
@app
struct Terminal {
    Screen screen;
    Option<Pid> shell;
};

impl App for Terminal {
    Self start() { return Terminal { screen: ui.screen() }; }

    View (Self t) view() {
        return <Window title="Terminal" w={600} h={400}>
            <Terminal screen={t.screen} w={600} h={368} focus={true} testId="terminal" />
        </Window>;
    }

    /** The shell starts on the launch, the first open. */
    void (borrow Self t) open(str path) {
        if (t.shell.is_some()) { return; }
        case terminal.spawn_bound("sh", t.screen) of {
            Ok(pid) -> ({ t.shell = Some(pid); });
            Err(e) -> ({
                t.screen.write("sh: ");
                t.screen.write(e.describe());
                t.screen.write("\n");
            });
        };
    }
}

// The shell has ended, with `exit`: so does the window.
@timer(200)
/** Closes the terminal once its shell has ended. */
void (borrow Terminal t) poll() {
    Pid pid = case t.shell of { Some(value) -> value; None -> ({ return; }); };
    bool exited = case process.has_exited(pid) of {
        Ok(value) -> value;
        Err(_) -> true;
    };
    if (exited) { app.quit(); }
}

i32 main() { return app.run<Terminal>(); }
