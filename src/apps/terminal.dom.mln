package terminal;

import dom_elements from "../ui/dom/dom_elements.mln";
import ui from "../app/ui.mln";
import console from "../proc/console.mln";
import fs from "../fs/fs.mln";
import irq from "../../../MyKernel/src/arch/irq.mln";
import str from "../../../../toolchain/MyStdLib/str.mln";
import strbuf from "../../../../toolchain/MyStdLib/text/strbuf.mln";
import { Result } from "../../../../toolchain/MyStdLib/result.mln";
import { FsError } from "../fs/fs.mln";
import { Option } from "../../../../toolchain/MyStdLib/option.mln";

// Terminal: a read-only TextArea for output and a command line. Lines typed
// while a user process is attached go to its stdin; otherwise they are
// built-in commands (help, ls, cat, clear, run). `run hello` (or just
// `hello`) loads the executable from the disk image and starts it as a
// separate process whose stdout lands in this window (see proc/console.mln).
// Each instance polls its own process on a @timer and prints the exit code.

i32 g_opened = 0;

@app
struct Terminal {
    i32 out;      // output TextArea
    i32 input;    // command TextInput
    i32 pid = 0;  // attached process, 0 = none
};

i32 (Terminal *t) view() {
    i32 off = 24 * g_opened;
    g_opened++;
    i32 win = <Window title="Terminal" x={220 + off} y={40 + off} w={560} h={400}>
        <TextArea ref={t->out} name="output" x={12} y={12} w={536} h={296} capacity={6144} readonly={1} testId="terminal-output" />
        <Row x={12} y={320} w={536} h={34} gap={8}>
            <TextInput ref={t->input} placeholder="type a command, e.g. help" w={440} h={34} capacity={96} testId="terminal-input" />
            <PrimaryButton text="Run" w={88} h={34} onClick={t->submit} />
        </Row>
    </Window>;
    t->say_line("MyOS terminal. Type help, ls, or the name of a program (hello, echo, count).");
    ui.focus(t->input);
    return win;
}

// A user process writes to the same TextArea from its stdout syscall, which
// runs with interrupts off; the terminal's own writes run on the compositor
// task with interrupts on. Disable interrupts around the compositor-side
// append so a timer tick cannot switch to the process mid-append and let the
// two interleave into the shared buffer.
void (Terminal *t) say(char *s) {
    irq.disable();
    ui.area_append(t->out, s);
    irq.enable();
}

void (Terminal *t) say_line(char *s) {
    t->say(s);
    t->say("\n");
}

char g_line_buf[96];   // scratch for one formatted line

void (Terminal *t) cmd_ls() {
    char name[16];
    i32 n = 0;
    i32 start = 0;
    while (1) {
        // See files.dom.mln's refresh(): decode Result<Option> in two
        // statement-level cases.
        Result<Option<i32>, FsError> res = fs.dir_next(start, &name[0], 16);
        i32 idx = -1;
        case res of {
            Ok(v) -> ({ idx = case v of { Some(n) -> n; None -> -1; }; });
            Err(e) -> ({ t->say_line("ls: filesystem error"); return; });
        };
        if (idx < 0) { break; }
        i32 size = fs.entry_size(idx);
        i32 k = strbuf.reset(&g_line_buf[0]);
        k = strbuf.append(&g_line_buf[0], 96, k, "  ");
        k = strbuf.append(&g_line_buf[0], 96, k, &name[0]);
        k = strbuf.append(&g_line_buf[0], 96, k, "  ");
        k = strbuf.append_i32(&g_line_buf[0], 96, k, size);
        k = strbuf.append(&g_line_buf[0], 96, k, " bytes\n");
        t->say(&g_line_buf[0]);
        n++;
        start = idx + 1;
    }
    if (n == 0) { t->say_line("  (no files)"); }
}

void (Terminal *t) cmd_cat(char *path) {
    i32 fd = case fs.open(path) of {
        Ok(v) -> v;
        Err(e) -> ({ t->say_line("cat: no such file"); return; });
    };
    char chunk[64];
    while (1) {
        i32 got = case fs.read(fd, (i32)(&chunk[0]), 63) of {
            Ok(v) -> v;
            Err(e) -> 0;
        };
        if (got <= 0) { break; }
        chunk[got] = (char)0;
        t->say(&chunk[0]);
    }
    fs.close(fd);
    t->say("\n");
}

void (Terminal *t) cmd_run(char *path) {
    if (t->pid != 0) {
        t->say_line("a process is still running here");
        return;
    }
    i32 pid = console.spawn_file(path);
    if (pid <= 0) {
        t->say_line("run: cannot start that (no such file, or not an executable)");
        return;
    }
    console.bind(pid, t->out);
    t->pid = pid;
    i32 k = strbuf.reset(&g_line_buf[0]);
    k = strbuf.append(&g_line_buf[0], 96, k, "[pid ");
    k = strbuf.append_i32(&g_line_buf[0], 96, k, pid);
    k = strbuf.append(&g_line_buf[0], 96, k, "] ");
    k = strbuf.append(&g_line_buf[0], 96, k, path);
    k = strbuf.append(&g_line_buf[0], 96, k, "\n");
    t->say(&g_line_buf[0]);
}

// Split "cmd arg" at the first space (in place) and return the argument.
char* split_arg(char *line) {
    i32 i = 0;
    while (line[i] != 0) {
        if (line[i] == ' ') {
            line[i] = (char)0;
            i++;
            while (line[i] == ' ') { i++; }
            return &line[i];
        }
        i++;
    }
    return &line[i];
}

char g_cmd[96];

void (Terminal *t) run_line(char *line) {
    // Echo the command line into the transcript.
    t->say("$ ");
    t->say_line(line);

    if (t->pid != 0) {
        console.feed_line(t->pid, line);
        return;
    }
    // Work on a copy: split_arg edits in place.
    i32 k = strbuf.reset(&g_cmd[0]);
    k = strbuf.append(&g_cmd[0], 96, k, line);
    char *arg = split_arg(&g_cmd[0]);
    char *cmd = &g_cmd[0];
    if (cmd[0] == 0) { return; }
    if (str.eq(cmd, "help") != 0) {
        t->say_line("help          this text");
        t->say_line("ls            list files on the disk");
        t->say_line("cat <file>    print a file");
        t->say_line("run <file>    start a user program (or just type its name)");
        t->say_line("clear         clear the screen");
        return;
    }
    if (str.eq(cmd, "ls") != 0) { t->cmd_ls(); return; }
    if (str.eq(cmd, "clear") != 0) { ui.area_clear(t->out); return; }
    if (str.eq(cmd, "cat") != 0) { t->cmd_cat(arg); return; }
    if (str.eq(cmd, "run") != 0) { t->cmd_run(arg); return; }
    t->cmd_run(cmd);
}

// Enter anywhere in the window, or the Run button, submits the command line.
@key("Enter")
void (Terminal *t) submit(i32 id) {
    char *text = ui.text_of(t->input);
    i32 k = strbuf.reset(&g_line_buf[0]);
    k = strbuf.append(&g_line_buf[0], 96, k, text);
    ui.input_set(t->input, "");
    t->run_line(&g_line_buf[0]);
    ui.focus(t->input);
}

// Poll the attached process; report and reap it once it exits.
@timer(100)
void (Terminal *t) poll() {
    if (t->pid == 0) { return; }
    if (console.has_exited(t->pid) == 0) { return; }
    i32 pid = t->pid;
    i32 code = console.reap(pid);
    t->pid = 0;
    i32 k = strbuf.reset(&g_line_buf[0]);
    k = strbuf.append(&g_line_buf[0], 96, k, "[pid ");
    k = strbuf.append_i32(&g_line_buf[0], 96, k, pid);
    k = strbuf.append(&g_line_buf[0], 96, k, " exited with ");
    k = strbuf.append_i32(&g_line_buf[0], 96, k, code);
    k = strbuf.append(&g_line_buf[0], 96, k, "]\n");
    t->say(&g_line_buf[0]);
}

// Closing the window while a process is attached: stop routing its output
// to a TextArea that no longer exists.
@on_close
void (Terminal *t) closing() {
    if (t->pid != 0) { console.unbind(t->pid); }
}
