package editor;

import elements from "../../../MyAppFramework/src/elements.mln";
import ui from "../../../MyAppFramework/src/ui.mln";
import { app, open, key } from "../../../MyAppFramework/src/annotations.mln";
import fs from "../../../../toolchain/MyStdLib/hosted/fs.mln";
import { Result } from "../../../../toolchain/MyStdLib/result.mln";
import { FsError } from "../../../../contracts/io/fs.contract.mln";

// Text editor: a TextArea over one file on the MFS disk. Save rewrites the
// file (MFS writes are append-only, so the file is removed and recreated).
//
// Single instance: `@app(single)` makes a second launch focus the existing
// window, and `ui.open(path)` from another app (Files) lands in the @open
// method of the running instance -- or of a fresh one if none is open.

i32 CAP = 4096;

/**
 * Per-window state for the single-instance text editor.
 * @property area DOM node ID of the editable text area.
 * @property name DOM node ID of the filename input.
 * @property status DOM node ID of the status label.
 * @property save_name Scratch buffer holding the filename copied from the input.
 * @property save_text Scratch buffer holding text copied from the editor before saving.
 */
struct Editor {
    i32 area;     // TextArea
    i32 name;     // filename TextInput
    i32 status;   // Label
    char save_name[32];
    char save_text[4096];
};

@app(single)
/** Builds the editor window and opens a scratch document for a plain launch.
 * @return DOM node ID of the editor window.
 */
i32 (Editor *e) view() {
    i32 muted = ui.rgb(0x6B, 0x72, 0x80);
    i32 win = <Window title="Editor" x={300} y={120} w={520} h={420}>
        <Row x={12} y={12} w={496} h={34} gap={8}>
            <TextInput ref={e->name} placeholder="file name" w={300} h={34} capacity={16} testId="editor-name" />
            <PrimaryButton text="Save" w={90} h={34} onClick={e->save} />
        </Row>
        <TextArea ref={e->area} name="Type here..." x={12} y={56} w={496} h={294} capacity={4096} testId="editor-text" />
        <Label ref={e->status} text="" x={12} y={360} color={muted} testId="editor-status" />
    </Window>;
    // A plain launch starts on a scratch file; ui.open() replaces it.
    e->open("untitled.txt");
    return win;
}

// Load `path` into the text area (empty when the file does not exist).
@open
/**
 * Opens a file into the editor, or leaves an empty document for a new path.
 * @param path NUL-terminated file path to load.
 */
void (Editor *e) open(char *path) {
    ui.input_set(e->name, path);
    ui.area_clear(e->area);
    ui.focus(e->area);
    i32 fd = case fs.open(path) of {
        Ok(v) -> v;
        Err(_) -> ({ ui.set_text(e->status, "new file"); return; });
    };
    char chunk[128];
    i32 total = 0;
    while (1) {
        i32 got = case fs.read(fd, (i32)(&chunk[0]), 127) of {
            Ok(v) -> v;
            Err(_) -> ({
                fs.close(fd);
                ui.set_text(e->status, "read failed: filesystem error");
                return;
            });
        };
        if (got <= 0) { break; }
        chunk[got] = (char)0;
        ui.area_append(e->area, &chunk[0]);
        total = total + got;
    }
    fs.close(fd);
    // area_append leaves the caret at the end; start at the top instead.
    ui.send_key(1, 0x105, 0); // Home of the last line
    ui.set_text_fmt(e->status, "loaded %d bytes", total, 0);
}

@key("Ctrl+S")
/** Saves the editor contents under the filename currently in the name field.
 * @param id DOM node ID supplied by the key event.
 */
void (Editor *e) save(i32 id) {
    char *path = &e->save_name[0];
    ui.text_copy(e->name, path, 32);
    if (path[0] == 0) { ui.set_text(e->status, "enter a file name first"); return; }
    char *text = &e->save_text[0];
    i32 len = ui.text_copy(e->area, text, 4096);
    // Bind the Result: a discarded aggregate return has no out-pointer.
    Result<_, FsError> removed = fs.remove(path);
    case removed of { Ok(_) -> _; Err(_) -> _; };
    i32 fd = case fs.create(path) of {
        Ok(v) -> v;
        Err(_) -> ({ ui.set_text(e->status, "save failed: cannot create file"); return; });
    };
    i32 written = 0;
    if (len > 0) {
        Result<i32, FsError> write_result = fs.write(fd, (i32)text, len);
        written = case write_result of {
            Ok(v) -> v;
            Err(_) -> ({
                fs.close(fd);
                ui.set_text(e->status, "save failed: filesystem error");
                return;
            });
        };
    }
    fs.close(fd);
    ui.set_text_fmt(e->status, "saved %d bytes", written, 0);
}
