package editor;

import app from "@app/app.mln";
import { App, View } from "@app/app.mln";
import elements from "@app/elements.mln";
import ui from "@app/ui.mln";
import { TextField } from "@app/ui.mln";
import { app, key } from "@app/annotations.mln";
import fs from "@std/hosted/fs.mln";
import { FsChunk } from "@std/hosted/fs.mln";
import str from "@std/text/str.mln";
import { Result } from "@std/core/result.mln";
import { FsError } from "@contracts/io/fs.contract.mln";
import { Text } from "@std/text/text.mln";
import { KeyEventType, KeyCode } from "@contracts/input/keyboard.contract.mln";

// Text editor: a TextArea over one file on the MFS disk. Save rewrites the
// file (MFS writes are append-only, so the file is removed and recreated).
//
// The text being edited stays in the DOM and is read on save. Single instance:
// `single` makes a second launch focus the existing window, and `ui.open(path)`
// from another app (Files) lands in `open` of the running instance, or of a
// fresh one if none is open.

/**
 * The editor's state.
 * @property name The file name field.
 * @property body The text being edited.
 * @property status What the last load or save did.
 */
@app(name = "Editor", single, opens)
struct Editor {
    TextField name;
    TextField body;
    Text<96> status;
};

impl App for Editor {
    Self start() { return Editor { name: ui.field(), body: ui.field() }; }

    View (Self e) view() {
        return <Window title="Editor" w={520} h={420}>
            <Row x={12} y={12} w={496} h={34} gap={8}>
                <TextInput field={e.name} placeholder="file name" w={300} h={34} capacity={16} testId="editor-name" />
                <PrimaryButton text="Save" w={90} h={34} onClick={e.save} />
            </Row>
            <TextArea field={e.body} name="Type here..." x={12} y={56} w={496} h={294} capacity={4096} testId="editor-text" />
            <Label text={e.status} x={12} y={360} color={ui.TEXT_SECONDARY} testId="editor-status" />
        </Window>;
    }

    /**
     * Loads a file, or leaves an empty document for a new path.
     * @param path File path to load; a plain launch starts on a scratch file.
     */
    void (borrow Self e) open(str path) {
        if (path.is_empty()) { e.open("untitled.txt"); return; }
        e.name.write(path);
        e.body.clear();
        e.body.focus();
        i32 fd = case fs.open(path) of {
            Ok(v) -> v;
            Err(_) -> ({ e.show("new file"); return; });
        };
        i32 total = 0;
        while (1) {
            FsChunk chunk = case fs.read(fd) of {
                Ok(v) -> v;
                Err(error) -> ({
                    fs.close(fd);
                    e.show_error("read failed", error.describe());
                    return;
                });
            };
            if (chunk.got <= 0) { break; }
            e.body.append(chunk.text.as_str());
            total = total + chunk.got;
        }
        fs.close(fd);
        // Appending leaves the caret at the end; start at the top instead.
        ui.send_key(KeyEventType::DOWN, KeyCode::HOME, 0); // Home of the last line
        e.show_bytes("loaded", total);
    }
}

/** Puts `text` on the status line. */
void (borrow Editor e) show(str text) {
    e.status.clear();
    e.status.append(text);
}

/** Shows a failure as `what: <message>`. */
void (borrow Editor e) show_error(str what, str message) {
    e.show(what);
    e.status.append(": ");
    e.status.append(message);
}

/** Shows `<verb> <n> bytes`. */
void (borrow Editor e) show_bytes(str verb, i32 n) {
    Text<12> count = n.to_string();
    e.show(verb);
    e.status.append(" ");
    e.status.append(count.as_str());
    e.status.append(" bytes");
}

@key("Ctrl+S")
/** Saves the body under the file name in the name field. */
void (borrow Editor e) save() {
    // A read lasts until the next one, and the body is read next.
    Text<32> name = Text<32> {};
    name.append(e.name.read());
    str path = name.as_str();
    if (path.is_empty()) { e.show("enter a file name first"); return; }
    str body = e.body.read();
    fs.remove(path);
    i32 fd = case fs.create(path) of {
        Ok(v) -> v;
        Err(error) -> ({ e.show_error("save failed", error.describe()); return; });
    };
    i32 written = 0;
    if (!body.is_empty()) {
        written = case fs.write(fd, body) of {
            Ok(v) -> v;
            Err(error) -> ({
                fs.close(fd);
                e.show_error("save failed", error.describe());
                return;
            });
        };
    }
    fs.close(fd);
    e.show_bytes("saved", written);
}

i32 main() { return app.run<Editor>(); }
