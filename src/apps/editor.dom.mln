package editor;

import dom_elements from "../ui/dom/dom_elements.mln";
import ui from "../app/ui.mln";
import fs from "../fs/fs.mln";
import { Result } from "../../../../toolchain/MyStdLib/result.mln";
import { FsError } from "../fs/fs.mln";

// Text editor: a TextArea over one file on the MFS disk. Save rewrites the
// file (MFS writes are append-only, so the file is removed and recreated).
//
// Single instance: `@app(single)` makes a second launch focus the existing
// window, and `ui.open(path)` from another app (Files) lands in the @open
// method of the running instance -- or of a fresh one if none is open.

i32 CAP = 4096;

@app(single)
struct Editor {
    i32 area;     // TextArea
    i32 name;     // filename TextInput
    i32 status;   // Label
};

i32 (Editor *e) view() {
    i32 muted = ui.rgb(0x6B, 0x72, 0x80);
    i32 win = <Window title="Editor" x={300} y={120} w={520} h={420}>
        <Row x={12} y={12} w={496} h={34} gap={8}>
            <TextInput ref={e->name} placeholder="file name" w={300} h={34} capacity={16} testId="editor-name" />
            <PrimaryButton text="Save" w={90} h={34} onClick={e->save} />
        </Row>
        <TextArea ref={e->area} name="Type here..." x={12} y={56} w={496} h={294} capacity={4096} testId="editor-text" />
        <Label ref={e->status} text="" x={12} y={360} color={muted} testId="editor-status" />
    </Window>;
    // A plain launch starts on a scratch file; ui.open() replaces it.
    e->open("untitled.txt");
    return win;
}

// Load `path` into the text area (empty when the file does not exist).
@open
void (Editor *e) open(char *path) {
    ui.input_set(e->name, path);
    ui.area_clear(e->area);
    ui.focus(e->area);
    i32 fd = case fs.open(path) of {
        Ok(v) -> v;
        Err(err) -> ({ ui.set_text(e->status, "new file"); return; });
    };
    char chunk[128];
    i32 total = 0;
    while (1) {
        i32 got = case fs.read(fd, (i32)(&chunk[0]), 127) of {
            Ok(v) -> v;
            Err(err) -> 0;
        };
        if (got <= 0) { break; }
        chunk[got] = (char)0;
        ui.area_append(e->area, &chunk[0]);
        total = total + got;
    }
    fs.close(fd);
    // area_append leaves the caret at the end; start at the top instead.
    ui.send_key(1, 0x105, 0); // Home of the last line
    ui.set_text_fmt(e->status, "loaded %d bytes", total, 0);
}

@key("Ctrl+S")
void (Editor *e) save(i32 id) {
    char *path = ui.text_of(e->name);
    if (path == 0) { return; }
    if (path[0] == 0) { ui.set_text(e->status, "enter a file name first"); return; }
    char *text = ui.text_of(e->area);
    i32 len = 0;
    while (text[len] != 0) { len++; }
    // Bind the Result: a discarded aggregate return has no out-pointer.
    Result<_, FsError> removed = fs.remove(path);
    case removed of { Ok(_) -> _; Err(_) -> _; };
    i32 fd = case fs.create(path) of {
        Ok(v) -> v;
        Err(err) -> ({ ui.set_text(e->status, "save failed: cannot create file"); return; });
    };
    i32 written = 0;
    if (len > 0) {
        written = case fs.write(fd, (i32)text, len) of {
            Ok(v) -> v;
            Err(err) -> 0;
        };
    }
    fs.close(fd);
    ui.set_text_fmt(e->status, "saved %d bytes", written, 0);
}
