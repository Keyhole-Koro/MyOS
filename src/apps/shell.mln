package shell;

import debug from "../../../MyKernel/src/debug/debug.mln";
import fs from "../fs/fs.mln";
import scheduler from "../../../MyKernel/src/kernel/scheduler.mln";
import serial from "../../../MyKernel/src/io/serial.mln";
import str from "../../../../toolchain/MyStdLib/str.mln";
import strbuf from "../../../../toolchain/MyStdLib/text/strbuf.mln";

// Block until a keystroke is available in the serial input queue, yielding the
// CPU while waiting. The serial IRQ handler fills the queue from hardware RX;
// reading the queue (not hardware RX) avoids racing the IRQ handler for bytes.
i32 read_char() {
    while (serial.has_input() == 0) {
        scheduler.sleep(1); // Yield so other tasks (the UI) keep running.
    }
    return serial.read_input();
}

export void run() {
    debug.println("Starting OS shell...");
    char buf[128];
    i32 len = 0;

    while (1) {
        debug.print("MyOS> ");
        len = strbuf.reset(&buf[0]);

        while (1) {
            i32 c = read_char();
            if (c == 13 || c == 10) {
                debug.println("");
                break;
            }
            if (c == 8 || c == 127) {
                if (len > 0) {
                    len = strbuf.truncate(&buf[0], len, 1);
                    // Backspace, space, backspace to erase char on terminal
                    debug.print("\b \b");
                }
            } else {
                i32 next = strbuf.push(&buf[0], 128, len, c);
                if (next != len) {
                    len = next;
                    char tmp[2];
                    tmp[0] = c;
                    tmp[1] = 0;
                    debug.print(tmp);
                }
            }
        }

        if (len > 0) {
            if (str.eq(&buf[0], "help") != 0) {
                debug.println("Commands:");
                debug.println("  help  - Show this help");
                debug.println("  ls    - List files");
                debug.println("  hello - Print a greeting");
            } else if (str.eq(&buf[0], "ls") != 0) {
                fs.list();
            } else if (str.eq(&buf[0], "hello") != 0) {
                debug.println("Hello from MyOS Shell!");
            } else {
                debug.print("Unknown command: ");
                debug.println(&buf[0]);
            }
        }
    }
}
