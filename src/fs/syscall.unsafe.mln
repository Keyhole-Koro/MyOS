/**
 * Filesystem syscall boundary.
 *
 * Validates and copies user buffers across the process boundary and forwards
 * filesystem operations to the underlying MyOS filesystem subsystem. Simple
 * operations are dispatched directly in handle(); helpers exist only where
 * buffers must be copied or chunked across address spaces.
 * Every range a call names -- its record, path, buffer and result_out -- is
 * checked before the operation runs, so a call the kernel answers with
 * BadAddress opens, reads, writes or removes nothing.
 * Result and FsError values are transferred intact without conversion to integer codes.
 */
namespace fs_syscall;

import mem from "@kernel/mm/mem.mln";
import str from "@std/text/str.mln";
import { Result } from "@std/core/result.mln";
import { Option } from "@std/core/option.mln";
import { OsCall, OsServiceError } from "@contracts/myos/services.contract.mln";
import { FsError } from "@contracts/io/fs.contract.mln";
import {
    FsOpenArgs, FsCreateArgs, FsMkdirArgs, FsRemoveArgs, FsReadArgs,
    FsWriteArgs, FsSeekArgs, FsCloseArgs, FsDirNextArgs,
    FsEntrySizeArgs, FsIsDirArgs
} from "@contracts/myos/fs-args.contract.mln";
import fs from "fs.mln";
import user_memory from "@os/syscall/user_memory.mln";
import { copy_in_text } from "@os/syscall/user_memory.mln";
import { UserAddress } from "@std/core/address.mln";
import { Pid } from "@contracts/process/control.contract.mln";
import { Text } from "@std/text/text.mln";
import debug from "@kernel/debug/debug.mln";
import error_trace from "@std/debug/error_trace.mln";

Text<64> g_path;
char g_io[512];
Text<16> g_name;
Text<768> g_trace_text;

/**
 * Logs where a filesystem error came from before it crosses to user space.
 * Only an image built with `--error-trace` records sites; otherwise the trace
 * is empty and nothing is printed.
 * @param failed Whether the operation's Result is an Err.
 */
void log_error_trace(bool failed) {
    if (!failed || error_trace.depth() == 0) { return; }
    error_trace.format(&g_trace_text);
    debug.print(g_trace_text.as_str());
    error_trace.clear();
}

/**
 * Whether service is the one A's contract binds it to, so a record is only
 * ever read under its own service number.
 * @param service Requested OsService wire value.
 * @return Whether service selects A.
 */
bool accept<A: OsCall>(i32 service) {
    return service == A::service();
}

/**
 * Copies the caller's argument record.
 * @param caller Calling process.
 * @param user_args User address of the caller's record.
 * @param out Kernel copy of the record.
 * @return false when the record is not the caller's to read; out is then not filled.
 */
bool fetch<A>(Pid caller, UserAddress user_args, A *out) {
    return user_memory.copy_in(caller, user_args, (char*)out, sizeof(A));
}

/**
 * Checks a record's reply slot before the operation that fills it runs.
 * @param caller Calling process.
 * @param user_out The record's result_out user address.
 * @return false when the slot is not the caller's to write.
 */
bool answerable<T>(Pid caller, T *user_out) {
    return user_memory.writable(caller, UserAddress((i32)user_out), sizeof(T));
}

/**
 * Writes a service result to the reply slot named by an argument record.
 * @param caller Calling process.
 * @param user_out The record's result_out user address.
 * @param value Kernel copy of the result.
 */
void reply<T>(Pid caller, T *user_out, T *value) {
    user_memory.copy_out(caller, UserAddress((i32)user_out), (char*)value, sizeof(T));
}

/**
 * Answers for a file the caller does not hold: to it, no such descriptor exists.
 * @param caller Calling process.
 * @param fd Descriptor it named.
 * @param user_out The record's result_out user address.
 * @return True when the request is refused and already answered.
 */
bool refused(Pid caller, i32 fd, Result<i32, FsError> *user_out) {
    if (fs.usable_by(fd, caller)) { return false; }
    Result<i32, FsError> out = Err(FsError::BadFd(fd));
    reply<Result<i32, FsError>>(caller, user_out, &out);
    return true;
}

/**
 * Hands a file just opened for a process to that process.
 * @param opened What open or create returned.
 * @param caller Calling process.
 */
void keep(Result<i32, FsError> opened, Pid caller) {
    case opened of {
        Ok(fd) -> fs.give_to(fd, caller);
        Err(_) -> _;
    };
}

/**
 * Reads bytes into a user buffer through a bounded kernel staging buffer.
 *
 * Reads data in chunks of up to 512 bytes via an intermediate kernel buffer.
 * handle() has checked the whole buffer and result_out.
 *
 * @param caller Calling process.
 * @param args Kernel copy of the caller's FsReadArgs.
 * Completes the read and writes its typed result to user memory.
 */
void read_user(Pid caller, FsReadArgs *args) {
    i32 fd = args->fd;
    UserAddress user_buf = UserAddress((i32)args->buffer);
    i32 size = args->size;
    i32 total = 0;
    while (total < size) {
        i32 want = size - total;
        if (want > 512) { want = 512; }
        Result<i32, FsError> r = fs.read(fd, (i32)(&g_io[0]), want);
        i32 got = 0;
        case r of {
            Ok(v) -> ({ got = v; });
            Err(e) -> ({
                log_error_trace(true);
                Result<i32, FsError> out = Err(e);
                if (total != 0) { out = Ok(total); }
                reply<Result<i32, FsError>>(caller, args->result_out, &out);
                return;
            });
        };
        if (got == 0) { break; }
        user_memory.copy_out(caller, user_buf.plus(total), &g_io[0], got);
        total = total + got;
        if (got < want) { break; }
    }
    Result<i32, FsError> out = Ok(total);
    reply<Result<i32, FsError>>(caller, args->result_out, &out);
}

/**
 * Writes bytes from a user buffer through a bounded kernel staging buffer.
 *
 * Copies data from user space in chunks of up to 512 bytes before writing.
 * handle() has checked the whole buffer and result_out.
 *
 * @param caller Calling process.
 * @param args Kernel copy of the caller's FsWriteArgs.
 * Completes the write and writes its typed result to user memory.
 */
void write_user(Pid caller, FsWriteArgs *args) {
    i32 fd = args->fd;
    UserAddress user_buf = UserAddress((i32)args->buffer);
    i32 size = args->size;
    i32 total = 0;
    while (total < size) {
        i32 n = size - total;
        if (n > 512) { n = 512; }
        if (!user_memory.copy_in(caller, user_buf.plus(total), &g_io[0], n)) { return; }
        Result<i32, FsError> r = fs.write(fd, (i32)(&g_io[0]), n);
        i32 put = 0;
        case r of {
            Ok(v) -> ({ put = v; });
            Err(e) -> ({
                Result<i32, FsError> out = Err(e);
                if (total != 0) { out = Ok(total); }
                reply<Result<i32, FsError>>(caller, args->result_out, &out);
                return;
            });
        };
        total = total + put;
        if (put < n) { break; }
    }
    Result<i32, FsError> out = Ok(total);
    reply<Result<i32, FsError>>(caller, args->result_out, &out);
}

/**
 * Enumerates a directory and copies the optional name into user memory.
 * The path and the name's destination are checked before the directory is read.
 *
 * @param caller Calling process.
 * @param args Kernel copy of the caller's FsDirNextArgs.
 * Completes the enumeration and writes its typed result to user memory.
 */
void dir_next_user(Pid caller, FsDirNextArgs *args) {
    char nul[1];
    nul[0] = (char)0;
    if (!copy_in_path(caller, args->path, args->path_length)) { return; }
    i32 start = args->start;
    UserAddress user_out = UserAddress((i32)args->name_out);
    i32 cap = args->name_cap;
    if (cap < 0) { cap = 0; }
    if (cap > 16) { cap = 16; }
    if (!user_memory.writable(caller, user_out, cap)) { return; }
    Result<Option<i32>, FsError> res = fs.dir_next_at(g_path.as_str(), start, &g_name);
    case res of {
        Ok(v) -> ({
            case v of {
                Some(idx) -> ({
                    if (cap > 0) {
                        i32 n = g_name.len() + 1;
                        if (n > cap) { n = cap; }
                        user_memory.copy_out(caller, user_out, g_name.as_ptr(), n);
                        user_memory.copy_out(caller, user_out.plus(cap - 1), &nul[0], 1);
                    }
                });
                None -> _;
            };
        });
        Err(_) -> _;
    };
    reply<Result<Option<i32>, FsError>>(caller, args->result_out, &res);
}

/**
 * Whether a path of this length fits the kernel's path buffer whole. One that
 * does not is answered InvalidName, not cut: what fits names another file,
 * which the operation would open, create or remove instead.
 * @param length Byte length of the path.
 */
bool path_fits(i32 length) { return length <= g_path.capacity(); }

/**
 * Copies a path argument into the shared kernel path buffer. A path that
 * does not fit (path_fits) is not read: g_path is left empty.
 * @param caller Calling process.
 * @param user_path User address of the path's first byte.
 * @param length Byte length of the path.
 * @return false when the path is not the caller's to read.
 */
bool copy_in_path(Pid caller, char *user_path, i32 length) {
    if (!path_fits(length)) {
        g_path.clear();
        return true;
    }
    return copy_in_text<64>(caller, UserAddress((i32)user_path), length, &g_path);
}

/**
 * Dispatches a filesystem service OS_CALL request.
 *
 * accept() matches service against each record's bound OsService, so a
 * record is only ever read under its own service number. Each operation then
 * checks the ranges it names -- the record itself, result_out, a path, a
 * buffer -- and does nothing unless all are the caller's: the kernel answers
 * a refused one with BadAddress.
 *
 * @param caller Calling process, which holds the files it opens.
 * @param service Filesystem service code (FS_OPEN .. FS_IS_DIR).
 * @param args Virtual address of argument structure in caller's memory.
 * @return Ok(_) when the request was handled, or Err(UnknownService).
 */
export Result<_, OsServiceError> handle(Pid caller, i32 service, UserAddress args) {
    FsReadArgs read;
    if (accept<FsReadArgs>(service)) {
        if (fetch<FsReadArgs>(caller, args, &read)
            && answerable<Result<i32, FsError>>(caller, read.result_out)
            && user_memory.writable(caller, UserAddress((i32)read.buffer), read.size)
            && !refused(caller, read.fd, read.result_out)) {
            read_user(caller, &read);
        }
        return Ok(_);
    }
    FsWriteArgs write;
    if (accept<FsWriteArgs>(service)) {
        if (fetch<FsWriteArgs>(caller, args, &write)
            && answerable<Result<i32, FsError>>(caller, write.result_out)
            && user_memory.readable(caller, UserAddress((i32)write.buffer), write.size)
            && !refused(caller, write.fd, write.result_out)) {
            write_user(caller, &write);
        }
        return Ok(_);
    }
    FsDirNextArgs dir_next;
    if (accept<FsDirNextArgs>(service)) {
        if (fetch<FsDirNextArgs>(caller, args, &dir_next)
            && answerable<Result<Option<i32>, FsError>>(caller, dir_next.result_out)) {
            dir_next_user(caller, &dir_next);
        }
        return Ok(_);
    }
    FsCloseArgs close;
    if (accept<FsCloseArgs>(service)) {
        if (fetch<FsCloseArgs>(caller, args, &close) && fs.usable_by(close.fd, caller)) { fs.close(close.fd); }
        return Ok(_);
    }
    FsEntrySizeArgs entry_size;
    if (accept<FsEntrySizeArgs>(service)) {
        if (!fetch<FsEntrySizeArgs>(caller, args, &entry_size)
            || !answerable<Result<i32, FsError>>(caller, entry_size.result_out)) { return Ok(_); }
        Result<i32, FsError> r = fs.entry_size(entry_size.entry);
        reply<Result<i32, FsError>>(caller, entry_size.result_out, &r);
        return Ok(_);
    }
    FsIsDirArgs is_dir;
    if (accept<FsIsDirArgs>(service)) {
        if (!fetch<FsIsDirArgs>(caller, args, &is_dir)
            || !answerable<Result<bool, FsError>>(caller, is_dir.result_out)) { return Ok(_); }
        Result<bool, FsError> r = fs.is_dir(is_dir.entry);
        reply<Result<bool, FsError>>(caller, is_dir.result_out, &r);
        return Ok(_);
    }
    FsSeekArgs seek;
    if (accept<FsSeekArgs>(service)) {
        if (!fetch<FsSeekArgs>(caller, args, &seek)
            || !answerable<Result<i32, FsError>>(caller, seek.result_out)) { return Ok(_); }
        if (refused(caller, seek.fd, seek.result_out)) { return Ok(_); }
        Result<i32, FsError> r = fs.seek(seek.fd, seek.offset, seek.whence);
        reply<Result<i32, FsError>>(caller, seek.result_out, &r);
        return Ok(_);
    }
    FsOpenArgs open;
    if (accept<FsOpenArgs>(service)) {
        if (!fetch<FsOpenArgs>(caller, args, &open)
            || !answerable<Result<i32, FsError>>(caller, open.result_out)
            || !copy_in_path(caller, open.path, open.path_length)) { return Ok(_); }
        Result<i32, FsError> r = Err(FsError::InvalidName);
        if (path_fits(open.path_length)) { r = fs.open(g_path.as_str()); }
        keep(r, caller);
        log_error_trace(r.is_err());
        reply<Result<i32, FsError>>(caller, open.result_out, &r);
        return Ok(_);
    }
    FsCreateArgs create;
    if (accept<FsCreateArgs>(service)) {
        if (!fetch<FsCreateArgs>(caller, args, &create)
            || !answerable<Result<i32, FsError>>(caller, create.result_out)
            || !copy_in_path(caller, create.path, create.path_length)) { return Ok(_); }
        Result<i32, FsError> r = Err(FsError::InvalidName);
        if (path_fits(create.path_length)) { r = fs.create(g_path.as_str()); }
        keep(r, caller);
        log_error_trace(r.is_err());
        reply<Result<i32, FsError>>(caller, create.result_out, &r);
        return Ok(_);
    }
    FsRemoveArgs remove;
    if (accept<FsRemoveArgs>(service)) {
        if (!fetch<FsRemoveArgs>(caller, args, &remove)
            || !answerable<Result<_, FsError>>(caller, remove.result_out)
            || !copy_in_path(caller, remove.path, remove.path_length)) { return Ok(_); }
        Result<_, FsError> r = Err(FsError::InvalidName);
        if (path_fits(remove.path_length)) { r = fs.remove(g_path.as_str()); }
        log_error_trace(r.is_err());
        reply<Result<_, FsError>>(caller, remove.result_out, &r);
        return Ok(_);
    }
    FsMkdirArgs mkdir;
    if (accept<FsMkdirArgs>(service)) {
        if (!fetch<FsMkdirArgs>(caller, args, &mkdir)
            || !answerable<Result<i32, FsError>>(caller, mkdir.result_out)
            || !copy_in_path(caller, mkdir.path, mkdir.path_length)) { return Ok(_); }
        Result<i32, FsError> r = Err(FsError::InvalidName);
        if (path_fits(mkdir.path_length)) { r = fs.mkdir(g_path.as_str()); }
        log_error_trace(r.is_err());
        reply<Result<i32, FsError>>(caller, mkdir.result_out, &r);
        return Ok(_);
    }
    return Err(OsServiceError::UnknownService(service));
}

/**
 * Closes what a process left open.
 * @param pid Process that has ended.
 */
export void process_gone(Pid pid) { fs.close_all_of(pid); }
