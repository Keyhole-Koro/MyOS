/**
 * Filesystem syscall boundary.
 *
 * Validates and copies user buffers across the process boundary and forwards
 * filesystem operations to the underlying MyOS filesystem subsystem. Simple
 * operations are dispatched directly in handle(); helpers exist only where
 * buffers must be copied or chunked across address spaces.
 * Result and FsError values are transferred intact without conversion to integer codes.
 */
package fs_syscall;

import mem from "@kernel/mm/mem.mln";
import str from "@std/text/str.mln";
import { Result } from "@std/core/result.mln";
import { Option } from "@std/core/option.mln";
import { OsCall, OsServiceError } from "@contracts/myos/services.contract.mln";
import { FsError } from "@contracts/io/fs.contract.mln";
import {
    FsOpenArgs, FsCreateArgs, FsMkdirArgs, FsRemoveArgs, FsReadArgs,
    FsWriteArgs, FsSeekArgs, FsCloseArgs, FsDirNextArgs,
    FsEntrySizeArgs, FsIsDirArgs
} from "@contracts/myos/fs-args.contract.mln";
import fs from "fs.mln";
import user_memory from "@os/syscall/user_memory.mln";
import { UserAddress } from "@std/core/address.mln";
import { Text } from "@std/text/text.mln";
import debug from "@kernel/debug/debug.mln";
import error_trace from "@std/debug/error_trace.mln";

Text<64> g_path;
char g_io[512];
Text<16> g_name;
char g_trace_text[768];

/**
 * Logs where a filesystem error came from before it crosses to user space.
 * Only an image built with `--error-trace` records sites; otherwise the trace
 * is empty and nothing is printed.
 * @param failed Whether the operation's Result is an Err.
 */
void log_error_trace(bool failed) {
    if (!failed || error_trace.depth() == 0) { return; }
    error_trace.format(&g_trace_text[0], 768);
    debug.print(&g_trace_text[0]);
    error_trace.clear();
}

/**
 * Copies the caller's argument record when service is the one its contract
 * binds to A.
 * @param service Requested OsService wire value.
 * @param user_args User address of the caller's record.
 * @param out Kernel copy of the record.
 * @return Whether service selects A; out is filled only then.
 */
bool accept<A: OsCall>(i32 service, UserAddress user_args, A *out) {
    if (service != A::service()) { return false; }
    user_memory.copy_in(user_args, (char*)out, sizeof(A));
    return true;
}

/**
 * Writes a service result to the reply slot named by an argument record.
 * @param user_out The record's result_out user address.
 * @param value Kernel copy of the result.
 */
void reply<T>(T *user_out, T *value) {
    user_memory.copy_out(UserAddress((i32)user_out), (char*)value, sizeof(T));
}

/**
 * Reads bytes into a user buffer through a bounded kernel staging buffer.
 *
 * Reads data in chunks of up to 512 bytes via an intermediate kernel buffer.
 *
 * @param args Kernel copy of the caller's FsReadArgs.
 * Completes the read and writes its typed result to user memory.
 */
void read_user(FsReadArgs *args) {
    i32 fd = args->fd;
    UserAddress user_buf = UserAddress((i32)args->buffer);
    i32 size = args->size;
    i32 total = 0;
    while (total < size) {
        i32 want = size - total;
        if (want > 512) { want = 512; }
        Result<i32, FsError> r = fs.read(fd, (i32)(&g_io[0]), want);
        i32 got = 0;
        case r of {
            Ok(v) -> ({ got = v; });
            Err(e) -> ({
                log_error_trace(true);
                Result<i32, FsError> out = Err(e);
                if (total != 0) { out = Ok(total); }
                reply<Result<i32, FsError>>(args->result_out, &out);
                return;
            });
        };
        if (got == 0) { break; }
        user_memory.copy_out(user_buf.plus(total), &g_io[0], got);
        total = total + got;
        if (got < want) { break; }
    }
    Result<i32, FsError> out = Ok(total);
    reply<Result<i32, FsError>>(args->result_out, &out);
}

/**
 * Writes bytes from a user buffer through a bounded kernel staging buffer.
 *
 * Copies data from user space in chunks of up to 512 bytes before writing.
 *
 * @param args Kernel copy of the caller's FsWriteArgs.
 * Completes the write and writes its typed result to user memory.
 */
void write_user(FsWriteArgs *args) {
    i32 fd = args->fd;
    UserAddress user_buf = UserAddress((i32)args->buffer);
    i32 size = args->size;
    i32 total = 0;
    while (total < size) {
        i32 n = size - total;
        if (n > 512) { n = 512; }
        i32 k = 0;
        while (k < n) { g_io[k] = (char)user_memory.read_byte(user_buf.plus(total + k)); k++; }
        Result<i32, FsError> r = fs.write(fd, (i32)(&g_io[0]), n);
        i32 put = 0;
        case r of {
            Ok(v) -> ({ put = v; });
            Err(e) -> ({
                Result<i32, FsError> out = Err(e);
                if (total != 0) { out = Ok(total); }
                reply<Result<i32, FsError>>(args->result_out, &out);
                return;
            });
        };
        total = total + put;
        if (put < n) { break; }
    }
    Result<i32, FsError> out = Ok(total);
    reply<Result<i32, FsError>>(args->result_out, &out);
}

/**
 * Enumerates a directory and copies the optional name into user memory.
 *
 * @param args Kernel copy of the caller's FsDirNextArgs.
 * Completes the enumeration and writes its typed result to user memory.
 */
void dir_next_user(FsDirNextArgs *args) {
    user_memory.copy_in_string(UserAddress((i32)args->path), g_path.as_ptr(), g_path.data.length);
    g_path.sync_from_ptr();
    i32 start = args->start;
    UserAddress user_out = UserAddress((i32)args->name_out);
    i32 cap = args->name_cap;
    if (cap < 0) { cap = 0; }
    if (cap > 16) { cap = 16; }
    Result<Option<i32>, FsError> res = fs.dir_next_at(g_path.as_ptr(), start, g_name.as_ptr(), g_name.data.length);
    g_name.sync_from_ptr();
    case res of {
        Ok(v) -> ({
            case v of {
                Some(idx) -> ({
                    if (cap > 0) {
                        i32 n = g_name.len() + 1;
                        if (n > cap) { n = cap; }
                        user_memory.copy_out(user_out, g_name.as_ptr(), n);
                        user_memory.write_byte(user_out.plus(cap - 1), 0);
                    }
                });
                None -> _;
            };
        });
        Err(_) -> _;
    };
    reply<Result<Option<i32>, FsError>>(args->result_out, &res);
}

/**
 * Copies a path argument into the shared kernel path buffer.
 * @param user_path User address of a NUL-terminated path.
 */
void copy_in_path(char *user_path) {
    user_memory.copy_in_string(UserAddress((i32)user_path), g_path.as_ptr(), g_path.data.length);
    g_path.sync_from_ptr();
}

/**
 * Dispatches a filesystem service OS_CALL request.
 *
 * accept() matches service against each record's bound OsService, so a
 * record is only ever read under its own service number.
 *
 * @param service Filesystem service code (FS_OPEN .. FS_IS_DIR).
 * @param args Virtual address of argument structure in caller's memory.
 * @return Ok(_) when the request was handled, or Err(UnknownService).
 */
export Result<_, OsServiceError> handle(i32 service, UserAddress args) {
    FsReadArgs read;
    if (accept<FsReadArgs>(service, args, &read)) { read_user(&read); return Ok(_); }
    FsWriteArgs write;
    if (accept<FsWriteArgs>(service, args, &write)) { write_user(&write); return Ok(_); }
    FsDirNextArgs dir_next;
    if (accept<FsDirNextArgs>(service, args, &dir_next)) { dir_next_user(&dir_next); return Ok(_); }
    FsCloseArgs close;
    if (accept<FsCloseArgs>(service, args, &close)) { fs.close(close.fd); return Ok(_); }
    FsEntrySizeArgs entry_size;
    if (accept<FsEntrySizeArgs>(service, args, &entry_size)) {
        Result<i32, FsError> r = fs.entry_size(entry_size.entry);
        reply<Result<i32, FsError>>(entry_size.result_out, &r);
        return Ok(_);
    }
    FsIsDirArgs is_dir;
    if (accept<FsIsDirArgs>(service, args, &is_dir)) {
        Result<bool, FsError> r = fs.is_dir(is_dir.entry);
        reply<Result<bool, FsError>>(is_dir.result_out, &r);
        return Ok(_);
    }
    FsSeekArgs seek;
    if (accept<FsSeekArgs>(service, args, &seek)) {
        Result<i32, FsError> r = fs.seek(seek.fd, seek.offset, seek.whence);
        reply<Result<i32, FsError>>(seek.result_out, &r);
        return Ok(_);
    }
    FsOpenArgs open;
    if (accept<FsOpenArgs>(service, args, &open)) {
        copy_in_path(open.path);
        Result<i32, FsError> r = fs.open(g_path.as_ptr());
        log_error_trace(r.is_err());
        reply<Result<i32, FsError>>(open.result_out, &r);
        return Ok(_);
    }
    FsCreateArgs create;
    if (accept<FsCreateArgs>(service, args, &create)) {
        copy_in_path(create.path);
        Result<i32, FsError> r = fs.create(g_path.as_ptr());
        log_error_trace(r.is_err());
        reply<Result<i32, FsError>>(create.result_out, &r);
        return Ok(_);
    }
    FsRemoveArgs remove;
    if (accept<FsRemoveArgs>(service, args, &remove)) {
        copy_in_path(remove.path);
        Result<_, FsError> r = fs.remove(g_path.as_ptr());
        log_error_trace(r.is_err());
        reply<Result<_, FsError>>(remove.result_out, &r);
        return Ok(_);
    }
    FsMkdirArgs mkdir;
    if (accept<FsMkdirArgs>(service, args, &mkdir)) {
        copy_in_path(mkdir.path);
        Result<i32, FsError> r = fs.mkdir(g_path.as_ptr());
        log_error_trace(r.is_err());
        reply<Result<i32, FsError>>(mkdir.result_out, &r);
        return Ok(_);
    }
    return Err(OsServiceError::UnknownService(service));
}
