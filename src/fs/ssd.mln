package ssd;

import mem from "../../../MyKernel/src/mm/mem.mln";
import { wfi_cpu } from "../../../MyKernel/src/arch/wfi.masm";

// Block-device driver for the emulated SSD. Memory-mapped registers must match
// constants.rs in the emulator. A command is issued by latching the block
// number and RAM buffer address, then writing the command register; the device
// performs the transfer asynchronously (STATUS reads BUSY meanwhile), then
// reports DONE/ERROR and raises IRQ_CAUSE_SSD.

i32 SSD_CMD_ADDR    = 0x24000010; // W: 1=READ, 2=WRITE
i32 SSD_BLOCK_ADDR  = 0x24000014; // W: block number
i32 SSD_ADDR_ADDR   = 0x24000018; // W: RAM buffer address
i32 SSD_STATUS_ADDR = 0x2400001C; // R: 0=idle, 1=busy, 2=done, 0xFF=error

enum SsdCommand {
    SSD_CMD_READ    = 1,
    SSD_CMD_WRITE   = 2
}

enum SsdStatus {
    SSD_STATUS_BUSY = 1,
    SSD_STATUS_DONE = 2
}

export i32 BLOCK_SIZE = 65536;

// Wait for the in-flight command to complete and return its final status.
// The completion IRQ ends the wfi; with interrupts disabled (boot paths) wfi
// acts as a NOP and this degenerates into a busy-poll, which is also correct.
i32 wait_for_completion() {
    i32 status = mem.read_word(SSD_STATUS_ADDR);
    while (status == SSD_STATUS_BUSY) {
        wfi_cpu();
        status = mem.read_word(SSD_STATUS_ADDR);
    }
    return status;
}

// Read one block from the disk into the buffer at buf_addr.
// Returns 0 on success, -1 on error.
export i32 read_block(i32 block_num, i32 buf_addr) {
    mem.write_word(SSD_BLOCK_ADDR, block_num);
    mem.write_word(SSD_ADDR_ADDR, buf_addr);
    mem.write_word(SSD_CMD_ADDR, SSD_CMD_READ);
    if (wait_for_completion() == SSD_STATUS_DONE) {
        return 0;
    }
    return -1;
}

// Write one block from the buffer at buf_addr to the disk.
// Returns 0 on success, -1 on error.
export i32 write_block(i32 block_num, i32 buf_addr) {
    mem.write_word(SSD_BLOCK_ADDR, block_num);
    mem.write_word(SSD_ADDR_ADDR, buf_addr);
    mem.write_word(SSD_CMD_ADDR, SSD_CMD_WRITE);
    if (wait_for_completion() == SSD_STATUS_DONE) {
        return 0;
    }
    return -1;
}
