package ssd;

import mem from "@kernel/mm/mem.mln";
import { wfi_cpu } from "@kernel/arch/wfi.masm";
import { Result } from "@std/core/result.mln";

// Block-device driver for the emulated SSD. Memory-mapped registers must match
// constants.rs in the emulator. A command is issued by latching the block
// number and RAM buffer address, then writing the command register; the device
// performs the transfer asynchronously (STATUS reads BUSY meanwhile), then
// reports DONE/ERROR and raises IRQ_CAUSE_SSD.

i32 SSD_CMD_ADDR    = 0x24000010; // W: 1=READ, 2=WRITE
i32 SSD_BLOCK_ADDR  = 0x24000014; // W: block number
i32 SSD_ADDR_ADDR   = 0x24000018; // W: RAM buffer address
i32 SSD_STATUS_ADDR = 0x2400001C; // R: 0=idle, 1=busy, 2=done, 0xFF=error

/** Hardware command values accepted by the SSD command register. */
enum SsdCommand {
    SSD_CMD_READ = 1,
    SSD_CMD_WRITE = 2
}

/** Successful status values returned by the SSD status register. */
enum SsdStatus {
    BUSY = 1,
    DONE = 2
}

/** Failure values returned when a storage-device transfer does not complete successfully. */
export enum SsdError {
    DeviceError,
}

export const i32 BLOCK_SIZE = 65536;

/**
 * Waits for an in-flight SSD command to complete.
 * @return Ok(DONE) after a completed transfer, or Err(DeviceError).
 */
Result<SsdStatus, SsdError> wait_for_completion() {
    i32 status = mem.read_word(SSD_STATUS_ADDR);
    while (status == SsdStatus::BUSY) {
        wfi_cpu();
        status = mem.read_word(SSD_STATUS_ADDR);
    }
    if (status == SsdStatus::DONE) { return Ok(SsdStatus::DONE); }
    return Err(SsdError::DeviceError);
}

/**
 * Reads a 64 KiB block from the SSD into memory.
 * @param block_num Logical block number to read.
 * @param buf_addr Destination memory buffer address.
 * @return Ok(_) on success, or Err(DeviceError) on hardware error.
 */
export Result<_, SsdError> read_block(i32 block_num, i32 buf_addr) {
    mem.write_word(SSD_BLOCK_ADDR, block_num);
    mem.write_word(SSD_ADDR_ADDR, buf_addr);
    mem.write_word(SSD_CMD_ADDR, SSD_CMD_READ);
    SsdStatus completed = wait_for_completion()?;
    return Ok(_);
}

/**
 * Writes a 64 KiB block from memory to the SSD.
 * @param block_num Logical block number to write.
 * @param buf_addr Source memory buffer address.
 * @return Ok(_) on success, or Err(DeviceError) on hardware error.
 */
export Result<_, SsdError> write_block(i32 block_num, i32 buf_addr) {
    mem.write_word(SSD_BLOCK_ADDR, block_num);
    mem.write_word(SSD_ADDR_ADDR, buf_addr);
    mem.write_word(SSD_CMD_ADDR, SSD_CMD_WRITE);
    SsdStatus completed = wait_for_completion()?;
    return Ok(_);
}
