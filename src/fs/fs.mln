package fs;

import debug from "../../../MyKernel/src/debug/debug.mln";
import heap from "../../../MyKernel/src/mm/heap.mln";
import mem from "../../../MyKernel/src/mm/mem.mln";
import bitset from "../../../../toolchain/MyStdLib/collections/bitset.mln";
import bytes from "../../../../toolchain/MyStdLib/text/bytes.mln";
import str from "../../../../toolchain/MyStdLib/str.mln";
import serial from "../../../MyKernel/src/io/serial.mln";
import ssd from "ssd.mln";
import { Result } from "../../../../toolchain/MyStdLib/result.mln";
import { Option } from "../../../../toolchain/MyStdLib/option.mln";

// =========================================================================
// MyFileSystem (MFS): Direct File Descriptor (mfd) Subsystem (No RAM Cache)
// =========================================================================
//
// --- Architecture & Disk Constraints ---
// 1. Block Size: Fixed 65,536 bytes (64 KiB), matching hardware SSD block size.
// 2. Capacity: 16,384 blocks = 1,073,741,824 bytes (1 GiB) addressable space.
// 3. File Limit: Max 2,048 files (fits in 1 single 64 KiB entry table block).
// 4. Filename Length: Max 15 printable ASCII characters + 1 null terminator (16 bytes).
// 5. Data Block Payload: 65,532 bytes. First 4 bytes hold the next-block pointer (0 = EOF).
// 6. Direct Storage Access: No intermediate RAM cache; metadata changes (size) are
//    written directly to SSD Block 1 on write operations.
//
// Disk Layout:
//   Block 0          Superblock (magic: 'MFS1', version: 1, max_files: 2048)
//   Block 1          File entry table (2048 entries x 32 bytes = 65,536 bytes)
//   Block 2          Block allocation bitmap (16,384 bits = 2,048 bytes in 1 block)
//   Block 3..16383   Data blocks (16,381 data blocks = ~1.02 GB usable)
//
// File entry on disk (32 bytes per entry):
//   Offset  0..15 : filename (16 bytes, null-terminated ASCII)
//   Offset 16..19 : first_block (i32: 0 = free entry, >0 = first data block index)
//   Offset 20..23 : file_size (i32: size in bytes)
//   Offset 24..27 : flags (i32: reserved)
//   Offset 28..31 : reserved (i32)

// Error type for the Result<T, FsError> and Result<_, FsError> operations below.
// Unit variants can be returned directly with `return Err(FsError::Variant);`.
// Payload variants are constructed first (`FsError cause = BadFd(fd); return Err(cause);`).
// Operations without a return value use Result<_, FsError> and `return Ok(_);`.
export enum FsError {
    Disabled,        // filesystem not enabled (SSD absent / not formatted)
    InvalidName,     // path cleans to an empty name
    AlreadyExists,   // create(): a file with this name already exists
    NoFreeSlot,      // entry table (create) or fd table (open) is full
    AllocFailed,     // create()/write(): no free data block on the SSD
    NotFound,        // open()/remove(): no file with this name
    BadFd(i32),      // the fd that was out of range or not an open descriptor
    WrongType(i32),  // the fd that was open, but not the kind this call needs
    BadWhence(i32),  // seek(): the whence value, none of SEEK_SET/CUR/END
    Closed(i32),     // the fd whose backing file entry was removed out from under it
    InvalidSize(i32),// the size argument, <= 0
}

export i32 MAGIC        = 0x4D465331; // 'MFS1' (MyFileSystem v1)
export i32 VERSION      = 1;
export i32 ENTRY_SIZE   = 32;
export i32 NAME_MAX     = 16;

export i32 BLOCK_SIZE   = 65536; // must match ssd block size
export i32 BLOCK_COUNT  = 16384;
export i32 PAYLOAD      = 65532; // BLOCK_SIZE - 4 (next pointer)

export i32 SB_BLOCK         = 0;
export i32 ENTRY_BLOCK      = 1; // file entry table (1 block)
export i32 BITMAP_BLOCK     = 2; // block allocation bitmap (1 block)
export i32 DATA_START       = 3;
export i32 ENTRIES_PER_BLOCK = 2048; // BLOCK_SIZE / ENTRY_SIZE
export i32 MAX_FILES        = 2048;  // one full entry block

// Shared block buffer (allocated at init).
// Constraint: Single global transfer buffer; file operations are synchronous and non-reentrant.
i32 g_buf = 0;
i32 g_enabled = 0;

// =========================================================================
// 1. Open File & Descriptor Table (mfile & mfd)
// =========================================================================
//
// --- File Descriptor Constraints & Invariants ---
// 1. Table Capacity: Max 8 open descriptors system-wide (FD_MAX = 8).
// 2. Reserved Descriptors:
//      mfd 0 : STDIN  (FD_TYPE_SERIAL, read-only)
//      mfd 1 : STDOUT (FD_TYPE_SERIAL, write-only)
//      mfd 2 : STDERR (FD_TYPE_SERIAL, write-only)
// 3. User Descriptors: Allocated dynamically from mfd 3 up to (FD_MAX - 1).
// 4. Descriptor Metadata: Each open file handle holds its own cursor (offset)
//    and loaded metadata (entry_idx, first_block, file_size).

export i32 FD_MAX = 8;

export i32 SEEK_SET = 0;
export i32 SEEK_CUR = 1;
export i32 SEEK_END = 2;

export struct FileState {
    i32 entry_idx;
    i32 offset;
    i32 first_block;
    i32 file_size;
    i32 flags;
};

export struct SerialState {
    i32 flags;
};

export enum OpenFile {
    Unused,
    Serial(SerialState),
    File(FileState),
}

OpenFile g_fd_table[8];

// =========================================================================
// 2. Buffer Field Accessors & RAM Helpers
// =========================================================================
//
// --- Memory Alignment Constraints ---
// * Word accessors (buf_word/set_buf_word) require 4-byte aligned offsets.
// * Byte accessors operate with 0xFF masking to prevent sign-extension issues.

i32 buf_word(i32 off) {
    return mem.read_word(g_buf + off);
}

void set_buf_word(i32 off, i32 value) {
    mem.write_word(g_buf + off, value);
}

i32 buf_byte(i32 off) {
    char *p = (char *)(g_buf + off);
    return (i32)(*p) & 0xFF;
}

void set_buf_byte(i32 off, i32 value) {
    char *p = (char *)(g_buf + off);
    *p = (char)value;
}

i32 ram_byte(i32 addr) {
    char *p = (char *)addr;
    return (i32)(*p) & 0xFF;
}

void set_ram_byte(i32 addr, i32 value) {
    char *p = (char *)addr;
    *p = (char)value;
}

void zero_buf() {
    i32 i = 0;
    while (i < BLOCK_SIZE) {
        set_buf_word(i, 0);
        i = i + 4;
    }
}

// =========================================================================
// 3. Bitmap Helpers (Block Allocation)
// =========================================================================

// The bitmap lives in the block buffer g_buf points at, so every helper here
// is std bitset over that buffer. bitset indexes with shifts rather than the
// `/ 8` and `% 8` this used to do, which the target has no instruction for.

i32 bitmap_get(i32 block_num) {
    char *bits = (char *)g_buf;
    return bitset.get(bits, block_num);
}

void bitmap_set(i32 block_num, i32 value) {
    char *bits = (char *)g_buf;
    bitset.put(bits, block_num, value);
}

// Allocate a free data block from the SSD bitmap. Returns block number or 0 if full.
//
// bitset.find_clear skips whole bytes of 0xFF, so a nearly full disk costs one
// load per 8 blocks instead of one per block -- this used to test every bit of
// the 16,384 in turn.
Option<i32> alloc_block() {
    ssd.read_block(BITMAP_BLOCK, g_buf);
    char *bits = (char *)g_buf;

    i32 b = bitset.find_clear(bits, BLOCK_COUNT, DATA_START);
    if (b < 0) {
        Option<i32> none = None;
        return none;
    }

    bitset.set(bits, b);
    ssd.write_block(BITMAP_BLOCK, g_buf);
    Option<i32> found = Some(b);
    return found;
}

void free_block(i32 block_num) {
    ssd.read_block(BITMAP_BLOCK, g_buf);
    bitmap_set(block_num, 0);
    ssd.write_block(BITMAP_BLOCK, g_buf);
}

// =========================================================================
// 4. File Entry & On-Disk Helpers
// =========================================================================

i32 entry_block(i32 idx) {
    return ENTRY_BLOCK + (idx / ENTRIES_PER_BLOCK);
}

i32 entry_offset(i32 idx) {
    return (idx % ENTRIES_PER_BLOCK) * ENTRY_SIZE;
}

i32 load_entry(i32 idx) {
    ssd.read_block(entry_block(idx), g_buf);
    return entry_offset(idx);
}

i32 name_match(i32 off, char* name) {
    char *stored = (char *)(g_buf + off);
    if (str.ncmp(stored, name, NAME_MAX) == 0) {
        return 1;
    }
    return 0;
}

void store_name(i32 off, char* name) {
    char *dst = (char *)(g_buf + off);
    i32 written = str.ncopy(dst, name, NAME_MAX);
    // ncopy stops at the terminator it just wrote; the on-disk entry still
    // needs every byte through NAME_MAX zeroed, the way the original
    // byte-at-a-time loop left it.
    bytes.zero(&dst[written], NAME_MAX - written);
}

Option<i32> find_entry_by_name(char* name) {
    ssd.read_block(ENTRY_BLOCK, g_buf);
    i32 idx = 0;
    while (idx < MAX_FILES) {
        i32 off = idx * ENTRY_SIZE;
        if (buf_word(off + 16) != 0) { // first_block != 0 => in use
            if (name_match(off, name) != 0) {
                Option<i32> found = Some(idx);
                return found;
            }
        }
        idx++;
    }
    Option<i32> none = None;
    return none;
}

Option<i32> find_free_entry() {
    ssd.read_block(ENTRY_BLOCK, g_buf);
    i32 idx = 0;
    while (idx < MAX_FILES) {
        i32 off = idx * ENTRY_SIZE;
        if (buf_word(off + 16) == 0) {
            Option<i32> found = Some(idx);
            return found;
        }
        idx++;
    }
    Option<i32> none = None;
    return none;
}

// =========================================================================
// 5. Descriptor Table & Path Operations
// =========================================================================

void fd_table_init() {
    g_fd_table[0] = OpenFile::Serial(SerialState { flags: 1 }); // stdin
    g_fd_table[1] = OpenFile::Serial(SerialState { flags: 2 }); // stdout
    g_fd_table[2] = OpenFile::Serial(SerialState { flags: 2 }); // stderr

    i32 i = 3;
    while (i < FD_MAX) {
        g_fd_table[i] = OpenFile::Unused;
        i++;
    }
}

Option<i32> find_free_fd() {
    i32 i = 3; // Descriptors 0, 1, 2 are reserved for standard streams
    while (i < FD_MAX) {
        i32 is_unused = case g_fd_table[i] of {
            Unused -> 1;
            Serial(s) -> 0;
            File(f) -> 0;
        };
        if (is_unused != 0) {
            Option<i32> found = Some(i);
            return found;
        }
        i++;
    }
    Option<i32> none = None;
    return none;
}

// --- Path Resolution Constraints ---
// 1. Absolute paths with leading '/' (e.g. "/readme.txt") and relative paths ("readme.txt")
//    are normalized to the same file entry name.
// 2. Path components longer than (NAME_MAX - 1 = 15 characters) are truncated.
void path_clean_name(char* path, char* out_name) {
    if (path == 0) {
        out_name[0] = 0;
        return;
    }
    i32 start = 0;
    if (path[0] == '/') {
        start = 1;
    }
    // Truncates to NAME_MAX - 1 characters and always terminates, the same
    // bound the byte-at-a-time loop enforced.
    str.ncopy(out_name, &path[start], NAME_MAX);
}

// =========================================================================
// 6. Format / Init
// =========================================================================

export void format() {
    // Superblock
    zero_buf();
    set_buf_word(0, MAGIC);
    set_buf_word(4, VERSION);
    set_buf_word(8, MAX_FILES);
    ssd.write_block(SB_BLOCK, g_buf);

    // Clear entry table (Block 1)
    zero_buf();
    i32 b = ENTRY_BLOCK;
    while (b < BITMAP_BLOCK) {
        ssd.write_block(b, g_buf);
        b++;
    }

    // Bitmap: metadata blocks (0..2) marked used, data blocks (3..16383) marked free
    zero_buf();
    i32 i = 0;
    while (i < DATA_START) {
        bitmap_set(i, 1);
        i++;
    }
    ssd.write_block(BITMAP_BLOCK, g_buf);
}

export void init() {
    if (g_buf == 0) {
        g_buf = heap.alloc(BLOCK_SIZE);
    }

    fd_table_init();

    // Auto-format if superblock magic is missing
    if (ssd.read_block(SB_BLOCK, g_buf) != 0) {
        debug.println("fs: no disk (SSD disabled)");
        return;
    }
    if (buf_word(0) != MAGIC) {
        debug.println("fs: formatting new disk");
        format();
    }
    debug.println("kernel: fs ready");
    g_enabled = 1;
}

// =========================================================================
// 7. File Operations (open, create, read, write, seek, close, remove, list)
// =========================================================================

// Create a file by path. On success, opens it and returns its mfd (same as
// open() would).
// Constraint: Fails if file already exists or if disk entry table / bitmap is full.
export Result<i32, FsError> create(char* path) {
    if (g_enabled == 0) {
        return Err(FsError::Disabled);
    }

    char clean_name[16];
    path_clean_name(path, &clean_name[0]);
    if (clean_name[0] == 0) {
        return Err(FsError::InvalidName);
    }

    Option<i32> existing = find_entry_by_name(&clean_name[0]);
    i32 already = case existing of { Some(v) -> 1; None -> 0; };
    if (already != 0) {
        return Err(FsError::AlreadyExists);
    }
    Option<i32> free_entry = find_free_entry();
    i32 idx = case free_entry of { Some(v) -> v; None -> -1; };
    if (idx == -1) {
        return Err(FsError::NoFreeSlot);
    }
    Option<i32> free_block = alloc_block();
    i32 first = case free_block of { Some(v) -> v; None -> 0; };
    if (first == 0) {
        return Err(FsError::AllocFailed);
    }

    // Initialize the first data block (0 next pointer)
    zero_buf();
    ssd.write_block(first, g_buf);

    // Write entry to disk
    i32 off = load_entry(idx);
    store_name(off, &clean_name[0]);
    set_buf_word(off + 16, first); // first_block
    set_buf_word(off + 20, 0);     // file_size
    set_buf_word(off + 24, 0);     // flags
    set_buf_word(off + 28, 0);     // reserved
    ssd.write_block(entry_block(idx), g_buf);

    // A function can't `return` another function's aggregate-returning call
    // directly (no lvalue to copy from); binding it to a local first gives
    // the codegen an address to forward through our own hidden out-pointer.
    Result<i32, FsError> r = open(path);
    return r;
}

// Open an existing file by path. Returns its mfd.
export Result<i32, FsError> open(char* path) {
    if (g_enabled == 0) {
        return Err(FsError::Disabled);
    }

    char clean_name[16];
    path_clean_name(path, &clean_name[0]);
    if (clean_name[0] == 0) {
        return Err(FsError::InvalidName);
    }

    Option<i32> entry = find_entry_by_name(&clean_name[0]);
    i32 idx = case entry of { Some(v) -> v; None -> -1; };
    if (idx == -1) {
        return Err(FsError::NotFound);
    }
    Option<i32> free_fd = find_free_fd();
    i32 fd = case free_fd of { Some(v) -> v; None -> -1; };
    if (fd == -1) {
        return Err(FsError::NoFreeSlot);
    }

    i32 off = load_entry(idx);
    g_fd_table[fd] = OpenFile::File(FileState {
        entry_idx: idx,
        offset: 0,
        first_block: buf_word(off + 16),
        file_size: buf_word(off + 20),
        flags: 3,
    });
    return Ok(fd);
}

// Close an open descriptor.
// Constraint: Descriptors 0..2 (stdin/stdout/stderr) are preserved and never closed.
export void close(i32 fd) {
    if (fd >= 3 && fd < FD_MAX) {
        i32 is_file = case g_fd_table[fd] of {
            Unused -> 0;
            Serial(s) -> 0;
            File(f) -> 1;
        };
        if (is_file != 0) {
            g_fd_table[fd] = OpenFile::Unused;
        }
    }
}

// Seek offset on fd. Returns the new offset.
// Supported whence modes: SEEK_SET (0), SEEK_CUR (1), SEEK_END (2).
export Result<i32, FsError> seek(i32 fd, i32 offset, i32 whence) {
    if (fd < 0 || fd >= FD_MAX) {
        FsError cause = BadFd(fd);
        return Err(cause);
    }
    
    case g_fd_table[fd] of {
        Unused -> ({
            FsError cause = WrongType(fd);
            return Err(cause);
        });
        Serial(s) -> ({
            FsError cause = WrongType(fd);
            return Err(cause);
        });
        File(f) -> ({
            i32 target = f.offset;
            if (whence == SEEK_SET) {
                target = offset;
            } else if (whence == SEEK_CUR) {
                target = target + offset;
            } else if (whence == SEEK_END) {
                target = f.file_size + offset;
            } else {
                FsError cause = BadWhence(whence);
                return Err(cause);
            }
            if (target < 0) { target = 0; }
            f.offset = target;
            g_fd_table[fd] = OpenFile::File(f);
            return Ok(target);
        });
    };
    FsError fallback = WrongType(fd);
    return Err(fallback);
}

// Read up to `size` bytes from fd into RAM buffer `buf`.
// Returns the count of bytes read.
export Result<i32, FsError> read(i32 fd, i32 buf, i32 size) {
    if (fd < 0 || fd >= FD_MAX) {
        FsError cause = BadFd(fd);
        return Err(cause);
    }
    if (size <= 0) {
        FsError cause = InvalidSize(size);
        return Err(cause);
    }

    case g_fd_table[fd] of {
        Unused -> ({
            FsError cause = WrongType(fd);
            return Err(cause);
        });
        Serial(s) -> ({
            i32 count = 0;
            while (count < size) {
                if (serial.has_input() == 0) { break; }
                i32 c = serial.read_input();
                set_ram_byte(buf + count, c);
                count++;
            }
            return Ok(count);
        });
        File(f) -> ({
            i32 remaining = f.file_size - f.offset;
            if (remaining <= 0) {
                return Ok(0);
            }
            if (size > remaining) { size = remaining; }

            i32 read_total = 0;
            i32 block = f.first_block;
            i32 skip = f.offset / PAYLOAD;
            while (skip > 0) {
                ssd.read_block(block, g_buf);
                block = buf_word(0);
                skip = skip - 1;
            }
            i32 in_block = f.offset % PAYLOAD;

            while (read_total < size) {
                ssd.read_block(block, g_buf);
                i32 next = buf_word(0);
                while (in_block < PAYLOAD) {
                    if (read_total >= size) {
                        f.offset = f.offset + read_total;
                        g_fd_table[fd] = OpenFile::File(f);
                        return Ok(read_total);
                    }
                    i32 c = buf_byte(4 + in_block);
                    set_ram_byte(buf + read_total, c);
                    read_total++;
                    in_block++;
                }
                in_block = 0;
                block = next;
                if (block == 0) {
                    f.offset = f.offset + read_total;
                    g_fd_table[fd] = OpenFile::File(f);
                    return Ok(read_total);
                }
            }
            f.offset = f.offset + read_total;
            g_fd_table[fd] = OpenFile::File(f);
            return Ok(read_total);
        });
    };
    FsError fallback = WrongType(fd);
    return Err(fallback);
}

// Internal helper: updates file size directly to SSD Block 1 and syncs all open handles
// Internal helper: updates file size directly to SSD Block 1 and syncs all open handles
i32 finish_write(i32 fd, i32 new_size) {
    case g_fd_table[fd] of {
        Unused -> ({ return 0; });
        Serial(s) -> ({ return 0; });
        File(f) -> ({
            i32 written = new_size - f.file_size;
            i32 idx = f.entry_idx;
            i32 off = load_entry(idx);
            set_buf_word(off + 20, new_size);
            ssd.write_block(entry_block(idx), g_buf);
            
            i32 i = 3;
            while (i < FD_MAX) {
                case g_fd_table[i] of {
                    Unused -> ({ 0; });
                    Serial(s) -> ({ 0; });
                    File(other_f) -> ({
                        if (other_f.entry_idx == idx) {
                            other_f.file_size = new_size;
                            g_fd_table[i] = OpenFile::File(other_f);
                        }
                        0;
                    });
                };
                i++;
            }
            return written;
        });
    };
    return 0;
}

// Write `size` bytes from RAM buffer `buf` to fd. On success, the payload is
// the count of bytes actually written -- this can be less than `size` if the
// disk fills up mid-write, which is not itself an error (a short write, same
// as any real filesystem under the same condition).
export Result<i32, FsError> write(i32 fd, i32 buf, i32 size) {
    if (fd < 0 || fd >= FD_MAX) {
        FsError cause = BadFd(fd);
        return Err(cause);
    }
    if (size <= 0) {
        FsError cause = InvalidSize(size);
        return Err(cause);
    }

    case g_fd_table[fd] of {
        Unused -> ({
            FsError cause = WrongType(fd);
            return Err(cause);
        });
        Serial(s) -> ({
            i32 i = 0;
            while (i < size) {
                i32 c = ram_byte(buf + i);
                serial.putc(c);
                i++;
            }
            return Ok(size);
        });
        File(f) -> ({
            i32 file_size = f.file_size;

            i32 block = f.first_block;
            ssd.read_block(block, g_buf);
            while (buf_word(0) != 0) {
                block = buf_word(0);
                ssd.read_block(block, g_buf);
            }
            i32 in_block = file_size % PAYLOAD;
            if (file_size > 0) {
                if (in_block == 0) {
                    Option<i32> next_block = alloc_block();
                    i32 nb = case next_block of { Some(v) -> v; None -> 0; };
                    if (nb == 0) { return Ok(0); }
                    set_buf_word(0, nb);
                    ssd.write_block(block, g_buf);
                    block = nb;
                    zero_buf();
                    ssd.write_block(block, g_buf);
                }
            }

            i32 written = 0;
            while (written < size) {
                ssd.read_block(block, g_buf);
                while (in_block < PAYLOAD) {
                    if (written >= size) {
                        ssd.write_block(block, g_buf);
                        return Ok(finish_write(fd, file_size + written));
                    }
                    i32 c = ram_byte(buf + written);
                    set_buf_byte(4 + in_block, c);
                    written++;
                    in_block++;
                }
                if (written < size) {
                    Option<i32> next_block = alloc_block();
                    i32 nb = case next_block of { Some(v) -> v; None -> 0; };
                    if (nb == 0) {
                        set_buf_word(0, 0);
                        ssd.write_block(block, g_buf);
                        return Ok(finish_write(fd, file_size + written));
                    }
                    set_buf_word(0, nb);
                    ssd.write_block(block, g_buf);
                    block = nb;
                    zero_buf();
                    ssd.write_block(block, g_buf);
                    in_block = 0;
                } else {
                    ssd.write_block(block, g_buf);
                }
            }
            return Ok(finish_write(fd, file_size + written));
        });
    };
    FsError fallback = WrongType(fd);
    return Err(fallback);
}

// Remove a file by path. Frees the SSD block chain and clears its entry from
// Block 1.
export Result<_, FsError> remove(char* path) {
    char clean_name[16];
    path_clean_name(path, &clean_name[0]);
    if (clean_name[0] == 0) {
        return Err(FsError::InvalidName);
    }

    Option<i32> entry = find_entry_by_name(&clean_name[0]);
    i32 idx = case entry of { Some(v) -> v; None -> -1; };
    if (idx == -1) {
        return Err(FsError::NotFound);
    }
    i32 off = load_entry(idx);
    i32 block = buf_word(off + 16);

    // Free block chain
    while (block != 0) {
        ssd.read_block(block, g_buf);
        i32 next = buf_word(0);
        free_block(block);
        block = next;
    }

    // Clear disk entry
    off = load_entry(idx);
    set_buf_word(off + 16, 0);
    set_buf_word(off + 20, 0);
    set_buf_byte(off, 0);
    ssd.write_block(entry_block(idx), g_buf);

    // Invalidate any open descriptors targeting this entry
    i32 i = 3;
    while (i < FD_MAX) {
        case g_fd_table[i] of {
            Unused -> ({ 0; });
            Serial(s) -> ({ 0; });
            File(f) -> ({
                if (f.entry_idx == idx) {
                    g_fd_table[i] = OpenFile::Unused;
                }
                0;
            });
        };
        i++;
    }

    return Ok(_);
}

// List all files and sizes to the serial console.
export void list() {
    if (g_enabled == 0) { return; }
    debug.println("--- fs list ---");
    ssd.read_block(ENTRY_BLOCK, g_buf);
    i32 idx = 0;
    while (idx < MAX_FILES) {
        i32 off = idx * ENTRY_SIZE;
        if (buf_word(off + 16) != 0) {
            i32 size = buf_word(off + 20);
            debug.print("  ");
            i32 i = 0;
            while (i < NAME_MAX) {
                i32 c = buf_byte(off + i);
                if (c == 0) {
                    i = NAME_MAX;
                } else {
                    serial.putc(c);
                    i++;
                }
            }
            debug.printf(" (%i bytes)\n", size);
        }
        idx++;
    }
}
