package fs;

import fs_config from "fs_config.mln";

import debug from "../../../MyKernel/src/debug/debug.mln";
import heap from "../../../MyKernel/src/mm/heap.mln";
import mem from "../../../MyKernel/src/mm/mem.mln";
import bitset from "../../../../toolchain/MyStdLib/collections/bitset.mln";
import bytes from "../../../../toolchain/MyStdLib/text/bytes.mln";
import str from "../../../../toolchain/MyStdLib/str.mln";
import serial from "../../../MyKernel/src/io/serial.mln";
import ssd from "ssd.mln";
import { SsdError } from "ssd.mln";
import { Result } from "../../../../toolchain/MyStdLib/result.mln";
import { Option } from "../../../../toolchain/MyStdLib/option.mln";

// =========================================================================
// MyFileSystem (MFS): Direct File Descriptor (mfd) Subsystem (No RAM Cache)
// =========================================================================
//
// --- Architecture & Disk Constraints ---
// 1. Block Size: Fixed 65,536 bytes (64 KiB), matching hardware SSD block size.
// 2. Capacity: 16,384 blocks = 1,073,741,824 bytes (1 GiB) addressable space.
// 3. File Limit: Max 2,048 files (fits in 1 single 64 KiB entry table block).
// 4. Filename Length: Max 15 printable ASCII characters + 1 null terminator (16 bytes).
// 5. Data Block Payload: 65,532 bytes. First 4 bytes hold the next-block pointer (0 = EOF).
// 6. Direct Storage Access: No intermediate RAM cache; metadata changes (size) are
//    written directly to SSD Block 1 on write operations.
//
// Disk Layout:
//   Block 0          Superblock (magic: 'MFS1', version: 1, max_files: 2048)
//   Block 1          File entry table (2048 entries x 32 bytes = 65,536 bytes)
//   Block 2          Block allocation bitmap (16,384 bits = 2,048 bytes in 1 block)
//   Block 3..16383   Data blocks (16,381 data blocks = ~1.02 GB usable)
//
// File entry on disk (32 bytes per entry):
//   Offset  0..15 : filename (16 bytes, null-terminated ASCII)
//   Offset 16..19 : first_block (i32: 0 = free entry, >0 = first data block index)
//   Offset 20..23 : file_size (i32: size in bytes)
//   Offset 24..27 : flags (i32: reserved)
//   Offset 28..31 : reserved (i32)

// Error type for the Result<T, FsError> and Result<_, FsError> operations below.
// Unit variants can be returned directly with `return Err(FsError::Variant);`.
// Payload variants are constructed first (`FsError cause = BadFd(fd); return Err(cause);`).
// Operations without a return value use Result<_, FsError> and `return Ok(_);`.
export enum FsError {
    Disabled,        // filesystem not enabled (SSD absent / not formatted)
    InvalidName,     // path cleans to an empty name
    AlreadyExists,   // create(): a file with this name already exists
    NoFreeSlot,      // entry table (create) or fd table (open) is full
    AllocFailed,     // create()/write(): no free data block on the SSD
    NotFound,        // open()/remove(): no file with this name
    BadFd(i32),      // the fd that was out of range or not an open descriptor
    WrongType(i32),  // the fd that was open, but not the kind this call needs
    BadWhence(i32),  // seek(): the whence value, none of SEEK_SET/CUR/END
    Closed(i32),     // the fd whose backing file entry was removed out from under it
    InvalidSize(i32),// the size argument, <= 0
    IoError,         // I/O error talking to SSD
}


// Shared block buffer (allocated at init).
// Constraint: Single global transfer buffer; file operations are synchronous and non-reentrant.
i32 g_buf = 0;
i32 g_enabled = 0;

// =========================================================================
// 1. Open File & Descriptor Table (mfile & mfd)
// =========================================================================
//
// --- File Descriptor Constraints & Invariants ---
// 1. Table Capacity: Max 8 open descriptors system-wide (fs_config.FD_MAX = 8).
// 2. Reserved Descriptors:
//      mfd 0 : STDIN  (FD_TYPE_SERIAL, read-only)
//      mfd 1 : STDOUT (FD_TYPE_SERIAL, write-only)
//      mfd 2 : STDERR (FD_TYPE_SERIAL, write-only)
// 3. User Descriptors: Allocated dynamically from mfd 3 up to (fs_config.FD_MAX - 1).
// 4. Descriptor Metadata: Each open file handle holds its own cursor (offset)
//    and loaded metadata (entry_idx, first_block, file_size).


export i32 SEEK_SET = 0;
export i32 SEEK_CUR = 1;
export i32 SEEK_END = 2;

export struct FileState {
    i32 entry_idx;
    i32 offset;
    i32 first_block;
    i32 file_size;
    i32 flags;
};

export struct SerialState {
    i32 flags;
};

export enum OpenFile {
    Unused,
    Serial(SerialState),
    File(FileState),
}

OpenFile g_fd_table[8];

// =========================================================================
// 2. Buffer Field Accessors & RAM Helpers
// =========================================================================
//
// --- Memory Alignment Constraints ---
// * Word accessors (buf_word/set_buf_word) require 4-byte aligned offsets.
// * Byte accessors operate with 0xFF masking to prevent sign-extension issues.

/**
 * Reads a 32-bit word from the file system block buffer at the given byte offset.
 * @param off Byte offset within g_buf (must be 4-byte aligned).
 * @return 32-bit word value.
 */
i32 buf_word(i32 off) {
    return mem.read_word(g_buf + off);
}

/**
 * Writes a 32-bit word into the file system block buffer at the given byte offset.
 * @param off Byte offset within g_buf (must be 4-byte aligned).
 * @param value 32-bit word to write.
 */
void set_buf_word(i32 off, i32 value) {
    mem.write_word(g_buf + off, value);
}

/**
 * Reads an unsigned 8-bit byte from the file system block buffer.
 * @param off Byte offset within g_buf.
 * @return Byte value as unsigned 32-bit integer (0..255).
 */
i32 buf_byte(i32 off) {
    char *p = (char *)(g_buf + off);
    return (i32)(*p) & 0xFF;
}

/**
 * Writes an 8-bit byte into the file system block buffer.
 * @param off Byte offset within g_buf.
 * @param value Byte value to write.
 */
void set_buf_byte(i32 off, i32 value) {
    char *p = (char *)(g_buf + off);
    *p = (char)value;
}

/**
 * Reads an unsigned byte from an arbitrary memory address.
 * @param addr Memory address to read.
 * @return Byte value as unsigned 32-bit integer (0..255).
 */
i32 ram_byte(i32 addr) {
    char *p = (char *)addr;
    return (i32)(*p) & 0xFF;
}

/**
 * Writes an 8-bit byte to an arbitrary memory address.
 * @param addr Memory address to write.
 * @param value Byte value to store.
 */
void set_ram_byte(i32 addr, i32 value) {
    char *p = (char *)addr;
    *p = (char)value;
}

/**
 * Zeroes the entire file system block buffer (512 bytes).
 */
void zero_buf() {
    i32 i = 0;
    while (i < fs_config.BLOCK_SIZE) {
        set_buf_word(i, 0);
        i = i + 4;
    }
}

// =========================================================================
// 3. Bitmap Helpers (Block Allocation)
// =========================================================================

// The bitmap lives in the block buffer g_buf points at, so every helper here
// is std bitset over that buffer. bitset indexes with shifts rather than the
// `/ 8` and `% 8` this used to do, which the target has no instruction for.

/**
 * Queries the allocation state of a data block in the active bitmap buffer.
 * @param block_num Data block number.
 * @return Non-zero if allocated, zero if free.
 */
i32 bitmap_get(i32 block_num) {
    char *bits = (char *)g_buf;
    return bitset.get(bits, block_num);
}

/**
 * Sets or clears the allocation bit for a data block in the active bitmap buffer.
 * @param block_num Data block number.
 * @param value 1 to mark allocated, 0 to mark free.
 */
void bitmap_set(i32 block_num, i32 value) {
    char *bits = (char *)g_buf;
    bitset.put(bits, block_num, value);
}

/**
 * Allocates a free data block from the SSD bitmap and writes back the updated bitmap block.
 * @return Option containing allocated block number, or None if disk is full or on I/O error.
 */
Option<i32> alloc_block() {
    case ssd.read_block(fs_config.BITMAP_BLOCK, g_buf) of {
        Ok(_) -> _;
        Err(_) -> ({ return None; });
    };
    char *bits = (char *)g_buf;

    i32 b = case bitset.find_clear(bits, fs_config.BLOCK_COUNT, fs_config.DATA_START) of {
        Some(v) -> v;
        None -> ({ return None; });
    };

    bitset.set(bits, b);
    case ssd.write_block(fs_config.BITMAP_BLOCK, g_buf) of {
        Ok(_) -> _;
        Err(_) -> ({ return None; });
    };
    return Some(b);
}

/**
 * Marks a data block as free in the SSD bitmap and updates the bitmap block on disk.
 * @param block_num Data block number to free.
 */
void free_block(i32 block_num) {
    case ssd.read_block(fs_config.BITMAP_BLOCK, g_buf) of {
        Ok(_) -> _;
        Err(_) -> ({ return; });
    };
    bitmap_set(block_num, 0);
    case ssd.write_block(fs_config.BITMAP_BLOCK, g_buf) of {
        Ok(_) -> _;
        Err(_) -> ({ return; });
    };
}

// =========================================================================
// 4. File Entry & On-Disk Helpers
// =========================================================================

/**
 * Computes the disk block number containing the directory entry for a file index.
 * @param idx File entry index.
 * @return Block number on disk.
 */
i32 entry_block(i32 idx) {
    return fs_config.ENTRY_BLOCK + (idx / fs_config.ENTRIES_PER_BLOCK);
}

/**
 * Computes the byte offset of a directory entry within its disk block.
 * @param idx File entry index.
 * @return Byte offset within block buffer.
 */
i32 entry_offset(i32 idx) {
    return (idx % fs_config.ENTRIES_PER_BLOCK) * fs_config.ENTRY_SIZE;
}

/**
 * Reads the disk block containing file entry `idx` into `g_buf` and returns its byte offset.
 * @param idx File entry index.
 * @return Ok(offset) on success, or Err(FsError::IoError).
 */
Result<i32, FsError> load_entry(i32 idx) {
    case ssd.read_block(entry_block(idx), g_buf) of {
        Ok(_) -> _;
        Err(_) -> ({ return Err(FsError::IoError); });
    };
    return Ok(entry_offset(idx));
}

/**
 * Compares an entry name in g_buf at `off` against a target string up to NAME_MAX chars.
 * @param off Byte offset of entry in g_buf.
 * @param name Target filename string.
 * @return 1 if matched, 0 otherwise.
 */
i32 name_match(i32 off, char* name) {
    char *stored = (char *)(g_buf + off);
    if (str.ncmp(stored, name, fs_config.NAME_MAX) == 0) {
        return 1;
    }
    return 0;
}

/**
 * Copies a filename into g_buf at `off` and zeroes all remaining padding bytes up to NAME_MAX.
 * @param off Byte offset in g_buf.
 * @param name Null-terminated filename string.
 */
void store_name(i32 off, char* name) {
    char *dst = (char *)(g_buf + off);
    i32 written = str.ncopy(dst, name, fs_config.NAME_MAX);
    // ncopy stops at the terminator it just wrote; the on-disk entry still
    // needs every byte through fs_config.NAME_MAX zeroed, the way the original
    // byte-at-a-time loop left it.
    bytes.zero(&dst[written], fs_config.NAME_MAX - written);
}

/**
 * Searches the directory table on disk for an active file matching `name`.
 * @param name Filename to find.
 * @return Option containing file entry index, or None if not found.
 */
Option<i32> find_entry_by_name(char* name) {
    case ssd.read_block(fs_config.ENTRY_BLOCK, g_buf) of {
        Ok(_) -> _;
        Err(_) -> ({ return None; });
    };
    i32 idx = 0;
    while (idx < fs_config.MAX_FILES) {
        i32 off = idx * fs_config.ENTRY_SIZE;
        if (buf_word(off + 16) != 0) { // first_block != 0 => in use
            if (name_match(off, name) != 0) {
                return Some(idx);
            }
        }
        idx++;
    }
    return None;
}

/**
 * Searches the directory table on disk for an unused file entry slot.
 * @return Option containing free entry index, or None if directory table is full.
 */
Option<i32> find_free_entry() {
    case ssd.read_block(fs_config.ENTRY_BLOCK, g_buf) of {
        Ok(_) -> _;
        Err(_) -> ({ return None; });
    };
    i32 idx = 0;
    while (idx < fs_config.MAX_FILES) {
        i32 off = idx * fs_config.ENTRY_SIZE;
        if (buf_word(off + 16) == 0) {
            return Some(idx);
        }
        idx++;
    }
    return None;
}

// =========================================================================
// 5. Descriptor Table & Path Operations
// =========================================================================

/**
 * Initializes the open file descriptor table, setting standard streams (0..2) and clearing 3..FD_MAX.
 */
void fd_table_init() {
    g_fd_table[0] = OpenFile::Serial(SerialState { flags: 1 }); // stdin
    g_fd_table[1] = OpenFile::Serial(SerialState { flags: 2 }); // stdout
    g_fd_table[2] = OpenFile::Serial(SerialState { flags: 2 }); // stderr

    i32 i = 3;
    while (i < fs_config.FD_MAX) {
        g_fd_table[i] = OpenFile::Unused;
        i++;
    }
}

/**
 * Finds an unused file descriptor slot starting after standard streams (index >= 3).
 * @return Option containing free file descriptor, or None if table is exhausted.
 */
Option<i32> find_free_fd() {
    i32 i = 3; // Descriptors 0, 1, 2 are reserved for standard streams
    while (i < fs_config.FD_MAX) {
        case g_fd_table[i] of {
            Unused -> ({ return Some(i); });
            _ -> _;
        };
        i++;
    }
    return None;
}

// --- Path Resolution Constraints ---
// 1. Absolute paths with leading '/' (e.g. "/readme.txt") and relative paths ("readme.txt")
//    are normalized to the same file entry name.
// 2. Path components longer than (fs_config.NAME_MAX - 1 = 15 characters) are truncated.

/**
 * Strips leading slash from path and normalizes filename into `out_name` up to NAME_MAX length.
 * @param path Input path string.
 * @param out_name Destination buffer of at least NAME_MAX bytes.
 */
void path_clean_name(char* path, char* out_name) {
    if (path == 0) {
        out_name[0] = 0;
        return;
    }
    i32 start = 0;
    if (path[0] == '/') {
        start = 1;
    }
    // Truncates to fs_config.NAME_MAX - 1 characters and always terminates, the same
    // bound the byte-at-a-time loop enforced.
    str.ncopy(out_name, &path[start], fs_config.NAME_MAX);
}

// =========================================================================
// 6. Format / Init
// =========================================================================

/**
 * Low-level formats the SSD with a clean MyFileSystem layout.
 *
 * Writes superblock (Block 0), clears entry table (Block 1), and initializes bitmap (Block 2).
 */
export void format() {
    // Superblock
    zero_buf();
    set_buf_word(0, fs_config.MAGIC);
    set_buf_word(4, fs_config.VERSION);
    set_buf_word(8, fs_config.MAX_FILES);
    case ssd.write_block(fs_config.SB_BLOCK, g_buf) of {
        Ok(_) -> _;
        Err(_) -> ({ return; });
    };

    // Clear entry table (Block 1)
    zero_buf();
    i32 b = fs_config.ENTRY_BLOCK;
    while (b < fs_config.BITMAP_BLOCK) {
        case ssd.write_block(b, g_buf) of {
            Ok(_) -> _;
            Err(_) -> ({ return; });
        };
        b++;
    }

    // Bitmap: metadata blocks (0..2) marked used, data blocks (3..16383) marked free
    zero_buf();
    i32 i = 0;
    while (i < fs_config.DATA_START) {
        bitmap_set(i, 1);
        i++;
    }
    case ssd.write_block(fs_config.BITMAP_BLOCK, g_buf) of {
        Ok(_) -> _;
        Err(_) -> ({ return; });
    };
}

/**
 * Initializes the filesystem driver and mounts the root filesystem from SSD.
 *
 * Allocates transfer buffer, initializes descriptor table, and auto-formats if no superblock exists.
 */
export void init() {
    if (g_buf == 0) {
        g_buf = heap.alloc(fs_config.BLOCK_SIZE);
    }

    fd_table_init();

    // Auto-format if superblock magic is missing
    case ssd.read_block(fs_config.SB_BLOCK, g_buf) of {
        Ok(_) -> _;
        Err(_) -> ({
            debug.println("fs: no disk (SSD disabled)");
            return;
        });
    };
    if (buf_word(0) != fs_config.MAGIC) {
        debug.println("fs: formatting new disk");
        format();
    }
    debug.println("kernel: fs ready");
    g_enabled = 1;
}

// =========================================================================
// 7. File Operations (open, create, read, write, seek, close, remove, list)
// =========================================================================

/**
 * Creates a new file by path and opens it for read/write access.
 * @param path Pointer to null-terminated file path string.
 * @return Ok(fd) with opened file descriptor, or Err(FsError).
 */
export Result<i32, FsError> create(char* path) {
    if (g_enabled == 0) {
        return Err(FsError::Disabled);
    }

    char clean_name[16];
    path_clean_name(path, &clean_name[0]);
    if (clean_name[0] == 0) {
        return Err(FsError::InvalidName);
    }

    case find_entry_by_name(&clean_name[0]) of {
        Some(_) -> ({ return Err(FsError::AlreadyExists); });
        None -> _;
    };
    i32 idx = case find_free_entry() of {
        Some(v) -> v;
        None -> ({ return Err(FsError::NoFreeSlot); });
    };
    i32 first = case alloc_block() of {
        Some(v) -> v;
        None -> ({ return Err(FsError::AllocFailed); });
    };

    // Initialize the first data block (0 next pointer)
    zero_buf();
    case ssd.write_block(first, g_buf) of {
        Ok(_) -> _;
        Err(_) -> ({ return Err(FsError::IoError); });
    };

    // Write entry to disk
    i32 off = case load_entry(idx) of {
        Ok(v) -> v;
        Err(e) -> ({ return Err(e); });
    };
    store_name(off, &clean_name[0]);
    set_buf_word(off + 16, first); // first_block
    set_buf_word(off + 20, 0);     // file_size
    set_buf_word(off + 24, 0);     // flags
    set_buf_word(off + 28, 0);     // reserved
    case ssd.write_block(entry_block(idx), g_buf) of {
        Ok(_) -> _;
        Err(_) -> ({ return Err(FsError::IoError); });
    };

    // A function can't `return` another function's aggregate-returning call
    // directly (no lvalue to copy from); binding it to a local first gives
    // the codegen an address to forward through our own hidden out-pointer.
    Result<i32, FsError> r = open(path);
    return r;
}

/**
 * Opens an existing file by path.
 * @param path Pointer to null-terminated file path string.
 * @return Ok(fd) with allocated file descriptor, or Err(FsError).
 */
export Result<i32, FsError> open(char* path) {
    if (g_enabled == 0) {
        return Err(FsError::Disabled);
    }

    char clean_name[16];
    path_clean_name(path, &clean_name[0]);
    if (clean_name[0] == 0) {
        return Err(FsError::InvalidName);
    }

    i32 idx = case find_entry_by_name(&clean_name[0]) of {
        Some(v) -> v;
        None -> ({ return Err(FsError::NotFound); });
    };
    i32 fd = case find_free_fd() of {
        Some(v) -> v;
        None -> ({ return Err(FsError::NoFreeSlot); });
    };

    i32 off = case load_entry(idx) of {
        Ok(v) -> v;
        Err(e) -> ({ return Err(e); });
    };
    g_fd_table[fd] = OpenFile::File(FileState {
        entry_idx: idx,
        offset: 0,
        first_block: buf_word(off + 16),
        file_size: buf_word(off + 20),
        flags: 3,
    });
    return Ok(fd);
}

/**
 * Closes an open file descriptor.
 *
 * Descriptors 0..2 (stdin/stdout/stderr) are preserved and never closed.
 * @param fd File descriptor to close.
 */
export void close(i32 fd) {
    if (fd >= 3 && fd < fs_config.FD_MAX) {
        case g_fd_table[fd] of {
            File(f) -> ({
                g_fd_table[fd] = OpenFile::Unused;
            });
            _ -> _;
        };
    }
}

/**
 * Sets the file position cursor for an open file descriptor.
 * @param fd File descriptor.
 * @param offset Byte offset relative to whence.
 * @param whence Origin (SEEK_SET = 0, SEEK_CUR = 1, SEEK_END = 2).
 * @return Ok(new_offset) with updated file cursor, or Err(FsError).
 */
export Result<i32, FsError> seek(i32 fd, i32 offset, i32 whence) {
    if (fd < 0 || fd >= fs_config.FD_MAX) {
        FsError cause = BadFd(fd);
        return Err(cause);
    }
    
    case g_fd_table[fd] of {
        Unused -> ({
            FsError cause = WrongType(fd);
            return Err(cause);
        });
        Serial(s) -> ({
            FsError cause = WrongType(fd);
            return Err(cause);
        });
        File(f) -> ({
            i32 target = f.offset;
            if (whence == SEEK_SET) {
                target = offset;
            } else if (whence == SEEK_CUR) {
                target = target + offset;
            } else if (whence == SEEK_END) {
                target = f.file_size + offset;
            } else {
                FsError cause = BadWhence(whence);
                return Err(cause);
            }
            if (target < 0) { target = 0; }
            f.offset = target;
            g_fd_table[fd] = OpenFile::File(f);
            return Ok(target);
        });
    };
    FsError fallback = WrongType(fd);
    return Err(fallback);
}

/**
 * Reads up to `size` bytes from an open descriptor into memory buffer `buf`.
 * @param fd File descriptor to read from.
 * @param buf Destination RAM address.
 * @param size Maximum number of bytes to read.
 * @return Ok(bytes_read) with count of bytes read, or Err(FsError).
 */
export Result<i32, FsError> read(i32 fd, i32 buf, i32 size) {
    if (fd < 0 || fd >= fs_config.FD_MAX) {
        FsError cause = BadFd(fd);
        return Err(cause);
    }
    if (size <= 0) {
        FsError cause = InvalidSize(size);
        return Err(cause);
    }

    case g_fd_table[fd] of {
        Unused -> ({
            FsError cause = WrongType(fd);
            return Err(cause);
        });
        Serial(s) -> ({
            i32 count = 0;
            while (count < size) {
                Option<i32> opt_c = serial.read_input();
                i32 has_c = case opt_c of {
                    Some(c) -> ({
                        set_ram_byte(buf + count, c);
                        count++;
                        1;
                    });
                    None -> 0;
                };
                if (has_c == 0) { break; }
            }
            return Ok(count);
        });
        File(f) -> ({
            i32 remaining = f.file_size - f.offset;
            if (remaining <= 0) {
                return Ok(0);
            }
            if (size > remaining) { size = remaining; }

            i32 read_total = 0;
            i32 block = f.first_block;
            i32 skip = f.offset / fs_config.PAYLOAD;
            while (skip > 0) {
                case ssd.read_block(block, g_buf) of {
                    Ok(_) -> _;
                    Err(_) -> ({ return Err(FsError::IoError); });
                };
                block = buf_word(0);
                skip = skip - 1;
            }
            i32 in_block = f.offset % fs_config.PAYLOAD;

            while (read_total < size) {
                case ssd.read_block(block, g_buf) of {
                    Ok(_) -> _;
                    Err(_) -> ({ return Err(FsError::IoError); });
                };
                i32 next = buf_word(0);
                while (in_block < fs_config.PAYLOAD) {
                    if (read_total >= size) {
                        f.offset = f.offset + read_total;
                        g_fd_table[fd] = OpenFile::File(f);
                        return Ok(read_total);
                    }
                    i32 c = buf_byte(4 + in_block);
                    set_ram_byte(buf + read_total, c);
                    read_total++;
                    in_block++;
                }
                in_block = 0;
                block = next;
                if (block == 0) {
                    f.offset = f.offset + read_total;
                    g_fd_table[fd] = OpenFile::File(f);
                    return Ok(read_total);
                }
            }
            f.offset = f.offset + read_total;
            g_fd_table[fd] = OpenFile::File(f);
            return Ok(read_total);
        });
    };
    FsError fallback = WrongType(fd);
    return Err(fallback);
}

/**
 * Updates file size in the on-disk directory entry and synchronizes all open file handles.
 * @param fd File descriptor being written.
 * @param new_size New file size in bytes.
 * @return Number of bytes appended to the file.
 */
i32 finish_write(i32 fd, i32 new_size) {
    case g_fd_table[fd] of {
        Unused -> ({ return 0; });
        Serial(s) -> ({ return 0; });
        File(f) -> ({
            i32 written = new_size - f.file_size;
            i32 idx = f.entry_idx;
            i32 off = case load_entry(idx) of {
                Ok(v) -> v;
                Err(_) -> ({ return 0; });
            };
            set_buf_word(off + 20, new_size);
            case ssd.write_block(entry_block(idx), g_buf) of {
                Ok(_) -> _;
                Err(_) -> ({ return 0; });
            };
            
            i32 i = 3;
            while (i < fs_config.FD_MAX) {
                case g_fd_table[i] of {
                    File(other_f) -> ({
                        if (other_f.entry_idx == idx) {
                            other_f.file_size = new_size;
                            g_fd_table[i] = OpenFile::File(other_f);
                        }
                    });
                    _ -> _;
                };
                i++;
            }
            return written;
        });
    };
    return 0;
}

/**
 * Writes `size` bytes from RAM buffer `buf` to an open descriptor.
 *
 * Can return a short write if the disk fills up.
 * @param fd File descriptor.
 * @param buf Source RAM buffer address.
 * @param size Number of bytes to write.
 * @return Ok(written) with count of bytes actually written, or Err(FsError).
 */
export Result<i32, FsError> write(i32 fd, i32 buf, i32 size) {
    if (fd < 0 || fd >= fs_config.FD_MAX) {
        FsError cause = BadFd(fd);
        return Err(cause);
    }
    if (size <= 0) {
        FsError cause = InvalidSize(size);
        return Err(cause);
    }

    case g_fd_table[fd] of {
        Unused -> ({
            FsError cause = WrongType(fd);
            return Err(cause);
        });
        Serial(s) -> ({
            i32 i = 0;
            while (i < size) {
                i32 c = ram_byte(buf + i);
                serial.putc(c);
                i++;
            }
            return Ok(size);
        });
        File(f) -> ({
            i32 file_size = f.file_size;

            i32 block = f.first_block;
            case ssd.read_block(block, g_buf) of {
                Ok(_) -> _;
                Err(_) -> ({ return Err(FsError::IoError); });
            };
            while (buf_word(0) != 0) {
                block = buf_word(0);
                case ssd.read_block(block, g_buf) of {
                    Ok(_) -> _;
                    Err(_) -> ({ return Err(FsError::IoError); });
                };
            }
            i32 in_block = file_size % fs_config.PAYLOAD;
            if (file_size > 0) {
                if (in_block == 0) {
                    i32 nb = case alloc_block() of {
                        Some(v) -> v;
                        None -> ({ return Ok(0); });
                    };
                    set_buf_word(0, nb);
                    case ssd.write_block(block, g_buf) of {
                        Ok(_) -> _;
                        Err(_) -> ({ return Err(FsError::IoError); });
                    };
                    block = nb;
                    zero_buf();
                    case ssd.write_block(block, g_buf) of {
                        Ok(_) -> _;
                        Err(_) -> ({ return Err(FsError::IoError); });
                    };
                }
            }

            i32 written = 0;
            while (written < size) {
                case ssd.read_block(block, g_buf) of {
                    Ok(_) -> _;
                    Err(_) -> ({ return Err(FsError::IoError); });
                };
                while (in_block < fs_config.PAYLOAD) {
                    if (written >= size) {
                        case ssd.write_block(block, g_buf) of {
                            Ok(_) -> _;
                            Err(_) -> ({ return Err(FsError::IoError); });
                        };
                        return Ok(finish_write(fd, file_size + written));
                    }
                    i32 c = ram_byte(buf + written);
                    set_buf_byte(4 + in_block, c);
                    written++;
                    in_block++;
                }
                if (written < size) {
                    i32 nb = case alloc_block() of {
                        Some(v) -> v;
                        None -> ({
                            set_buf_word(0, 0);
                            case ssd.write_block(block, g_buf) of {
                                Ok(_) -> _;
                                Err(_) -> ({ return Err(FsError::IoError); });
                            };
                            return Ok(finish_write(fd, file_size + written));
                        });
                    };
                    set_buf_word(0, nb);
                    case ssd.write_block(block, g_buf) of {
                        Ok(_) -> _;
                        Err(_) -> ({ return Err(FsError::IoError); });
                    };
                    block = nb;
                    zero_buf();
                    case ssd.write_block(block, g_buf) of {
                        Ok(_) -> _;
                        Err(_) -> ({ return Err(FsError::IoError); });
                    };
                    in_block = 0;
                } else {
                    case ssd.write_block(block, g_buf) of {
                        Ok(_) -> _;
                        Err(_) -> ({ return Err(FsError::IoError); });
                    };
                }
            }
            return Ok(finish_write(fd, file_size + written));
        });
    };
    FsError fallback = WrongType(fd);
    return Err(fallback);
}

/**
 * Removes a file by path, freeing its allocated block chain and entry.
 * @param path Pointer to null-terminated file path string.
 * @return Ok(_) on success, or Err(FsError).
 */
export Result<_, FsError> remove(char* path) {
    char clean_name[16];
    path_clean_name(path, &clean_name[0]);
    if (clean_name[0] == 0) {
        return Err(FsError::InvalidName);
    }

    i32 idx = case find_entry_by_name(&clean_name[0]) of {
        Some(v) -> v;
        None -> ({ return Err(FsError::NotFound); });
    };
    i32 off = case load_entry(idx) of {
        Ok(v) -> v;
        Err(e) -> ({ return Err(e); });
    };
    i32 block = buf_word(off + 16);

    // Free block chain
    while (block != 0) {
        case ssd.read_block(block, g_buf) of {
            Ok(_) -> _;
            Err(_) -> ({ return Err(FsError::IoError); });
        };
        i32 next = buf_word(0);
        free_block(block);
        block = next;
    }

    // Clear disk entry
    off = case load_entry(idx) of {
        Ok(v) -> v;
        Err(e) -> ({ return Err(e); });
    };
    set_buf_word(off + 16, 0);
    set_buf_word(off + 20, 0);
    set_buf_byte(off, 0);
    case ssd.write_block(entry_block(idx), g_buf) of {
        Ok(_) -> _;
        Err(_) -> ({ return Err(FsError::IoError); });
    };

    // Invalidate any open descriptors targeting this entry
    i32 i = 3;
    while (i < fs_config.FD_MAX) {
        case g_fd_table[i] of {
            File(f) -> ({
                if (f.entry_idx == idx) {
                    g_fd_table[i] = OpenFile::Unused;
                }
            });
            _ -> _;
        };
        i++;
    }

    return Ok(_);
}

/**
 * Lists all existing files and their sizes to the serial debug console.
 */
export void list() {
    if (g_enabled == 0) { return; }
    debug.println("--- fs list ---");
    case ssd.read_block(fs_config.ENTRY_BLOCK, g_buf) of {
        Ok(_) -> _;
        Err(_) -> ({ return; });
    };
    i32 idx = 0;
    while (idx < fs_config.MAX_FILES) {
        i32 off = idx * fs_config.ENTRY_SIZE;
        if (buf_word(off + 16) != 0) {
            i32 size = buf_word(off + 20);
            debug.print("  ");
            i32 i = 0;
            while (i < fs_config.NAME_MAX) {
                i32 c = buf_byte(off + i);
                if (c == 0) {
                    i = fs_config.NAME_MAX;
                } else {
                    serial.putc(c);
                    i++;
                }
            }
            debug.printf(" (%i bytes)\n", size);
        }
        idx++;
    }
}

// =========================================================================
// 8. Directory enumeration (MYOS-015: file manager)
// =========================================================================

/**
 * Finds the next used file entry starting at index `start`.
 * @param start Starting entry table index.
 * @param out Buffer to receive null-terminated filename.
 * @param cap Maximum capacity of output buffer.
 * @return Ok(Some(idx)) on match, Ok(None) at end of directory, or Err(FsError).
 */
export Result<Option<i32>, FsError> dir_next(i32 start, char* out, i32 cap) {
    if (g_enabled == 0) { return Err(FsError::Disabled); }
    if (start < 0) { start = 0; }
    case ssd.read_block(fs_config.ENTRY_BLOCK, g_buf) of {
        Ok(_) -> _;
        Err(_) -> ({ return Err(FsError::IoError); });
    };
    i32 idx = start;
    while (idx < fs_config.MAX_FILES) {
        i32 off = idx * fs_config.ENTRY_SIZE;
        if (buf_word(off + 16) != 0) {
            i32 i = 0;
            while (i < fs_config.NAME_MAX) {
                i32 c = buf_byte(off + i);
                if (c == 0) { break; }
                if (i + 1 >= cap) { break; }
                out[i] = (char)c;
                i++;
            }
            out[i] = (char)0;
            return Ok(Some(idx));
        }
        idx++;
    }
    return Ok(None);
}

/**
 * Returns the size in bytes of the file at entry index `idx`.
 * @param idx File entry table index.
 * @return File size in bytes, or 0 if entry is free/invalid.
 */
export i32 entry_size(i32 idx) {
    if (g_enabled == 0) { return 0; }
    if (idx < 0 || idx >= fs_config.MAX_FILES) { return 0; }
    case ssd.read_block(fs_config.ENTRY_BLOCK, g_buf) of {
        Ok(_) -> _;
        Err(_) -> ({ return 0; });
    };
    i32 off = idx * fs_config.ENTRY_SIZE;
    if (buf_word(off + 16) == 0) { return 0; }
    return buf_word(off + 20);
}
